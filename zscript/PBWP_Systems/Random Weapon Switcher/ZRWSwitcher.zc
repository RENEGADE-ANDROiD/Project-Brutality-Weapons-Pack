
class RandomWeaponSwitcher : StaticEventHandler
{
    Array<int>  SwitchTics;          // time until switch is triggered
    Array<int>  lockActive;          // 0 = free, 1 = forced weapon lock
    Array<Name> forcedWeapon;        // forced weapon class
    Array<Name> lastWeapon;          // player's previously held weapon
    Array<Name> currentWeapon;       // currently tracked weapon
    Array<int>  cachedDelayMin;
    Array<int>  cachedDelayMax;
    Array<bool> cachedSwitchEnabled;
    Array<bool> cachedLockWeap;
    Array<bool> cachedInstSwitch;

    const RW_CVAR_REFRESH_TICS = 35;

    void EnsureCacheArrays()
    {
        int max = MAXPLAYERS;
        cachedDelayMin.Resize(max);
        cachedDelayMax.Resize(max);
        cachedSwitchEnabled.Resize(max);
        cachedLockWeap.Resize(max);
        cachedInstSwitch.Resize(max);
    }

    void RefreshPlayerCVars(int pn)
    {
        if (pn < 0 || pn >= MAXPLAYERS)
            return;
        EnsureCacheArrays();

        PlayerInfo p = players[pn];
        if (!p)
            return;

        let cvMin = CVar.GetCVar("rw_DelayMin", p);
        cachedDelayMin[pn] = cvMin ? cvMin.GetInt() : 0;

        let cvMax = CVar.GetCVar("rw_DelayMax", p);
        cachedDelayMax[pn] = cvMax ? cvMax.GetInt() : 60;

        let cvEnabled = CVar.GetCVar("rw_switchEnabled", p);
        cachedSwitchEnabled[pn] = cvEnabled && cvEnabled.GetBool();

        let cvLock = CVar.GetCVar("rw_lockWeap", p);
        cachedLockWeap[pn] = cvLock && cvLock.GetBool();

        let cvInst = CVar.GetCVar("rw_instSwitch", p);
        cachedInstSwitch[pn] = cvInst && cvInst.GetBool();
    }

    void RefreshAllPlayerCVars()
    {
        for (int i = 0; i < MAXPLAYERS; i++)
        {
            if (!playeringame[i])
                continue;
            RefreshPlayerCVars(i);
        }
    }

    int RandomSwitchDelayTics(int pn)
    {
        int dmin = cachedDelayMin[pn];
        int dmax = cachedDelayMax[pn];
        if (dmax < dmin)
        {
            int tmp = dmin;
            dmin = dmax;
            dmax = tmp;
        }
        return Random(ticrate * dmin, ticrate * dmax);
    }

    bool TrySelectWeapon(PlayerInfo p, int pn, Name wepClass)
    {
        if (wepClass == '' || !p || !p.mo)
            return false;

        if (cachedInstSwitch[pn])
        {
            int oldCheats = p.cheats;
            p.cheats |= CF_INSTANTWEAPSWITCH;

            if (p.mo.A_SelectWeapon(wepClass))
            {
                let restorer = new("CheatRestorer");
                CheatRestorer(restorer).Init(p, oldCheats, 2);
                return true;
            }

            p.cheats = oldCheats;
            return false;
        }

        return p.mo.A_SelectWeapon(wepClass);
    }

    override void WorldLoaded(WorldEvent e)
    {
        InitArrays();
        RefreshAllPlayerCVars();
    }

    override void PlayerSpawned(PlayerEvent e)
    {
        int pn = e.PlayerNumber;
        if (pn < 0 || pn >= MAXPLAYERS) return;

        EnsureArrays();
        RefreshPlayerCVars(pn);

        SwitchTics[pn]       = RandomSwitchDelayTics(pn);
        lockActive[pn]       = 0;
        forcedWeapon[pn]     = '';
        lastWeapon[pn]       = '';
        currentWeapon[pn]    = '';
    }

    override void WorldTick()
    {
        if (level.isFrozen()) return;

        if ((level.maptime % RW_CVAR_REFRESH_TICS) == 0)
            RefreshAllPlayerCVars();

        for (int i = 0; i < MAXPLAYERS; i++)
        {
            if (!playeringame[i]) continue;
            PlayerInfo p = players[i];
            if (!p || !p.mo) continue;

            Weapon rw = p.ReadyWeapon;
            if (rw)
            {
                Name cur = rw.GetClassName();
                if (cur != currentWeapon[i])
                {
                    lastWeapon[i]    = currentWeapon[i];
                    currentWeapon[i] = cur;
                }
            }

            // --- Enforce weapon lock
            if (lockActive[i] && forcedWeapon[i] != '')
            {
                if (!HasWeapon(p, forcedWeapon[i]))
                {
                    lockActive[i]   = 0;
                    forcedWeapon[i] = '';
                }
                else
                {
                    if (!rw || rw.GetClassName() != forcedWeapon[i])
                    {
                        if (!cachedLockWeap[i])
                            continue;

                        TrySelectWeapon(p, i, forcedWeapon[i]);
                    }
                }
            }

            if (!cachedSwitchEnabled[i])
                continue;

            // --- random switch timer
            SwitchTics[i]--;
            if (SwitchTics[i] <= 0)
            {
                ForceRandomSwitch(p);
                SwitchTics[i] = RandomSwitchDelayTics(i);
            }
        }
        super.WorldTick();
    }

    override void NetworkProcess(ConsoleEvent e)
    {
        if (e.Player < 0 || e.Player >= MAXPLAYERS) return;

        PlayerInfo p = players[e.Player];
        if (!p || !p.mo) return;

        RefreshPlayerCVars(e.Player);

        // Manual trigger
        if (e.Name == "SwitchItUp")
            ForceRandomSwitch(p);

        // Unlock & restore last weapon
        if (e.Name == "SwitchBack" && lastWeapon[e.Player] != '')
        {
            TrySelectWeapon(p, e.Player, lastWeapon[e.Player]);

            lockActive[e.Player]   = 0;
            forcedWeapon[e.Player] = '';
        }
    }

    void ForceRandomSwitch(PlayerInfo p)
    {
        Array<Weapon> Arsenal;

        for (let it = p.mo.Inv; it; it = it.Inv)
        {
            Weapon w = Weapon(it);
            if (w && w != p.ReadyWeapon)
                Arsenal.Push(w);
        }
        if (Arsenal.Size() == 0) return;

        int pick = Random(0, Arsenal.Size() - 1);
        Weapon newW = Arsenal[pick];
        Name chosenWeapon = newW.GetClassName();

        int pn = FindPlayerNum(p);
        if (pn < 0)
            return;

        TrySelectWeapon(p, pn, chosenWeapon);

        forcedWeapon[pn] = chosenWeapon;
        lockActive[pn]   = 1;
    }

    void InitArrays()
    {
        int max = MAXPLAYERS;
        SwitchTics.Resize(max);
        lockActive.Resize(max);
        forcedWeapon.Resize(max);
        lastWeapon.Resize(max);
        currentWeapon.Resize(max);
        EnsureCacheArrays();

        for (int i = 0; i < max; i++)
        {
            cachedDelayMin[i] = 0;
            cachedDelayMax[i] = 60;
            cachedSwitchEnabled[i] = false;
            cachedLockWeap[i] = false;
            cachedInstSwitch[i] = false;
            SwitchTics[i]       = Random(ticrate * cachedDelayMin[i], ticrate * cachedDelayMax[i]);
            lockActive[i]       = 0;
            forcedWeapon[i]     = '';
            lastWeapon[i]       = '';
            currentWeapon[i]    = '';
        }
    }

    void EnsureArrays()
    {
        int max = MAXPLAYERS;
        SwitchTics.Resize(max);
        lockActive.Resize(max);
        forcedWeapon.Resize(max);
        lastWeapon.Resize(max);
        currentWeapon.Resize(max);
        EnsureCacheArrays();
    }

    bool HasWeapon(PlayerInfo p, Name wepClass)
    {
        if (wepClass == '') return false;
        for (let it = p.mo.Inv; it; it = it.Inv)
        {
            Weapon w = Weapon(it);
            if (w && w.GetClassName() == wepClass)
                return true;
        }
        return false;
    }

    int FindPlayerNum(PlayerInfo p)
    {
        for (int i = 0; i < MAXPLAYERS; i++)
            if (players[i] == p) return i;
        return -1;
    }
}


// Thinker to restore cheats after the switch has been processed
class CheatRestorer : Thinker
{
	PlayerInfo plr;
	int restoreFlags;
	int delay;

	void Init(PlayerInfo p, int oldFlags, int holdTics = 2) // hold for 2 tics, just enough to process cheats
	{
		plr = p;
		restoreFlags = oldFlags;
		delay = holdTics;
	}

	override void Tick()
	{
		if (--delay <= 0)
		{
			if (plr != null)
				plr.cheats = restoreFlags;
			Destroy();
		}
	}
}
