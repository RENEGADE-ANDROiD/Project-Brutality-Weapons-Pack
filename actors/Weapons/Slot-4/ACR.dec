Actor ACRSpread : Inventory //Recoil Factor
{
inventory.maxamount 10
}

//// --------------------------------------------------------------------------
//
// ACR Ammo (overall)
//
// ----------------------------------------------------------------------------

ACTOR ACRAmmo : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 33
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 33
   Inventory.Icon "ACRPA0"
}

//// --------------------------------------------------------------------------
//
// ACR
//
// ----------------------------------------------------------------------------

ACTOR ACR : PB_Weapon
{
	Weapon.AmmoUse1 0
	Weapon.AmmoGive1 15
	Weapon.AmmoUse2 0
	Weapon.AmmoGive2 0
	YScale 0.6
	XScale 0.8
	Weapon.SelectionOrder 4500
	Weapon.SlotNumber 4
	Weapon.AmmoType1 "PB_HighCalMag"
	Weapon.AmmoType2 "ACRAmmo"
	Obituary "%o was shot down by %k's ACR."
    AttackSound "None"
    Inventory.PickupSound "acr/bolt"
	Inventory.Pickupmessage "You got the Adaptive Combat Rifle! (Slot 4)!"
	+WEAPON.WIMPY_WEAPON
    +WEAPON.NOAUTOAIM
    +WEAPON.NOALERT
    +WEAPON.NOAUTOFIRE
	+FORCEXYBILLBOARD
	+FLOORCLIP
    Scale 0.7
	Tag "Magpul Adaptive Combat Rifle"
	Inventory.althudicon "ACRPA0"
    PB_WeaponBase.RespectItem "Combat-RifleRespected"
	States
	{
	PickUp:
	TNT1 A 0 A_Playsound("PICKUPONELINER")
	TNT1 A 0
	Stop
	
	Steady:
	TNT1 A 1
	Goto Ready
	
	Ready:
        TNT1 A 2 A_JumpIfInventory("GoFatality", 1, "Steady")
        TNT1 A 0 A_PlaySound("acr/bolt")
        ACRS ABCDE 1
        TNT1 AAAAAAAA 0
        TNT1 A 0 //A_JumpIfInventory("ACRAmmo",1,2)
        //Goto Reload
        TNT1 AAAA 0
	RealReady:
        TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
        TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
        TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("GoSilencerAbility", 1, "SilencerToggle")
		TNT1 A 0 A_JumpIfInventory("GoWeaponSpecialAbility", 1, "WeaponSpecial")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("ThrowPipeBomb",1,"ThrowPipeBomb")//DetonatePipeBomb
		TNT1 A 0 A_JumpIfInventory("DetonatePipeBomb",1,"DetonatePipeBomb")
		TNT1 A 0 A_TakeInventory("ACRSpread", 10)
		TNT1 A 0 A_JumpIfInventory("IsRunning", 1, "SprintMadduhAssHo")
		ACRG A 1 A_DoPBWeaponAction
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Zoom")
		TNT1 A 0 A_TakeInventory("UsedStamina", 1)
        Goto RealReady
	
    Ready2:
        TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
        TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
        TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("GoSilencerAbility", 1, "SilencerToggle")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("IsRunning", 1, "UnZoom")
		ACZG A 1 A_DoPBWeaponAction(WRF_NOBOB)
		TNT1 A 0 A_JumpIfInventory("ThrowPipeBomb",1,"ThrowPipeBomb")//DetonatePipeBomb
		TNT1 A 0 A_JumpIfInventory("DetonatePipeBomb",1,"DetonatePipeBomb")//
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_TakeInventory("UsedStamina", 2)
		Loop
	Deselect:
		TNT1 A 0
		TNT1 A 0 A_playsound("weapon/swap", 4)
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "DeselectZoomed")
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_TakeInventory("ThrowPipeBomb", 1)
		TNT1 A 0 A_TakeInventory("DetonatePipeBomb", 1)
		TNT1 A 0 A_TakeInventory("GoSilencerAbility", 1)
		TNT1 A 0 A_TakeInventory("Kicking", 1)
		TNT1 A 0 A_TakeInventory("Reloading", 1)
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility", 1)
        TNT1 A 0 A_ZoomFactor(1.0)
		ACRS EDCBA 1
		TNT1 A 0 A_Lower(120)
		Wait
	DeselectZoomed:
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_TakeInventory("ThrowPipeBomb", 1)
		TNT1 A 0 A_TakeInventory("DetonatePipeBomb", 1)
		TNT1 A 0 A_TakeInventory("GoSilencerAbility", 1)
		TNT1 A 0 A_TakeInventory("Kicking", 1)
		TNT1 A 0 A_TakeInventory("Reloading", 1)
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility", 1)
        TNT1 A 0 A_ZoomFactor(1.0)
		ACRZ DCBA 1
		ACRG A 1
		ACRS EDCBA 1
		TNT1 A 0 A_Lower(120)
		Wait
	
	Select:
		TNT1 A 0 A_Takeinventory("Unloading",1)
		Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("RifleSelected"); }
		TNT1 A 0 A_GiveInventory("GoSpecial",1)
		Goto Ready
	
	Ready3:
	Ready:
		ACRG A 1 A_DoPBWeaponAction
		Loop
	
	WeaponSpecial:
	ATRifleSwitch:
	SilencerToggle:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("GoSilencerAbility",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
        TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility",1)
		TNT1 A 0 A_TakeInventory("ACRBurstShots", 3)
		TNT1 A 0 A_JumpIfInventory("ACRBurstMode", 1, "ACRSetFullAuto")
		TNT1 A 0 A_GiveInventory("ACRBurstMode", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Switch Mode: 3-Round Burst")
		Goto RealReady
	ACRSetFullAuto:
		TNT1 A 0 A_TakeInventory("ACRBurstMode", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Switch Mode: Full Auto")
		Goto RealReady
   Fire:
		TNT1 A 0 { PB_FireOffset; }
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		TNT1 A 0 A_JumpIfInventory("ACRAmmo",1,2)
        Goto Reload
        TNT1 AAAA 0
		TNT1 A 0 A_JumpIfInventory("ACRBurstMode", 1, "ACRBurstFire")
		
		TNT1 A 0 A_JumpIfInventory("ACRSpread", 10, "FireHighSpreadLoop")
		TNT1 A 0 A_GiveInventory("ACRSpread", 1)
   FireLoud1:
		TNT1 A 0 A_PlaySound("acr/fire",7)
		ACRF A 1 BRIGHT A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("YellowFlareSpawn", 0, 0, 4, 0, 0, 0)
		TNT1 A 0 { PB_GunSmoke(0, 4, -1); }
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 1, 1, 0, 0, 1); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		ACRF B 1 BRIGHT
        RIFF A 0, 0, 13, -3, 0, random(-1,1))
		TNT1 A 0 A_JumpIfInventory("NoPenetration", 1, 2)
		RIFF A 0 A_FireCustomMissile("WallPenetrationHitscan", 0, 0, -1, 0, 0, 0)
		TNT1 A 0
        TNT1 A 0 A_SetPitch(-1.3 + pitch)
		TNT1 A 0 A_Takeinventory("ACRAmmo",1)
		TNT1 A 0 A_SetPitch(+0.6 + pitch)
		ACRF C 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 18, 28, frandom(4,7), frandom(6,9), frandom(0,5)); }
		TNT1 A 0 A_SetPitch(+0.5 + pitch)
        ACRG A 1 A_DoPBWeaponAction(WRF_NOBOB)
		Goto RefireState1
	RefireState1:
		RIFG A 0 A_JumpIfInventory("ACRBurstMode", 1, "ACRBurstAdvance")
		RIFG A 0 A_Refire("FireLoop")
		Goto DoneFiring

	ACRBurstFire:
		TNT1 A 0 A_TakeInventory("ACRBurstShots", 3)
		Goto FireLoud1
	ACRBurstAdvance:
		TNT1 A 0 A_GiveInventory("ACRBurstShots", 1)
		TNT1 A 0 A_JumpIfInventory("ACRBurstShots", 3, "ACRBurstDone")
		TNT1 A 0 A_JumpIfInventory("ACRAmmo", 1, "FireLoop")
		Goto DoneFiring
	ACRBurstDone:
		TNT1 A 0 A_TakeInventory("ACRBurstShots", 3)
		Goto DoneFiring
		
	FireLoop:
		TNT1 A 0 { PB_FireOffset; }
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		
        TNT1 A 0 A_JumpIfInventory("ACRAmmo",1,2)
        Goto Reload
        TNT1 AAAA 0
		
		
		TNT1 A 0 A_JumpIfInventory("ACRSpread", 10, "FireHighSpread")
		TNT1 A 0 A_GiveInventory("ACRSpread", 1)
   FireLoud2:
		TNT1 A 0 A_PlaySound("acr/fire",6)
		ACRF A 1 BRIGHT A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("YellowFlareSpawn", 0, 0, 4, 0, 0, 0)
		TNT1 A 0 { PB_GunSmoke(0, 4, -1); }
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 1, 1, 0, 0, 1); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		ACRF B 1 BRIGHT
        RIFF A 0, 0, 13, -3, 0, random(-1,1))
		TNT1 A 0 A_JumpIfInventory("NoPenetration", 1, 2)
		RIFF A 0 A_FireCustomMissile("WallPenetrationHitscan", 0, 0, -1, 0, 0, 0)
		TNT1 A 0
        TNT1 A 0 A_SetPitch(-1.3 + pitch)
		TNT1 A 0 A_Takeinventory("ACRAmmo",1)
		TNT1 A 0 A_SetPitch(+0.6 + pitch)
		ACRF C 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 18, 28, frandom(4,7), frandom(6,9), frandom(0,5)); }
		TNT1 A 0 A_SetPitch(+0.5 + pitch)
        ACRG A 1 A_DoPBWeaponAction(WRF_NOBOB)
		Goto RefireState2
	RefireState2:
		RIFG A 0 A_JumpIfInventory("ACRBurstMode", 1, "ACRBurstAdvance2")
		RIFG A 0 A_Refire("Fire")
		Goto DoneFiring
	ACRBurstAdvance2:
		TNT1 A 0 A_GiveInventory("ACRBurstShots", 1)
		TNT1 A 0 A_JumpIfInventory("ACRBurstShots", 3, "ACRBurstDone")
		TNT1 A 0 A_JumpIfInventory("ACRAmmo", 1, "Fire")
		Goto DoneFiring
		
	FireHighSpread:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		
        TNT1 A 0 A_JumpIfInventory("ACRAmmo",1,2)
        Goto Reload
        TNT1 AAAA 0
		
        TNT1 A 0 A_PlaySound("acr/fire",7)
		ACRF A 1 BRIGHT A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("YellowFlareSpawn", 0, 0, 4, 0, 0, 0)
		TNT1 A 0 { PB_GunSmoke(0, 4, -1); }
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 5, 5, 0, 0, 5); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		ACRF B 1 BRIGHT
        RIFF A 0, 0, 13, -3, 0, random(-3,3))
		TNT1 A 0 A_JumpIfInventory("NoPenetration", 1, 2)
		RIFF A 0 A_FireCustomMissile("WallPenetrationHitscan", random(-3,3), 0, -1, 0, 0, random(-3,3))
		TNT1 A 0
        TNT1 A 0 A_SetPitch(-0.7 + pitch)
		TNT1 A 0 A_FireCustomMissile("ShakeYourAssMinor", 0, 0, 0, 0)
		TNT1 A 0 A_Takeinventory("ACRAmmo",1)
		TNT1 A 0 A_SetPitch(+0.4 + pitch)
		ACRF C 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 18, 28, frandom(4,7), frandom(6,9), frandom(0,5)); }
        S94G A 0 A_SetPitch(+0.3 + pitch)
		ACRG A 1 A_DoPBWeaponAction(WRF_NOBOB)
		Goto RefireState3
	RefireState3:
		RIFG A 0 A_Refire("FireHighSpreadLoop")
		Goto DoneFiring
		
	FireHighSpreadLoop:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		
        TNT1 A 0 A_JumpIfInventory("ACRAmmo",1,2)
        Goto Reload
        TNT1 AAAA 0
		
        TNT1 A 0 A_PlaySound("acr/fire",6)
		ACRF A 1 BRIGHT A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("YellowFlareSpawn", 0, 0, 4, 0, 0, 0)
		TNT1 A 0 { PB_GunSmoke(0, 4, -1); }
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 5, 5, 0, 0, 5); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		ACRF B 1 BRIGHT
        RIFF A 0, 0, 13, -3, 0, random(-3,3))
		TNT1 A 0 A_JumpIfInventory("NoPenetration", 1, 2)
		RIFF A 0 A_FireCustomMissile("WallPenetrationHitscan", random(-3,3), 0, -1, 0, 0, random(-3,3))
		TNT1 A 0
        TNT1 A 0 A_SetPitch(-0.7 + pitch)
		TNT1 A 0 A_FireCustomMissile("ShakeYourAssMinor", 0, 0, 0, 0)
		TNT1 A 0 A_Takeinventory("ACRAmmo",1)
		TNT1 A 0 A_SetPitch(+0.4 + pitch)
		ACRF C 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 18, 28, frandom(4,7), frandom(6,9), frandom(0,5)); }
        S94G A 0 A_SetPitch(+0.3 + pitch)
		ACRG A 1 A_DoPBWeaponAction(WRF_NOBOB)
		Goto RefireState4
	RefireState4:
		RIFG A 0 A_Refire("FireHighSpread")
		Goto DoneFiring
		
	DoneFiring:
		ACRG A 5 A_DoPBWeaponAction(1)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
        TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
        TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_TakeInventory("ACRSpread", 6)
		ACRG A 5 A_DoPBWeaponAction(1)
		Goto RealReady
		
      Fire2:
		TNT1 A 0 A_JumpIfInventory("ACRAmmo",1,2)
        Goto Reload
        TNT1 AAAA 0
		
		TNT1 A 0 A_JumpIfInventory("IsFiringAltFireOnFullAuto", 1, "Fire2FullAuto")
	Fire2Loud1:
		TNT1 A 0 A_PlaySound("acr/fire",6)
		RI2G A 0 A_AlertMonsters
		RIFF A 0 { PB_GunSmoke(0, 0, 4); }
		TNT1 A 0 A_FireCustomMissile("YellowFlareSpawn",0,0,0,5)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 1, 0.1, 0, 0, 0.1); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		ACZF A 1 BRIGHT
		Goto ContinueFire21
	ContinueFire21:
        RI2F A 0 BRIGHTTNT1 A 0 A_JumpIfInventory("NoPenetration", 1, 2)
		RIFF A 0 A_FireCustomMissile("WallPenetrationHitscan", 0, 0, -1, -12, 0, 0)
		TNT1 A 0
        //TNT1 A 0 ACS_Execute(373, 0, 0, 0, 0)
		//TNT1 A 0 A_FireCustomMissile("ShakeYourAssMinor", 0, 0, 0, 0)
		TNT1 A 0 A_SetPitch(-0.8 + pitch)
		TNT1 A 0 A_Takeinventory("ACRAmmo",1)
		ACZF B 1 A_DoPBWeaponAction(WRF_NOBOB)
		TNT1 A 0 A_SetPitch(+0.4 + pitch)
		TNT1 A 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 8, 28, frandom(4,7), frandom(6,9), frandom(0,5)); }
        ACZF C 1 A_DoPBWeaponAction(1)
		TNT1 A 0 A_GiveInventory("IsFiringAltFireOnFullAuto", 1)
		36ZG A 0 A_SetPitch(+0.4 + pitch)
		ACZG A 1 A_DoPBWeaponAction(WRF_NOBOB)
        RI2F B 0 A_ReFire
		Goto DoneZoomFire
		
	Fire2FullAuto:
		TNT1 A 0 A_JumpIfInventory("ACRAmmo",1,2)
        Goto Reload
        TNT1 AAAA 0
		
        TNT1 A 0 A_PlaySound("acr/fire",7)
		RI2G A 0 A_AlertMonsters
		RIFF A 0 { PB_GunSmoke(0, 0, 4); }
		TNT1 A 0 A_FireCustomMissile("YellowFlareSpawn",0,0,0,5)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 1, 0.1, 0, 0, 0.1); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		ACZF A 1 BRIGHT
		Goto ContinueFire2FullAuto1

	ContinueFire2FullAuto1:
        RI2F A 0 BRIGHT//TNT1 A 0 ACS_Execute(373, 0, 0, 0, 0)
		//TNT1 A 0 A_FireCustomMissile("ShakeYourAssMinor", 0, 0, 0, 0)
		TNT1 A 0 A_SetPitch(-1.3 + pitch)
		TNT1 A 0 A_Takeinventory("ACRAmmo",1)
		TNT1 A 0 A_SetAngle(random(1, -1) + angle)
		ACZF B 1
		TNT1 A 0 A_SetPitch(+0.4 + pitch)
		TNT1 A 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 8, 28, frandom(4,7), frandom(6,9), frandom(0,5)); }
        ACZF C 1

		36ZG A 0 A_SetPitch(+0.4 + pitch)
		ACZG A 1 A_DoPBWeaponAction(WRF_NOBOB)
		TNT1 A 0 A_Refire("Fire2FullAutoLoop")
        Goto DoneZoomFire
		
	Fire2FullAutoLoop:
		TNT1 A 0 A_JumpIfInventory("ACRAmmo",1,2)
        Goto Reload
        TNT1 AAAA 0
		
        TNT1 A 0 A_PlaySound("acr/fire",6)
		RI2G A 0 A_AlertMonsters
		RIFF A 0 { PB_GunSmoke(0, 0, 4); }
		TNT1 A 0 A_FireCustomMissile("YellowFlareSpawn",0,0,0,5)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 1, 0.1, 0, 0, 0.1); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		ACZF A 1 BRIGHT
		Goto ContinueFire2FullAuto2

	ContinueFire2FullAuto2:
        RI2F A 0 BRIGHT//TNT1 A 0 ACS_Execute(373, 0, 0, 0, 0)
		//TNT1 A 0 A_FireCustomMissile("ShakeYourAssMinor", 0, 0, 0, 0)
		TNT1 A 0 A_SetPitch(-1.3 + pitch)
		TNT1 A 0 A_Takeinventory("ACRAmmo",1)
		TNT1 A 0 A_SetAngle(random(1, -1) + angle)
		ACZF B 1
		TNT1 A 0 A_SetPitch(+0.4 + pitch)
		TNT1 A 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 8, 28, frandom(4,7), frandom(6,9), frandom(0,5)); }
        ACZF C 1
		36ZG A 0 A_SetPitch(+0.4 + pitch)
		ACZG A 1 A_DoPBWeaponAction(WRF_NOBOB)
		TNT1 A 0 A_Refire("Fire2FullAuto")
        Goto DoneZoomFire
		
	DoneZoomFire:
		TNT1 A 0
		ACZG A 5 A_DoPBWeaponAction(WRF_NOBOB)
		TNT1 A 0 A_TakeInventory("IsFiringAltFireOnFullAuto", 1)
		ACZG A 5 A_DoPBWeaponAction(WRF_NOBOB)
        RI2G A 0
		Goto Ready2

    AltFire:
        TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"UnZoom")
		TNT1 A 0 A_Giveinventory("Zoomed",1)
	Zoom:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
        TNT1 A 0 A_ZoomFactor(1.6)
		TNT1 A 0 A_Giveinventory("ADSmode",1)
        ACRZ ABCD 1
        Goto Ready2
	UnZoom:
        TNT1 AAAAAA 0
        ACRZ DCBA 1
		TNT1 A 0 A_Takeinventory("Zoomed",1)
        TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
        Goto RealReady
		
	NoAmmo:
	ACRG A 1 A_PlaySound("weapons/empty")
	TNT1 A 0 A_Takeinventory("Zoomed",1)
    TNT1 A 0 A_ZoomFactor(1.0)
	TNT1 A 0 A_Takeinventory("ADSmode",1)
	Goto RealReady
	
    Reload:
		TNT1 A 0 { return PB_CheckReloadMag("NoReload", "NoAmmo", 33); }
        TNT1 AAA 0
		TNT1 A 0 A_GiveInventory ("Pumping", 1)
        
		
		
		ACRR ABCDE 1  A_JumpIfInventory("Kicking",1,"DoKick")
		ACRR F 1 A_Playsound("acr/clip/out")
        ACRR G 1 A_FireCustomMissile("EmptyClipSpawn",-5,0,8,-4)
		ACRR G 24
		ACRR HI 1
		ACRR J 3 A_Playsound("acr/clip/in")
		ACRR FEDCBA 1 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_Takeinventory("HasUnloaded",1)
		
		
		TNT1 A 0 A_JumpIfInventory("ACRAmmo",1,"InsertBullets2")//30+1 effect
		Goto InsertBullets
		
	InsertBullets:
		TNT1 A 0 { PB_AmmoIntoMag("ACRAmmo", "PB_HighCalMag", 32, 1); }
		Goto Bolt
		
	Bolt:
		TNT1 A 0 A_giveinventory("ACRAmmo", 1)
		ACRC ABC 1
		ACRC D 1 A_playsound("acr/bolt")
		ACRC E 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -6, frandom(4,7), frandom(6,9), frandom(0,5)); }
		TNT1 A 0 A_takeinventory("ACRAmmo", 1)
		ACRC FGHIIHFEDJK 1
		Goto ReloadFinish
		
	InsertBullets2:
		TNT1 A 0 { PB_AmmoIntoMag("ACRAmmo", "PB_HighCalMag", 33, 1); }
		Goto ReloadFinish

	NoReload:
	ReloadFinish:
		TNT1 A 0 { PB_SetChamberEmpty(false); PB_SetMagEmpty(false); PB_SetMagUnloaded(false); }
		TNT1 A 0 A_TakeInventory("Reloading", 1)
		Goto RealReady
		
 	Spawn:
		ACRP A -1
		Stop
	KickFlash:
		ACRS EDCB 1
		ACRS AAAA 2
		ACRS BCDE 1
		Stop
	SprintMadduhAssHo:
		TNT1 A 0
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_TakeInventory("ThrowPipeBomb", 1)
		TNT1 A 0 A_TakeInventory("DetonatePipeBomb", 1)
		TNT1 A 0 A_TakeInventory("GoSilencerAbility", 1)
		TNT1 A 0 A_TakeInventory("Kicking", 1)
		TNT1 A 0 A_TakeInventory("Reloading", 1)
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility", 1)
        TNT1 A 0 A_ZoomFactor(1.0)
		ACRS A 0
		Goto SprintStart
	SprintStart:
		TNT1 A 0 A_JumpIfInventory("IsRunning", 1, 2)
		Goto RealReady
		ACRS ABCDE 1 A_DoPBWeaponAction
		Loop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		ACRS EDCB 1
		ACRS AAAA 2
		Stop
	}
}
