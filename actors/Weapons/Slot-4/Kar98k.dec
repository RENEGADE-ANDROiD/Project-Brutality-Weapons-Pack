Actor RifleK98StagedReload : Inventory
{
inventory.maxamount 1
}
Actor PB_Kar98k : PB_Weapon 

{
Weapon.AmmoUse1 0
Weapon.AmmoUse2 0
Weapon.AmmoGive1 5
Weapon.AmmoGive2 0
//Weapon.AmmoType 1 YOU FUCKING TOSSER,WHERE YOU CAME FROM?!?!?
Weapon.AmmoType1 "PB_HighCalMag"
Weapon.AmmoType2 "KarabineAmmo"
	Obituary "%o was shot down by %k's K98k."
Inventory.PickUpMessage "You got the Karabiner 98k! (Slot 4)"
Inventory.PickUpSound "M40RIF3"
AttackSound "None"
+WEAPON.NOALERT
+WEAPON.NOAUTOAIM
+WEAPON.NOAUTOFIRE
    +FORCEXYBILLBOARD
    Weapon.SlotNumber 4
    Weapon.SlotPriority 4
Scale 0.9
Tag "Mauser Karabiner 98k"
inventory.althudicon "KARPA0"
Inventory.Icon "KARPA0"
States
{

    FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		Goto HideWeaponDuringAction

    FlashKicking:
	ZK9G A 14 A_DoPBWeaponAction
	Stop
	FlashAirKicking:
	ZK9G A 20 A_DoPBWeaponAction
	Stop
	FlashSlideKicking:
	ZK9G A 20 A_DoPBWeaponAction
	Stop
	FlashSlideKickingStop:
	ZK9G A 17 A_DoPBWeaponAction
	Stop
Ready:
Ready3:
TNT1 A 0 A_SetCrosshair(0)
TNT1 A 0 A_JumpIfInventory("RifleK98StagedReload",1,"BoltAction")
TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
ZK9G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
ZK9G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
ZK9G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
ZK9G A 0 A_JumpIfInventory("Reloading",1,"Reload")
ZK9G A 0 A_JumpIfInventory("UseEquipment",1,"TossGrenade")
//DEAG A 0 A_JumpIfInventory("Unloading",1,"Unload")
ZK9G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
ZK9G A 0 A_JumpIfInventory("IsRunning",1,"CheckSprint")
//DEAG A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
Loop

ReadySettle:
		TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
		Goto Ready3

Ready2:
TNT1 A 0 A_SetCrosshair(0)
TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
DEAG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
DEAG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
DEAG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
DEAG A 0 A_JumpIfInventory("Reloading",1,"Reload")
DEAG A 0 A_JumpIfInventory("UseEquipment",1,"TossGrenade")
//DEAG A 0 A_JumpIfInventory("Unloading",1,"Unload")
ZK92 A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
DEAG A 0 A_JumpIfInventory("IsRunning",1,"CheckSprint")
//DEAG A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
Loop
			Deselect:
	    TNT1 A 0 A_ZoomFactor(1)
	    DEAG A 0 A_Takeinventory("Zoomed",1)
		DEAG A 0 A_Takeinventory("ADSmode",1)
TNT1 A 0 A_SetCrosshair(0)
		Goto DeselectDown
	DeselectDown:
		DEAG A 0 A_TakeInventory("UseEquipment", 1)
				TNT1 A 0 A_Lower(120)
		Wait
			Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
		Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		DEAG A 0 { PB_SetMagUnloaded(false); }
		DEAG A 0 A_Takeinventory("Unloading",1)
		DEAG A 0 A_TakeInventory("DMRSelected",1)
		DEAG A 0 A_TakeInventory("CarbineSelected",1)
		DEAG A 0 A_TakeInventory("FistsSelected",1)
		DEAG A 0 A_TakeInventory("SawSelected",1)
		DEAG A 0 A_TakeInventory("SledgeSelected",1)
		DEAG A 0 A_TakeInventory("HandgunSelected",1)
		DEAG A 0 A_TakeInventory("DualHandgunSelected",1)
		DEAG A 0 A_TakeInventory("RevolverSelected",1)
		DEAG A 0 A_TakeInventory("ShotgunSelected",1)
		DEAG A 0 A_GiveInventory("SSGSelected",1)
		DEAG A 0 A_TakeInventory("ASGSelected",1)
		DEAG A 0 A_TakeInventory("QSGSelected",1)
		DEAG A 0 A_TakeInventory("MinigunSelected",1)
		DEAG A 0 A_TakeInventory("NewChaingunSelected",1)	
		DEAG A 0 A_TakeInventory("RocketLauncherSelected",1)
		DEAG A 0 A_TakeInventory("GrenadeLauncherSelected",1)
		DEAG A 0 A_TakeInventory("SGLSelected",1)
		DEAG A 0 A_TakeInventory("PlasmaGunSelected",1)
		DEAG A 0 A_TakeInventory("M2Selected",1)	
		DEAG A 0 A_TakeInventory("CryoRifleSelected",1)
		DEAG A 0 A_TakeInventory("RailGunSelected",1)
		DEAG A 0 A_TakeInventory("BFGSelected",1)
		DEAG A 0 A_TakeInventory("BFGBeamSelected",1)
		DEAG A 0 A_TakeInventory("BHCSelected",1)
		DEAG A 0 A_TakeInventory("RevenantLauncherSelected",1)
		DEAG A 0 A_TakeInventory("FlameCannonSelected",1)
		DEAG A 0 A_TakeInventory("HellRifleSelected",1)
		DEAG A 0 A_TakeInventory("LandMineSelected",1)
		DEAG A 0 A_TakeInventory("UACSMGSelected",1)
		DEAG A 0 A_TakeInventory("SubMachineGunSelected",1)
		DEAG A 0 A_TakeInventory("LostSoulSelected",1)
		DEAG A 0 A_TakeInventory("HasBarrel",1)
		DEAG A 0 A_TakeInventory("HasFlameBarrel",1)
		DEAG A 0 A_TakeInventory("HasIceBarrel", 1)
		DEAG A 0 A_GiveInventory("GoSpecial",1)
		TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
		Goto Ready3
	SelectAnimation:
		TNT1 A 0 A_PlaySound("M40RIF3", 7)
		ZK9S ABC 1 A_DoPBWeaponAction(WRF_NOFIRE)
		TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
		Goto Ready3
		FIRE:
TNT1 A 0 A_JumpIfInventory("RifleK98StagedReload",1,"BoltAction")
TNT1 A 0 A_Takeinventory("Reloading",1)
TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
TNT1 A 0 A_JumpIfInventory("karabineAmmo",1,1)
Goto Reload
TNT1 AAAA 0
TNT1 A 0 A_AlertMonsters
TNT1 A 0 A_PlaySound("M40Rifle/Fire", 1)
TNT1 A 0 A_Takeinventory("karabineAmmo",1)
TNT1 A 0 A_Recoil(1.5)
ZK9G B 1 Bright 
TNT1 A 0 { PB_GunSmoke_Sniper(0,0,0); }
TNT1 A 0 A_FireCustomMissile("PBWP_Tracer_Sniper", frandom(-2, 2), 0, 0, 0, 0, frandom(-2, 2))
TNT1 A 0 A_FireBullets(3,5,0,550,"ShotgunPuff",FBF_NORANDOM)
TNT1 A 0 A_JumpIfInventory("IsTacticalClass",1,"Tacticoool")
TNT1 A 0 A_SetPitch(pitch - 8.0)
TNT1 A 0 A_GiveInventory("RifleK98StagedReload",1)
ZK9G CDEF 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB)
ZK9G FFF 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB)
ZK9G FDEC 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB)

BoltAction:
TNT1 A 0 A_PlaySound("M40Rifle/Bolt1", 3)
ZK9R ABCD 2
TNT1 A 0 A_FireCustomMissile("RifleCaseSpawn",5,0,8,-9)
ZK9R EEE 2 
TNT1 A 0 A_PlaySound("M40Rifle/Bolt2", 3)
ZK9R DCBA 2 
TNT1 A 0 A_TakeInventory("RifleK98StagedReload",1)
Goto Ready3

Tacticoool:
TNT1 A 0 A_SetPitch(pitch - 16.0)
TNT1 A 0 A_GiveInventory("RifleK98StagedReload",1)
ZK9G CDEF 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB)
ZK9G FFF 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB)
ZK9G FDEC 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB)
Goto BoltAction


Fire2:
TNT1 A 0 A_JumpIfInventory("RifleK98StagedReload",1,"BoltAction2")
TNT1 A 0 A_Takeinventory("Reloading",1)
TNT1 A 0 A_JumpIfInventory("karabineAmmo",1,1)
Goto Reload
TNT1 AAAA 0
TNT1 A 0 A_AlertMonsters
TNT1 A 0 A_PlaySound("M40Rifle/Fire", 1)
TNT1 A 0 A_Takeinventory("karabineAmmo",1)
TNT1 A 0 A_Recoil(1.5)
ZK92 B 1 Bright 
TNT1 A 0 { PB_GunSmoke_Sniper(0,0,0); }
TNT1 A 0 A_FireCustomMissile("PBWP_Tracer_Sniper", frandom(-2, 2), 0, 0, 0, 0, frandom(-2, 2))
TNT1 A 0 A_FireBullets(0,0,0,550,"ShotgunPuff",FBF_NORANDOM)
TNT1 A 0 A_JumpIfInventory("IsTacticalClass",1,"Tacticoool2")
TNT1 A 0 A_SetPitch(pitch - 6.0)
TNT1 A 0  A_GiveInventory("RifleK98StagedReload",1)
ZK92 CDEF 1  A_DoPBWeaponAction(WRF_NOFIRE | WRF_NOBOB)
ZK92 FFF 1  A_DoPBWeaponAction(WRF_NOFIRE | WRF_NOBOB)
ZK92 FDEC 1  A_DoPBWeaponAction(WRF_NOFIRE | WRF_NOBOB)
Goto BoltAction2

Tacticoool2:
TNT1 A 0 A_SetPitch(pitch - 12.0)
TNT1 A 0  A_GiveInventory("RifleK98StagedReload",1)
ZK92 CDEF 1  A_DoPBWeaponAction(WRF_NOFIRE | WRF_NOBOB)
ZK92 FFF 1  A_DoPBWeaponAction(WRF_NOFIRE | WRF_NOBOB)
ZK92 FDEC 1  A_DoPBWeaponAction(WRF_NOFIRE | WRF_NOBOB)
Goto BoltAction2

AltFire:
TNT1 A 0 A_SetCrosshair(0)
TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
TNT1 A 0 A_JumpIfInventory("Zoomed",1,"UnZoom")
TNT1 A 0 A_Giveinventory("Zoomed",1)
TNT1 A 0 A_ZoomFactor(1.8)
ZK9X ABCDEF 1 
Goto Ready2

UnZoom:
TNT1 A 0 A_SetCrosshair(0)
TNT1 A 0 A_Takeinventory("Zoomed",1)
TNT1 A 0 A_ZoomFactor(1.0)
ZK9X FEDCBA 1 
Goto Ready3

boltAction2:
TNT1 A 0 A_ZoomFactor(1.0)
ZK9X FEDCBA 1 
TNT1 A 0 A_PlaySound("M40Rifle/Bolt1", 3)
ZK9R ABCD 2
TNT1 A 0 A_FireCustomMissile("RifleCaseSpawn",5,0,8,-9)
ZK9R EEE 2  
TNT1 A 0 A_PlaySound("M40Rifle/Bolt2", 3)
ZK9R DCBA 2 
TNT1 A 0 A_ZoomFactor(1.8)
ZK9X ABCDEF 1 
TNT1 A 0 A_TakeInventory("RifleK98StagedReload",1)
Goto Ready2

Reload:
TNT1 A 0 A_JumpIfInventory("karabineAmmo",1,"Reload2")
ContinueReloading:
TNT1 A 0 A_SetCrosshair(0)
TNT1 A 0 A_ZoomFactor(1.0)
TNT1 A 0 A_Takeinventory("Reloading",1)
TNT1 A 0 A_Takeinventory("Zoomed",1)
TNT1 A 0 A_JumpIfInventory("karabineAmmo",5,"InsertBullets")
TNT1 A 0 A_JumpIfInventory("PB_HighCalMag",1,3)
Goto NoAmmo
DEAG A 0 A_JumpIfInventory("TurboReload",1,"TurboReload")
TNT1 AAA 0
ZK9R AB 2 
TNT1 A 0 A_PlaySound("weapons/carbine/magout", 3)
ZK9R CDEFGHIJ 2 
ZK9R JJ 2 
ZKR2 ABCDEFGHI 2 
TNT1 A 0 A_PlaySound("weapons/carbine/magin", 3)
ZKR2 JKLMNO 2 
//TNT1 A 0 A_FireCustomMissile("K98STRIPEmpty",5,0,8,-9)
TNT1 A 0 A_FireCustomMissile("k98stripEmpty",0,0,4,5)
TNT1 A 0 A_PlaySound("weapons/carbine/magout", 3)
ZK9R EDCBA 2 

InsertBullets:
TNT1 AAAA 0
TNT1 A 0 A_JumpIfInventory("karabineAmmo",5,"Ready3")
TNT1 A 0 A_JumpIfInventory("PB_HighCalMag",1,"AmmoIn")
Goto Ready3

AmmoIn:
TNT1 A 0 A_Giveinventory("karabineAmmo",1)
TNT1 A 0 A_Takeinventory("PB_HighCalMag",1)
Goto InsertBullets

NoAmmo:
TNT1 A 0 A_Takeinventory("Zoomed",1)
TNT1 A 0 A_ZoomFactor(1.0)
TNT1 A 0 A_Takeinventory("ADSmode",1)
Goto Ready3

 	Spawn:
		DEAG A 0
		KARP A -1
		Stop
	Steady:
		TNT1 A 1
		Goto Ready3	

}

}
Actor k98stripEmpty : Actor
{
	+MISSILE
	+NOBLOCKMAP
	+NOCLIP
	+DROPOFF
	+NOTELEPORT
	+NOGRAVITY
	Radius 2
	Height 2
	Speed 4
	Scale 0.3
	States
	{
	Spawn:
		TNT1 A 1
		Stop

}

}
ACTOR KarabineAmmo : PB_Ammo
{
Inventory.Icon "KARPA0"
   Inventory.Amount 0
   Inventory.MaxAmount 5
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 5
}

