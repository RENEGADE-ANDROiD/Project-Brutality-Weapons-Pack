Actor noammocheck : inventory { inventory.maxamount 1 }

// --------------------------------------------------------------------------
//
// Rpg
//
// --------------------------------------------------------------------------

ACTOR KarnRPG7 : PB_Weapon //Karnageweapon
{
	Weapon.Slotnumber 6
	Weapon.AmmoGive1 10
	Weapon.AmmoGive2 1
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoType1 "PB_RocketAmmo"
	Weapon.AmmoType2 "Krg_rpgammo"
	Weapon.upsound "ssar_magin"
	Weapon.SelectionOrder 900
	Scale 0.45
	inventory.icon KR7IA0
	Inventory.Pickupmessage "The great rpg-7"
	Tag "DA-7p RPG-7"
	+WEAPON.NOAUTOAIM
	States
	{
	Ready3:
	Ready:
		TNT1 A 0 A_Zoomfactor(1)
		TNT1 A 0 A_Jumpifnoammo("Noammo")
		TNT1 A 0 A_Takeinventory("Noammocheck",1)
		RPGG A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop
	Noammo:
		TNT1 A 0 A_Zoomfactor(1)
		TNT1 A 0 A_Jumpifinventory("Krg_Rpgammo",1,"Reloadrpg")
		TNT1 A 0 A_Giveinventory("Noammocheck",1)
		RPGG B 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop
	Deselect:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_Jumpifinventory("Noammocheck",1,"Nadeselect")
		RPGG A 1 offset(0,34) A_Playsound("ARDN")
		goto down
	Down:
		TNT1 A 0 A_Zoomfactor(1)
		RPGG AA 0 A_Lower
		RPGG A 1 A_Lower
		Loop
	Select:
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
		Goto SelectFirstPersonLegs
		SelectContinue:
		TNT1 A 0 A_Gunflash("pitch")
		Selected:
		TNT1 A 0 A_Jumpifinventory("Noammocheck",1,"Naselect")
		TNT1 AA 0 A_Raise
		RPGG A 1 A_Raise
		Loop
	Nadeselect:
		TNT1 AA 0 A_Lower
		RPGG B 1 A_Lower
		Loop
	NaSelect:
		TNT1 AA 0 A_Raise
		RPGG B 1 A_Raise
		Loop
	Fire:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "ThrowBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "ThrowFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "ThrowIceBarrel")
	    TNT1 A 0 A_JUMPIFINVENTORY("Krg_rpgammo",1,1)
		TNT1 A 0 A_Jumpifnoammo("Noammo")
		TNT1 A 0 A_Zoomfactor(1)
		RPGG A 1 Offset(1,33)
		TNT1 A 0 A_Playsound("Rpgfire",6)
 		TNT1 A 0 A_Setblend("yellow",.1,2)
		TNT1 A 0 A_FireCustomMissile("muzzlelight", 1,0,6,15)
		TNT1 A 0 A_FireCustomMissile("muzzlesmokeblst",1,0,6,15)
		RPGG B 1 Offset(10,50)A_FireCustomMissile("Rpggrenade",1,1,6)
		TNT1 AA 0 A_FireCustomMissile("muzzlesmoker", 6,0,12,13)
		TNT1 A 0 A_TAKEINVENTORY("Krg_rpgammo",1)
 		TNT1 A 0 A_Setblend("gray",.2,4)
 		TNT1 A 0 A_Setpitch(pitch-8)
		RPGG B 1 Offset(17,51)
		TNT1 A 0 A_FireCustomMissile("muzzlesmokeblst", 1,0,6,15)
 		TNT1 A 0 A_Setpitch(pitch+4)
		RPGG B 1 Offset(20,52)
 		TNT1 A 0 A_Setpitch(pitch+4)
		RPGG B 1 Offset(23,53)
		TNT1 A 0 A_FireCustomMissile("muzzlesmoker", 6,0,12,10)
		RPGG B 10 Offset(25,54)
		TNT1 A 0 A_FireCustomMissile("muzzlesmoker", 6,0,12,10)
		RPGG B 1 Offset(23,51)
		RPGG B 1 Offset(20,49)
		RPGG B 1 Offset(18,47)
		TNT1 A 0 A_FireCustomMissile("muzzlesmoker", 6,0,12,10)
		RPGG B 1 Offset(16,45)
		RPGG B 1 Offset(14,43)
		RPGG B 1 Offset(12,41)
		TNT1 A 0 A_FireCustomMissile("muzzlesmoker", 6,0,12,10)
		RPGG B 1 Offset(9,39)
		RPGG B 1 Offset(6,37)
		TNT1 A 0 A_FireCustomMissile("muzzlesmoker", 6,0,12,10)
		RPGG B 1 Offset(3,35)
	TNT1 A 0 A_Jumpifnoammo("Noammo")
		TNT1 A 0 A_FireCustomMissile("muzzlesmoker", 6,0,12,10)
Reloadrpg:
		RPGG B 1 Offset(1,45) A_JumpIfInventory("PB_RocketAmmo",1,2)
		RPGG B 1 Offset(1,70)
		RPGG B 1 Offset(1,87)
		RPGG B 1 Offset(1,100) A_Playsound("ssar_modattach",6)
		RPGG B 1 Offset(1,115)
		RPGG B 1 Offset(1,117)
		RPGG B 1 Offset(1,119)
		RPGG B 1 Offset(1,121)
		RPGG B 1 Offset(1,124)
		TNT1 A 0 A_Playsound("ssar_magin",7)
		RPGG B 5 Offset(1,127)
		RPGG B 1 Offset(4,133)
		RPGG B 1 Offset(7,137)
		RPGG B 1 Offset(12,143)A_Playsound("MP55_Magin",5)
		RPGG B 15 Offset(15,150)
		TNT1 A 0 A_Setpitch(pitch+2)
		RPGG B 1 Offset(12,143)
		TNT1 A 0 A_Setpitch(pitch-2)
		RPGG B 1 Offset(7,137)
		RPGG B 5 Offset(1,130)
		RPGG A 1 Offset(1,115)
		RPGG A 1 Offset(1,100)
		RPGG A 1 Offset(1,85)A_TakeInventory("PB_RocketAmmo",1)
		RPGG A 1 Offset(1,70)A_GiveInventory("Krg_rpgammo",1)
		RPGG A 1 Offset(1,43)
		RPGG A 1 Offset(1,36)
		goto ready
	Altfire:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_Zoomfactor(1.5)
		TNT1 A 0 A_Jumpifinventory("Noammocheck",1,"Nazoomin")
		TNT1 A 0 A_Playsound("grenadeaim",6)
		RPGG A 60 A_Weaponready
		Goto ready
	Nazoomin:
		TNT1 A 0 A_Zoomfactor(1.5)
		TNT1 A 0 A_Playsound("grenadeaim",6)
		RPGG B 60 A_Weaponready
		Goto noammo
	Zoom:
		TNT1 A 0 A_Playsound("Melee_kick")
		HAND A 1 Offset(1,50)
		TNT1 A 0 A_Gunflash("pitch")
		HAND A 1 Offset(1,57)
		KICK A 1 Offset(10,50)
		KICK A 1 Offset(5,40)
		KICK B 1 Offset(10,40)
		KICK B 1 Offset(5,36) A_customPunch(7,0,0,"meleehit")
		KICK B 1 Offset(1,33)
		KICK B 1 Offset(-2,34)
		KICK B 1 Offset(-3,35)
		KICK B 1 Offset(-4,36)
		KICK B 1 Offset(-5,37)
		KICK B 1 Offset(-6,38)
		KICK B 1 Offset(10,50)
		KICK A 1 Offset(5,40)
		KICK A 1 Offset(10,50)
		goto select
	Pitch:
		TNT1 A 0 A_Setpitch(pitch-2)
		NULL A 1 A_Setpitch(pitch-1)
		TNT1 A 0 A_Setangle(angle-2)
		NULL A 1 A_Setangle(angle-1)
		TNT1 A 0 A_Setpitch(pitch+1)
		NULL A 1 A_Setangle(angle+1)
		TNT1 A 0 A_Setpitch(pitch+1)
		NULL A 1 A_Setangle(angle+1)
		TNT1 A 0 A_Setpitch(pitch+1)
		NULL A 1 A_Setangle(angle+1)
		Stop
	Spawn:
		RPGP A -1
		Stop
		
		WeaponSpecial:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
	    TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility",1)
			TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility", 1)
			Goto Ready3
		
	FlashKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0
		Goto Ready3
		
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")	
		TNT1 A 0
		Goto Ready3
		
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0
	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0
		Goto Ready3
		
	
}
}
Actor Krg_Rpgammo : Ammo
{
	Inventory.amount 0
	Inventory.maxamount 1
	Ammo.Backpackamount 0
	Ammo.backpackmaxamount 1
	+INVENTORY.IGNORESKILL
	Inventory.icon "RP7AA0"
}