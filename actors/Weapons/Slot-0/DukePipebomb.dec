Actor SatchelCharge 
{ 
	Gravity 1.0
	Speed 10
	Radius 10
    Height 5
    Health 50
   // Obituary "%k \c[m1]passed\c- %o \c[m1]the pipe.\c-"
   // Gravity 0.8
   BounceType Doom
	BounceFactor 0.2
    //BounceCount 3
    //Scale 0.1
    PROJECTILE
	//+PUSHABLE
    +NOBLOOD
    +SHOOTABLE
    -NOBLOCKMAP
    -NOLIFTDROP
    -NOGRAVITY
    -NOTELEPORT
	-TELESTOMP
    +MOVEWITHSECTOR
    -BOUNCEONACTORS
//   +DOOMBOUNCE
    -EXPLODEONWATER
    +CANBOUNCEWATER
    +FORCERADIUSDMG
	+FORCEXYBILLBOARD
    +THRUGHOST
	+NOTARGETSWITCH
	Obituary "%o done charged his last satchel."
    Damage 1
    SeeSound "Weapons/SatchelToss"
	BounceSound "Weapons/SatchelBounce"
    DeathSound "Weapons/SatchelBounce"
    Renderstyle NORMAL
    States
    {
    Spawn:
	  //TNT1 A 0
	  //TNT1 A 0 A_PlaySoundEx("silence","voice",0,0)
	  //Spawn2:
        STCP ABCD 3 A_JumpIfInTargetInventory ("DetonateSatchelCharge",1,"Death")
      //STCP BB 1 A_JumpIfInTargetInventory ("DetonateSatchelCharge",1,"Death")
        Loop
	See:
		TNT1 A 0 A_JumpIfInTargetInventory ("SatchelChargeAmmo", 0, "Death")
		TNT1 A 1 A_JumpIfCloser(15,"GiveSatchelCharge")
		Loop
	GiveSatchelCharge:
		TNT1 A 0 A_SpawnItemEx("SatchelChargePickup")
	  //STCP A 1
		Stop

    Death:
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",1) //for r3827 compatibility
      //TNT1 A 0 A_PlaySound("weapons/SCbounce")
		TNT1 A 0 A_Jump(256,"Death1","Death2")
 		STCP C 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 15)

    Death1:
		TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
        TNT1 A 0 A_JumpIfHealthLower(1,"Explode")
        TNT1 A 0 A_JumpIfInTargetInventory ("DetonateSatchelCharge",1,"Explode")
        STCP A 1 A_Gravity
 		STCP A 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 15)
       Loop

    Death2:
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
        TNT1 A 0 A_JumpIfHealthLower(1,"Explode")
        TNT1 A 0 A_JumpIfInTargetInventory ("DetonateSatchelCharge",1,"Explode")
        STCP C 1 A_Gravity
 		STCP C 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 15)
        Loop

    Explode:
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",0) //This must be cleared when we get here so double explosions don't happen!
        TNT1 A 0 A_NoBlocking
        TNT1 A 0 A_AlertMonsters
//      TNT1 A 0 A_PlaySound("duke/explosion", CHAN_WEAPON, 1.0, 0, 1)
//      TNT1 A 0 A_PlaySound("duke/pipeexplosion", 5, 0.5, 0, 0)
//      TNT1 AAAAAAA 0 A_SpawnItemEx("PipebombFrag",random(-1,1),random(-1,1),random(26,56),random(-2,2),random(-2,2),random(5,15))//A_SpawnDebris("PipebombFrag")
		STCP A 1 Bright A_CustomMissile ("SatchelExplosion",0,0,0,0,0)
		STCP A 1 Bright A_CustomMissile ("SatchelExplosion",0,random(-30,30),random(0, 360),0,0)
		STCP A 1 Bright A_CustomMissile ("SatchelExplosion",0,random(-30,30),random(0, 360),0,0)
		STCP A 1 Bright A_CustomMissile ("SatchelExplosion",0,random(-30,30),random(0, 360),0,0)
		STCP A 1 Bright A_CustomMissile ("SatchelExplosion",0,random(-30,30),random(0, 360),0,0)
//      TNT1 A 1 A_SpawnItemEx("TheExplosion",0,0,3,0,0,0,0,0)//A_SpawnItem("RPGExplosion")
//      TNT1 A 1 A_Explode(128,192) // Pipebombs have 1.5 the radius of the rockets.
        Stop




}

}
/*
    States
    {
    Spawn:
      STCP A 1 Thing_ChangeTid(0,1999)
      Loop
    Death:
      STCP A 1
      STCP A 1 Thing_ChangeTid(0,1999)
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
        TNT1 A 0 A_JumpIfHealthLower(0,"Explode")
      STCP A 1 
      Goto Death+2
	 Explode:
	     TNT1 A 0 A_ChangeFlag("SHOOTABLE",0)
        TNT1 A 0 A_NoBlocking
		STCP A 1 Bright A_CustomMissile ("TheExplosion",0,0,0,0,0)
			STOP
    }
*/


Actor PipeExplosion
{
    SeeSound "Explosion"
    SpawnID 201
    Radius 8
    Height 56
    Speed 0
	DamageType ExplosiveImpact
	+NOBLOCKMAP
	+EXTREMEDEATH
	+BLOODSPLATTER
    States
    {
	Spawn:
		TNT1 A 0
	Goto Death
	Death:
        TNT1 A 0 A_SpawnItemEx ("DetectFloorCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	    TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	    TNT1 A 0 A_SpawnItemEx ("UnderwaterExplosion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
        TNT1 A 0 A_SpawnItemEx ("ExplosionFlareSpawner_Explosives",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
        NKXP A 0 A_Explode(140, 240) //, TRUE, TRUE, 0, 30, 1)
		//TNT1 AAAA 0 BRIGHT A_CustomMissile("ExplosionFlak", random(-9,9), 0, -1, random(-9,9))
        EXPL A 0 Radius_Quake (2, 16, 0, 15, 0)
        TNT1 AAA 0 A_CustomMissile ("ExplosionParticleHeavy_Explosives", 0, 0, random (0, 360), 2, random (0, 180))
        TNT1 AAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("ExplosionParticleHeavy_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAAAA 0 A_CustomMissile ("ExplosionParticleVeryFast_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("ShrapnelParticle_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
        TNT1 AAAAAAA 0 A_CustomMissile ("MediumExplosionFlames_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
        EXPL AAAAAA 0 A_CustomMissile ("ExplosionSmokeFast22_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0 A_Playsound("FAREXPL")
		TNT1 AAAAAAAAAAAAA 3 A_CustomMissile ("HeavyExplosionSmoke_Explosives", 2, 0, random (0, 360), 2, random (0, 360))
	Stop




}

}
Actor SatchelExplosion : PipeExplosion
{
	ProjectileKickBack 200
    States
    {
	Death:
        TNT1 A 0 A_SpawnItemEx ("DetectFloorCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	    TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	    TNT1 A 0 A_SpawnItemEx ("UnderwaterExplosion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
        TNT1 A 0 A_SpawnItemEx ("ExplosionFlareSpawner_Explosives",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
        NKXP A 0 A_Explode(140, 240) //, TRUE, TRUE, 0, 30, 1)
		//TNT1 AAAA 0 BRIGHT A_CustomMissile("ExplosionFlak", random(-9,9), 0, -1, random(-9,9))
        EXPL A 0 Radius_Quake (2, 16, 0, 15, 0)
        TNT1 AAA 0 A_CustomMissile ("ExplosionParticleHeavy_Explosives", 0, 0, random (0, 360), 2, random (0, 180))
        TNT1 AAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("ExplosionParticleHeavy_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAAAA 0 A_CustomMissile ("ExplosionParticleVeryFast_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("ShrapnelParticle_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
        TNT1 AAAAAAA 0 A_CustomMissile ("MediumExplosionFlames_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
        EXPL AAAAAA 0 A_CustomMissile ("ExplosionSmokeFast22_Explosives", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0 A_Playsound("FAREXPL")
		TNT1 AAAAAAAAAAAAA 3 A_CustomMissile ("HeavyExplosionSmoke_Explosives", 2, 0, random (0, 360), 2, random (0, 360))
	Stop




}


}
Actor PipebombAmmo : Ammo 30785
{
   Inventory.Amount 1
   Inventory.MaxAmount 25
   Ammo.BackpackAmount 6
   Ammo.BackpackMaxAmount 40
   Inventory.Icon PBAMA0
   Inventory.PickupMessage "You got a pipebomb!"
   + INVENTORY.IGNORESKILL
   Scale 0.5
   States
   {
   Spawn:
		TNT1 A 0 
	  //TNT1 A 0 ACS_NamedExecuteWithResult("RadarChanger",0)
		PBAM A   -1     



}

}
Actor PipeBombPickup : PipeBombAmmo
{
	States
	{
	Spawn:
	TNT1 A 0
	TNT1 A -1

}

}
Actor PipebombBox : CustomInventory 30786
{
  Game Doom
  Scale 0.5
  SpawnID 134
  Inventory.PickupMessage "Picked up a box of pipebombs!"
   + INVENTORY.IGNORESKILL
  States
  {
  Spawn:
	TNT1 A 0 
  //TNT1 A 0 ACS_NamedExecuteWithResult("RadarChanger",0)
    PBOX A -1
    Stop
  Pickup:
    TNT1 A 0 A_GiveInventory("PipebombAmmo",6)
    TNT1 A 0 A_GiveInventory("PBWP_PipeBombToken", 1)
    Stop



}
}
