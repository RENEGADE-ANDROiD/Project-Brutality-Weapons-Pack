Actor EXVerify : Inventory 
{ 
   +INVENTORY.UNDROPPABLE 
	Inventory.Maxamount 1
}

Actor Det_Pipebomb : CustomInventory
{
   Game Doom
   Scale 0.5
   SpawnID 134
   Inventory.PickupSound "misc/w_pkup"
   Inventory.PickupMessage "You got a box of Pipebombs and a Detonator!"
   +INVENTORY.IGNORESKILL
   States
   {
   Spawn:
		TNT1 A 0
		PDET A -1
		Stop
   Pickup:
		TNT1 A 0 A_GiveInventory("PipebombAmmo", 6)
		TNT1 A 0 A_GiveInventory("PBWP_PipeBombToken", 1)
		Stop



}
}
Actor Pipebomb 
{ 
	Gravity 0.7
	Speed 10
	Radius 10
    Height 5
    Health 50
   // Obituary "%k \c[m1]passed\c- %o \c[m1]the pipe.\c-"
   // Gravity 0.8
   BounceType Doom
	BounceFactor 0.4
    //BounceCount 3
    Scale 0.1
    PROJECTILE
	//+PUSHABLE
    +NOBLOOD
    +SHOOTABLE
    -NOBLOCKMAP
    -NOLIFTDROP
    -NOGRAVITY
    -NOTELEPORT
	-TELESTOMP
    +MOVEWITHSECTOR
    -BOUNCEONACTORS
//   +DOOMBOUNCE
    -EXPLODEONWATER
    +CANBOUNCEWATER
    +FORCERADIUSDMG
	+FORCEXYBILLBOARD
    +THRUGHOST
	+NOTARGETSWITCH
	Obituary "%o tripped on his own pipebomb."
    Damage 1
    SeeSound "weapons/pbthrow"
	BounceSound "weapons/pbbounce"
    DeathSound "weapons/pbbounce"
    Renderstyle NORMAL
    States
    {
    Spawn:
	  //TNT1 A 0
	  //TNT1 A 0 A_PlaySoundEx("silence","voice",0,0)
	  //Spawn2:
        PIPB AB 3 A_JumpIfInTargetInventory ("DetonatePB",1,"Death")
      //PIPB BB 1 A_JumpIfInTargetInventory ("DetonatePB",1,"Death")
        Loop
	 See:
		TNT1 A 0 A_JumpIfInTargetInventory ("PipebombAmmo", 0, "Death")
		TNT1 A 1 A_JumpIfCloser(15,"GivePipeBomb")
		Loop
	GivePipeBomb:
		TNT1 A 0 A_SpawnItemEx("PipeBombPickup")
		//PIPB A 1
		Stop
      Death:
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",1) //for r3827 compatibility
      //TNT1 A 0 A_PlaySound("weapons/pbbounce")
		TNT1 A 0 A_Jump(256,"Death1","Death2")
 		PIPB C 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 15)

      Death1:
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
        TNT1 A 0 A_JumpIfHealthLower(1,"Explode")
        TNT1 A 0 A_JumpIfInTargetInventory ("DetonatePB",1,"Explode")
        PIPB A 1 A_Gravity
 		PIPB A 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 15)
       Loop

      Death2:
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
        TNT1 A 0 A_JumpIfHealthLower(1,"Explode")
        TNT1 A 0 A_JumpIfInTargetInventory ("DetonatePB",1,"Explode")
        PIPB B 1 A_Gravity
 		PIPB B 1 A_LookEx(LOF_NOSOUNDCHECK, 0, 15)
        Loop

      Explode:
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",0) //This must be cleared when we get here so double explosions don't happen!
        TNT1 A 0 A_NoBlocking
        TNT1 A 0 A_AlertMonsters
      //TNT1 A 0 A_PlaySound("duke/explosion", CHAN_WEAPON, 1.0, 0, 1)
      //TNT1 A 0 A_PlaySound("duke/pipeexplosion", 5, 0.5, 0, 0)
      //TNT1 AAAAAAA 0 A_SpawnItemEx("PipebombFrag",random(-1,1),random(-1,1),random(26,56),random(-2,2),random(-2,2),random(5,15))//A_SpawnDebris("PipebombFrag")
		PIPB A 1 Bright A_CustomMissile ("PipeExplosion",0,0,0,0,0)
      //TNT1 A 1 A_SpawnItemEx("TheExplosion",0,0,3,0,0,0,0,0)//A_SpawnItem("RPGExplosion")
      //TNT1 A 1 A_Explode(128,192) // Pipebombs have 1.5 the radius of the rockets.
        Stop




}

}
/*
    States
    {
    Spawn:
      PIPB A 1 Thing_ChangeTid(0,1999)
      Loop
    Death:
      PIPB A 1
      PIPB A 1 Thing_ChangeTid(0,1999)
        TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
        TNT1 A 0 A_JumpIfHealthLower(0,"Explode")
      PIPB A 1 
      Goto Death+2
	 Explode:
	     TNT1 A 0 A_ChangeFlag("SHOOTABLE",0)
        TNT1 A 0 A_NoBlocking
		PIPB A 1 Bright A_CustomMissile ("TheExplosion",0,0,0,0,0)
			STOP
    }
*/


ACTOR Det_SatchelCharge : PB_Weapon
{
   Game Doom
   Weapon.BobRangeX 0.3
   Weapon.BobRangeY 0.5
   Weapon.BobStyle InverseSmooth
   Weapon.BobSpeed 2.0
   Inventory.PickupSound "Weapons/SatchelPick"
   Inventory.PickupMessage "You Got A Satchel-Charge With Detonator! (Slot 0)"
   Obituary "Was Blown Up By Satchel Charge. Ouch!"
   Weapon.AmmoType1 "SatchelChargeAmmo"
   Weapon.AmmoType2 "SatchelChargeAmmo"
   Weapon.AmmoGive1 0
   Weapon.AmmoGive2 1
   Weapon.AmmoUse1 0
   Weapon.AmmoUse2 1
   Weapon.Kickback 0
   +CLIENTSIDEONLY
   +NOALERT
   +WEAPON.NOAUTOAIM
   +WEAPON.ALT_AMMO_OPTIONAL
   AttackSound "weapons/pbarm"
   Weapon.SlotNumber 0
   Weapon.SlotPriority 0
   Weapon.SelectionOrder 2600
   Scale 0.2
   Tag "Det Satchel-Charge"
   Inventory.AltHudIcon "SCDSA0"
   FloatBobStrength 0.5
   States
   {
   Steady:
	    TNT1 A 0
	    Goto Ready

	SCSelect:
		TNT1 A 0 A_JumpIfInventory("SatchelChargeAmmo",1,2)
        Goto NoAmmoSC
		TNT1 AAAAA 0
		STCG HGFEDCBAAAAAAAA 1
		Stop

    Ready:
		TNT1 A 0
		TNT1 A 0 A_GunFlash("SCSelect", GFF_NOEXTCHANGE)
	  //SREM A 1 A_DoPBWeaponAction
        Goto Ready3

	Ready3:
		TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			A_TakeInventory("PB_LockScreenTilt",1);
		}
	    TNT1 A 0
	SatchelChargeReadyToThrow:
	    TNT1 A 0 A_GunFlash("SCReady", GFF_NOEXTCHANGE)
	    SREM A 1 {
			return A_DoPBWeaponAction(WRF_NOFIRE);






		}
		TNT1 A 0 A_JumpIfInventory("GoFatality",1,"Steady")
	    Loop
	SCReady:
		TNT1 A 0 A_JumpIfInventory("SatchelChargeAmmo",1,2)
        Goto NoAmmoSC
		TNT1 AAAAA 0
		STCG A 1// A_DoPBWeaponAction
		Stop

   Deselect:
	   TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
	   TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
	   TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
	   TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			A_TakeInventory("PB_LockScreenTilt",1);
		}
	   TNT1 A 0 A_GunFlash("SCDeselect", GFF_NOEXTCHANGE)
       TNT1 A 0 A_Lower(120)
       Wait
	SCDeSelect:
	   TNT1 A 0 A_JumpIfInventory("SatchelChargeAmmo",1,2)
       Goto NoAmmoSC
	   TNT1 AAAAA 0

	   STCG ABCDEFGH 1
       Stop

   Select:
	   TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			A_TakeInventory("PB_LockScreenTilt",1);
		}
	   TNT1 A 0 A_TakeInventory("HasBarrel",1)
	   TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
	   TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
	   TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
	   TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
	   TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
	   Goto SelectFirstPersonLegs
	   SelectContinue:
	   TNT1 A 0 
	   TNT1 A 0 A_Gunflash("SCSelect", GFF_NOEXTCHANGE)
	   Goto Ready3

	NoAmmoSC:
		TNT1 A 1
		Goto SCReady
	AltFlashSC:
		TNT1 A 0 A_JumpIfInventory("SatchelChargeAmmo",1,2)
        Goto NoAmmoSC
		TNT1 AAAAA 0
		STCG A 23
		Stop
   Fire:
	  TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "ThrowBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "ThrowFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "ThrowIceBarrel")
		TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			A_TakeInventory("PB_LockScreenTilt",1);
		}
	  TNT1 a 0 A_GunFlash("AltFlashSC", GFF_NOEXTCHANGE)
      SREM B 2
	  SREM B 0
      TNT1 A 0 A_JumpIfInventory("ThrownSatchelCharge",1,"Fire2")
      SREM B 0 A_PlayWeaponSound("weapons/pbarm")
    //TNT1 A 0 A_GiveInventory("DetonateSatchelCharge",1)
    //TNT1 A 0 A_TakeInventory("ThrownSatchelCharge")
    //TNT1 A 0 A_TakeInventory("DetonateSatchelCharge")
      SREM B 2
      SREM A 8
      SREM A 8
      SREM A 3 
      Goto SatchelChargeReadyToThrow

	Fire2:
       TNT1 A 0 A_GiveInventory("DetonateSatchelCharge",1)
       SREM B 2 A_DoPBWeaponAction(14)
       SREM B 0 A_DoPBWeaponAction(14)
       SREM B 0 A_PlayWeaponSound("weapons/pbarm")
       SREM B 0 A_DoPBWeaponAction(14)
       SREM B 0 A_DoPBWeaponAction(14)
       SREM B 1 A_DoPBWeaponAction(14)
       TNT1 A 0 A_TakeInventory("ThrownSatchelCharge")
       TNT1 A 0 A_TakeInventory("DetonateSatchelCharge")
       Goto Select

	DetonatorReadyFlash:
		SREM A 999
		Stop

    AltFire:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 {
		    A_WeaponOffset(0,32);
			A_SetRoll(0);
			A_TakeInventory("PB_LockScreenTilt",1);
		}
		TNT1 A 0 A_JumpIfNoAmmo("SatchelChargeReadyToThrow")
		TNT1 A 0 A_GunFlash("DetonatorReadyFlash", GFF_NOEXTCHANGE)
        STCG ACE 1 A_DoPBWeaponAction(14)

    AltHold:
        TNT1 A 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_GiveInventory("SatchelChargeSpeed",5)
        TNT1 A 0 A_Refire

     Release:
      TNT1 A 0 A_ClearRefire
	  STCG Z 8
    //STCG NOP 1 A_DoPBWeaponAction(14)

     ReleaseConsider:
        STCG I 1
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",100,"ReleaseSpeed11")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",90,"ReleaseSpeed10")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",80,"ReleaseSpeed9")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",70,"ReleaseSpeed8")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",60,"ReleaseSpeed7")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",50,"ReleaseSpeed6")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",40,"ReleaseSpeed5")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",30,"ReleaseSpeed4")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",20,"ReleaseSpeed3")
        TNT1 A 0 A_JumpIfInventory("SatchelChargeSpeed",10,"ReleaseSpeed2")
      //STCG I 1 A_DoPBWeaponAction(14)

      ReleaseSpeed1:
       TNT1 A 0 A_FireProjectile("SatchelCharge",0,1,0,-10,0,-15)  // spawns under for dropping rather than throwing;
       TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
       Goto ReleaseFinish

      ReleaseSpeed2:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge2",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseSpeed3:
       STCG I 1 A_DoPBWeaponAction(14)
       TNT1 A 0 A_FireProjectile("SatchelCharge3",0,1,0,-10,0,-15)
       TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
       Goto ReleaseFinish

      ReleaseSpeed4:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge4",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseSpeed5:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge5",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseSpeed6:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge6",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseSpeed7:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge7",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseSpeed8:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge8",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseSpeed9:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge9",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseSpeed10:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge10",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseSpeed11:
        STCG I 1 A_DoPBWeaponAction(14)
        TNT1 A 0 A_FireProjectile("SatchelCharge11",0,1,0,-10,0,-15)
        TNT1 A 0 A_GiveInventory("ThrownSatchelCharge",1)
        Goto ReleaseFinish

      ReleaseFinish:
       PIPE QRSTU 1
       STCG Z 8 
       TNT1 A 2 A_TakeInventory("SatchelChargeSpeed")
       		TNT1 A 0 A_Lower(120)
       Goto SatchelChargeReadyToThrow//Select

	Reload:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 { PBWP_OffsetReloadSetReturn("SatchelChargeReadyToThrow"); }
		TNT1 A 0 { return ResolveState("PBWP_OffsetReloadAnim"); }
	Spawn:
		TNT1 A 0 
		SCDS A -1
        Loop

	WeaponSpecial:
	  TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
	  TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
	  TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
	  TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			A_GiveInventory("PB_LockScreenTilt",1);
			A_Takeinventory("GoWeaponSpecialAbility",1);
		}
	   TNT1 A 0
       Goto SatchelChargeReadyToThrow

	FlashKicking:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_GunFlash("SCReady", GFF_NOEXTCHANGE)
		Goto SatchelChargeReadyToThrow

	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_GunFlash("SCReady", GFF_NOEXTCHANGE)
		Goto SatchelChargeReadyToThrow

	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_gunFlash("SCReady", GFF_NOEXTCHANGE)
		Goto SatchelChargeReadyToThrow

	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_gunFlash("SCReady", GFF_NOEXTCHANGE)
		Goto SatchelChargeReadyToThrow

	FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		TNT1 AAAAAAAAAAAAAA 1
		Stop
	BP_Switchingpistol:
		TNT1 A 0 A_JumpIfInventory("PowerStrength",1,"BP_Switchingpistol1B")
	  //TNT1 A 0 A_TakeInventory("weaponspecial2",1)
		TNT1 A 0 A_PlaySound("PIHOL", 4)
		TNT1 A 0 A_SetAngle(-0.4 + angle)
		TNT1 Z 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_SetPitch(pitch + 0.2)
		TNT1 A 0 A_SetAngle(-0.4 + angle)
		TNT1 D 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_SetPitch(pitch + 0.2)
		TNT1 A 0 A_SetAngle(+0.4 + angle)
		TNT1 C 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_SetPitch(pitch + 0.2)
		TNT1 A 0 A_SetAngle(+0.4 + angle)
		TNT1 B 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_SetPitch(pitch + 0.2)
		TNT1 A 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH) 
		TNT1 Y 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH) 
	  //TNT1 A 0 A_TakeInventory("weaponspecial2",1)
		TNT1 A 0 A_TakeInventory("PSeq2", 1)
		TNT1 A 0 A_TakeInventory("PSeq1", 2)
		TNT1 A 0 A_Recoil(-1)
		PUN3 A 1 A_DoPBWeaponAction(WRF_NoFire|WRF_NoSwitch)
		TNT1 A 0 A_PlaySound("weapons/fistwhoosh",0)
		PUN3 B 1 A_DoPBWeaponAction(WRF_NoFire|WRF_NoSwitch)
		TNT1 A 0 A_SetPitch(+2 + pitch)
		TNT1 A 0 A_FireCustomMissile("ShakeYourAss",0,0,0,0)
		PUN3 D 1 A_DoPBWeaponAction(WRF_NoFire|WRF_NoSwitch)
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		RIfF AA 0 A_FireCustomMissile("MeleeStrike1", 0, 0, 0, 5)
		RIfF A 0 A_FireCustomMissile("MeleeStrike1", 0, 0, 25, 5)
		RIfF A 0 A_FireCustomMissile("MeleeStrike1", 0, 0, -25, 5)
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_SetPitch(+3 + pitch)
		PUN3 EGH 1 A_DoPBWeaponAction(WRF_NoFire|WRF_NoSwitch)
		PUN3 I 1 A_SetPitch(-2 + pitch)
		TNT1 A 0 A_SetPitch(-3 + pitch)
		PUN3 JKL 1 A_DoPBWeaponAction(WRF_NoFire|WRF_NoSwitch)
		TNT1 A 5
			//TNT1 A 0 A_JumpIfInventory("weaponspecial2", 1, "BP_Switchingpistol2")
			//TNT1 A 0 A_JumpIfInventory("weaponspecial2", 1, "BP_Switchingpistol2")
				//TNT1 A 0 A_JumpIfInventory("weaponspecial2", 1, "BP_Switchingpistol2")
					//TNT1 A 0 A_JumpIfInventory("weaponspecial2", 1, "BP_Switchingpistol2")
						//TNT1 A 0 A_JumpIfInventory("weaponspecial2", 1, "BP_Switchingpistol2")
							//TNT1 A 0 A_JumpIfInventory("weaponspecial2", 1, "BP_Switchingpistol2")
		TNT1 A 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
	  //TNT1 A 0 A_TakeInventory("weaponspecial2",1)
		Goto Ready
	BP_Switchingpistol1B:
	  //TNT1 A 0 A_TakeInventory("weaponspecial2",1)
		TNT1 A 0 A_PlaySound("PIHOL", 4)
		TNT1 A 0 A_SetAngle(-0.4 + angle)
		TNT1 Z 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_SetPitch(pitch + 0.2)
	    TNT1 A 0 A_SetAngle(-0.4 + angle)
		TNT1 D 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_SetPitch(pitch + 0.2)
		TNT1 A 0 A_SetAngle(+0.4 + angle)
		TNT1 C 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_SetPitch(pitch + 0.2)
		TNT1 A 0 A_SetAngle(+0.4 + angle)
		TNT1 B 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 A_SetPitch(pitch + 0.2)
		TNT1 A 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH) 
		TNT1 Y 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH) 
		TNT1 X 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOSWITCH) 
      //TNT1 A 0 A_TakeInventory("weaponspecial2",1)
