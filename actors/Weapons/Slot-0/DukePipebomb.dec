		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		RIfF AA 0 A_FireCustomMissile("MeleeStrike1Smash", 0, 0, 0, 5)
		RIfF A 0 A_FireCustomMissile("MeleeStrike1Smash", 0, 0, 25, 5)
		RIfF A 0 A_FireCustomMissile("MeleeStrike1Smash", 0, 0, -25, 5)
