// --------------------------------------------------------------------------
//
// Unmaker / Satan Scream
//
// --------------------------------------------------------------------------

ACTOR Satan_Scream : PB_WeaponBase 20023
{
	Weapon.AmmoUse1 0
	Weapon.AmmoGive1 150
	Weapon.AmmoType1 "PB_DTech"
	Inventory.PickUpSound "BFGREADY"
	Inventory.PickupMessage "What the $-#( is This?"
	Obituary "$O has been Desintegrated"
	Weapon.SlotNumber 0
	Weapon.SlotPriority 0
	+Weapon.NoAutoAim
	Tag "Unmaker - Satan Scream"
	States
	{
	Steady:
	TNT1 A 1
	Goto Ready
	SelectReady:
	Ready:
	    TNT1 A 0
	    Goto Ready3
	SelectAnimation:
	    HG2U A 1 FAST A_SetPitch(Pitch+0.8)
		HG2U B 1 FAST A_SetPitch(Pitch-0.4)
		HG2U C 1 FAST A_SetPitch(Pitch-0.4)
		TNT1 A 0 A_SetCrosshair(72)
		TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
		Goto Ready3
	ReadySettle:
	Ready3:
	RealReady:
        TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("GoWeaponSpecialAbility", 1,"WeaponSpecial")
		HG2G AB 1 A_DoPBWeaponAction
        TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("GoWeaponSpecialAbility", 1,"WeaponSpecial")
		HG2G CD 1 A_DoPBWeaponAction
        TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("GoWeaponSpecialAbility", 1,"WeaponSpecial")
		HG2G E 1 A_DoPBWeaponAction
        TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("GoWeaponSpecialAbility", 1,"WeaponSpecial")
		Goto RealReady

  Deselect:
    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
	TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
	TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
    TNT1 A 0 A_PlaySound("VRTOFF",18)
	TNT1 A 0 A_Takeinventory("Zoomed",1)
	UNHG A 0 A_StopSOund(11)
	UNHG A 0 A_StopSOund(6)
	UNHG A 0 A_PlaySOund("UNMSTO", 1)
	TNT1 A 0 A_ZoomFactor(1.0)
	Goto DeselectDown
	DeselectDown:
				TNT1 A 0 A_Lower(120)
    Wait

	Select:
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
		Goto SelectFirstPersonLegs
		SelectContinue:
		TNT1 A 0 { PB_WeaponRaise("BFGREADY"); }
		TNT1 A 0 { PB_WeapTokenSwitch("BFGSelected"); }
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
		Goto SelectAnimation
	WeaponSpecial:
	TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
	TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
	TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
	TNT1 A 0 A_JumpIfInventory ("SSModII", 1, "Normal")
	TNT1 A 0 A_Takeinventory("GoWeaponSpecialAbility",1)
	TNT1 A 0 A_GiveInventory("SSModII", 1)
	TNT1 A 0 A_Playsound("UNMSWT2",3)
	TNT1 A 0 A_Print("AltFire: Seekers Mode")
	Goto Ready3
	Normal:
	TNT1 A 0 A_Takeinventory("GoWeaponSpecialAbility",1)
	TNT1 A 0 A_TakeInventory("SSModII", 1)
	TNT1 A 0 A_Playsound("UNMSWT2",3)
	TNT1 A 0 A_Print("AltFire: Laser Mode")
	Goto Ready3

	Fire:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "ThrowBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "ThrowFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "ThrowIceBarrel")
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		TNT1 A 0 A_JumpIfInventory("PB_DTech",4,2)
		Goto NoAmmo
		TNT1 AAA 0
		HG2G E 4
		HG2G F 3
		TNT1 A 0 A_PlaySound ("UNMSTA", 15)
		HG2G G 2

		HG2G H 1
		HG2G I 1 Bright {
		PB_FireOffset;
		A_WeaponOffset(0,32,WOF_INTERPOLATE);
		A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
		A_Overlay(-3,"MuzzleFlashNormal");
		A_Overlay(6,"FiringLightning");
		A_OverlayFlags(6,PSPF_FLIP|PSPF_MIRROR,random(false,true));
		A_OverlayOffset(6,frandom(-2,2),frandom(-4,3));
		A_OverlayPivotAlign(6,PSPA_CENTER,PSPA_CENTER);
		A_OverlayRotate(6,frandom(-20,20));
		A_PlaySOund("UNMLOP", 6, 1, 1);
		A_FireCustomMissile("UnmakerLaser2", 0, 0, 0, 0, 0, 0);
		A_TakeInventory("PB_DTech", 2,TIF_NOTAKEINFINITE);
		PB_WeaponRecoil(-0.7,random(1, -1));
		}
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_ZoomFactor(0.95)
	goto Hold

	HOLD:
		TNT1 A 0 A_JumpIfInventory("PB_DTech",1,2)
		Goto NoAmmo
		TNT1 AAAA 0
		HG2G J 1 Bright {
		PB_FireOffset;
		A_WeaponOffset(0,32,WOF_INTERPOLATE);
		A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
		A_Overlay(-3,"MuzzleFlashNormal");
		A_Overlay(6,"FiringLightning");
		A_OverlayFlags(6,PSPF_FLIP|PSPF_MIRROR,random(false,true));
		A_OverlayOffset(6,frandom(-2,2),frandom(-4,3));
		A_OverlayPivotAlign(6,PSPA_CENTER,PSPA_CENTER);
		A_OverlayRotate(6,frandom(-20,20));
		A_PlaySOund("UNMLOP", 6, 1, 1);
		A_FireCustomMissile("UnmakerLaser2", 0, 0, 0, 0, 0, 0);
		A_TakeInventory("PB_DTech", 2,TIF_NOTAKEINFINITE);
		PB_WeaponRecoil(-0.7,random(1, -1));
		}
		TNT1 A 0 A_JumpIfInventory("PB_DTech",1,2)
		Goto NoAmmo
		TNT1 AAAA 0
		HG2G J 1 Bright {
		PB_FireOffset;
		A_WeaponOffset(0,32,WOF_INTERPOLATE);
		A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
		A_Overlay(-3,"MuzzleFlashNormal");
		A_FireCustomMissile("UnmakerLaser2", 0, 0, 0, 0, 0, 0);
		A_TakeInventory("PB_DTech", 2,TIF_NOTAKEINFINITE);
		PB_WeaponRecoil(-0.7,random(1, -1));
		}
		TNT1 A 0 A_JumpIfInventory("PB_DTech",1,2)
		Goto NoAmmo
		TNT1 AAAA 0
		HG2G J 1 Bright {
		PB_FireOffset;
		A_WeaponOffset(0,32,WOF_INTERPOLATE);
		A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
		A_Overlay(-3,"MuzzleFlashNormal");
		A_FireCustomMissile("UnmakerLaser2", 0, 0, 0, 0, 0, 0);
		A_TakeInventory("PB_DTech", 2,TIF_NOTAKEINFINITE);
		PB_WeaponRecoil(-0.7,random(1, -1));
		}
		TNT1 A 0 A_JumpIfInventory("PB_DTech",1,2)
		Goto NoAmmo
		TNT1 AAAA 0
		HG2G J 1 Bright {
		PB_FireOffset;
		A_WeaponOffset(0,32,WOF_INTERPOLATE);
		A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
		A_Overlay(-3,"MuzzleFlashNormal");
		A_FireCustomMissile("UnmakerLaser2", 0, 0, 0, 0, 0, 0);
		A_TakeInventory("PB_DTech", 2,TIF_NOTAKEINFINITE);
		PB_WeaponRecoil(-0.7,random(1, -1));
		}
	    TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_ReFire
		UNHG A 0 A_ZoomFactor(1.0)
		UNHG A 0 A_StopSOund(11)
		UNHG A 0 A_StopSOund(6)
		UNHG A 0 A_PlaySOund("UNMSTO", 1)
		Goto RealReady
	AltFire: //Current Progress
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_JumpIfInventory ("SSModII", 1, "SeekerAltFire")
		TNT1 A 0 A_JumpIfInventory("PB_DTech",5,2)
		Goto NoAmmo
		TNT1 AAA 0
		HG2G E 4
		HG2G F 3
		HG2G G 2

		HG2G H 1
		HG2G I 1 Bright
		TNT1 A 0 A_AlertMonsters
	AltFireHold:
		HG2G J 1 BRIGHT 
		TNT1 A 0 A_Playsound("unmaker/fire", 1, 1, 0)
		TNT1 A 0 A_TakeInventory("PB_DTech", 5,TIF_NOTAKEINFINITE)
		HG2G J 2 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", 5, 0, 0, 0, 5, 1, none, 0)
		HG2G J 0 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", 0, 0, 0, 0, 5, 1, none, 0)
		HG2G J 0 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", -5, 0, 0, 0, 5, 1, none, 0)
		TNT1 A 0 A_JumpIfInventory("PB_DTech",5,1)
		Goto Ready+8
		HG2G J 1 BRIGHT 
		TNT1 A 0 A_Refire("AltFireHold2")
		Goto RealReady
	AltFireHold2:
		HG2G J 1 BRIGHT 
		TNT1 A 0 A_Playsound("unmaker/fire", 1, 1, 0)
		TNT1 A 0 A_TakeInventory("PB_DTech", 5,TIF_NOTAKEINFINITE)
		HG2G J 2 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", 10, 0, 0, 0, 5, 1, none, 0)
		HG2G J 0 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", 0, 0, 0, 0, 5, 1, none, 0)
		HG2G J 0 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", -10, 0, 0, 0, 5, 1, none, 0)
		TNT1 A 0 A_JumpIfInventory("PB_DTech",5,1)
		Goto Ready+8
		HG2G J 1 BRIGHT 
		TNT1 A 0 A_Refire("AltFireHold3")
		Goto RealReady
	AltFireHold3:
		HG2G J 1 BRIGHT 
		TNT1 A 0 A_Playsound("unmaker/fire", 1, 1, 0)
		TNT1 A 0 A_TakeInventory("PB_DTech", 5,TIF_NOTAKEINFINITE)
		HG2G J 2 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", 15, 0, 0, 0, 5, 1, none, 0)
		HG2G J 0 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", 0, 0, 0, 0, 5, 1, none, 0)
		HG2G J 0 BRIGHT  A_RailAttack(50, 0, 0, "none", "red", RGF_SILENT | RGF_NOPIERCING | RGF_FULLBRIGHT | RGF_EXPLICITANGLE, 0, "SatanScreamPuff", -15, 0, 0, 0, 5, 1, none, 0)
		TNT1 A 0 A_JumpIfInventory("PB_DTech",5,1)
		Goto Ready+8
		HG2G J 1 BRIGHT
		TNT1 A 0 A_Refire("AltFireHold")
		Goto RealReady
	SeekerAltFire:
		TNT1 A 0 A_JumpIfInventory("PB_DTech",10,2)
		Goto NoAmmo
		TNT1 AAA 0
		TNT1 A 0 A_PlaySound("weapons/bh_primary2",CHAN_AUTO)
		HG2G E 4 { PB_FireOffset; }
		HG2G F 3 { PB_FireOffset; }
		HG2G G 2 { PB_FireOffset; }

		HG2G H 1 { PB_FireOffset; }
		HG2G I 1 Bright
		TNT1 A 0 A_AlertMonsters
	SeekerAltFireHold:
		HG2G J 1 BRIGHT 
		TNT1 A 0 A_Playsound("weapons/bh_secondary", 1, 1, 0)
		TNT1 A 0 A_TakeInventory("PB_DTech", 10,TIF_NOTAKEINFINITE)
		HG2G J 2 BRIGHT {
			PB_FireOffset;
			A_FireCustomMissile ("UnmakerDoomSeeker", 0, 0, 0, 0);
			A_FireCustomMissile ("UnmakerDoomSeeker", 5, 0, 0, 0);
			A_FireCustomMissile ("UnmakerDoomSeeker", -5, 0, 0, 0);
			}
		HG2G J 10 { PB_FireOffset; }
		TNT1 A 0 A_Refire("SeekerAltFireHoldII")
		Goto Ready3
	SeekerAltFireHoldII:
		HG2G J 1 BRIGHT 
		TNT1 A 0 A_Playsound("weapons/bh_secondary", 1, 1, 0)
		TNT1 A 0 A_TakeInventory("PB_DTech", 10,TIF_NOTAKEINFINITE)
		HG2G J 2 BRIGHT {
			PB_FireOffset;
			A_FireCustomMissile ("UnmakerDoomSeeker", 0, 0, 0, 0);
			A_FireCustomMissile ("UnmakerDoomSeeker", 10, 0, 0, 0);
			A_FireCustomMissile ("UnmakerDoomSeeker", -10, 0, 0, 0);
			}
		HG2G J 10 { PB_FireOffset; }
		TNT1 A 0 A_Refire("SeekerAltFireHoldIII")
		Goto Ready3
	SeekerAltFireHoldIII:
		HG2G J 1 BRIGHT 
		TNT1 A 0 A_Playsound("weapons/bh_secondary", 1, 1, 0)
		TNT1 A 0 A_TakeInventory("PB_DTech", 10,TIF_NOTAKEINFINITE)
		HG2G J 2 BRIGHT {
			PB_FireOffset;
			A_FireCustomMissile ("UnmakerDoomSeeker", 0, 0, 0, 0);
			A_FireCustomMissile ("UnmakerDoomSeeker", 15, 0, 0, 0);
			A_FireCustomMissile ("UnmakerDoomSeeker", -15, 0, 0, 0);
			}
		HG2G J 10 { PB_FireOffset; }
		TNT1 A 0 A_Refire("SeekerAltFireHold")
		Goto Ready3
	NoAmmo:
		HG2G A 1 A_PlaySound ("Dryfire/Laser", 65)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		UNHG A 0 A_StopSOund(11)
		UNHG A 0 A_StopSOund(6)
		UNHG A 0 A_PlaySOund("UNMSTO", 1)
		Goto RealReady
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		HG2U CB 2
		HG2U A 7
		HG2U ABC 2
		Stop
	FlashKicking:
		HG2U CB 2
		HG2U A 7
		HG2U ABC 2
		Goto Ready3
	FlashAirKicking:
		HG2U CB 2
		HG2U A 9
		HG2U ABC 2
		Goto Ready3
	FlashSlideKicking:
	FlashSlideKickingStop:
		HG2U CB 2
		HG2U AAAAAAAAA 2
		HG2U ABC 1
		Goto Ready3

	Spawn:
		HFG2 A -1
		Stop
	}
}
Actor SSModII : Inventory { Inventory.MaxAmount 1 }

Actor UnmakerLaser2: UnmakerLaser
{
	decal "none"
	states
		{
		Spawn:
			LEYS R 1 BRIGHT
			Loop
	Death:
	XDeath:
		TNT1 A 0 A_explode(20, 100)
		Stop
		}
	}	
ACTOR SatanScreamLaserTrail
{
  Scale 0.1
  +NOCLIP
  +NOGRAVITY
  +THRUGHOST
  States
  {
  Spawn:
	LENR A 1  A_FadeOut(0.02)
	Loop
  }
}

ACTOR SatanScreamPuff: BulletPuff
{
  alpha 1
  Scale 0.5
  renderstyle ADD
  +NOBLOCKMAP
  +NOGRAVITY
  +NOEXTREMEDEATH
  +FORCEXYBILLBOARD
  +NOBLOOD
  +PUFFONACTORS
  +EXTREMEDEATH
  +ALWAYSPUFF
  -NOEXTREMEDEATH
  Decal "UnmakerBeamScorch"
  States
  {
  Spawn:
	TNT1 A 0 A_Jump(256, "Decal1", "Decal2")
  Melee:
	TNT1 A 0 A_Jump(256, "Decal1", "Decal2")
  
  Decal1:
    UNPF AB 3 
	Stop
  
  Decal2:
    UNPF CDE 2 
	Stop
  }
}


ACTOR SatanScreamLaserSpark
{ 
    RenderStyle Add
    Scale 0.0125
    Alpha 0.95
    +NOINTERACTION
    +NOGRAVITY
    +CLIENTSIDEONLY
    States
    {
    Spawn:
	YHE5 A 0 NoDelay A_JumpIf(ScaleX <= 0, "NULL")
	YHE5 A 0 A_SetScale(ScaleX-0.00075)
    YHE5 A 3  A_ChangeVelocity (frandom(-0.03, 0.03), frandom(-0.03, 0.03), frandom(-0.03, 0.03), 0)
    YHE5 A 1  A_FadeOut(0.05)
    Stop
    }
}
