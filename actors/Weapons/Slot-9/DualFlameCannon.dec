Actor RespectDualFlameCannon: Inventory
{
Inventory.MaxAmount 1
}

ACTOR DualFlameCannon : PB_WeaponBase
{
	Game Doom
   SpawnID 5019
	Weapon.BobRangeX 0.3
	Weapon.BobRangeY 0.5
	Weapon.BobStyle InverseSmooth
	Weapon.BobSpeed 2.4
	Height 20
	Weapon.AmmoUse 0
	Weapon.AmmoGive 50
	Weapon.AmmoType "PB_Fuel"
   Inventory.PickupSound "FLMDRAW"
	+WEAPON.NOAUTOFIRE
   +WEAPON.NOAUTOAIM
	+WEAPON.CHEATNOTWEAPON
	+INVENTORY.ALWAYSPICKUP
	+FORCEXYBILLBOARD
	+FLOORCLIP
	+DONTGIB
	Inventory.PickupMessage "Dual Mancubus Flame Cannons (monster drop)"
	// Weapon.SlotNumber 8
   Weapon.SelectionOrder 5550
	Scale 0.9
	Tag "Dual Mancubus Flame Cannons"
	Inventory.AltHudIcon "MANAH0"
	PB_WeaponBase.RespectItem "RespectDualFlameCannon"
   FloatBobStrength 0.5
	States
	{
    Spawn:
        MANA H -1
        Stop

	Steady:
	TNT1 A 1
	Goto Ready

	Ready:
		TNT1 A 0
		TNT1 A 0 { PB_RespectIfNeeded; }
	WeaponRespect:
		TNT1 A 0 A_PlaySound("FLMDRAW")
		MARR ABCD 1 A_DoPBWeaponAction
	   MARM GHI 1 A_DoPBWeaponAction
		MAR2 ABCDEFGH 2 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySound("HRSteam", 6)//FLMDRAW
		TNT1 AAAAA 0 A_FireCustomMissile("GunFireSmoke", random(-5,5), 0, random(-3,3),random(-12,-5))
		TNT1 A 0 A_FireCustomMissile("MancubusSwitchModeEffect", 0, 0, 0, random(-12,-5))
		TNT1 AAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-5,5), 0, random(-3,3),random(-12,-5))
		MAR2 IJJJ 2 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySound("FLMDRAW", 7)
		MAR2 HGFEDCBA 2 A_DoPBWeaponAction
		Goto Ready3
	SelectAnimation:
        TNT1 A 0 A_PlaySound("FLMDRAW")
		MARR ABCD 1 {
			if(CountInv("DaedabusSlimeSelected") == 1) {A_SetWeaponSprite("FVMS"); }
			}
        TNT1 AAAAAAAA 0
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
				Goto Ready3
	ReadySettle:
	Ready3:
    		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("PB_Fuel", 4, 1)
		Goto NoAmmo
		TNT1 A 0
        	TNT1 A 0 A_PlaySound("FLMRIDL",6,1,1)	
		TNT1 A 0 A_JumpIfInventory("DaedabusSlimeSelected", 1, "Ready2")
	    	MARM GHI 1 A_DoPBWeaponAction
	    Goto Ready3

	Ready2:
        	TNT1 AAA 0
		TNT1 A 0 A_JumpIfInventory("PB_Fuel", 4, 1)
		Goto NoAmmo
        	TNT1 A 0 A_PlaySound("FLMRIDL",6,1,1)
	    MARM JKL 1 A_DoPBWeaponAction
	    Goto Ready2

	WeaponSpecial:
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility", 1)
		TNT1 A 0 A_JumpIfInventory("DaedabusSlimeSelected", 1, "DeselectSlime")
		TNT1 A 0 A_GiveInventory("DaedabusSlimeSelected", 1)
		TNT1 A 0 A_Print("Firemode: \cdDaedabus Slime")
		TNT1 A 0 A_PlaySound("FLMSWTC", 3)//FLMDRAW
		MAR2 ABCDEFGH 2
		TNT1 A 0 A_PlaySound("HRSteam", 6)//FLMDRAW
		TNT1 A 0 A_FireCustomMissile("DaedabusSwitchModeEffect", 0, 0, 0, random(-12,-5))
		TNT1 AAAAA 0 A_FireCustomMissile("GunFireSmoke", random(-5,5), 0, random(-3,3),random(-12,-5))
		TNT1 AAAAA 0 A_FireCustomMissile("PlasmaParticle", random(-5,5), 0, random(-3,3),random(-12,-5))
		MAR2 IJJJ 2 
		TNT1 A 0 A_PlaySound("FLMDRAW", 7)
		MAR2 HGFEDCBA 2
		Goto Ready2

	DeselectSlime:
		TNT1 A 0 A_TakeInventory("DaedabusSlimeSelected", 1)
		TNT1 A 0 A_Print("Firemode: \ciMancubus Flame")
		TNT1 A 0 A_PlaySound("FLMSWTC", 3)//FLMDRAW
		MAR2 ABCDEFGH 2
		TNT1 A 0 A_PlaySound("HRSteam", 6)//FLMDRAW
		TNT1 AAAAA 0 A_FireCustomMissile("GunFireSmoke", random(-5,5), 0, random(-3,3),random(-12,-5))
		TNT1 A 0 A_FireCustomMissile("MancubusSwitchModeEffect", 0, 0, 0, random(-12,-5))
		TNT1 AAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-5,5), 0, random(-3,3),random(-12,-5))
		MAR2 IJJJ 2 
		TNT1 A 0 A_PlaySound("FLMDRAW", 7)
		MAR2 HGFEDCBA 2
		Goto Ready3

	DryFire:
		TNT1 A 0 A_PlaySound("HRSteam")//FLMDRAW
		TNT1 AAAA 0 A_FireCustomMissile("GunFireSmoke", random(-5,5), 0, random(-3,3),random(-4,-2))
	    MAR2 ABCDBAAA 2 //A_PlaySound("weapons/empty")
	NoAmmo:
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_StopSound(3)
		TNT1 A 0 A_StopSound(2)
		TNT1 A 0 A_ZoomFactor(1.0)
		MARM Z 1 A_DoPBWeaponAction
		TNT1 A 0 A_JumpIfInventory("PB_Fuel", 4, 1)
		Loop
		TNT1 A 0
		Goto Ready3

	Deselect:
	TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
	TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
	TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
	TNT1 A 0 {
				A_WeaponOffset(0,32);
				A_SetRoll(0);
				PB_HandleCrosshair(39);
				A_TakeInventory("PB_LockScreenTilt",1);
			}
	    TNT1 A 0 A_StopSound(CHAN_WEAPON)
	    TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_JumpIfInventory("GotMeatShield", 1, "GrabEnemy")
		TNT1 A 0 {
			if(CountInv("DaedabusSlimeSelected") == 1) {A_SetWeaponSprite("FVMS"); }
			}
		Goto DeselectDown
	DeselectDown:
				TNT1 A 0 A_Lower(120)
		Wait

	Select:
    TNT1 A 0 {
				A_WeaponOffset(0,32);
				A_SetRoll(0);
				PB_HandleCrosshair(39);
				A_TakeInventory("PB_LockScreenTilt",1);



			}
	TNT1 A 0 A_TakeInventory("HasBarrel",1)
	TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
	TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
	TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
	TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
	TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
	Goto SelectFirstPersonLegs
  SelectContinue:
		TNT1 A 0 PBWP_EnsureMonsterDurability("DualFlameCannonDurability", 60)
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
				Goto Ready3

	AltFire:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_WeaponOffset(0,32)
        TNT1 A 0 A_JumpIfInventory("PB_Fuel", 15, "Fireball")
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		Goto DryFire

	Fireball:	
        MARM A 1 BRIGHT A_FireCustomMissile("BigFireBall_II", 0, 1, 0, 0)
		TNT1 A 0 A_TakeInventory("PB_Fuel", 15)
		TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
        MARM BC 1 BRIGHT 
        MARM CD 1 
		MARM A 10
		Goto Ready3

	////////////////////////////////////////////////////////
	Fire:
		TNT1 A 0 PBWP_MonsterDurabilityFireGate("DualFlameCannonDurability", "DualFlameCannon")
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "ThrowBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "ThrowFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "ThrowIceBarrel")
		TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			A_SetCrosshair(39);
		}
	TNT1 A 0 { return PB_FireExecuteCheck(); }

		TNT1 A 0 A_JumpIfInventory("DaedabusSlimeSelected", 1, "FireSlime")
        TNT1 A 0 A_JumpIfInventory("PB_Fuel",15,4)
		Goto DryFire
        TNT1 AAAA 0
		TNT1 A 0 A_StopSound(6)
        TNT1 A 0 A_TakeInventory("PB_Fuel",15)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_ZoomFactor(0.97)
        MARM A 2 BRIGHT A_FireCustomMissile("BigFireBall_II", 0, 1, 0, 0)
		TNT1 A 0 A_ZoomFactor(1.0)
	    TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
		TNT1 AAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-17,17), 0, -1, random(-12,12))
		TNT1 A 0 { PB_WeaponRecoil(-3.2, 0); }

        MARM BCD 2 BRIGHT
        MARM EF 2
	    MARM GHI 2
		MARM A 0 { PB_ReFire; }
	    Goto Ready3

	FireSlime:
		TNT1 A 0 A_JumpIfInventory("PB_Fuel",10,4)
		Goto DryFire
        TNT1 AAAA 0
		TNT1 A 0 A_StopSound(6)
        TNT1 A 0 A_TakeInventory("PB_Fuel",10)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 //A_PlaySound("BIOSHOOT", CHAN_WEAPON)
		TNT1 A 0 A_ZoomFactor(0.97)
        MARM G 2 BRIGHT A_FireCustomMissile("DaedabusWithGravity", 0, 1, 0, 0)
		TNT1 AAAAA 0 BRIGHT A_FireCustomMissile("PlasmaParticle", random(-17,17), 0, -1, random(-9,9))
		TNT1 A 0 A_ZoomFactor(1.0)
	    TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
	    TNT1 A 0 { PB_WeaponRecoil(-3.2, 0); }

        MARM HIJ 2 BRIGHT
        MARM KL 2
	    MARM JKL 1
		MARM A 0 { PB_ReFire; }
	    Goto Ready3


   AltFire:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_JumpIfInventory("DaedabusSlimeSelected", 1, "AltFireSlime")
        TNT1 A 0 A_JumpIfInventory("PB_Fuel",4,2)
		Goto DryFire
        TNT1 AAAA 0
        TNT1 A 0 A_TakeInventory("PB_Fuel",4)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_ZoomFactor(0.925)
		TNT1 A 0 A_PlaySoundEx("FLMRST1", CHAN_WEAPON)
		MARM A 1 BRIGHT
		MARM B 1 BRIGHT A_FireCustomMissile("FlamethrowerMissileNew", 0, 1, 0, -1)
        MARM Z 1 BRIGHT
		TNT1 A 0 A_ZoomFactor(1.0)
   AltHold:
        TNT1 A 0 A_JumpIfInventory("PB_Fuel",4,3)
		TNT1 A 0 A_StopSoundEx("Weapon")
		TNT1 A 0 A_PlaySoundEx("FLMREND", CHAN_WEAPON)
		Goto StopFlamer
        TNT1 A 0 A_TakeInventory("PB_Fuel",4)
		TNT1 A 0 A_AlertMonsters
        MARM Y 1 BRIGHT
		TNT1 AAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-17,17), 0, -1, random(-12,9))
		TNT1 A 0 A_FireCustomMissile("FlamethrowerMissileNew", 0, 1, 0, -1)
        MARM X 1 BRIGHT
		TNT1 AAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-17,17), 0, -1, random(-12,9))
		TNT1 A 0 A_FireCustomMissile("FlamethrowerMissileNew", 0, 1, 0, -1)
        MARM Z 1 BRIGHT
		TNT1 A 0 A_PlaySoundEx("FLMRLOP", CHAN_WEAPON,1)
		TNT1 A 0 { PB_ReFire("AltHold"); }
		TNT1 A 0 A_StopSoundEx("Weapon")
		TNT1 A 0 A_PlaySoundEx("FLMREND", CHAN_WEAPON)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 { PB_ReFire("AltHold"); }
        Goto StopFlamer

	AltFireSlime:
		TNT1 A 0 A_JumpIfInventory("PB_Fuel",4,4)
		Goto NoAmmo
        TNT1 AAAA 0
        TNT1 A 0 A_TakeInventory("PB_Fuel",4)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_StopSound(2)
		TNT1 A 0 A_Playsound("FLMrStr", 6)
		TNT1 A 0 A_ZoomFactor(0.925)
		MARM F 1 BRIGHT
		TNT1 A 0 A_PlaySound("acid/spew", 3, 1, 1)
		MARM G 1 BRIGHT A_FireCustomMissile("GreenCloudMissile", 0, 1, 0, -5)

        MARM H 1 BRIGHT
   SlimeHold:
        TNT1 A 0 A_JumpIfInventory("PB_Fuel",5,2)
		Goto StopAcid
        TNT1 AAAA 0
        TNT1 A 0 A_TakeInventory("PB_Fuel",4)
		TNT1 A 0 A_AlertMonsters
        MARM I 1 BRIGHT
		TNT1 AAA 0 BRIGHT A_FireCustomMissile("PlasmaParticle", random(-17,17), 0, -1, random(-9,9))
		TNT1 A 0 A_FireCustomMissile("GreenCloudMissile", 0, 0, 0, -5)
        MARM H 1 BRIGHT
		TNT1 A 0 { PB_ReFire("SlimeHold"); }
		TNT1 A 0 A_ZoomFactor(1.0)
        Goto StopAcid

	StopAcid:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_StopSound(3)
		TNT1 A 0 A_JumpIfInventory("PB_Fuel",5,1)
		Goto DryFire
		TNT1 A 0
		TNT1 A 0 A_PlaySound("acid/spewstop ", 2)
		TNT1 AAAAA 0 A_FireCustomMissile("GunFireSmoke", random(-5,5), 0, random(-3,3),random(-5,-2))
		TNT1 AAAA 0 A_FireCustomMissile("PlasmaParticle", random(-5,5), 0, random(-3,3),random(-5,-2))
		MARM H 2 BRIGHT A_FireCustomMissile("GreenCloudMissile", 0, 0, 0, 5)
		MARM J 2 BRIGHT A_FireCustomMissile("GreenCloudMissile", 0, 0, 0, 5)
		MARM KL 1
		Goto Ready2

	StopFlamer:
		TNT1 A 0 A_JumpIfInventory("PB_Fuel",4,3)
		Goto DryFire
		MARM A 1 BRIGHT A_FireCustomMissile("FlamethrowerMissileNew", 0, 1, 0, 1)
		MARM B 1 BRIGHT A_FireCustomMissile("FlamethrowerMissileNew", 0, 1, 0, 0)
		TNT1 AAAAA 0 A_FireCustomMissile("GunFireSmoke", random(-5,5), 0, random(-3,3),random(-5,-2))
		MARM CD 1 BRIGHT
		MARM EF 1 
		Goto Ready3
	Reload:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory ("HasBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory ("HasFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("HasIceBarrel", 1, "IdleIceBarrel")
		Goto Ready3

	FlashPunching:
		 TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		 TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		 TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		 MAR2 A 0 A_JumpIfInventory("DaedabusSlimeSelected",1,2)
		 MARM A 0
		"####" A 1 A_OverlayOffset(PSP_WEAPON,0,0)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" B 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" C 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" D 1 A_OverlayOffset(PSP_WEAPON,-48,20)
		"####" D 1 A_OverlayOffset(PSP_WEAPON,-46,18)
		"####" D 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" D 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" C 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" B 1 A_OverlayOffset(PSP_WEAPON,0,0)
		 MARM A 1 {
			if(CountInv("DaedabusSlimeSelected") == 1) {A_SetFlashWeaponSprite("MAR2 AABCDDDDCBA 0"); }
			}
		 Stop

	FlashPunchingStop:
		MAR2 A 0 A_JumpIfInventory("DaedabusSlimeSelected",1,2)
		MARM GHI 0 {
			if(CountInv("DaedabusSlimeSelected") == 1) {A_SetFlashWeaponSprite("MAR2A0"); }
			}
	     Stop

  //Used A_OverlayOffset so the kicking animation doesn't mess up
	FlashKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		MAR2 A 0 A_JumpIfInventory("DaedabusSlimeSelected",1,2)
		MARM A 0
		"####" A 1 A_OverlayOffset(PSP_WEAPON,0,0)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" A 3 A_OverlayOffset(PSP_WEAPON,-48,20)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-46,18)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,0,0)
		 MARM A 2 {
			if(CountInv("DaedabusSlimeSelected") == 1) {A_SetFlashWeaponSprite("MARM"); }
			}
		Stop

	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		MAR2 A 0 A_JumpIfInventory("DaedabusSlimeSelected",1,2)
		MARM A 0
		"####" A 1 A_OverlayOffset(PSP_WEAPON,0,0)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" A 3 A_OverlayOffset(PSP_WEAPON,-48,20)
		"####" A 2  A_OverlayOffset(PSP_WEAPON,-46,18)
		"####" A 1  A_OverlayOffset(PSP_WEAPON,-42,16)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,0,0)
		MARM A 2  {
			if(CountInv("DaedabusSlimeSelected") == 1) {A_SetFlashWeaponSprite("MARM"); }
			}
		Stop
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		MAR2 A 0 A_JumpIfInventory("DaedabusSlimeSelected",1,2)
		MARM A 0
		"####" A 1 A_OverlayOffset(PSP_WEAPON,0,0)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" A 13 A_OverlayOffset(PSP_WEAPON,-48,20)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-46,18)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,0,0)
		 MARM A 2 {
			if(CountInv("DaedabusSlimeSelected") == 1) {A_SetFlashWeaponSprite("MARM"); }
			}
		Stop
	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKickingStop")
		MAR2 A 0 A_JumpIfInventory("DaedabusSlimeSelected",1,2)
		MARM A 0
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-46,18)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-36,15)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-24,10)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,-12,5)
		"####" A 1 A_OverlayOffset(PSP_WEAPON,0,0)
		MARM A 2 {
			if(CountInv("DaedabusSlimeSelected") == 1) {A_SetFlashWeaponSprite("MARM"); }
			}
		Stop

	// PDA weapon codex preview strips (PB_Staging_PDA PBPDA.zc expects these labels)
	PDA_Preview_DFC_FireBurst:
		MARM A 2
		MARM B 2
		MARM C 2
		Stop
	PDA_Preview_DFC_Slime:
		MARM A 2
		MARM B 2
		Stop
	PDA_Preview_DFC_AltStream:
		MARM D 2
		MARM E 2
		Stop
	PDA_Preview_DFC_AltSlime:
		MARM C 2
		MARM D 2
		Goto HideWeaponDuringAction
	}
}
