Actor NuclearMushroom
{
   Radius 8
   Height 40
   PROJECTILE
   RENDERSTYLE Add
   DamageType Burn
   ALPHA 0.99
   DONTHURTSHOOTER
   +NOCLIP
   +NOGRAVITY
   +NOEXPLODEFLOOR
   +NODAMAGETHRUST
   +THRUGHOST
   Scale 6.0
   States
   {
   Spawn:
      BFE1 ABCDEFGHIJKL 4 BRIGHT
      Stop
   }
}

