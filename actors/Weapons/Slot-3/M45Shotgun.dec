Actor M45Halo3ShotgunFired: Inventory {Inventory.MaxAmount 200}

Actor RespectM45Shotgun: Inventory {Inventory.MaxAmount 1}

Actor HaloShotgunWasEmpty : Inventory {Inventory.MaxAmount 1}

Actor M45Shotgun : PB_Weapon
{
 //$Title Rifle
 //$Category Weapons
 //$Sprite SY0SA0
	SpawnID 2900
    Weapon.BobRangeX 0.3
    Weapon.BobRangeY 0.5
    Weapon.BobStyle InverseSmooth
    Weapon.BobSpeed 2.0
	Weapon.AmmoUse1 0
	Weapon.AmmoGive1 5
	Weapon.AmmoUse2 0
	Weapon.AmmoGive2 0
	Weapon.AmmoType1 "PB_Shell"
	Weapon.AmmoType2 "HaloShotgunAmmo"
	Inventory.PickupMessage "You got the M45 Halo 3 Shotgun. (Slot 3)!"
    Inventory.PickupSound "HaloSelect"
	Obituary "Outgunned. Outmatched. Dead Men Walking!"
   +WEAPON.NOALERT
   +WEAPON.NOAUTOAIM
   +WEAPON.NOAUTOFIRE
   +WEAPON.WIMPY_WEAPON
   +DONTGIB
	Weapon.SlotNumber 3
    Weapon.SlotPriority 5
	Weapon.SelectionOrder 1300
	Scale 0.9
	Tag "M45 Halo 3 Shotgun"
	Inventory.AltHudIcon "SY0SG0"
	PB_WeaponBase.RespectItem "RespectM45Shotgun"
	FloatBobStrength 0.5
	PB_WeaponBase.OffsetRecoilX 2.5
	PB_WeaponBase.OffsetRecoilY 2.5
	States
	{
  Steady:
	 TNT1 A 0
	 Goto Ready

  Ready:
	 TNT1 A 0
	 TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
	 TNT1 A 0 PB_RespectIfNeeded
  WeaponRespect:
	 TNT1 A 0 {
		  A_GiveInventory("RespectM45Shotgun",1);
		  A_GiveInventory ("HaloShotgunAmmo", 13);
		  A_GiveInventory("PB_LockScreenTilt",1);
		  A_PlaySound("HaloSelect");
		  }
	 SY0S FE 1 {
		  A_SetRoll(roll-1.5,SPF_INTERPOLATE);
		  return A_DoPBWeaponAction(WRF_NOFIRE);
		  }
	 SY0S DCB 1 {
		  A_SetRoll(roll-1.5,SPF_INTERPOLATE);
		  return A_DoPBWeaponAction(WRF_NOFIRE);
		  }
	 SY0S AAAAAA 3 {
		  A_SetRoll(0);
		  return A_DoPBWeaponAction(WRF_NOFIRE);
		  }
	 SY0P A 0 A_PlaySound("HaloPump", 6)
	 SY0P BCDEFGHH 1 {
		  A_SetRoll(roll-0.5,SPF_INTERPOLATE);
		  return A_DoPBWeaponAction(WRF_NOFIRE);
		  }
	 SY0P HHHIJKLLLLMNO 1 {
		  A_SetRoll(roll+2.0,SPF_INTERPOLATE);
		  return A_DoPBWeaponAction(WRF_NOFIRE);
		  }
	 SY0P PQRSTUV 1 {
		  A_SetRoll(roll-1.0,SPF_INTERPOLATE);
		  return A_DoPBWeaponAction(WRF_NOFIRE);
		  }
	 TNT1 A 0
	 Goto Ready3
  SelectAnimation:
	 TNT1 A 0 {
		  A_WeaponOffset(0,32);
		  A_SetRoll(0);
		  A_TakeInventory("PB_LockScreenTilt",1);
		  }
	 TNT1 A 0 A_PlaySound("HaloSelect",6)
	 SY0S FEDCB 1 {
	      return A_DoPBWeaponAction(WRF_NOFIRE);
		  }
	 TNT1 A 0
	 TNT1 A 0 A_JumpIfInventory("GoFatality",1,"Steady")
  Ready3:
	 TNT1 A 0 {
		  A_WeaponOffset(0,32);
		  A_SetRoll(0);
		  PB_HandleCrosshair(46);
		  A_TakeInventory("PB_LockScreenTilt",1);
		  }
	 TNT1 A 0
  M45Halo3ShotgunReadyToFire:
	 SY0S A 1 {
		  if (CountInv("M45Halo3ShotgunFired") >= 60) { A_GunFlash("M45Halo3ShotgunBarrelSmoke");
		  }
		  if (PressingFire() && CountInv("HaloShotgunAmmo") > 0){
		  return state("Fire");
		  }
		  return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
		  }
	 TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
	 Loop
  M45Halo3ShotgunBarrelSmoke:
	 TNT1 A 0 {
		  A_FireCustomMissile("GunBarrelSmoke", 0, 0, 0, 0, 0, 0);
		  A_TakeInventory("M45Halo3ShotgunFired",1);
		  }
	 TNT1 A 0
	 Stop

  Deselect:
	 TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
	 TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
	 TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
	 TNT1 A 0 {
		  A_WeaponOffset(0,32);
		  A_SetRoll(0);
		  PB_HandleCrosshair(46);
		  A_TakeInventory("PB_LockScreenTilt",1);
		  }
	 TNT1 A 0 A_ZoomFactor(1.0)
	 TNT1 A 0 OffSet(0,32)
	 TNT1 A 0 A_Takeinventory("Zoomed",1)
	 TNT1 A 0 A_Takeinventory("ADSmode",1)
	 SY0S BCDEF 1
	 TNT1 A 1 A_Lower
	 Wait
    
  Select:
	 TNT1 A 0 {
		  A_WeaponOffset(0,32);
		  A_SetRoll(0);
		  PB_HandleCrosshair(46);
		  A_TakeInventory("PB_LockScreenTilt",1);
		  }
	 TNT1 A 0 A_TakeInventory("HasBarrel",1)
	 TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
	 TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
	 TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
	 TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
	 TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
	 Goto SelectFirstPersonLegs
	 SelectContinue:
	 TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
     Goto Ready3

  Fidget:
	 SY0P A 0 A_PlaySound("HaloPump")
	 SY0P BCDEFGHH 1
	 SY0P HHHIJKLLLLMNO 1 A_DoPBWeaponAction
	 SY0P PQRSTUV 1 A_DoPBWeaponAction 
	 SHTN A 0 A_TakeInventory("Reloading",1)
	 Goto M45Halo3ShotgunReadyToFire

  Fire:
	 TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "ThrowBarrel")
	 TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "ThrowFlameBarrel")
	 TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "ThrowIceBarrel")
		TNT1 A 0 { return PB_FireExecuteCheck(); }
	 TNT1 A 0 {
		  A_WeaponOffset(0,32);
		  A_SetRoll(0);
		  PB_HandleCrosshair(46);
		  A_TakeInventory("PB_LockScreenTilt",1);
		  }
	 TNT1 A 0 Offset(0,32)
     SHTN A 0 A_TakeInventory("Reloading",1)
	 SHTN A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
     SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",1,2)
     Goto NoAmmo
     TNT1 AAAA 0
	 SHTN A 0 A_JumpIfInventory("HaloShotgunWasEmpty", 1, "Pump2")
	 SHTN A 0 A_ZoomFactor(0.96)
     SHTN A 0 A_PlaySound("HaloFire", 1)
     SHTN A 0
	 SY0F B 0 A_SetPitch(-6.0 + pitch, SPF_INTERPOLATE)
	 SY0F B 1 Bright {
	      A_SpawnItemEx("PlayerMuzzle1",30,5,30);
		  A_FireCustomMissile("YellowFlareSpawn",0,0,0,0);
		  A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0);
		  A_FireCustomMissile("ShotgunParticles", random(-12,12), 0, -1, 0, 0, random(-9,9));
	      A_FireCustomMissile("ShotgunParticles2", random(-12,12), 0, -1, 0, 0, random(-9,9));
		  A_FireCustomMissile("Tracer", random(-3,3), 0, 0, -12, 0, random(-3,3));
		  A_FireBullets (6, 2, 5, 13, "ShotgunPuff", FBF_NORANDOM);
		  A_AlertMonsters;
		  A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 0, 0, 0);
	      A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 0, 0, 0);
		  A_GiveInventory("M45Halo3ShotgunFired",20);
		  A_GunFlash;
		  }
	 SHTN A 0 A_TakeInventory("HaloShotgunAmmo",1)
	 SHTN A 0 A_ZoomFactor(1.00)
	 SY0F C 1 A_SetPitch(+1.0 + pitch, SPF_INTERPOLATE)
	 SY0F DE 1 A_SetPitch(+1.0 + pitch, SPF_INTERPOLATE)
	 SY0F F 1 A_SetPitch(+3.0 + pitch, SPF_INTERPOLATE)
	 SY0F GHH 1
	 Goto Pump1

   Pump1:	
	   SHTN A 0
	   SHTN A 0 A_GiveInventory ("Pumping", 1)
	   SHTN A 0 A_GiveInventory ("GoSpecial", 1)
	   SY0P A 0 A_PlaySound("HaloPump", 3)
	   SY0P ABCDEF 1 
	   SY0P GHHHHH 1 
	   SY0P I 1
	   SHTN A 0 {
	        A_FireCustomMissile("ShotCaseSpawn",40,0,3,-26);
			}
	   SHTN A 0 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
	   SHTN A 0 A_JumpIfInventory("TurboReload", 1, "PumpNoReload")//Tactical Mode is slower to pump
	   SY0P JK 1 A_JumpIfInventory("Reloading",1,"InsertingShells")
	   SY0P LLLLM 1
	   SHTN A 0 A_TakeInventory("HaloShotgunWasEmpty",1)
	   SY0P NOP 1 A_JumpIfInventory("Reloading",1,"InsertingShells")
	   SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",1,5)
	   SHTN A 0 A_JumpIfInventory("TurboReload", 1, 4)
	   SHTN A 0 A_GiveInventory("HaloShotgunWasEmpty",1)
	   SHTN A 0
	   Goto InsertingShells
	   TNT1 AA 0
	   SY0P Q 1
	   SY0P RSTUVW 1
	   SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",1,2)
	   SHTN A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
	   SHTN A 0
	   Goto M45Halo3ShotgunReadyToFire

   Pump2:	
	   SHTN A 0
	   SHTN A 0 A_GiveInventory ("Pumping", 1)
	   SHTN A 0 A_TakeInventory("Reloading", 1)
	   SHTN A 0 A_TakeInventory("Zoomed",1)
	   SHTN A 0 A_ZoomFactor(1.0)
	   SYR3 B 0 A_PlaySound("HaloPump2", 3)
	   SYR3 ABCDEEEEFGHI 1
	   SHTN A 0 A_TakeInventory("HaloShotgunWasEmpty",1)
	   SHTN A 0
	   SYR3 JKLMNOP 1
	   Goto M45Halo3ShotgunReadyToFire

	PumpNoReload:	
	   SHTN IJ 1
	   SHTN KL 1
	   SHTN KJIH 1
	   SHTN A 0
	   SHTN A 0 A_TakeInventory("HaloShotgunWasEmpty",1)
	   SHTN GFEDC 1
	   SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",1,2)
	   SHTN A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
	   SHTN A 0
	   Goto M45Halo3ShotgunReadyToFire

	AltFire:
	   TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
	   TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
	   TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
	   TNT1 A 0 {
		    A_WeaponOffset(0,32);
		    A_SetRoll(0);
		    PB_HandleCrosshair(46);
		    A_TakeInventory("PB_LockScreenTilt",1);
		    }
	   RIFG A 0 A_JumpIfInventory("HaloShotgunAmmo",1,1)
	   Goto NoAmmo
	AltFireStacks:
		TNT1 A 0
		RIFG A 0 A_JumpIfInventory("HaloShotgunAmmo",1,3)
		Goto AltActualFire
        TNT1 AAAAAA 0
        SHTN A 0 {
             A_FireBullets (7, 4, 8, 11, "ShotgunPuff", FBF_NORANDOM);
			 A_FireBullets (7, 4, 8, 11, "ShotgunPuff", FBF_NORANDOM);
			 A_AlertMonsters;
			 A_FireCustomMissile("ShotCaseSpawn",40,0,3,-26);
			 A_GiveInventory("M45Halo3ShotgunFired",20);
		     A_GunFlash;
			 }
		SHTN A 0
		RIFG A 0 A_TakeInventory("HaloShotgunAmmo",1)
		Goto AltFireStacks
	AltActualFire:
        SHTN A 0 A_TakeInventory("Reloading",1)
        TNT1 AAAA 0
		SHTN A 0 A_ZoomFactor(0.96)
        SHTN A 0 A_PlaySound("HaloAlt", 1)
		SY0B B 0 A_SetPitch(-20.0 + pitch, SPF_INTERPOLATE)
		SY0B B 1 Bright {
		     A_SpawnItemEx("PlayerMuzzle1",30,5,30);
			 A_FireCustomMissile("YellowFlareSpawn",0,0,0,0);
		     A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0);
			 A_FireCustomMissile("ShotgunParticles", random(-12,12), 0, -1, 0, 0, random(-9,9));
		     A_FireCustomMissile("ShotgunParticles2", random(-12,12), 0, -1, 0, 0, random(-9,9));
		     A_FireCustomMissile("Tracer", random(-3,3), 0, 0, -12, 0, random(-3,3));
		     A_AlertMonsters;
			 A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 0, 0, 0);
			 A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 0, 0, 0);
			 }
		SHTN A 0 A_ZoomFactor(1.00)
		SY0B C 1
		SY0B CDEF 1 A_SetPitch(+4.0 + pitch, SPF_INTERPOLATE)
		SY0B GH 1 A_SetPitch(+2.0 + pitch, SPF_INTERPOLATE)
		SY0B IJK 1
		Goto NoAmmo2

    Reload:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
	    TNT1 A 0 {
		     A_Takeinventory("PB_LockScreenTilt",1);
		     }
	    TNT1 A 0
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_JumpIfInventory("PB_Shell", 1, 2)
		Goto NoAmmo
		SHTN A 0
	    SHTN A 0 A_TakeInventory("Zoomed",1)
        SHTN A 0 A_ZoomFactor(1.0)
		SYR1 A 1 A_DoPBWeaponAction
		SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",13,"Fidget")
		SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo", 1, "ReloadNormally")//Check if there is a shell in the chamber
		SHTN A 0 A_GiveInventory("HaloShotgunWasEmpty", 1)//This means there is no shell in the chamber

	ReloadNormally:	
        SHTN A 0 A_JumpIfInventory("PB_Shell",1,1)//If there is no reserve ammo, don't reload, go back to Ready
        Goto M45Halo3ShotgunReadyToFire
		SHTN A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		SYR1 B 1 A_GiveInventory ("Pumping", 1)
		SYR1 CDEFGH 1

	InsertingShells:
		SHTN A 0
		SHTN A 0 A_JumpIfInventory("PB_Shell",1,2)//if there are no more reserve shells, finish reload.
        Goto Pump2
		SHTN A 0
		SHTN A 0 A_GiveInventory ("Pumping", 1)
		SSHR A 0 A_TakeInventory("Reloading", 1)
        SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",13,"CheckIfFinishReload")
        SHTN A 0 A_GiveInventory("HaloShotgunAmmo",1)
		SHTN A 0 A_TakeInventory("PB_Shell",1)

	InsertShellAnimation:	
		SHTN A 0
		SYR2 A 0 A_PlaySound("HaloReload")
		SYR2 ABCDEFG 1
        SYR2 HHHIIJ 1
		SYR2 LKL 1 A_DoPBWeaponAction(WRF_NOBOB)
        SSHR A 0 A_JumpIfInventory("Reloading", 1, "Pump2")
		SHTN A 0
		SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",13,"FinishedInsertingShells")//If there are 8+1 shells, stop it immediately
        Goto InsertingShells

	CheckIfFinishReload:
		SYR2 A 1
		SHTN A 0 A_JumpIfInventory("HaloShotgunWasEmpty", 1, "FinishedInsertingShells")//If shotgun was empty, 
	  //Play the insert shell animation again, and insert the 9th shell
		SHTN A 0 A_JumpIfInventory("PB_Shell",1,1)//if there are no more reserve shells, finish reload.
        Goto Pump2
		SHTN A 0 A_GiveInventory("HaloShotgunAmmo",1)
		SHTN A 0 A_TakeInventory("PB_Shell",1)
        Goto InsertShellAnimation

	FinishedInsertingShells:
		SHTN A 0 A_TakeInventory("Reloading",1)
		SHTN A 0 A_JumpIfInventory("HaloShotgunWasEmpty", 1, "Pump2")
		SYR1 HGFEDCBA 1 A_DoPBWeaponAction
		SHTN A 0 A_TakeInventory("Reloading",1)
		TNT1 A 0 { PB_SetMagUnloaded(false); }
		Goto M45Halo3ShotgunReadyToFire
     
   //TurboReloads//
	 
	TurboReload:
		SHSS BC 0
	TurboBullets:	
		SHTN A 0
		SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",13,"FinishTurboReload")
        SHTN A 0 A_JumpIfInventory("PB_Shell",1,3)
        Goto FinishTurboReload
        TNT1 AAAA 0
        SHTN A 0 A_Giveinventory("HaloShotgunAmmo",1)
		SHTN A 0 A_Takeinventory("PB_Shell",1)
		Goto TurboBullets
	FinishTurboReload:
		SY0S A 1
		SY0S A 1 A_Refire
		Goto M45Halo3ShotgunReadyToFire

	Unload:
		SY0S A 1
		SHTN A 0 A_ZoomFactor(1.0)
		SHTN A 0 A_TakeInventory("Unloading",1)
		SHTN A 0 A_TakeInventory("ADSmode",1)
		SHTN A 0 A_TakeInventory("Zoomed",1)
		SHTN A 0 A_GiveInventory("HaloShotgunWasEmpty", 1)
        SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",1,3)
        Goto M45Halo3ShotgunReadyToFire
        TNT1 AAA 0
		SHTN A 0 A_TakeInventory("Zoomed",1)
		SHTN A 0 A_GiveInventory ("Pumping", 1)
		SHTN A 0 A_TakeInventory("Unloading",1)
		SYR1 ABCDEFGH 1 

	RemoveBullets:
		TNT1 AAAA 0
		SHTN A 0 A_JumpIfInventory("HaloShotgunAmmo",1,3)
		Goto FinishUnload
        TNT1 AAAAAA 0
		SHTN A 0 A_TakeInventory("HaloShotgunAmmo",1)
		SHTN A 0 A_GiveInventory("PB_Shell",1)
	    SYR3 B 0 A_PlaySound("HaloPump2", 3)
	    SYR3 ABCDEEEEFGHI 1
	    SHTN A 0 A_GiveInventory("HaloShotgunWasEmpty",1)
		Goto RemoveBullets

	FinishUnload:
		SYR3 JKLMNOP 1 
		TNT1 A 0 { PB_SetMagUnloaded(true); }
		SHTN A 0 A_TakeInventory("Unloading",1)
		Goto M45Halo3ShotgunReadyToFire

	NoAmmo:
		TNT1 A 0
		SY0S A 1 {
		     A_DoPBWeaponAction(WRF_NOFIRE);
			 A_ZoomFactor(1.0);
		     A_TakeInventory("Zoomed",1);
		     A_TakeInventory("ADSmode",1);
			 A_PlaySound("weapons/empty", 4);
			 }
		TNT1 A 0 A_JumpIfInventory("TurboReload",1,"TurboReload")
	NoAmmo2:
		TNT1 A 0
		SY0S A 3 {
		     A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOPRIMARY);
		     }
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("PB_Shell",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"NoAmmo2")
		TNT1 A 0 {
		     A_SelectWeapon("PB_Pistol");
			 }
		TNT1 A 0
		Goto M45Halo3ShotgunReadyToFire

	Spawn:
	    SY0S G 0 NoDelay
	    SY0S G 10 A_PbvpFramework("SY0S")
	   "####" A 0 A_PbvpInterpolate()
	    Loop

	WeaponSpecial:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
	    TNT1 A 0 {
		     A_WeaponOffset(0,32);
		     A_SetRoll(0);
		     A_TakeInventory("PB_LockScreenTilt",1);
		     A_Takeinventory("GoWeaponSpecialAbility",1);
		     }
	    TNT1 A 0 A_Print("No M45 Halo 3 Shotgun Special Available")
        Goto M45Halo3ShotgunReadyToFire

	FlashKicking:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelKicking")
	    TNT1 A 0 A_ClearOverlays(10,11)
		SYR1 A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		SYR1 B 1
		SYR1 C 1
		SYR1 D 1
		SYR1 E 1
		SYR1 F 1
		SYR1 G 1
		SYR1 H 6
		SYR1 G 1
		SYR1 F 1
		SYR1 E 1
		SYR1 D 1
		SYR1 C 1
		SYR1 B 1
		SYR1 A 1
		Goto M45Halo3ShotgunReadyToFire

	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelAirKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")	
	    TNT1 A 0 A_ClearOverlays(10,11)
		SYR1 A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		SYR1 B 1
		SYR1 C 1
		SYR1 D 1
		SYR1 E 1
		SYR1 F 1
		SYR1 G 1
		SYR1 H 7
		SYR1 G 1
		SYR1 F 1
		SYR1 E 1
		SYR1 D 1
		SYR1 C 1
		SYR1 B 1
		SYR1 A 1
		Goto M45Halo3ShotgunReadyToFire

	FlashSlideKicking:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
	    TNT1 A 0 A_ClearOverlays(10,11)
		SYR1 A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		SYR1 B 1
		SYR1 C 1
		SYR1 D 1
		SYR1 E 1
		SYR1 F 1
		SYR1 G 1
		SYR1 H 13
		SYR1 G 1
		SYR1 F 1
		SYR1 E 1
		SYR1 D 1
		SYR1 C 1
		SYR1 B 1
		SYR1 A 1
		Goto M45Halo3ShotgunReadyToFire

	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKickingStop")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKickingStop")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKickingStop")
	    TNT1 A 0 A_ClearOverlays(10,11)
		SY0S A 1 A_DoPBWeaponAction
		Goto M45Halo3ShotgunReadyToFire

	FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
	    TNT1 A 0 A_ClearOverlays(10,11)
		SY0P A 1 A_DoPBWeaponAction
		SY0P B 1
		SY0P C 1
		SY0P D 1
		SY0P E 1
		SY0P F 1
		SY0P G 1
		SY0P H 3
		SY0P G 1
		SY0P F 1
		SY0P E 1
		SY0P D 1
		SY0P C 1
		SY0P B 1
		SY0P A 1
		Stop

	FlashPunchingStop:
	    TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
	    TNT1 A 0 A_ClearOverlays(10,11)
		SY0P A 1 A_DoPBWeaponAction
		Stop
	}
}

Actor HaloShotgunAmmo : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 13
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 13
  +Inventory.IgnoreSkill
   Inventory.Icon "SY0SG0"
}