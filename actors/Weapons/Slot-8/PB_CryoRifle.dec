//////////////////////////////////////////////////////////////
///														   ///
///				  Freezer canon			       			   ///
///		script parts from BD's BFG10k & plasmagun		   ///
//////////////////////////////////////////////////////////////
ACTOR FreezerIsUnloaded : Inventory { Inventory.MaxAmount 1 }

ACTOR PB_CryoRifle : PB_Weapon
{
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive1 100
	Weapon.AmmoGive2 50
	Weapon.AmmoType1 "PB_Cell"
	Weapon.AmmoType2 "FreezerAmmo"
	Obituary "%o was put on ice by %k's FreezeThrower."
    Inventory.PickupSound "PLSDRAW"
	Inventory.Pickupmessage "Cryo Rifle / Freeze Thrower (Slot 8)"
	+WEAPON.NOAUTOAIM
	+WEAPON.NOALERT
	+WEAPON.NOAUTOFIRE
	+WEAPON.EXPLOSIVE
	+WEAPON.CHEATNOTWEAPON
	damagetype "Ice"
	Weapon.SelectionOrder 1550
	Inventory.AltHUDIcon "FRZRA0"
	Weapon.SlotNumber 8
	Weapon.SlotPriority 5
	Tag "TeiTenga Type B Freezer Thrower"
	States
	{
	Steady:
	TNT1 A 1
	Goto Ready
	SpawnSmoke:
	TNT1 A 8
	TNT1 A 0 A_FireCustomMissile("FrozenSmokeSpawner",0,0,-1,7)
	TNT1 A 8
	TNT1 A 0 A_FireCustomMissile("FrozenSmokeSpawner",0,0,-1,7)
	TNT1 A 8
	TNT1 A 0 A_FireCustomMissile("FrozenSmokeSpawner",0,0,-1,7)
	TNT1 A 8
	TNT1 A 0 A_FireCustomMissile("FrozenSmokeSpawner",0,0,-1,7)
	TNT1 A 8
	TNT1 A 0 A_FireCustomMissile("FrozenSmokeSpawner",0,0,-1,7)
	stop
	/*GrenadeThrowFlashNoAmmo:
		TNT1 A 0 A_JumpIfInventory("FreezerIsUnloaded",1,"GrenadeThrowFlashUnloaded")
	    FR1S JKLME 1 //A_DoPBWeaponAction(WRF_NOFIRE)
		TNT1 A 22
		 FR1S EMLKJ 1
		Stop
	GrenadeThrowFlashUnloaded:
	    FR1S FGHIE 1 //A_DoPBWeaponAction(WRF_NOFIRE)
		TNT1 A 22
		FR1S EIHGF 1
		Stop
	GrenadeThrowFlash:
	    RAIL A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"GrenadeThrowFlashNoAmmo")
        FR1S ABCDE 1 //A_DoPBWeaponAction(WRF_NOFIRE)
		TNT1 A 22
		FR1S EDCBA 1 //32 in total
		Stop*/
	FlashKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"KickingFlashNoAmmo")
		FR1K ABCD 1 A_DoPBWeaponAction
		FR1K EFGE 2 A_DoPBWeaponAction
		FR1K DCBA 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"AirKickingFlashNoAmmo")
		FR1K ABCD 1 A_DoPBWeaponAction
		FR1K EFGEF 2 A_DoPBWeaponAction
		FR1K DCBA 1 A_DoPBWeaponAction
		Stop
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"SlideKickingStartNoAmmo")
	    FR1K ABCD 1 A_DoPBWeaponAction
	    FR1K EEFFGGEEFFGGEEFFGGEEFFGGEEFFGGEEFFGG 1 A_DoPBWeaponAction
	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"SlideKickingEndNoAmmo")
		FR1K EEFFGG 1 A_DoPBWeaponAction
		FR1K DCBA 1 A_DoPBWeaponAction
		Stop
	KickingFlashNoAmmo:
	TNT1 A 0 A_JumpIf(CountInv("FreezerIsUnloaded")==1,"KickingFlashUnloaded")
	FR1K MNOP 1
	FR1K Q 8
	FR1K PONM 1 //16
	Goto Ready

	AirKickingFlashNoAmmo:
	TNT1 A 0 A_JumpIf(CountInv("FreezerIsUnloaded")==1,"AirKickingFlashUnloaded")
	FR1K MNOP 1
	FR1K Q 10
	FR1K PONM 1 //18
	Goto Ready
	 SlideKickingStartNoAmmo:
		TNT1 A 0 A_JumpIf(CountInv("FreezerIsUnloaded")==1,"SlideKickingStartUnloaded")
	    FR1K MNOP 1
	    FR1K QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ 1 { //39 total
			if (CountInv("Kicking") == 0) {
				return state("SlideKickingEnd");



			}
			return state("");


		}
		Goto Ready

	 SlideKickingEndNoAmmo:
		TNT1 A 0 A_JumpIf(CountInv("FreezerIsUnloaded")==1,"SlideKickingEndUnloaded")
		FR1K Q 6
		FR1K PONM 1
	    Goto Ready
	KickingFlashUnloaded:
	FR1K HIJK 1
	FR1K L 8
	FR1K KJIH 1 //16
	Goto Ready

	AirKickingFlashUnloaded:
	FR1K HIJK 1
	FR1K L 10
	FR1K KJIH 1 //18
	Goto Ready
	 SlideKickingStartUnloaded:
	    FR1K HIJK 1
	    FR1K LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 1 { //39 total
			if (CountInv("Kicking") == 0) {
				return state("SlideKickingEnd");



			}
			return state("");


		}
		Goto Ready

	 SlideKickingEndUnloaded:
		FR1K L 6
		FR1K KJIH 1
	    Goto Ready	
		Fuckyouflash:
	TNT1 A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"FuckyouNoAmmo")
	FR1K ABCD 1
	FR1K EFGEFGEFGFG 2
	FR1K DCBA 1 //30
	Stop
	fuckyouNoAmmo:
	TNT1 A 0 A_JumpIf(CountInv("FreezerIsUnloaded")==1,"fuckyouUnloaded")
	FR1K MNOP 1
	FR1K Q 22
	FR1K PONM 1 //30
	Stop
	FuckYouUnloaded:
	FR1K HIJK 1
	FR1K L 20
	FR1K KJIH 1 //28
	Stop
	//FuckYouFlash:
	//FR1K EFGHHIIJJHHIIHHIIJJHHIIJJGFE 1 //18
	//stop
	SelectAnimationNoAmmo:
		TNT1 A 0 A_JumpIfInventory("FreezerIsUnloaded",1,"SelectAnimationUnloaded")
	    FR1S EMLKJ 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3
	SelectAnimationUnloaded:
	    FR1S EIHGF 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3
	SelectAnimation:
	ReturnFromNothing:
	    RAIL A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"SelectAnimationNoAmmo")
        FR1S EDCBA 1 A_DoPBWeaponAction(WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("weapons/CryoRifle/up", 2)
		Goto Ready3

	Ready:
	Ready3:
		TNT1 A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"ReadyNoAmmo")
		RAIL A 0 A_PlaySound("PLSIDLE")
		FR1D ABC 2 {
			A_DoPBWeaponAction(WRF_ALLOWRELOAD);
			if (CountInv("GoFatality") == 1) { return state("Steady"); }
			if (CountInv("GoWeaponSpecialAbility") == 1) { return state("PlaceFreezeBot"); }
			if (CountInv("FreezerAmmo") == 0) { return state("ReadyNoAmmo"); }
			return state("");
		}
		FR1D ABC 2 {
			A_DoPBWeaponAction(WRF_ALLOWRELOAD);
			//if (CountInv("StartDualWield") == 1) { return state("DualWield"); }
			if (CountInv("GoFatality") == 1) { return state("Steady"); }
			if (CountInv("FreezerAmmo") == 0) { return state("ReadyNoAmmo"); }
			if (CountInv("GoWeaponSpecialAbility") == 1) { return state("PlaceFreezeBot"); }
			return state("");
		}
		Goto Ready3
	ReadyNoAmmo:
		FR1D T 0 A_JumpIf(CountInv("FreezerIsUnloaded")==1,"ReadyUnloaded")
		FR1D Q 1
		{
			A_DoPBWeaponAction(WRF_ALLOWRELOAD);
			//if (CountInv("StartDualWield") == 1) { return state("DualWield"); }
			if (CountInv("GoFatality") == 1) { return state("Steady"); }
			if (CountInv("GoWeaponSpecialAbility") == 1) { return state("PlaceFreezeBot"); }
			return state("");
		}
		loop
	ReadyUnloaded:
		FR1D T 1
		{
			A_DoPBWeaponAction(WRF_ALLOWRELOAD);
			//if (CountInv("StartDualWield") == 1) { return state("DualWield"); }
			if (CountInv("GoFatality") == 1) { return state("Steady"); }
			if (CountInv("GoWeaponSpecialAbility") == 1) { return state("PlaceFreezeBot"); }
			return state("");
		}
		Loop

	DontNeedToReload:
		RAIL A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
	Goto Ready+6
	Deselect:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		RAIL A 0 A_Takeinventory("HasFreezerWeapon",1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
        RAIL A 0 A_ZoomFactor(1.0)
		"####" A 0 A_ClearOverlays(-2,-2)
	    RAIL A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"DeselectNoAmmo")
				TNT1 A 0 A_Lower(120)
		Wait
	DeselectNoAmmo:
		TNT1 A 0 A_JumpIfInventory("FreezerIsUnloaded",1,"DeselectUnloaded")
	    FR1S JKLME 1
				TNT1 A 0 A_Lower(120)
		Wait
	DeselectUnloaded:
	    FR1S FGHIE 1
				TNT1 A 0 A_Lower(120)
		Wait
	Select:
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
		Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise("PLSDRAW"); }
		TNT1 A 0 { PB_WeapTokenSwitch("CryoRifleSelected"); }
		TNT1 A 0 PBWP_EnsureMonsterDurability("CryoRifleDurability", 45)
		TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
		Goto SelectAnimation
	NoAmmo:
		RIFG A 0
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_StopSound(1)
		TNT1 A 0 A_StopSound(7)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_PlaySound("weapons/empty", 4)
		NoAmmo2:
		R4FL T 0 A_JumpIfInventory("FreezerIsUnloaded",1,2)
	    RAIL Q 0
		FR1D "#" 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOFIRE)
		RIFG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RIFG A 0 A_JumpIfInventory("PB_Cell",1,"Reload")
		RIFG A 0 A_JumpIfInventory("FiredPrimary",1,"NoAmmo2")
		Goto Ready3
	Fire:
		TNT1 A 0 PBWP_MonsterDurabilityFireGate("CryoRifleDurability", "PB_CryoRifle")
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "ThrowBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "ThrowFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "ThrowIceBarrel")
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		RAIL A 0 A_JumpIfInventory("FreezerAmmo",1,2)
		Goto NoAmmo
		FR1D D 3
		FR1D E 1
	FireContinue:
		RAIL A 0 A_JumpIfInventory("FreezerAmmo",1,2)
		Goto NoAmmo
		FR1D EFF 1
		FR1D G 1
		RAIL A 0 A_Giveinventory("HasFreezerWeapon",1)
		RAIL A 0 A_TakeInventory("FreezerAmmo",1)
		RAIL A 0 A_PlaySound("weapons/CryoRifle/missile", CHAN_WEAPON)
		TNT1 AA 0 A_FireCustomMissile ("BluePlasmaParticleWeapon", random(-11,11), 0, -1, -3, 0, random(-7,14))
		FR1D H 1 BRIGHT A_FireCustomMissile("CryoShot", frandom(0.9,-0.9),0, 0, -3, 0)
	    //TNT1 A 0 A_FireCustomMissile ("PlasmaSmoke", 0, 0, 0, 2)
		FR1D I 1 BRIGHT A_SetPitch(-1.5 + pitch, SPF_INTERPOLATE)
		"####" A 0 A_WeaponOffset(random(-1,1),32+random(0,1) )
		FR1D JKM 1 A_SetPitch(0.5 + pitch, SPF_INTERPOLATE)
		"####" A 0 A_WeaponOffset(0,32)
		//RAIL A 0 A_PlaySound("weapons/CryoRifle/powerdown", CHAN_AUTO)
		TNT1 A 0 A_Refire
		TNT1 A 0 A_Takeinventory("HasFreezerWeapon",1)
		Goto Ready3
	AltFire:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
	    RAIL A 0
		RAIL A 0 A_JumpIfInventory("FreezerAmmo",1,2)
		Goto NoAmmo
		RAIL A 0 A_Giveinventory("HasFreezerWeapon",1)
		RAIL A 0 A_TakeInventory("FreezerAmmo",1)
		FLMT A 0 A_PlaySound("weapons/cryobowflyby", 1, 1, 1)
		TNT1 AA 0 A_FireCustomMissile ("BluePlasmaParticleWeapon", random(-45,45), 0, random(-2,2), random(-3,1), 0, random(-6,22))
		NULL A 0 A_WeaponOffset(random(1,-1),32+random(-1,1))
		FR1D R 1 BRIGHT A_FireCustomMissile("FreezeThrowerMissile", 0, 1, 0, -12, 0, 8)
		//RAIL A 0 A_Takeinventory("FreezerAmmo",1)
		NULL A 0 A_WeaponOffset(random(1,-1),32+random(-1,1))
		FR1D S 1 BRIGHT// A_FireCustomMissile("FreezeThrowerMissile", frandom(0.9,-0.9),0, 0, -3, 0)
		RAIL A 0 A_JumpIf(CountInv("FreezerAmmo")<1,"AltGoToNoAmmo")
		TNT1 AA 0	
		RAIL A 0 A_Refire
		NULL A 0 A_WeaponOffset(0,32)
		RAIL A 0 A_Takeinventory("HasFreezerWeapon",1)
		TNT1 A 0 A_StopSound(1)
		FLMT A 0 BRIGHT A_PlaySound("weapons/CryoRifle/powerdown", 1)
		//R4FF DCCCCCCCDEEFFG 1 BRIGHT
		FR1D KJJJKKLMNOPNOPNO 1 BRIGHT
		TNT1 A 0 A_Overlay(3, "SpawnSmoke")
		//RAIL A 0 A_JumpIfInventory("FreezerAmmo",0,"Reload")
		//TNT1 A 0 A_FireCustomMissile("FrozenSmokeSpawner",0,0,-1.5,7)
		Goto Ready3		
	GoToNoAmmo:
		TNT1 A 0 A_PlaySound("RAILRIP")
		FR1D NOP 1
		Goto Ready
	AltGoToNoAmmo:
		FLMT A 0 BRIGHT A_PlaySound("weapons/CryoRifle/powerdown", 1)
		FR1D KJJJKKLMNOPNOPNO 1 BRIGHT
		TNT1 A 0 A_Overlay(3, "SpawnSmoke")
		TNT1 A 0 A_PlaySound("RAILRIP")
		FR1D NOP 1
		Goto Ready
	Reload:	
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
        RAIL A 0 A_Takeinventory("Reloading",1)
		RAIL A 0 A_ZoomFactor(1.0)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_JumpIfInventory("FreezerAmmo",50,"Ready")
        RAIL A 0 A_JumpIfInventory("PB_Cell",10,3)
        Goto Ready+6
        TNT1 AAAA 0
		RAIL A 0 A_JumpIfinventory("FreezerIsUnloaded",1,"ReloadUnloaded")
		RAIL A 0 A_JumpIf(CountInv("FreezerAmmo")==0,"ReloadContinue")
		TNT1 A 0 A_PlaySound("RAILRIP", 1)
		FR1D NOP 1
	ReloadContinue:
		FRRL ABCDEFF 1
		FRRL G 2	
		FRRL G 1 offset(0,33)
		FRRL G 1 offset(0,32)
		FRRL G 1 offset(0,33)
		FRRL G 1 offset(0,32)	
		"####" A 0 A_PlaySound("weapons/CryoRifle/respect2",1)
		FRRL HIJKLLLMNOPP 1
		TNT1 A 0 A_FireCustomMissile("EmptyFreezerMagSpawn",160,0,10,-8)
		FRRL Q 4
		FRRL RRSTUV 1
		"####" A 0 A_PlaySound("weapons/CryoRifle/respect3")
		FRRL WWXYYYYZZ 1
		FRRL "[" 1
		FRRL "\" 1
		FRRL "]" 1
		FR1D Q 6
		"####" A 0 A_PlaySound("BEP")
		FR1D PONPO 1
		"####" Z 0 A_PlaySound("weapons/railgun/inspect6", 2)
		SHTZ A 0 A_TakeInventory("Reloading",1)
		Goto InsertBullets
	InsertBullets:	
		"####" AAAA 0
		"####" A 0 A_JumpIfInventory("FreezerAmmo",50,"FinishReload")
		"####" A 0 A_JumpIfInventory("PB_Cell",1,3)
		Goto FinishReload
        "####" AAAAAA 0
		"####" A 0 A_Giveinventory("FreezerAmmo",1)
		"####" A 0 A_Takeinventory("PB_Cell",1)
		Loop
	FinishReload:
	    FR1D D 1
		Goto Ready
	ReloadUnloaded:
		FR1D VU 1
		FRRL RRSTUV 1
		"####" A 0 A_PlaySound("weapons/CryoRifle/respect3")
		FRRL WWXYYYYZZ 1
		FRRL "[" 1
		FRRL "\" 1
		FRRL "]" 1
		FR1D Q 6
		"####" A 0 A_PlaySound("BEP")
		FR1D PONPO 1
		"####" Z 0 A_PlaySound("weapons/railgun/inspect6", 2)
		SHTZ A 0 A_TakeInventory("Reloading",1)
		SHTZ A 0 A_TakeInventory("FreezerIsUnloaded",1)
		RAIL A 0 A_Takeinventory("Unloading",1)
		Goto InsertBullets
	Unload:
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
        RAIL A 0 A_Takeinventory("Unloading",1)
		RAIL A 0 A_JumpIfInventory("FreezerAmmo",1,2)
		Goto ReadyNoAmmo
		TNT1 AA 0
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_PlaySound("RAILRIP", 1)
		FR1D NOP 1
		FRRL ABCDEFF 1
		FRRL G 2	
		FRRL G 1 offset(0,33)
		FRRL G 1 offset(0,32)
		FRRL G 1 offset(0,33)
		FRRL G 1 offset(0,32)	
		"####" A 0 A_PlaySound("weapons/CryoRifle/respect2",1)
		FRRL HIJKLLLMNOPP 1
	//	FRRL Q 4
		FR1D UV 1
		RAIL A 0 A_Giveinventory("FreezerIsUnloaded",1)
		RAIL A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:	
		TNT1 AAAA 0
		RAIL A 0 A_JumpIfInventory("FreezerAmmo",1,3)
		Goto ReadyUnloaded
        TNT1 AAAAAA 0
		RAIL A 0 A_Takeinventory("FreezerAmmo",1)
		RAIL A 0 A_Giveinventory("PB_Cell",1)
		Loop	
 	Spawn:
		FRZR ABC 2
		LOOP
	WeaponSpecial:
	TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
	TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
	TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
	TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility",1)
	Goto Ready3
	PlaceFreezeBot:
	TNT1 A 0 A_takeinventory("GoWeaponSpecialAbility",1)
	TNT1 A 0 A_JumpIfInventory("FreezerAmmo",15,2)
	Goto NoAmmo
	TNT1 A 0
	TNT1 A 0 A_overlay(6,"PlaceFreezeBot2")
	FR1K ABCD 1
	FR1K EFGEFGEFGEFGEFG 2
	FR1K DCBA 1
	Goto ready
	PlaceFreezeBot2:
		TNT1 A 4
		TNT1 A 0 A_playsound("freezebot/talk",7)
		TNT1 A 0 A_playsound("foley/ASGDrumOut",8)
		FR2R ABCDEFGHIJJJJJJJJJ 1
		TNT1 A 0 A_TakeInventory("freezerammo",15)
		TNT1 A 0 A_spawnitemex("freezebot",-40,-12,28,0,0,0,180)
		FR2R KLMNOPQRST 1
		Stop

	FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		TNT1 AAAAAAAAAAAAAA 1
		Stop

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		TNT1 AAAAAAAAAAAAAAA 0
		Stop

	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		TNT1 AAAAAAAAAAAAAAAA 1
		Stop

	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAA 1
		Stop

	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 AAAAAAA 1
		Stop
	}
}

ACTOR FreezerAmmo : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 50
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 50
   Inventory.Icon "FRZRA0"
}






ACTOR EmptyFreezerMagSpawn : EmptyCell
{
	Speed 20
	PROJECTILE
	+NOCLIP
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 1 A_CustomMissile("EmptyFreezerMag",1,-2,random(105,115),2,1)
		Stop

	}
}

