ACTOR FDCustomFunction : CustomInventory
{
  -COUNTITEM
  +INVENTORY.ALWAYSPICKUP
  Inventory.PickupMessage ""
  +INVENTORY.QUIET
  Inventory.PickupSound ""
  States
  {
  Spawn:
    TNT1 A 1
    Stop
  Pickup:
    TNT1 A 0 
	TNT1 A 0
    Stop


}
}
ACTOR FDHellboundTotenheimGeigerSpawner : FDCustomFunction
{
States
{
Pickup:
TNT1 A 0 A_JumpIfInventory ("FDHellboundTotenheimGeigerCooldown", 1, "NoGeiger")
TNT1 A 0 A_GiveInventory ("FDHellboundTotenheimGeigerCooldown", 1)
TNT1 A 0 A_SpawnItemEx ("FDHellboundTotenheimGeigerSound", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION)
Stop
NoGeiger:
TNT1 A 0
Stop
}
}
actor FDHellboundTotenheimGeigerSound
{
+NOINTERACTION
+NOCLIP
States
{
Spawn:
TNT1 A random(0,8)
TNT1 A 0 A_PlaySound ("effects/geigerburst", CHAN_WEAPON, 1, 0, 2.0)
TNT1 A 50
Stop
}
}
ACTOR FDCooldown : Powerup
{
+INVENTORY.UNTOSSABLE
Powerup.Duration -5
}


ACTOR FDHellboundTotenheimGeigerCooldown : FDCooldown
