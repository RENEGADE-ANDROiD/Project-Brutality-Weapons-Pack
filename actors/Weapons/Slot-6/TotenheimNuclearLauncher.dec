Actor FDHellboundTotenheimRadiationSpot : FDBFGRay999
{ 
DamageType "Desintegrate"
Decal ""
Scale 1.75
Alpha 0.02
+BLOODLESSIMPACT
+NODAMAGETHRUST
var int user_radiationtimer;
var int user_radiationdissipate;
States
{
Spawn:
XDeath:
Melee:
Crash:
TNT1 A 0
RadiationLoop:
TNT1 A 0 A_JumpIf (user_radiationtimer <= 0, "RadiationDamage")
TNT1 A 0 A_SetUserVar("user_radiationtimer", user_radiationtimer - 1)
TNT1 A 0 A_Jump (256, 1,2)
TNT1 AAA 0 A_SpawnParticle (1cfe12, SPF_FULLBRIGHT | SPF_RELATIVE, random(3,50), random(1,3), frandom(0,360), frandom(-256.0,256.0),frandom(-256.0,256.0),frandom(-256.0,256.0), frandom(0.01,0.2),frandom(-0.1,0.1),frandom(-0.2,0.2), 0,0,0, 0.2, -1)
TNT1 A 0 A_Jump (256, 1,2)
TNT1 AAA 0 A_SpawnParticle (64fe5d, SPF_FULLBRIGHT | SPF_RELATIVE, random(3,50), random(1,3), frandom(0,360), frandom(-256.0,256.0),frandom(-256.0,256.0),frandom(-256.0,256.0), frandom(0.01,0.2),frandom(-0.1,0.1),frandom(-0.2,0.2), 0,0,0, 0.2, -1)
TNT1 A 0 A_Jump (256, 1,2)
TNT1 AAA 0 A_SpawnParticle (08ca00, SPF_FULLBRIGHT | SPF_RELATIVE, random(3,50), random(1,3), frandom(0,360), frandom(-256.0,256.0),frandom(-256.0,256.0),frandom(-256.0,256.0), frandom(0.01,0.2),frandom(-0.1,0.1),frandom(-0.2,0.2), 0,0,0, 0.2, -1)
TNT1 A 0 A_Jump (256, "DeathAnimation")
Goto DeathAnimation
DeathAnimation:
TNT1 A 1
Goto RadiationLoop
RadiationDamage:
TNT1 A 0 A_JumpIf (user_radiationdissipate >= 30, "FizzleOut")
TNT1 A 0 A_SetUserVar("user_radiationdissipate", user_radiationdissipate + 1)
TNT1 A 0 A_SetUserVar("user_radiationtimer", 32)
TNT1 A 0 A_Explode (10, 256, 0, 0, 256)
Goto RadiationLoop
FizzleOut:
TNT1 A 0
Stop
}
}
Actor FDHellboundTotenheimRadiationSpotMain : FDHellboundTotenheimRadiationSpot
{ 
States
{
DeathAnimation:
//TNT1 A 0 A_JumpIf (user_radiationtimer >= 1, "RadiationLoop")
TNT1 A 1 Light("FDHellBoundTotenheimRadiation") A_RadiusGive ("FDHellboundTotenheimGeigerSpawner", random(50,700), RGF_PLAYERS | RGF_NOSIGHT, 1)
Goto RadiationLoop
}
}
ACTOR FDGunSmoke
{
PROJECTILE
+FORCEXYBILLBOARD
+THRUACTORS
+NOTELEPORT
+DONTSPLASH
-ACTIVATEIMPACT
-ACTIVATEPCROSS
Speed 20
Radius 3
Height 3
RenderStyle Translucent
Alpha 0.25
Scale 0.3
States
{
Spawn:
TNT1 A 0
TNT1 A 0 A_ScaleVelocity (0.01)
TNT1 A 0 A_SetScale (scalex * frandom(0.08,0.14))
TNT1 A 0 A_Jump (128, 2)
TNT1 A 0 A_SetScale (scalex - (scalex * 2), scaley)
SMOK ABCDEFGHIJKLMNOPQ 1 A_FadeTo(0, 0.01, 1)
Stop
}
}
