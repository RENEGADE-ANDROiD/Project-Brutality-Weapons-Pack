ACTOR PPSh : PB_WeaponBase
{
	Weapon.SlotNumber 2
	Weapon.AmmoType1 "PB_LowCalMag"
	Weapon.AmmoType2 "PPShAmmo"
	Weapon.AmmoGive1 0
	Weapon.SelectionOrder 1000
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \cePPSh! \c-(slot 2)"
	Obituary "$OBBD_SMG"
	Tag "PPSh-41"
	States
	{
	NoAmmo:
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		PPSS J 0 { PB_JumpIfMagUnloaded("KickFlashUnLoaded"); }
		PPSS AB 1 A_DoPBWeaponAction
		PPSS C 14 A_DoPBWeaponAction
		PPSS BA 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		PPSS J 0 { PB_JumpIfMagUnloaded("KickFlashUnLoaded"); }
		PPSS AB 1 A_DoPBWeaponAction
		PPSS C 14 A_DoPBWeaponAction
		PPSS BA 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		PPSS J 0 { PB_JumpIfMagUnloaded("SlideFlashUnLoaded"); }
		PPSS AB 1 A_DoPBWeaponAction
		PPSS C 14 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		PPSS J 0 { PB_JumpIfMagUnloaded("SlideFlashEndLoaded"); }
		PPSS c 7 A_DoPBWeaponAction
		PPSS BA 1 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		PPSS J 0 { PB_JumpIfMagUnloaded("SlideFlashEndEarlyLoaded"); }
		PPSS c 4
		PPSS AB 1
		Stop
	KickFlashUnLoaded: 
		PPSS de 1
		PPSS f 14
		PPSS ed 1
		Goto Ready3
	SlideFlashUnLoaded:
		PPSS de 1
		PPSS f 36
		Goto Ready3
	SlideFlashEndLoaded: 
		PPSS f 7
		PPSS ed 1
		Goto Ready3
	SlideFlashEndEarlyLoaded: 
		PPSS f 4
		PPSS ed 1
		Goto Ready3

	StartSprint:
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16G A 0 A_Takeinventory("ADSmode",1)
		M16G A 0 A_ZoomFactor(1.0)
		PPSG A 0 A_TakeInventory("NeverSelectedPPS",1)
		PPSG B 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip34"); }
		PPSG A 0
		PPSG "#" 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		PPSG "#" 0 { PB_JumpIfMagUnloaded("StartSprintUnLoaded"); }
		PB_MagUnloadedSkip34:
		PPSS A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Sprinting
	StartSprintUnLoaded:
		PPSS D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Sprinting:
		PPSG A 0 offset(-9,32)
		PPSS E 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PPSS E 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		PPSS E 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		PPSS E 0 offset(-9,32)
		PPSS D 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip33"); }
		PPSS A 0
		PPSS "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		PPSS "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		PB_MagUnloadedSkip33:
		PPSS "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		PPSS "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		PPSS "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		PPSS "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		PPSS "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		PPSS "#" 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		PPSS "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PPSS "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		PPSS "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		PPSS "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		PPSS "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		PPSS "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		PPSS "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		PPSS "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		PPSS "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		PPSS "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		PPSS "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		PPSS "#" 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		PPSS "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint
	StopSprint:
		PPSg A 0 { PB_JumpIfMagUnloaded("StopSprintUnLoaded"); }
		PPSg A 1
		PPSg A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	StopSprintUnLoaded:
		PPSG B 1
		PPSG B 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("UACSMGSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("PPSSelected",1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("NeverSelectedPPS", 1, "FirstSelectAnimation")
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
				Goto Ready3

	SelectAnimation:
		PIST E 0 A_PlaySound("mp40/Draw", 5)	
		PISS A 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip32"); }
		Goto SelectAnimationLoaded
		TNT1 AA 0
		PPSS FED 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("StartDualWield",1)
		PB_MagUnloadedSkip32:
		Goto Ready

	SelectAnimationLoaded:
		PPSS CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready3

	FirstSelectAnimation:
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		PPSG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("NeverSelectedPPS", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 3 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Tacticalselect:
		TNT1 A 0 A_TakeInventory("NeverSelectedPPS",1)
		TNT1 A 4 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		PPSR J 8 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		PPSr IHGF 1
		RIFR A 0 A_PlaySound("asg/Reload2", 5)
		PPSR E 1 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		PPSr DDDCBAKL 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		PPSR M 4 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("mp40/Bolt1", 5)
		PPSR N 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		PPSR O 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		PPSR PA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		PPSG A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		Goto Ready3

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		PPSG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		PPSG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PPSG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PPSG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		PPSG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		PPSG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PPSG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PPSG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		PPSG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PPSG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		PPSG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		PPSG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		PPSG B 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip31"); }
		PPSG A 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		PB_MagUnloadedSkip31:
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		Loop

	Ready2:
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		PPSG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RI2G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RI2G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		PPSG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		PPSG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		PPSG A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RI2G A 0 A_TakeInventory("UsedStamina", 2)
		PPSI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		Loop

	Deselect:
		PPSG A 0 A_Takeinventory("Zoomed",1)
		PPSG A 0 A_Takeinventory("ADSmode",1)
		PPSG A 0 A_TakeInventory("TossGrenade", 1)
		PPSG A 0 A_TakeInventory("Kicking",1)
		PPSG A 0 A_TakeInventory("Taunting",1)
		AKMG A 0 A_TakeInventory("DropIt", 1)
		PPSG A 0 A_TakeInventory("Reloading",1)
		PPSG A 0 A_TakeInventory("Unloading",1)
		PPSG A 0 A_TakeInventory("Salute1", 1)
		PPSG A 0 A_TakeInventory("Salute2", 1)
		PPSG A 0 A_Takeinventory("PPSSelected",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		PPSG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		PISS E 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip30"); }
		Goto DeselectLoaded
		PPSS E 0
	DeselectContinue:
		"####" DEF 1
				TNT1 A 0 A_Lower(120)
		PB_MagUnloadedSkip30:
		TNT1 A 0 A_Lower(120)
		Wait
	DeselectLoaded:
		PPSS ABC 1
		TNT1 A 0 A_Lower(120)
		Wait


	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		PPSI C 0 A_JumpIfInventory("Zoomed",1,13)
		PPSG A 0
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" A 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("PPShAmmo",1,1)
		Goto NoAmmo
		"####" "#" 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 3)
		"####" "#" 0 A_JumpIfInventory("PPShDurability",1,1)
		Goto GunBroken
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("PPShDurability",35,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "#" 0
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("PPShAmmo",1)
		"####" "#" 0 A_JumpIfInventory("PPShAmmo",10,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("PPShAmmo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("PB_LowCalMag",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("PB_LowCalMag",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
        PPSG AA 0
		PPSG A 0 A_AlertMonsters
		PPSG A 0 A_PlaySound("coltfir", CHAN_WEAPON)
		PPSG A 0 A_JumPIfInventory("Zoomed",1,"Fire2")
		PPSF A 1 Bright { PB_LowAmmoSoundWarning("smg"); PB_FireBullets("PB_9x19mm", 1, 3, 0, 0, 3); }
		PPSG A 0 A_ZoomFactor(0.98)
		PPSF B 1 A_FireCustomMissile("AK47Tracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		PPSG A 0 A_SPawnItemEx("PlayerMuzzle1",30,5,30)
		PPSG A 0 { PB_GunSmoke(0,0,0); }
        //PPSF A 0 A_FireCustomMissile("Tracer", random(-3,3), 0, 0, 0, 0, random(-3,3))
		PPSG A 0 A_SetPitch(Pitch-0.5)
		PPSG A 0 A_Quake(1,2,0,3,"")
		PPSG A 0 A_Takeinventory("PPShAmmo",1)
		PPSF C 0 { PB_SpawnCasing("PB_EmptyBrass", 28, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		PPSG A 0 A_SetPitch(Pitch-0.6)
		PPSG A 0 A_ZoomFactor(1.0)
		PPSG A 0 A_SetANgle(angle+random(-1, 1))
		PPSI C 0 A_JumPIfInventory("Zoomed",1,1)
		PPSG A 0
		"####" "#" 0
		"####" "#" 0 A_JumPIfInventory("PPShAmmo",1,2)
        Goto NoAmmo
        PPSG AA 0
		PPSG A 0 A_AlertMonsters
		PPSG A 0 A_PlaySound("coltfir", CHAN_WEAPON)
		PPSF C 1 Bright { PB_LowAmmoSoundWarning("smg"); PB_FireBullets("PB_9x19mm", 1, 4, 0, 0, 4); }
		PPSG A 0 A_ZoomFactor(0.99)
		PPSF D 1 A_SPawnItemEx("PlayerMuzzle1",30,5,30)
		PPSF D 0 { PB_GunSmoke(0,0,0); }
		PPSG A 0 A_SetPitch(Pitch-0.6)
		PPSG A 0 A_Takeinventory("PPShAmmo",1)
		PPSF C 0 { PB_SpawnCasing("PB_EmptyBrass", 28, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		PPSG A 0 A_SetPitch(Pitch-0.5)
		PPSG A 0 A_Quake(1,3,0,4,"")
		PPSG A 0 A_ZoomFactor(1.0)
		PPSG A 0 A_SetANgle(angle+random(-1, 1))
		PPSG A 0 A_Refire
		Goto Ready3


	Fire2:
		PPSG A 0
		PPSG A 0 A_PlaySound("coltfir", CHAN_WEAPON)
		RIFG A 0 A_SPawnItemEx("PlayerMuzzle1",30,0,45)
		RIFG A 0 { PB_GunSmoke(0,0,0); }
		RIFG A 0 A_ZoomFactor(1.15)
		PPSI D 1 Bright { PB_LowAmmoSoundWarning("smg"); PB_FireBullets("PB_9x19mm", 1, 2, 0, 0, 2); }
		PPSF A 0 A_FireCustomMissile("AK47Tracer", random(-3,3), 0, 0, 0, 0, random(-3,3))
        TNT1 A 0 A_Quake(1,2,0,3,"")
		RIFG A 0 A_Takeinventory("PPShAmmo",1)
		RIFG A 0 A_ZoomFactor(1.2)
		PPSI E 1 
		RIFG A 0 A_SetPitch(Pitch-0.33)
		TNT1 A 0 A_SetANgle(angle+frandom(-0.5, 0.5))
		PPSI B 0 { PB_SpawnCasing("PB_EmptyBrass", 28, 8, 0, frandom(4,7), frandom(6,9), frandom(0,5)); }
		PPSF D 0
		PPSG A 0 A_JumPIfInventory("PPShAmmo",1,2)
        Goto NoAmmo
        TNT1 AA 0
		PPSG A 0 A_AlertMonsters
		PPSG A 0 A_PlaySound("coltfir", CHAN_WEAPON)
		RIFG A 0 A_ZoomFactor(1.16)
		TNT1 A 0 A_Quake(1,3,0,4,"")
		PPSI F 1 { PB_LowAmmoSoundWarning("smg"); PB_FireBullets("PB_9x19mm", 1, 3, 0, 0, 3); }
		RIFG A 0 A_Takeinventory("PPShAmmo",1)
		RIFG A 0 A_ZoomFactor(1.2)
		PPSI G 1 
		RIFG A 0 A_SetPitch(Pitch-0.5)
		PPSI B 0 { PB_SpawnCasing("PB_EmptyBrass", 28, 8, 0, frandom(4,7), frandom(6,9), frandom(0,5)); }
		PPSI C 0 A_Refire
		Goto Ready2
	IsHolding:
		PPSG A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+11

	AltFire:
		PPSG A 0
		PPSS J 0 { PB_JumPIfMagUnloaded("ready"); }
		2IFG A 0 A_JumPIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		//PPSG A 0 A_TakeInventory("FiredMGGrenade",1)
		PPSG A 0 A_JumPIfInventory("Zoomed",1,"NoAim")
		PPSG A 0 A_Giveinventory("GoSPecial",1)
		PPSG A 0 A_Giveinventory("Zoomed",1)
		//PPSG A 0 A_Takeinventory("IsInsPecting",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaPonOffset(0, 32, WOF_INTERPOLATE)
		PPSG A 0 A_ZoomFactor(1.2)
		PPSG A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		PPSG A 0 A_JumPIfInventory("AimMode_Toggle",1,"ToggleAim")
		PPSI ABC 1 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlaySound("weaPons/rifle/move")
		PPSG A 0 A_JumPIfInventory("AimMode_Toggle",1,3)
		PPSG A 0 A_JumPIfInventory("AimMode_Hold",1,"HoldAim")
		PPSG A 0 A_JumPIfInventory("FiredSecondary",1,3)
		PPSi C 5 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RI2G A 0 A_JumPIfInventory("FiredPrimary",1,"HoldAim")
		PPSi C 4
		PPSG A 0 A_JumPIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		PPSI ABC 1 //A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		PPSI C 5 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		PPSG A 0
		PPSG A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumPIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumPIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumPIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumPIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumPIfInventory("Unloading",1,"Unload")
		//TNT1 A 0 A_JumPIfInventory("RFGrenade",1,"FireGrenade")
		RI2G A 0 A_JumPIfInventory("TossGrenade",1,"FireGrenade")
		//RI2G A 0 A_JumPIfInventory("StartDualWield",1,"DualWield")
		//TNT1 A 0 A_JumPIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumPIfInventory("IsRunning",1,"StartSPrint")
		PPSG A 0 A_JumPIfInventory("FiredPrimary",1,"Fire")
		PPSI c 1 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		PPSG A 0 A_JumPIfInventory("FiredPrimary",1,"Fire")
		PPSI c 1 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		PPSG A 0 A_JumPIfInventory("FiredPrimary",1,"Fire")
		PPSI c 1 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		PPSG A 0 A_JumPIfInventory("FiredPrimary",1,"Fire")
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		//PPSG A 0 A_JumPIfInventory("NoAutoReload",1,2)
		//PPSG A 0 A_JumPIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		PPSG AA 0 A_JumPIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(7)
		PPSG A 0
		PPSG A 0 A_Takeinventory("Zoomed",1)
		PPSG A 0 A_Takeinventory("ZoomHold",1)
		PPSG A 0 A_ZoomFactor(1.0)
		PPSG A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		PPSG A 0 A_JumPIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		PPSI cBA 1 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		PPSG "#" 0 A_JumPIfInventory("Reloading",1,"Reload")
		PPSG A 5 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		PPSI CBA 1 //A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		PPSG "#" 0 A_JumPIfInventory("Reloading",1,"Reload")
		PPSG A 5 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	//InsPecting anim (also rePurPosed as rechambering)
	InsPect:
		PPSG A 0 A_JumPIfInventory("DoInsPect",1,"ContinueInsPect")
		PPSG A 0 A_JumPIfInventory("FiredSecondary",1,"ContinueInsPect")
		PPSG A 0 A_JumPIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		PPSG A 0 A_JumPIfInventory("Zoomed",1,"Ready2")
		//TNT1 A 0 A_JumPIfInventory("RFGrenade",1,"FireGrenade")
		PPSG A 0 A_JumPIfInventory("TossGrenade",1,"TossGrenade")
		PPSG A 0 A_JumPIfInventory("Taunting",1,"Taunt")
		PPSG A 0 A_JumPIfInventory("Reloading",1,"Reload")
		PPSG A 0 A_JumPIfInventory("Unloading",1,"Unload")
		PPSG A 0 A_JumPIfInventory("Salute1", 1, "Salute")
		PPSG A 0 A_JumPIfInventory("Salute2", 1, "Salute")
		PPSG A 0 A_JumPIfInventory("Unloading",1,"Unload")
		PPSG A 0 A_JumPIfInventory("IsRunning",1,"StartSPrint")
		PPSG A 0 A_JumPIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		//PPSG A 0 A_JumPIfInventory("StartDualWield",1,"DualWield")
		PPSG A 0 A_JumPIfInventory("FiredPrimary",1,"Fire")
		PPSG A 0 A_JumPIfInventory("AimMode_Toggle",1,2)
		PPSG A 0 A_JumPIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		PPSG A 5 A_DoPBWeaPonAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		PPSG A 0 A_GiveInventory("DoInsPect",1)
		PPSG A 1 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PPSG A 0 A_TakeInventory("DoInsPect",1)
		Goto Ready3

	ContinueInsPect:
		TNT1 AA 0
		PPSG A 0 A_TakeInventory("DoInsPect",1)
		PPSR AKL 1 A_DoPBWeaPonAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	InsPect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		PPSG "#" 0 A_Giveinventory("IsInsPecting",1)
		PPSR M 5 A_DoPBWeaPonAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("mP40/Bolt1", 5)
		PPSR N 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		PPSG "#" 0 A_TakeInventory("PPSReloadToken",1)
		TNT1 A 0 A_GiveInventory("HoldInsPect",1)
	InsPectHold:
		PPSR O 2 A_DoPBWeaPonAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInsPect",1)
		//2IFR A 0 A_PlaySound("mP40/Bolt2", 5)
		PPSR PA 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		PPSG A 2 A_DoPBWeaPonAction(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		PPSG "#" 0 A_Takeinventory("IsInsPecting",1)
		PPSG "#" 0 A_TakeInventory("PPSReloadToken",1)
		PPSG "#" 0 A_Takeinventory("IsInsPecting",1)
		PPSG "#" 0 A_TakeInventory("PPSReloadToken",1)
		PPSG "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectRechamber:
		PPSG A 0 A_TakeInventory("DoInsPect",1)
		PPSr ab 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		PPSc a 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		PPSG "#" 0 A_Giveinventory("IsInsPecting",1)
		PPSc b 5 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		PPSG "#" 0 A_TakeInventory("PPSReloadToken",1)
		PPSC CDE 1
		TNT1 A 0 A_GiveInventory("HoldInsPect",1)
		PPSC E 2 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInsPect",1)
		2IFR A 0 A_PlaySound("mP40/Bolt2", 5)
		PPSC F 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		PPSC A 5 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		PPSG "#" 0 A_Takeinventory("IsInsPecting",1)
		PPSG "#" 0 A_TakeInventory("PPSReloadToken",1)
		PPSR ba 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE)
		PPSG "#" 0 A_Takeinventory("IsInsPecting",1)
		PPSG "#" 0 A_TakeInventory("PPSReloadToken",1)
		PPSG "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready
	FullReload:
		PPSG A 0 A_ClearReFire
		PPSG A 0 { PB_SetMagUnloaded(false); }


		//PPSr STU 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		//2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		//PPSr VVVV 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		//TNT1 A 0 A_TakeInventory("PPSReloadToken",1)
		//PPSr UTSNEDCBA 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PPSG A 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	Reload:
		PPSG "#" 0 A_JumPIfInventory("Zoomed", 1,"NoAim")
		PPSG "#" 0 A_Takeinventory("Reloading",1)
		PPSG "#" 0 A_JumPIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		PPSG "#" 0 A_JumPIfInventory("NoReloading", 1, "Ready")
		PPSG "#" 0 A_JumPIfInventory("PB_LowCalMag",1,3)
		Goto Ready
		TNT1 AAA 0
		PPSG "#" 0 A_JumPIfInventory("HoldInsPect", 1, "InsPectHold")
		PPSG "#" 0 A_JumPIfInventory("IsInsPecting", 1, "InsPect2")
		PPSG A 0 A_JumPIfInventory("PPShAmmo",0,"InsPect")
		PPSG A 0 A_JumPIfInventory("PPSReloadToken",1,"InsPect")
		PPSG A 0 A_Takeinventory("Reloading",1)
		PPSG A 0 A_Takeinventory("ADSmode",1)
		PPSG A 0 A_Takeinventory("Zoomed",1)
		PPSG A 0 A_Takeinventory("ZoomHold",1)
		PPSG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//PPSG A 3 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PPSG A 0 A_Takeinventory("ADSmode",1)
		PPSG A 0 A_Takeinventory("Zoomed",1)
		PPSG A 0 A_Takeinventory("ZoomHold",1)
		PPSG A 0 { PB_JumPIfMagUnloaded("ReloadFromEmPty"); }
		PPSG A 0 A_GiveInventory ("PumPing", 1)
		PPSG A 0 A_Takeinventory("Reloading",1)
		PPSR ABCDEEEEEE 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PPSG A 0 A_PlaySound("asg/Reload1", 5)
		PPSG A 0 { PB_JumPIfMagUnloaded("PB_MagUnloadedSkiP29"); }
		PPSR FGHI 1
		RIFR G 0 A_FireCustomMissile("EmPtyASGAmmoSPawn",-5,0,8,-4)
	ReloadFromEmPty:
		PPSR J 16 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PB_MagUnloadedSkiP29:
		PPSr IHGF 1
		RIFR A 0 A_PlaySound("asg/Reload2", 5)
		PPSR E 5 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_GiveInventory("PPSReloadToken",1)
		Goto InsertBullets

	FinishReloading:
		PPSG A 0 A_ClearReFire
		PPSr DDDDDCBA 1 A_DoPBWeaPonAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("PPSReloadToken",1)
		Goto ReloadConcluded

	InsertBullets:
		TNT1 AAAA 0
		PPSG A 0 A_JumPIfInventory("PPShAmmo", 71, 15)
		PPSG A 0 A_JumPIfInventory("PB_LowCalMag", 1, 3)
		Goto FinishReloading
		TNT1 AAAAAA 0
		PPSG A 0 A_Giveinventory("PPShAmmo", 1)
		//PPSG A 0 A_Giveinventory("DoublePPShAmmo",1)
		PPSG A 0 { PB_SetMagUnloaded(false); }


		//PPSG A 0 { PB_SetMagUnloaded(false); }


		PPSG A 0 A_Takeinventory("PB_LowCalMag", 1, TIF_NOTAKEINFINITE)
		PPSG A 1
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		PPSG A 0 A_Takeinventory("Reloading",1)
		PPSG A 0 //A_Refire //Commented out so that reload Animation can finish.
		Goto FinishReloading
		TNT1 AAAA 0
		PPSG A 0 A_Takeinventory("Reloading",1)
		PPSG A 0 //A_Refire
		Goto FinishReloading

	ReloadConcluded:
		PPSG A 2
		PPSG "#" 0 A_TakeInventory("PPSReloadToken",1)
		PPSG A 0 A_Refire
		Goto Ready3

	User2:
	Unload:
		PPSG "#" 0 A_Takeinventory("Unloading",1)
		PPSG "#" 0 A_JumPIfInventory("NoReloading",1,"Ready")
		PPSG "#" 0 A_JumPIfInventory("PPShAmmo",1,3)
		Goto Ready
		TNT1 AAA 0
		PPSG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		PPSG A 0 A_Takeinventory("Unloading",1)
		PPSG A 0 A_Takeinventory("ADSmode",1)
		PPSG A 0 A_Takeinventory("Zoomed",1)
		//RIFR AB 1
		//RIFR "[" 1
		PPSR ABCDEEEE 1
		PPSG A 0 A_PlaySound("asg/Reload1", 5)
		PPSG A 0 A_GiveInventory ("PumPing", 1)
		PPSG A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		PPSG A 0 A_JumPIfInventory("PPShAmmo", 1, 3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		PPSG A 0 A_Takeinventory("PPShAmmo", 1)
		//PPSG A 0 A_Takeinventory("DoublePPShAmmo",1)
		PPSG A 0 { PB_SetMagUnloaded(true); }


		//PPSG A 0 { PB_SetMagUnloaded(true); }


		PPSG A 0 A_Giveinventory("PB_LowCalMag", 1)
		PPSG A 1
		Goto RemoveBullets
	FInishUnload:
		PPSr FGHIJJJJJ 1
		PPSG A 0 A_Takeinventory("Unloading",1)
		Goto Ready3
	GunBroken:
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("WeaPon/EmPty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 1 A_DoPBWeaPonAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 0 A_Print("Your gun has been destroyed!\n\n\n\n\n\n\n")
		"####" "#" 0 A_GiveInventory("PPShDestroyed", 1)
		"####" "#" 0 A_PlaySound("DSBRK2")
		"####" "#" 0 A_Quake(4,5,0,12,"")
		"####" "##" 0 A_CustomMissile("MetalShard1", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_SPawnItemEx("PlayerMuzzle1",30,0,45)
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#######" 0 A_CustomMissile("ShotgunParticles2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#######" 0 A_CustomMissile("ShotgunParticles", 20, 0, random(-35, 35), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "####" 0 A_CustomMissile ("WoodParticle", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile("ExPlosionParticle", 20, 0, random(-10, 10), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard3", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_FireCustomMissile("SmokeSPawner",0,0,0,5)
		TNT1 A 0 A_GiveInventory("DroPPPSh", 1)
		TNT1 A 0 A_TakeInventory("DroPIt", 1)
		TNT1 A 0 A_SelectWeaPon("DroPPer")
		StoP

	RollForJam:
		"####" "#" 0 A_JumPIfInventory("PPShDurability", 120, "JamChanceLow")
		"####" "#" 0 A_JumPIfInventory("PPShDurability", 60, "JamChanceMid")

	JamChanceHigh:
		"####" "#" 0 A_JumP(10, "ClearJam")
		Goto ResumeFireFrame

	JamChanceMid:
		"####" "#" 0 A_JumP(7, "ClearJam")
		Goto ResumeFireFrame

	JamChanceLow:
		"####" "#" 0 A_JumP(4, "ClearJam")
		Goto ResumeFireFrame

	ClearJam:
		PPSG A 0
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_ClearReFire
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("WeaPon/EmPty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 2 A_DoPBWeaPonAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 1 A_ClearReFire
		PPSG A 5		
		PPSR AKLMMMMMM 1		
		2IFR A 0 A_PlaySound("mP40/Bolt1", 5)
		PPSR N 1
		PPSR N 0 A_FireCustomMissile("PistolCaseSPawn",5,0,6,-14)
		PPSR OOPA 1
		PPSG A 4
		Goto Ready

	PrintConditionTrash:
		"####" "#" 0 A_Print("Condition: \crTrash\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionBroken:
		"####" "#" 0 A_Print("Condition: \cgBroken\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionAlmostBroken:
		"####" "#" 0 A_Print("Condition: \cgAlmost Broken\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionCritical:
		"####" "#" 0 A_Print("Condition: \caCritical\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionBad:
		"####" "#" 0 A_Print("Condition: \caBad\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionHeavilyWorn:
		"####" "#" 0 A_Print("Condition: \ciHeavily Worn\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionWorn:
		"####" "#" 0 A_Print("Condition: \ciWorn\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionFair:
		"####" "#" 0 A_Print("Condition: \ckFair\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionGood:
		"####" "#" 0 A_Print("Condition: \cdGood\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionVeryGood:
		"####" "#" 0 A_Print("Condition: \cdVery Good\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionExcellent:
		"####" "#" 0 A_Print("Condition: \cdExcellent\n\n\n\n\n\n\n")
		Goto InsPect2CarryOn

	PrintConditionPristine:
		"####" "#" 0 A_Print("Condition: \cCPristine\n\n\n\n\n\n\n")

	InsPect2CarryOn:
		"####" "#" 0 A_GiveInventory("HoldInsPect",1)

	DroPPer:
		GLOA A 0 A_JumPIfInventory("VietDoomDurabilityDisabled", 1,"Ready")
		919A A 0 A_Takeinventory("Zoomed",1)
		919A A 0 A_Takeinventory("ADSmode",1)
		919A A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("DroPPPSh", 1)
		TNT1 A 0 A_TakeInventory("DroPIt", 1)
		TNT1 A 0 A_SelectWeaPon("DroPPer")
		StoP
	SPawn:
		WPPS A 1
		WPPS A 1 A_SPawnItemEx ("PPShSPawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		StoP
	}


}
ACTOR PPShAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 71
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 71
	Inventory.Icon "WPPSA0"
}
Actor PPSReloadToken : bd_Token {
}
ACTOR NeverSelectedPPS : bd_Token {
}
Actor PPSSelected : bd_Token {
}
ACTOR PPShPickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \cePPSh! \c-(slot 2)"
	Inventory.PickupSound "ads/in"
	States
	{

	Spawn:
		P3ST A 0
		WPPS A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WPPS A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("PPSh", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("PPSh", 1)
		P3ST A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 1)
		P3ST A 0 A_GiveInventory("PPShDurability", 800)
		P3ST A 0 A_GiveInventory("NeverSelectedPPS", 1)
		P3ST A 0 A_Giveinventory("PB_LowCalMag", 30)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_LowCalMag", 30)
		Stop

}

}

Actor PPShDestroyed : bd_Token {}

ACTOR PPShPickUpHC: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	//scale 0.74
	+THRUACTORS
	States
	{
	Spawn:
		WPPS A 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
