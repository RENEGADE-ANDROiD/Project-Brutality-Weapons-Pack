ACTOR MAT49 : PB_WeaponBase
{
	Weapon.SlotNumber 2
	Weapon.AmmoType1 "PB_LowCalMag"
	Weapon.AmmoType2 "MAT49Ammo"
	Weapon.AmmoGive1 0
	Weapon.SelectionOrder 1000
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \ceMAT49! \c-(slot 2)"
	Obituary "$OBBD_SMG"
	Tag "MAT49"
	States
	{
	NoAmmo:
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true, ""); }
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		MATR A 1 A_DoPBWeaponAction
		MATS AB 1 A_DoPBWeaponAction
		MATS C 11 A_DoPBWeaponAction
		MATS ba 1 A_DoPBWeaponAction
		MATg A 2 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		MATS AA 0 A_Lower
		MATS A 4 A_Lower
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		MATR A 2 A_DoPBWeaponAction
		MATS AB 1 A_DoPBWeaponAction
		MATS C 35 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		MATR A 10 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		MATR A 2
		MATR Aaaa 1
		Stop

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedMAT",1)
		MATG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		MATs AAA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		MATG A 0 A_Takeinventory("Zoomed",1)
		MATG A 0 A_Takeinventory("ADSmode",1)
		MATG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
	Sprinting:
		MATG A 0
		RISP A 0 offset(-9,32)
		MATG A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		MATG A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		MATG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		MATG A 0 offset(-9,32)
		MATS A 1 offset(-9,34) A_SetPitch(pitch -0.5)
		MATS A 1 offset(-6,36) A_SetPitch(pitch -0.5)
		MATS A 1 offset(-3,38) A_SetPitch(pitch -0.5)
		MATS A 1 offset(0,38) A_SetPitch(pitch -0.5)
		MATS A 1 offset(3,36) A_SetPitch(pitch -0.5)
		MATS A 1 offset(6,34) A_SetPitch(pitch -0.5)
		MATS A 1 offset(9,32) A_SetPitch(pitch -0.5)
		MATG A 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		MATG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		MATG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		MATG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		MATG A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		MATS A 1 offset(9,34) A_SetPitch(pitch +0.5)
		MATS A 1 offset(6,36) A_SetPitch(pitch +0.5)
		MATS A 1 offset(3,38) A_SetPitch(pitch +0.5)
		MATS A 1 offset(0,38) A_SetPitch(pitch +0.5)
		MATS A 1 offset(-3,36) A_SetPitch(pitch +0.5)
		MATS A 1 offset(-6,34) A_SetPitch(pitch +0.5)
		MATS A 1 offset(-9,32) A_SetPitch(pitch +0.5)
		MATG A 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		MATG A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		MATs AAA 1
		MATs A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready3

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("UACSMGSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("MATSelected",1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("NeverSelectedMAT", 1, "FirstSelectAnimation")
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
				Goto Ready3

	SelectAnimation:
		MP40 A 0 A_PlaySound("MP40/Draw", 5)
		MATS CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("RELOADING",1)
		Goto Ready3

	FirstSelectAnimation:
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		MATG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("NeverSelectedMAT", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 2 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Tacticalselect:
		TNT1 A 0 A_TakeInventory("NeverSelectedMAT",1)
		TNT1 A 3 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		MATR J 6 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("smg/Reload2", 5)
		MATr IHGFE 1 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		//TNT1 A 0 A_GiveInventory("MATReloadToken",1)
		MATr DDDCBAK 1 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		MATR L 3 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		MATR M 1 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		MATR N 5 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("mp40/Bolt2", 5)
		MATR MLLKA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		MATG A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM)
		goto ready

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		MATG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		MATG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		MATG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		MATG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		MATG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		MATG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		MATG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		MATG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		MATG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		MATG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		MATG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		MATG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		MATG A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Ready2:
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		MATG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RI2G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RI2G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		MATG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		MATG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		MATG A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RI2G A 0 A_TakeInventory("UsedStamina", 2)
		MATI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Deselect:
		MATG A 0 A_Takeinventory("Zoomed",1)
		MATG A 0 A_Takeinventory("ADSmode",1)
		MATG A 0 A_TakeInventory("TossGrenade", 1)
		MATG A 0 A_TakeInventory("Kicking",1)
		MATG A 0 A_TakeInventory("Taunting",1)
		MATG A 0 A_TakeInventory("Reloading",1)
		MATG A 0 A_TakeInventory("Unloading",1)
		MATG A 0 A_TakeInventory("Salute1", 1)
		MATG A 0 A_TakeInventory("Salute2", 1)
		MATG A 0 A_Takeinventory("MATSelected",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		MATG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		TNT1 A 0 A_Lower(120)
		Wait

	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true); }
		MATI C 0 A_JumpIfInventory("Zoomed",1,13)
		MATG A 0
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" A 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("MAT49Ammo",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 { PB_LowAmmoSoundWarning("smg"); }
		"####" "#" 0 A_Takeinventory("MAT49Ammo",1)
		"####" "#" 0 A_JumpIfInventory("MAT49Ammo",7,2)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("MAT49Ammo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("PB_LowCalMag",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("PB_LowCalMag",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		MATG AAAA 0
		MATG A 0 A_AlertMonsters
		//MATG A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		MATG A 0 A_PlaySound("ColtFir", 1)
		MATG A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		MATG "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		MATG "#" 0 { PB_GunSmoke(0,0,0); }
		MATF A 1 BRIGHT
		{
			if (CountInv("MAT49Braced") >= 1)
			{
				PB_FireBullets("PB_9x19mm", 1, 1.25, 0, 0, 1.25);
			}
			else
			{
				PB_FireBullets("PB_9x19mm", 1, 3, 0, 0, 3);
			}
		}
		MATG B 0 A_FireCustomMissile("PistolCaseSpawn",5,0,6,-14)
		MATG B 0 A_ZoomFactor(0.97)
		MATG A 0 A_SetPitch(pitch-0.75)
		MATF B 1 
		TNT1 A 0 A_ZoomFactor(1.0)
		MATF C 1 A_SetPitch(Pitch+0.1)
		MATf D 1 A_SetPitch(Pitch+0.1)
		MATG A 0 A_Refire
		Goto Ready

	IsHolding:
		MATG A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+11
	Fire2:
		MATG A 0
		MATG A 0 A_PlaySound("ColtFir", 1)
		MATG A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		MATG A 0 { PB_GunSmoke(0,0,0); }
		MATG A 0 A_ZoomFactor(1.15)
		MATI d 1 BRIGHT
		{
			if (CountInv("MAT49Braced") >= 1)
			{
				PB_FireBullets("PB_9x19mm", 1, 0.75, 0, 0, 0.75);
			}
			else
			{
				PB_FireBullets("PB_9x19mm", 1, 2, 0, 0, 2);
			}
		}
		MATG A 0 A_SetPitch(pitch-0.5)
		MATI F 1 A_ZoomFactor(1.2) 
		MATi E 1 A_SetPitch(Pitch+0.1)
		MATI e 0 A_FireCustomMissile("PistolCaseSpawn",1,0,8,0)
		MATi c 1 A_SetPitch(Pitch+0.1)
		MATG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		MATG A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")//If still pressing alt fire, it means its holding aim
		MATG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		TNT1 AAA 0
		RI2G A 0 A_ReFire
		MATI c 10 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		MATG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		MATG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		MATG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		MATG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RI2G A 0
		Goto Ready2

	WeaponSpecial:
		TNT1 A 0 {
			A_TakeInventory("GoWeaponSpecialAbility", 1);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_TakeInventory("ZoomHold", 1);
			A_ZoomFactor(1.0);
		}
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("MAT49Braced", 1, "MAT49BracedOff")
		TNT1 A 0 A_GiveInventory("MAT49Braced", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Stock: Braced")
		Goto Ready3
	MAT49BracedOff:
		TNT1 A 0 A_TakeInventory("MAT49Braced", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Stock: Folded")
		Goto Ready3
	AltFire:
		MATG A 0
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		//MATG A 0 A_TakeInventory("FiredMGGrenade",1)
		MATG A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		MATG A 0 A_Giveinventory("GoSpecial",1)
		MATG A 0 A_Giveinventory("Zoomed",1)
		//MATG A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		MATG A 0 A_ZoomFactor(1.2)
		MATG A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		MATG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		MATI ABC 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlaySound("weapons/rifle/move")
		MATG A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		MATG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		MATG A 0 A_JumpIfInventory("FiredSecondary",1,3)
		MATi C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		MATi C 4
		MATG A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		MATI ABC 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		MATI C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		MATG A 0
		MATG A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		RI2G A 0 A_JumpIfInventory("TossGrenade",1,"FireGrenade")
		//RI2G A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		//TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		MATG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		MATI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		MATG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		MATI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		MATG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		MATI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		MATG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		//MATG A 0 A_JumpIfInventory("NoAutoReload",1,2)
		//MATG A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		MATG AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(7)
		MATG A 0
		MATG A 0 A_Takeinventory("Zoomed",1)
		MATG A 0 A_Takeinventory("ZoomHold",1)
		MATG A 0 A_ZoomFactor(1.0)
		MATG A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		MATG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		MATI cBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		MATG "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		MATG A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		MATI CBA 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		MATG "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		MATG A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	//Inspecting anim (also repurposed as rechambering)
	Inspect:
		MATG A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		MATG A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		MATG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		MATG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		MATG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		MATG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		MATG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		MATG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		MATG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		MATG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		MATG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		MATG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		MATG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		//MATG A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		MATG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		MATG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		MATG A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		MATG A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		MATG A 0 A_GiveInventory("DoInspect",1)
		MATG A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		MATG A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		MATG A 0 A_TakeInventory("DoInspect",1)
		MATR AK 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		MATG "#" 0 A_Giveinventory("IsInspecting",1)
		MATR L 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		MATR M 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		MATG "#" 0 A_TakeInventory("MATReloadToken",1)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		MATR N 2 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("mp40/Bolt2", 5)
		MATR MLLLLKA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		MATG A 2 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		MATG "#" 0 A_Takeinventory("IsInspecting",1)
		MATG "#" 0 A_TakeInventory("MATReloadToken",1)
		MATG "#" 0 A_Takeinventory("IsInspecting",1)
		MATG "#" 0 A_TakeInventory("MATReloadToken",1)
		MATG "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectRechamber:
		MATG A 0 A_TakeInventory("DoInspect",1)
		MATr ab 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		MATc a 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		MATG "#" 0 A_Giveinventory("IsInspecting",1)
		MATc b 5 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		MATG "#" 0 A_TakeInventory("MATReloadToken",1)
		MATC CDE 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
		MATC E 2 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("mp40/Bolt2", 5)
		MATC F 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		MATC A 5 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		MATG "#" 0 A_Takeinventory("IsInspecting",1)
		MATG "#" 0 A_TakeInventory("MATReloadToken",1)
		MATR ba 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		MATG "#" 0 A_Takeinventory("IsInspecting",1)
		MATG "#" 0 A_TakeInventory("MATReloadToken",1)
		MATG "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready
	FullReload:
		MATG A 0 A_ClearReFire
		MATG A 0 { PB_SetMagUnloaded(false); }

		MATG A 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	Reload:
		MATG "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		MATG "#" 0 A_Takeinventory("Reloading",1)
		MATG "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		MATG "#" 0 A_JumpIfInventory("PB_LowCalMag",1,3)
		Goto Ready
		TNT1 AAA 0
		MATG "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		MATG "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")
		MATG A 0 A_JumpIfInventory("MAT49Ammo",0,"Inspect")
		MATG A 0 A_JumpIfInventory("MATReloadToken",1,"Inspect")
		MATG A 0 A_Takeinventory("Reloading",1)
		MATG A 0 A_Takeinventory("ADSmode",1)
		MATG A 0 A_Takeinventory("Zoomed",1)
		MATG A 0 A_Takeinventory("ZoomHold",1)
		MATG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//MATG A 3 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MATG A 0 A_Takeinventory("ADSmode",1)
		MATG A 0 A_Takeinventory("Zoomed",1)
		MATG A 0 A_Takeinventory("ZoomHold",1)
		MATG A 0 { PB_JumpIfMagUnloaded("ReloadFromEmpty"); }
		MATG A 0 A_GiveInventory ("Pumping", 1)
		MATG A 0 A_Takeinventory("Reloading",1)
		MATR ABCDDDDDD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MATG A 0 A_PlaySound("smg/Reload1", 5)
		MATR EFGHI 1
		RIFR G 0 A_FireCustomMissile("EmptyClip2Spawn",-5,0,8,-4)
	ReloadFromEmpty:
		MATR J 12 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("smg/Reload2", 5)
		MATr IHGFE 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_GiveInventory("MATReloadToken",1)
		Goto InsertBullets

	FinishReloading:
		MATG A 0 A_ClearReFire
		MATr DDDDDCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("MATReloadToken",1)
		Goto ReloadConcluded

	InsertBullets:
		TNT1 AAAA 0
		MATG A 0 A_JumpIfInventory("MAT49Ammo",0,15)
		MATG A 0 A_JumpIfInventory("PB_LowCalMag",1,3)
		Goto FinishReloading
		TNT1 AAAAAA 0
		MATG A 0 A_Giveinventory("MAT49Ammo",1)
		//MATG A 0 A_Giveinventory("DoubleMAT49Ammo",1)
		MATG A 0 { PB_SetMagUnloaded(false); }

		//MATG A 0 { PB_SetMagUnloaded(false); }

		MATG A 0 A_Takeinventory("PB_LowCalMag",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		MATG A 0 A_Takeinventory("Reloading",1)
		MATG A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto FinishReloading
		TNT1 AAAA 0
		MATG A 0 A_Takeinventory("Reloading",1)
		MATG A 0 //A_Refire
		Goto FinishReloading

	ReloadConcluded:
		MATG A 2
		MATG "#" 0 A_TakeInventory("MATReloadToken",1)
		MATG A 0 A_Refire
		Goto Ready3

	User2:
	Unload:
		MATG "#" 0 A_Takeinventory("Unloading",1)
		MATG "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		MATG "#" 0 A_JumpIfInventory("MAT49Ammo",1,3)
		Goto Ready
		TNT1 AAA 0
		MATG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		MATG A 0 A_Takeinventory("Unloading",1)
		MATG A 0 A_Takeinventory("ADSmode",1)
		MATG A 0 A_Takeinventory("Zoomed",1)
		//RIFR AB 1
		//RIFR "[" 1
		MATR ABCDDDDD 1
		MATG A 0 A_PlaySound("MP40/Reload1", 5)
		MATG A 0 A_GiveInventory ("Pumping", 1)
		MATG A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		MATG A 0 A_JumpIfInventory("MAT49Ammo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		MATG A 0 A_Takeinventory("MAT49Ammo",1)
		//MATG A 0 A_Takeinventory("DoubleMAT49Ammo",1)
		MATG A 0 { PB_SetMagUnloaded(true); }

		//MATG A 0 { PB_SetMagUnloaded(true); }

		MATG A 0 A_Giveinventory("PB_LowCalMag",1)
		Goto RemoveBullets
	FInishUnload:
		MATr EFGHIJJJJJ 1
		MATG A 0 A_Takeinventory("Unloading",1)
		Goto Ready3
	Spawn:
		WM49 A 1
		WM49 A 1 A_SpawnItemEx ("MAT49Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop
	}

}
ACTOR MAT49Ammo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 32
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 32
	Inventory.Icon "WM49A0"
}
Actor MATReloadToken : bd_Token {
}
ACTOR NeverSelectedMAT : bd_Token {
}
Actor MATSelected : bd_Token {

//ads/out

}
ACTOR MAT49PickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceMAT49! \c-(slot 2)"
	Inventory.PickupSound "ads/out"
	States
	{

	Spawn:
		P3ST A 0
		WM49 A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WM49 A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("MAT49", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("MAT49", 1)
		P3ST A 0 A_Giveinventory("PB_LowCalMag", 20)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_GiveInventory("MAT49", 20)
		Stop

}

}
