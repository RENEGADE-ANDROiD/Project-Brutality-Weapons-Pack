	TNT1 A 1
	Stop
}

}
ACTOR ShotCaseSpawn2 : RifleCaseSpawn
{
	States
	{

	Spawn:
		TNT1 A 0
		TNT1 A 1 A_CustomMissile("ShotgunCasing2",0,0,random(-80,-100),2,random(40,60))
		Stop

}

}
ACTOR IthacaPickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceIthaca 37! \c-(slot 3)"
	Inventory.PickupSound "Shotgun/Pump1"
	States
	{

	Spawn:
		P3ST A 0
		WSG1 A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WSG1 A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("Ithaca", 1, "AmmoOnly")
		P3ST A 0 A_JumpIfInventory("IthacaFlame", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("Ithaca", 1)
		P3ST A 0 A_Giveinventory("PB_Shell", 5)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_Shell", 5)
		Stop

}

}
