		FIR3 F 1 BRIGHT A_Explode(12, 64, 0, 0, 1)
		TNT1 A 0 A_CustomMissile ("IncendiaryRocketSmoke2", 1, 0, random (60, 120), 2, random (20, 90))
		TNT1 A 0 A_CustomMissile ("FlamethrowerFireParticles2", 1, 0, random (0, 360), 2, random (0, 5))
		TNT1 A 0 A_CustomMissile ("BDExplosionparticles2", 1, 0, 0, 2, random (0, 90))
