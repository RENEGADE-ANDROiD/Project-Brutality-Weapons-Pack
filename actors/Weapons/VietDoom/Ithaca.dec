Actor DragonsBreathProjectile
{
PROJECTILE
+MISSILE
Radius 4
Height 4
Speed 100
Damagetype "Fire"
Damage (random (30,30)) 
MissileType "SmallFlameTrails"
Decal "Scorch"
States
	{

    Spawn:
	    TNT1 AAAAAAAAAAA 1 A_CustomMissile ("SmallFlameTrails", 1, 0, 180, 2, random (0, 5))
		Stop
Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(64, 128, 1, 0, 1)
	EXPL AA 0 A_CustomMissile ("FlamethrowerFireParticles", 6, 0, random (0, 360), 2, random (10, 90))
	EXPL AA 0 A_CustomMissile ("BDExplosionparticles4", 1, 0, random (0, 360), 2, random (10, 90))
	EXPL AAA 0 A_CustomMissile ("BDExplosionparticlesFast", 1, 0, random (0, 360), 2, random (10, 90))
	TNT1 A 0 A_CustomMissile("FlamethrowerBurningStuff", random (-32, 0), random (-32, 32), random (-32, 32), 2, random (-32, 32))
