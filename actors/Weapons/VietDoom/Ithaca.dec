ACTOR Ithaca : PB_WeaponBase
{
	Weapon.SlotNumber 3
	Game Doom
	Weapon.AmmoType1 "PB_Shell"
	Weapon.AmmoType2 "IthacaAmmo"
	Weapon.SelectionOrder 1300
	+INVENTORY.UNDROPPABLE
	Inventory.PickupSound "Shotgun/Pump1"
	Inventory.PickupMessage "You got the \ceIthaca! \c-(slot 3)"
	Obituary "$OBBD_SHOTGUN"
	Tag "Ithaca"
	PB_WeaponBase.UsesWheel 1
	PB_WeaponBase.WheelInfo "PBWP_VietIthacaWheel"
	States
	{
	NoAmmo:
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true, ""); }
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	Inspect:
		ITCN A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		ITCN A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		ITCN A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		ITCN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		ITCN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		ITCN A 0 A_JumpIfInventory("Zoomed",1,"REady2")
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(5)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		ITCN AAA 0
		ITCN A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN A 0 A_GiveInventory("DoInspect",1)
		ITCN A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		ITCN A 0 A_TakeInventory("DoInspect",1)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		ITCN BC 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_Giveinventory("IsInspecting",1)
	ContinueInspect2:
		ITCN DDD 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Shotgun/Pump1", 5)
		ITCN EFG 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		ITCN H 2 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		ITCN H 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCN GFEDDD 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("IsInspecting",1)
		ITCN CBA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		Goto ReadyToFireAgain

	FlashKicking:
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		ITCM AB 1 A_DoPBWeaponAction
		TNT1 A 2
		ITCM CDE 1 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySound("Melee/Swing", 5)
		KNIF A 0 A_FireCustomMissile("BayoAttack", 0, 0, 0, 1)
		ITCM F 1 A_DoPBWeaponAction
		ITCM F 6 A_DoPBWeaponAction
		ITCM EDC 1 A_DoPBWeaponAction
		TNT1 A 2
		ITCM BA 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		ITCM AB 1 A_DoPBWeaponAction
		TNT1 AAAAAAAAAAAAAA 1
		Stop
		ITCM CDE 1 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySound("Melee/Swing", 5)
		KNIF A 0 A_FireCustomMissile("BayoAttack", 0, 0, 0, 1)
		ITCM F 1 A_DoPBWeaponAction
		ITCM F 6 A_DoPBWeaponAction
		ITCM EDC 1 A_DoPBWeaponAction
		TNT1 AAAAAAAAAAAAAA 1
		Stop
		ITCM BA 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		Goto FlashKicking

	Spawn:
		WSG1 A 1
		WSG1 A 1 A_SpawnItemEx ("IthacaSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop

	FirstSelectAnimation:
		ITCN A 0 A_Takeinventory("NeverSelectedIthaca",1)
		ITCN A 0 A_Takeinventory("IthacaSwitchAmmo",1)
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN ABCDD 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		ITCN A 0 A_PlaySound("Shotgun/Pump1", 5)
		ITCN EFGHHHHH 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		ITCN H 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCN GFEDDCBA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		Goto Ready3

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("SSGSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		ITCN A 0 A_Giveinventory("IthacaSelected",1)
		TNT1 A 0 A_TakeInventory("IthacaFlame", 1)
		TNT1 A 0 A_SetCrosshair(5)
		TNT1 A 1
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN A 0 A_JumpIfInventory("IthacaSwitchAmmo", 1, "FirstSelectAnimation")
		ITCN A 0 A_JumpIfInventory("NeverSelectedIthaca", 1, "FirstSelectAnimation")
			TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
			Goto Ready3
	SelectAnimation:
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty",1,2)
		ITCN A 0 A_PlaySound("Shotgun/Pump2", 1)
		ITCM CDE 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty",1,"Pump1")
		ITCN A 0 A_GunFlash
		TNT1 A 0 A_TakeInventory("RELOADING",1)
	Ready3:
	Ready:
		TNT1 A 0 A_SetCrosshair(5)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		ITCN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		ITCN A 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		BINO A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		ITCN A 0 A_JumpIfInventory("Zoomed",1,"REady2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
	OkToFire:
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		ITCN A 0
		ITCN A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_SetCrosshair(0)
		Goto Ready

	Ready2:
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump3")
		ITCN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		ITCN A 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		ITCN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		BINO A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		ITCN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		ITCN A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		ITCI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Deselect:
		ITCN A 0 A_Takeinventory("Zoomed",0)
		ITCN A 0 A_TakeInventory("TossGrenade", 0)
		ITCN A 0 A_Takeinventory("ADSmode",0)
		TNT1 A 0 A_TakeInventory("HoldInspect",0)
		TNT1 A 0 A_TakeInventory("IsInspecting",0)
		ITCN A 0 A_Takeinventory("UseShotgunStrap",0)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(5)
		ITCN A 0 A_JumpIfInventory("IthacaSwitchAmmo", 1, "DeselectInstant")
		TNT1 A 0 A_Lower(120)
		Wait

	DeselectInstant:
		ITCN A 0 A_Takeinventory("IthacaSwitchAmmo", 1)
		TNT1 A 0 A_Lower(120)
		Wait

	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true); }
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump2")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,1)
		Goto NoAmmo
		TNT1 A 0 { PB_LowAmmoSoundWarning("Shotgun"); }
		ITCN A 0 A_Takeinventory("IthacaAmmo",1)
		Goto ResumeFireFrame

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("PB_Shell",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("PB_Shell",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		ITCA A 0
		"####" A 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		"####" "#" 0 A_Quake(4,4,0,12,"")
		"####" A 0 A_AlertMonsters
		"####" A 0 A_PlaySound("Shotgun/Fire", 1)
		"####" A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_GiveInventory("IthacaWasEmpty",1)
		"####" A 0 A_ZoomFactor(0.97)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" A 0 { PB_GunSmoke(0,0,-0.9); }
		"####" A 0 { PB_GunSmoke(0,0,0.9); }
		"####" AAAAAAAAAAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" A 1 BRIGHT { PB_FireBullets("PB_12GAPellet", 5, 5, 0, 0, 2.5); }
		"####" B 1 BRIGHT { PB_FireBullets("PB_12GAPellet", 5, 2.5, 0, 0, 2.5); }
		"####" A 0 { PB_FireBullets("PB_12GAPellet", 5, 6, 0, 0, 4); }
		"####" A 0 A_SetPitch(pitch-10)
		"####" A 0 A_ZoomFactor(1.0)
		"####" C 1 A_SetPitch(-6.0 + pitch)
		"####" DE 1 A_SetPitch(+2.5 + pitch)
		ITCN A 1 A_SetPitch(+1.0 + pitch)
		"####" AAAAAA 1 A_SetPitch(pitch+0.6)
		"####" A 1 A_DoPBWeaponAction(WRF_NOPRIMARY)

	Pump1:
		ITCN A 0
		"####" A 0
		"####" A 0 A_GiveInventory ("Pumping", 1)
		"####" A 0 A_GiveInventory ("GoSpecial", 1)
		"####" A 0 A_JumpIfInventory("IthacaAmmo",1,3)
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		"####" ABCDD 1
		"####" A 0 A_Takeinventory("IthacaWasEmpty",1)
		"####" A 0 A_FireCustomMissile("ShotCaseSpawn",5,0,6,-14)
		"####" A 0 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
		"####" E 1 A_PlaySound("Shotgun/Pump1", 5)
		"####" FG 1
		"####" A 0 A_Giveinventory("IthacaWasEmpty",1)
		"####" AA 0
		"####" HHHHH 1
		"####" A 0 A_Takeinventory("IthacaWasEmpty",1)
		"####" H 0 A_PlaySound("Shotgun/Pump2", 5)
		"####" A 0 A_JumpIfInventory("NoReloading",1,13)
		"####" A 0 A_JumpIfInventory("IthacaAmmo",0,12)
		"####" GF 1 A_JumpIfInventory("Reloading",1,"ReloadFromPumping")
		"####" EDDCBA 1 A_JumpIfInventory("Reloading",1,"ReloadFromPumping")
		"####" A 0 A_JumpIfInventory("IthacaAmmo",1,2)
		"####" A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		"####" A 0
		Goto ReadyToFireAgain
		"####" AA 0
		"####" AAAA 1 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		Goto ReadyToFireAgain

	Pump2:
		ITCN A 0
		ITCN A 0 A_GiveInventory ("Pumping", 1)
		ITCN A 0 A_GiveInventory ("GoSpecial", 1)
		ITCN A 0 A_TakeInventory("Reloading", 1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IthacaAmmo",1,3)
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		ITCN dD 1
		ITCN E 1 A_PlaySound("Shotgun/Pump1", 5)
		ITCN FG 1
		ITCN A 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip22"); }
		ITCN A 0 A_FireCustomMissile("ShotCaseSpawn",5,0,6,-14)
		ITCN HHHHHGF 1
		ITCN A 0 A_Takeinventory("IthacaWasEmpty",1)
		PB_MagUnloadedSkip22:
		ITCN A 0 { PB_SetMagUnloaded(false); }

		ITCN H 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",0,18)
		ITCN ED 1 A_JumpIfInventory("Reloading",1,"ReloadFromPumping")
		ITCN DCBA 1 A_JumpIfInventory("Reloading",1,"ReloadFromPumping")
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		ITCN A 0 A_JumpIfInventory("PB_Shell",1,2)
		Goto ReadyToFireAgain
		ITCN AA 0
		ITCN A 0 A_JumpIfInventory("Reloading",1,"InsertingShells")
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,2)
		ITCN A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		ITCN A 0
		Goto ReadyToFireAgain
		ITCN AA 0
		ITCN AAA 1 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		Goto ReadyToFireAgain

	ReadyToFireAgain:
		ITCN AA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 //A_Refire
		Goto Ready3

	IsHolding:
		ITCN A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+21

	Fire2:
		ITCN A 0
		ITCN A 0 A_Takeinventory("Reloading",1)
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump3")
		ITCN A 0 A_AlertMonsters
		ITCN A 0 A_PlaySound("Shotgun/Fire", 1)
		ITCN A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		ITCN A 0 { PB_GunSmoke(0,0,-0.9); }
		ITCN A 0 { PB_GunSmoke(0,0,0.9); }
		ITCA A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#" 0 A_Quake(4,4,0,12,"")
		ITCI D 1 BRIGHT { PB_FireBullets("PB_12GAPellet", 5, 5, 0, 0, 3); }
		ITCN A 0 { PB_FireBullets("PB_12GAPellet", 5, 6, 0, 0, 3); }
		ITCN A 0 A_SetPitch(pitch-10)
		ITCN A 0 { PB_FireBullets("PB_12GAPellet", 5, 2.5, 0, 0, 2.5); }
		ITCI E 1 A_SetPitch(-8.0 + pitch)
		ITCI F 1 A_SetPitch(+2.0 + pitch)
		ITCN A 0 A_SetPitch(+2.0 + pitch)
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		ITCN A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		ITCN A 0 A_JumpIfInventory("FiredSecondary", 1, "IsHolding")
		ITCN AAA 0
		ITCI GGG 1 A_SetPitch(+2.0 + pitch)
		ITCI C 0 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
	Pump3:
		ITCI C 0
		ITCN A 0 A_JumpIfInventory("IthacaAmmo", 1, 2)
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1, 1)
		Goto NoAmmo3
		ITCN A 0 A_GiveInventory ("Pumping", 1)
		ITCN A 0 A_PlaySound("Shotgun/Pump1", 5)
		ITCI GHIIJJ 1
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty", 1, 1)
		ITCN A 0 A_TakeInventory("IthacaWasEmpty", 1)
		ITCN A 0 A_FireCustomMissile("ShotCaseSpawn",40,0,14,0)
		ITCN A 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCI IHHGG 1
		ITCI C 0
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")//If still pressing alt fire, it means its holding aim
		ITCN A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		TNT1 AAA 0
		ITCN A 0 A_REfire
		ITCN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		ITCN A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		Goto Ready2

	AltFire:
		ITCN A 0
		ITCN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		ITCN A 0 A_Giveinventory("GoSpecial",1)
		ITCN A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		ITCN A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		ITCN A 0 A_ZoomFactor(1.2)
		ITCN A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		ITCI AB 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlayWeaponSound("Shotgun/Fire/move")
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		ITCN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,3)
		ITCI C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		ITCI C 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		ITCI C 4
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		ITCI AB 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		ITCI C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		ITCN AA 0
		ITCN A 0 A_GiveInventory("ZoomHold",1)
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump3")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCN AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(5)
		TNT1 AAAAAA 0
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_ZoomFactor(1.0)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		ITCI BA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready

	ToggleNoAim:
		ITCI BA 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready
	WeaponSpecial:
		TNT1 A 0 {
			A_TakeInventory("GoWeaponSpecialAbility", 1);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_TakeInventory("ZoomHold", 1);
			A_ZoomFactor(1.0);
		}
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("SelectViet_IthacaDragon", 1, "DualWield")
		TNT1 A 0 A_JumpIfInventory("SelectViet_IthacaBuck", 1, "Ready3")
		Goto DualWield
	DualWield:
		TNT1 A 0 A_TakeInventory("StartDualWield", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_IthacaBuck", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_IthacaDragon", 1)
		TNT1 A 0
		TNT1 A 0 A_JumpIFInventory("AmmoFireShell", 1, 2)
		Goto CantSwitch
		TNT1 A 0
		TNT1 A 0 A_Print("Switching to Dragonbreath Rounds")
		Goto UnloadToSwitch

	CantSwitch:
		ITCN A 3
		TNT1 A 0 A_Print("No Dragonbreath Rounds")
		TNT1 A 0 A_PlaySound("weapons/empty", 4)
		Goto Ready3

	UnloadToSwitch:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("FiredPrimary", 1)
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,2)
		Goto FinishUnloading
		TNT1 A 0
		ITCN A 0 A_Takeinventory("IthacaAmmo",1)
		ITCN A 0 A_Giveinventory("PB_Shell",1)
		ITCN A 1
		Loop
	FinishUnloading:
		ITCN A 0
		ITCN A 0 A_Giveinventory("IthacaSwitchAmmo",1)
		TNT1 A 0 A_GiveInventory("IthacaFlame", 1)
		TNT1 A 0 A_SelectWeapon("IthacaFlame")
		Goto Ready3

	StartSprint:
		ITCN A 0 A_Takeinventory("NeverSelectedIthaca",1)
		ITCN A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		ITCM E 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(5)
	Sprinting:
		SHTA R 0 offset(-9,32)
		//ITCN A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		ITCN A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		ITCN A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		ITCN A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		ITCN A 0 offset(-9,32)
		ITCM F 1 offset(-9,34) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(-6,36) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(-3,38) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(0,38) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(3,36) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(6,34) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(9,32) A_SetPitch(pitch -0.5)
		ITCN A 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		ITCN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		ITCN A 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		ITCN A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		ITCM F 1 offset(9,34) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(6,36) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(3,38) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(0,38) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(-3,36) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(-6,34) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(-9,32) A_SetPitch(pitch +0.5)
		ITCN A 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		ITCN A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		ITCM E 1
		ITCN A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	ReloadFromPumping:
		ITCN A 0 A_Takeinventory("Reloading",1)
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"Pump2")
		ITCN A 0 A_JumpIfInventory("PB_Shell", 1, 2)
		Goto Pump2+38
		ITCN AA 0
		ITCN BCD 1
		Goto InsertingShells

	ReloadWithNoAmmoLeft:
	Reload:
		ITCN A 0
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		ITCN A 0 A_TakeInventory("Reloading", 1)
		ITCN A 0 A_JumpIfInventory("PB_Shell", 1, 2)
		Goto Ready
		ITCN AA 0
		ITCN AA 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		ITCN AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(5)
		ITCN A 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		ITCN A 0 A_JumpIfInventory("IsInspecting",1,"ContinueInspect2")
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",0,"Inspect")
		ITCN A 0 A_JumpIfInventory("IthacaAmmo", 1, "ReloadNormally")//Check if there is a shell in the chamber
		ITCN A 0 A_GiveInventory("IthacaWasEmpty", 1)//This means there is no shell in the chamber
	ReloadNormally:
		ITCN A 0 A_JumpIfInventory("PB_Shell",1,2)//If there is no reserve ammo, don't reload, go back to Ready
		Goto Ready
		ITCN AAA 0
		ITCN AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 1 A_GiveInventory ("Pumping", 1)
		ITCN BCD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN DD 1  A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	InsertingShells:
		ITCN A 0
		ITCN A 0 A_JumpIfInventory("PB_Shell",1,2)//if there are no more reserve shells, finish reload.
		Goto Pump2
		ITCN AAA 0
		ITCN A 0 A_GiveInventory ("Pumping", 1)
		SSHR AA 0 A_TakeInventory("Reloading", 1)
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"CheckIfFinishReload")
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",5,"CheckIfFinishReload")
		ITCN A 0 A_Giveinventory("IthacaAmmo",1)
		ITCN A 0 A_Takeinventory("PB_Shell",1,TIF_NOTAKEINFINITE)
	InsertShellAnimation:
		ITCN A 0
		ITCR AB 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Reload",5)
		ITCR CDEFGH 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
		ITCN AA 0 A_JumpIfInventory("Reloading", 1, "FinishedInsertingShells")
		ITCN AA 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"FinishedInsertingShells")//If there are 8+1 shells, stop it immediately
		Goto InsertingShells

	CheckIfFinishReload:
		//SSHR A 1
		ITCN AA 0 A_JumpIfInventory("IthacaWasEmpty", 1, "FinishedInsertingShells")//If shotgun was empty,
		//Play the insert shell animation again, and insert the 9th shell
		ITCN A 0 A_JumpIfInventory("PB_Shell",1,1)//if there are no more reserve shells, finish reload.
		Goto Pump2
		ITCN A 0 A_Giveinventory("IthacaAmmo",1)
		ITCN A 0 A_Takeinventory("PB_Shell",1,TIF_NOTAKEINFINITE)
		Goto InsertShellAnimation

	FinishedInsertingShells:
		ITCN AA 0 A_Takeinventory("Reloading",1)
		ITCN AA 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump2")
		ITCN DCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN AA 0 A_Takeinventory("Reloading",1)
		Goto ReadyToFireAgain

	TurboReload:
		SHSS BC 0
	TurboBullets:
		ITCN A 0
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"FinishTurboReload")
		ITCN A 0 A_JumpIfInventory("PB_Shell",1,3)
		Goto FinishTurboReload
		TNT1 AAAA 0
		ITCN A 0 A_Giveinventory("IthacaAmmo",1)
		ITCN A 0 A_Takeinventory("PB_Shell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets
	FinishTurboReload:
		ITCN A 1
		ITCN A 1 A_Refire
		Goto Ready3

	TurboReload2:
		SHSS BC 0
	TurboBullets2:
		ITCN A 0
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"FinishTurboReload")
		ITCN A 0 A_JumpIfInventory("PB_Shell",1,3)
		Goto FinishTurboReload2
		TNT1 AAAA 0
		ITCN A 0 A_Giveinventory("IthacaAmmo",1)
		ITCN A 0 A_Takeinventory("PB_Shell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets2

	FinishTurboReload2:
		ITCN A 1 A_Refire
		Goto Ready2

	User2:
	Unload:
		//ITCN A 1
		ITCN A 0 A_ZoomFactor(1.0)
		ITCN A 0 A_SetCrosshair(5)
		ITCN A 0 A_Takeinventory("Unloading",1)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		ITCN AA 0 A_JumpIfInventory("NoReloading",1,"OkToFire")
		ITCN A 0 A_GiveInventory("IthacaWasEmpty", 1)
		ITCN A 0 { PB_SetMagUnloaded(true); }

		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,3)
		Goto OkToFire
		TNT1 AAA 0
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_GiveInventory ("Pumping", 1)
		ITCN A 0 A_Takeinventory("Unloading",1)
		ITCN ABC 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RemoveBullets:
		TNT1 AAAA 0
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,3)
		ITCN A 0 A_Giveinventory("IthacaWasEmpty",1)
		Goto FinishUnload
		TNT1 AAAAAA 0
		ITCN A 0 A_Takeinventory("IthacaAmmo",1)
		ITCN A 0 A_Giveinventory("PB_Shell",1)

		ITCN DDD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Pump1", 5)
		ITCN EFG 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN HHH 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCN GFE 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN DD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("Unloading", 1,"FinishUnload")
		"####" "#" 0 A_JumpIfInventory("Reloading", 1,"FinishUnload")
		Goto RemoveBullets

	FInishUnload:
		ITCN CBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN A 0 A_Takeinventory("Unloading",1)
		Goto ReadyToFireAgain

	ReloadingKickFlash://DoKickReloading:
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_PlaySound("Kick/Swing", 5)
		TNT1 A 0 SetPlayerProperty(0,1,0)
		KICK ABC 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_Quake(2,2,0,12,"")
		KICK D 1 A_FireCustomMissile("KickAttack", 0, 0, 0, -7)
		KICK A 0 A_Takeinventory("Kicking",1)
		KICK EEEEFGHIJKLM 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 SetPlayerProperty(0,0,0)
		RIBA A 0 A_Takeinventory("Kicking",1)
		Stop//Goto InsertingShells

	DoKickReloading://ReloadingKickFlash:
		//NULL A 0 A_JumpIf (momZ > 0, "AirKick")
		//NULL A 0 A_JumpIf (momZ < 0, "AirKick")
		TNT1 A 0 A_GunFlash("ReloadingKickFlash")
		ITCN A 1 Offset(0, 34)
		ITCN A 1 Offset(0, 38)
		ITCN A 1 Offset(0, 42)
		ITCN A 4 Offset(0, 50)
		ITCN A 1 Offset(0, 42)
		ITCN A 1 Offset(0, 38)
		ITCN A 1 Offset(0, 34)
		ITCN A 4
		Goto InsertingShells//Stop

	Steady:
		TNT1 A 1
		Goto Ready
	NoAmmo3:
		RIFG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		ITCN A 4 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOPRIMARY)
		RIFG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"TurboReload2")
		TNT1 A 0 A_JumpIfInventory("NoAutoReload", 1, "NoAmmo3")
		RIFG A 0 A_JumpIfInventory("PB_Shell",1,"Reload")
		RIFG A 0 A_JumpIfInventory("FiredPrimary",1,"NoAmmo3")
		Goto Ready3

}
}
ACTOR IthacaFlame : PB_WeaponBase
{
	Weapon.SlotNumber 3
	Game Doom
	Weapon.AmmoType1 "AmmoFireShell"
	Weapon.AmmoType2 "IthacaAmmo"
	Weapon.SelectionOrder 1300
	+INVENTORY.UNDROPPABLE
	+WEAPON.CHEATNOTWEAPON
	Inventory.PickupSound "Shotgun/Pump"
	Inventory.PickupMessage "You got the Ithaca 37!"
	Obituary "$OBBD_SHOTGUN"
	Tag "Ithaca"
	PB_WeaponBase.UsesWheel 1
	PB_WeaponBase.WheelInfo "PBWP_VietIthacaWheel"
	States
	{
	NoAmmo:
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true, ""); }
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	Inspect:
		ITCN A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		ITCN A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		ITCN A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		ITCN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		ITCN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		ITCN A 0 A_JumpIfInventory("Zoomed",1,"REady2")
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(5)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		ITCN AAA 0
		ITCN A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN A 0 A_GiveInventory("DoInspect",1)
		ITCN A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		ITCN A 0 A_TakeInventory("DoInspect",1)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		ITCN BC 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_Giveinventory("IsInspecting",1)
	ContinueInspect2:
		ITCN DDD 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Shotgun/Pump1", 5)
		ITCN EFG 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		ITCN H 2 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		ITCN H 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCN GFEDDD 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("IsInspecting",1)
		ITCN CBA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		Goto ReadyToFireAgain

	FlashKicking:
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		ITCM AB 1 A_DoPBWeaponAction
		TNT1 A 2
		ITCM CDE 1 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySound("Melee/Swing", 5)
		KNIF A 0 A_FireCustomMissile("BayoAttack", 0, 0, 0, 1)
		ITCM F 1 A_DoPBWeaponAction
		ITCM F 6 A_DoPBWeaponAction
		ITCM EDC 1 A_DoPBWeaponAction
		TNT1 A 2
		ITCM BA 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		Goto FlashKicking
	FlashAirKicking:
		Goto FlashKicking

	Spawn:
		WSG1 A 1
		WSG1 A 1 A_SpawnItemEx ("IthacaSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop

	FirstSelectAnimation:
		ITCN A 0 A_Takeinventory("NeverSelectedIthaca",1)
		ITCN A 0 A_Takeinventory("IthacaSwitchAmmo",1)
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN ABCDD 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		ITCN A 0 A_PlaySound("Shotgun/Pump1", 5)
		ITCN EFGHHHHH 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		ITCN H 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCN GFEDDCBA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		Goto Ready3

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("SSGSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		ITCN A 0 A_Giveinventory("IthacaSelected",1)
		TNT1 A 0 A_TakeInventory("Ithaca", 1)
		TNT1 A 0 A_SetCrosshair(5)
		TNT1 A 1
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN A 0 A_JumpIfInventory("NeverSelectedIthaca", 1, "FirstSelectAnimation")
		ITCN A 0 A_JumpIfInventory("IthacaSwitchAmmo", 1, "FirstSelectAnimation")
			TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
			Goto Ready3
	SelectAnimation:
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty",1,2)
		ITCN A 0 A_PlaySound("Shotgun/Pump2", 1)
		ITCM CDE 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty",1,"Pump1")
		ITCN A 0 A_GunFlash
		TNT1 A 0 A_TakeInventory("RELOADING",1)
	Ready3:
	Ready:
		TNT1 A 0 A_SetCrosshair(5)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		ITCN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		ITCN A 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		BINO A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		ITCN A 0 A_JumpIfInventory("Zoomed",1,"REady2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
	OkToFire:
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		ITCN A 0
		ITCN A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_SetCrosshair(0)
		Goto Ready

	Ready2:
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump3")
		ITCN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		ITCN A 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		ITCN A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		ITCN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		ITCN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		BINO A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		ITCN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		ITCN A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		ITCI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Deselect:
		ITCN A 0 A_Takeinventory("Zoomed",0)
		ITCN A 0 A_TakeInventory("TossGrenade", 0)
		ITCN A 0 A_Takeinventory("ADSmode",0)
		TNT1 A 0 A_TakeInventory("HoldInspect",0)
		TNT1 A 0 A_TakeInventory("IsInspecting",0)
		ITCN A 0 A_Takeinventory("UseShotgunStrap",0)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(5)
		ITCN A 0 A_JumpIfInventory("IthacaSwitchAmmo", 1, "DeselectInstant")
		TNT1 A 0 A_Lower(120)
		Wait

	DeselectInstant:
		ITCN A 0 A_Takeinventory("IthacaSwitchAmmo", 1)
		TNT1 A 0 A_Lower(120)
		Wait

	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true); }
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump2")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,1)
		Goto NoAmmo
		TNT1 A 0 { PB_LowAmmoSoundWarning("Shotgun"); }
		ITCN A 0 A_Takeinventory("IthacaAmmo",1)
		Goto ResumeFireFrame

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("AmmoFireShell",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("AmmoFireShell",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		ITCA A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		ITCA A 0
		"####" A 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		"####" "#" 0 A_Quake(4,4,0,12,"")
		"####" A 0 A_AlertMonsters
		"####" A 0 A_PlaySound("Shotgun/Fire", 1)
		"####" A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_GiveInventory("IthacaWasEmpty",1)
		"####" A 0 A_ZoomFactor(0.97)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" A 0 { PB_GunSmoke(0,0,-0.9); }
		"####" A 0 { PB_GunSmoke(0,0,0.9); }
		TNT1 A 0 A_FireCustomMissile("DragonsBreathFire1", 0, 1, 0, 0, 0, 0)
		ITCA AAAA 0 A_FireCustomMissile("DragonsBreathProjectile", frandom(-6.6, 6.6), 0, 0, 0, 0, frandom(-2.6, 2.6))
		"####" AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-3,3), 0, 0, -12, 0, random(-3,3))
		//"####" A 1 BRIGHT A_FireBullets (5, 2.5, 5, 13, "ShotgunPuff", FBF_NORANDOM)
		//"####" B 1 BRIGHT A_FireBullets (2.5, 2.5, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		//"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		//"####" A 0 A_FireBullets (6, 4, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		"####" A 0 A_SetPitch(pitch-10)
		"####" A 0 A_ZoomFactor(1.0)
		"####" C 1 A_SetPitch(-6.0 + pitch)
		"####" DE 1 A_SetPitch(+2.5 + pitch)
		ITCN A 1 A_SetPitch(+1.0 + pitch)
		"####" AAAAAA 1 A_SetPitch(pitch+0.6)
		"####" A 1 A_DoPBWeaponAction(WRF_NOPRIMARY)

	Pump1:
		ITCN A 0
		"####" A 0
		"####" A 0 A_GiveInventory ("Pumping", 1)
		"####" A 0 A_GiveInventory ("GoSpecial", 1)
		"####" A 0 A_JumpIfInventory("IthacaAmmo",1,3)
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		"####" ABCDD 1
		"####" A 0 A_Takeinventory("IthacaWasEmpty",1)
		"####" A 0 A_FireCustomMissile("ShotCaseSpawn2",5,0,6,-14)
		"####" A 0 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
		"####" E 1 A_PlaySound("Shotgun/Pump1", 5)
		"####" FG 1
		"####" A 0 A_Giveinventory("IthacaWasEmpty",1)
		"####" AA 0
		"####" HHHHH 1
		"####" A 0 A_Takeinventory("IthacaWasEmpty",1)
		"####" H 0 A_PlaySound("Shotgun/Pump2", 5)
		"####" A 0 A_JumpIfInventory("NoReloading",1,13)
		"####" A 0 A_JumpIfInventory("IthacaAmmo",0,12)
		"####" GF 1 A_JumpIfInventory("Reloading",1,"ReloadFromPumping")
		"####" EDDCBA 1 A_JumpIfInventory("Reloading",1,"ReloadFromPumping")
		"####" A 0 A_JumpIfInventory("IthacaAmmo",1,2)
		"####" A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		"####" A 0
		Goto ReadyToFireAgain
		"####" AA 0
		"####" AAAA 1 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		Goto ReadyToFireAgain

	Pump2:
		ITCN A 0
		ITCN A 0 A_GiveInventory ("Pumping", 1)
		ITCN A 0 A_GiveInventory ("GoSpecial", 1)
		ITCN A 0 A_TakeInventory("Reloading", 1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IthacaAmmo",1,3)
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		ITCN DD 1
		ITCN E 1 A_PlaySound("Shotgun/Pump1", 5)
		ITCN FG 1
		ITCN A 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip21"); }
		ITCN A 0 A_FireCustomMissile("ShotCaseSpawn2",5,0,6,-14)
		ITCN HHHHHGF 1
		ITCN A 0 A_Takeinventory("IthacaWasEmpty",1)
		PB_MagUnloadedSkip21:
		ITCN A 0 { PB_SetMagUnloaded(false); }

		ITCN H 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",0,18)
		ITCN ED 1 A_JumpIfInventory("Reloading",1,"ReloadFromPumping")
		ITCN DCBA 1 A_JumpIfInventory("Reloading",1,"ReloadFromPumping")
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		ITCN A 0 A_JumpIfInventory("AmmoFireShell",1,2)
		Goto ReadyToFireAgain
		ITCN AA 0
		ITCN A 0 A_JumpIfInventory("Reloading",1,"InsertingShells")
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,2)
		ITCN A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		ITCN A 0
		Goto ReadyToFireAgain
		ITCN AA 0
		ITCN AAA 1 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		Goto ReadyToFireAgain

	ReadyToFireAgain:
		ITCN AA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 //A_Refire
		Goto Ready3

	IsHolding:
		ITCN A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+21

	Fire2:
		ITCN A 0
		ITCN A 0 A_Takeinventory("Reloading",1)
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump3")
		ITCN A 0 A_AlertMonsters
		ITCN A 0 A_PlaySound("Shotgun/Fire", 1)
		ITCN A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		ITCN A 0 { PB_GunSmoke(0,0,-0.9); }
		ITCN A 0 { PB_GunSmoke(0,0,0.9); }
		ITCA A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		//TNT1 AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-5,5), 0, 0, 0, 0, random(-5,5))
		"####" "#" 0 A_Quake(4,4,0,12,"")
		ITCI D 1 BRIGHT
		TNT1 A 0 A_FireCustomMissile("DragonsBreathFire1", 0, 1, 0, 0, 0, 0)
		ITCA AAAA 0 A_FireCustomMissile("DragonsBreathProjectile", frandom(-4.6, 4.6), 0, 0, 0, 0, frandom(-2.2, 2.2))
		ITCN A 0 A_SetPitch(pitch-10)
		ITCI E 1 A_SetPitch(-8.0 + pitch)
		ITCI F 1 A_SetPitch(+2.0 + pitch)
		ITCN A 0 A_SetPitch(+2.0 + pitch)
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		ITCN A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		ITCN A 0 A_JumpIfInventory("FiredSecondary", 1, "IsHolding")
		ITCN AAA 0
		ITCI GGG 1 A_SetPitch(+2.0 + pitch)
		ITCI C 0 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
	Pump3:
		ITCI C 0
		ITCN A 0 A_JumpIfInventory("IthacaAmmo", 1, 2)
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1, 1)
		Goto NoAmmo3
		ITCN A 0 A_GiveInventory ("Pumping", 1)
		ITCN A 0 A_PlaySound("Shotgun/Pump1", 5)
		ITCI GHIIJJ 1
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty", 1, 1)
		ITCN A 0 A_TakeInventory("IthacaWasEmpty", 1)
		ITCN A 0 A_FireCustomMissile("ShotCaseSpawn2",40,0,14,0)
		ITCN A 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCI IHHGG 1
		ITCI C 0
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")//If still pressing alt fire, it means its holding aim
		ITCN A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		TNT1 AAA 0
		ITCN A 0 A_REfire
		ITCN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		ITCN A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		Goto Ready2

	AltFire:
		ITCN A 0
		ITCN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		ITCN A 0 A_Giveinventory("GoSpecial",1)
		ITCN A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		ITCN A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		ITCN A 0 A_ZoomFactor(1.2)
		ITCN A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		ITCI AB 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlayWeaponSound("Shotgun/Fire/move")
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		ITCN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,3)
		ITCI C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		ITCI C 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		ITCI C 4
		ITCN A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		ITCI AB 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		ITCI C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		ITCN AA 0
		ITCN A 0 A_GiveInventory("ZoomHold",1)
		ITCN A 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump3")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		ITCN A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		ITCN AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(5)
		TNT1 AAAAAA 0
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_ZoomFactor(1.0)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		ITCN A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		ITCI BA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready

	ToggleNoAim:
		ITCI BA 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready
	WeaponSpecial:
		TNT1 A 0 {
			A_TakeInventory("GoWeaponSpecialAbility", 1);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_TakeInventory("ZoomHold", 1);
			A_ZoomFactor(1.0);
		}
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("SelectViet_IthacaBuck", 1, "DualWield")
		TNT1 A 0 A_JumpIfInventory("SelectViet_IthacaDragon", 1, "Ready3")
		Goto DualWield
	DualWield:
		TNT1 A 0 A_TakeInventory("StartDualWield", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_IthacaBuck", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_IthacaDragon", 1)
		TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("PB_Shell", 1, 2)
		Goto CantSwitch
		TNT1 A 0
		TNT1 A 0 A_Print("Switching to Buckshot Rounds")
		Goto UnloadToSwitch

	CantSwitch:
		ITCN A 3
		TNT1 A 0 A_Print("No Buckshot Rounds")
		TNT1 A 0 A_PlaySound("weapons/empty", 4)
		Goto Ready3

	UnloadToSwitch:
		TNT1 A 0
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_TakeInventory("FiredPrimary", 1)
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,2)
		Goto FinishUnloading
		TNT1 A 0
		ITCN A 0 A_Takeinventory("IthacaAmmo",1)
		ITCN A 0 A_Giveinventory("AmmoFireShell",1)
		ITCN A 1
		Loop
	FinishUnloading:
		TNT1 A 0 A_GiveInventory("IthacaSwitchAmmo", 1)
		TNT1 A 0 A_GiveInventory("Ithaca", 1)
		TNT1 A 0 A_SelectWeapon("Ithaca")
		Goto Ready3

	StartSprint:
		ITCN A 0 A_Takeinventory("NeverSelectedIthaca",1)
		ITCN A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		ITCM E 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(5)
	Sprinting:
		SHTA R 0 offset(-9,32)
		//ITCN A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		ITCN A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		ITCN A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		ITCN A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		ITCN A 0 offset(-9,32)
		ITCM F 1 offset(-9,34) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(-6,36) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(-3,38) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(0,38) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(3,36) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(6,34) A_SetPitch(pitch -0.5)
		ITCM F 1 offset(9,32) A_SetPitch(pitch -0.5)
		ITCN A 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		ITCN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		ITCN A 0 A_JumpIfInventory("Reloading",1,"Reload")
		ITCN A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		ITCN A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		ITCM F 1 offset(9,34) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(6,36) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(3,38) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(0,38) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(-3,36) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(-6,34) A_SetPitch(pitch +0.5)
		ITCM F 1 offset(-9,32) A_SetPitch(pitch +0.5)
		ITCN A 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		ITCN A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		ITCM E 1
		ITCN A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	ReloadFromPumping:
		ITCN A 0 A_Takeinventory("Reloading",1)
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"Pump2")
		ITCN A 0 A_JumpIfInventory("AmmoFireShell", 1, 2)
		Goto Pump2+38
		ITCN AA 0
		ITCN BCD 1
		Goto InsertingShells

	ReloadWithNoAmmoLeft:
	Reload:
		ITCN A 0
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		ITCN A 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		ITCN A 0 A_JumpIfInventory("AmmoFireShell", 1, 2)
		Goto Ready
		ITCN AA 0
		ITCN AA 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		ITCN AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(5)
		ITCN A 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		ITCN A 0 A_JumpIfInventory("IsInspecting",1,"ContinueInspect2")
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",0,"Inspect")
		ITCN A 0 A_JumpIfInventory("IthacaAmmo", 1, "ReloadNormally")//Check if there is a shell in the chamber
		ITCN A 0 A_GiveInventory("IthacaWasEmpty", 1)//This means there is no shell in the chamber
	ReloadNormally:
		ITCN A 0 A_JumpIfInventory("AmmoFireShell",1,2)//If there is no reserve ammo, don't reload, go back to Ready
		Goto Ready
		ITCN AAA 0
		ITCN AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 1 A_GiveInventory ("Pumping", 1)
		ITCN BCD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN DD 1  A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	InsertingShells:
		ITCN A 0
		ITCN A 0 A_JumpIfInventory("AmmoFireShell",1,2)//if there are no more reserve shells, finish reload.
		Goto Pump2
		ITCN AAA 0
		ITCN A 0 A_GiveInventory ("Pumping", 1)
		SSHR AA 0 A_TakeInventory("Reloading", 1)
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"CheckIfFinishReload")
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",5,"CheckIfFinishReload")
		ITCN A 0 A_Giveinventory("IthacaAmmo",1)
		ITCN A 0 A_Takeinventory("AmmoFireShell",1,TIF_NOTAKEINFINITE)
	InsertShellAnimation:
		ITCN A 0
		ITCR AB 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Reload",5)
		ITCR CDEFGH 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
		ITCN AA 0 A_JumpIfInventory("Reloading", 1, "FinishedInsertingShells")
		ITCN AA 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"FinishedInsertingShells")//If there are 8+1 shells, stop it immediately
		Goto InsertingShells

	CheckIfFinishReload:
		//SSHR A 1
		ITCN AA 0 A_JumpIfInventory("IthacaWasEmpty", 1, "FinishedInsertingShells")//If shotgun was empty,
		//Play the insert shell animation again, and insert the 9th shell
		ITCN A 0 A_JumpIfInventory("AmmoFireShell",1,1)//if there are no more reserve shells, finish reload.
		Goto Pump2
		ITCN A 0 A_Giveinventory("IthacaAmmo",1)
		ITCN A 0 A_Takeinventory("AmmoFireShell",1,TIF_NOTAKEINFINITE)
		Goto InsertShellAnimation

	FinishedInsertingShells:
		ITCN AA 0 A_Takeinventory("Reloading",1)
		ITCN AA 0 A_JumpIfInventory("IthacaWasEmpty", 1, "Pump2")
		ITCN DCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN AA 0 A_Takeinventory("Reloading",1)
		Goto ReadyToFireAgain

	TurboReload:
		SHSS BC 0
	TurboBullets:
		ITCN A 0
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"FinishTurboReload")
		ITCN A 0 A_JumpIfInventory("AmmoFireShell",1,3)
		Goto FinishTurboReload
		TNT1 AAAA 0
		ITCN A 0 A_Giveinventory("IthacaAmmo",1)
		ITCN A 0 A_Takeinventory("AmmoFireShell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets
	FinishTurboReload:
		ITCN A 1
		ITCN A 1 A_Refire
		Goto Ready3

	TurboReload2:
		SHSS BC 0
	TurboBullets2:
		ITCN A 0
		ITCN AA 0 A_JumpIfInventory("IthacaAmmo",0,"FinishTurboReload")
		ITCN A 0 A_JumpIfInventory("AmmoFireShell",1,3)
		Goto FinishTurboReload2
		TNT1 AAAA 0
		ITCN A 0 A_Giveinventory("IthacaAmmo",1)
		ITCN A 0 A_Takeinventory("AmmoFireShell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets2

	FinishTurboReload2:
		ITCN A 1 A_Refire
		Goto Ready2

	User2:
	Unload:
		//ITCN A 1
		ITCN A 0 A_ZoomFactor(1.0)
		ITCN A 0 A_SetCrosshair(5)
		ITCN A 0 A_Takeinventory("Unloading",1)
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		ITCN AA 0 A_JumpIfInventory("NoReloading",1,"OkToFire")
		ITCN A 0 A_GiveInventory("IthacaWasEmpty", 1)
		ITCN A 0 { PB_SetMagUnloaded(true); }

		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,3)
		Goto OkToFire
		TNT1 AAA 0
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_GiveInventory ("Pumping", 1)
		ITCN A 0 A_Takeinventory("Unloading",1)
		ITCN ABC 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RemoveBullets:
		TNT1 AAAA 0
		ITCN A 0 A_JumpIfInventory("IthacaAmmo",1,3)
		ITCN A 0 A_Giveinventory("IthacaWasEmpty",1)
		Goto FinishUnload
		TNT1 AAAAAA 0
		ITCN A 0 A_Takeinventory("IthacaAmmo",1)
		ITCN A 0 A_Giveinventory("AmmoFireShell",1)

		ITCN DDD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Pump1", 5)
		ITCN EFG 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN HHH 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Pump2", 5)
		ITCN GFE 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN DD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("Unloading", 1,"FinishUnload")
		"####" "#" 0 A_JumpIfInventory("Reloading", 1,"FinishUnload")
		Goto RemoveBullets

	FInishUnload:
		ITCN CBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		ITCN A 0 A_Takeinventory("Unloading",1)
		Goto ReadyToFireAgain

	ReloadingKickFlash://DoKickReloading:
		ITCN A 0 A_Takeinventory("ADSmode",1)
		ITCN A 0 A_Takeinventory("Zoomed",1)
		ITCN A 0 A_Takeinventory("ZoomHold",1)
		ITCN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_PlaySound("Kick/Swing", 5)
		TNT1 A 0 SetPlayerProperty(0,1,0)
		KICK ABC 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_Quake(2,2,0,12,"")
		KICK D 1 A_FireCustomMissile("KickAttack", 0, 0, 0, -7)
		KICK A 0 A_Takeinventory("Kicking",1)
		KICK EEEEFGHIJKLM 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 SetPlayerProperty(0,0,0)
		RIBA A 0 A_Takeinventory("Kicking",1)
		Stop//Goto InsertingShells

	DoKickReloading://ReloadingKickFlash:
		//NULL A 0 A_JumpIf (momZ > 0, "AirKick")
		//NULL A 0 A_JumpIf (momZ < 0, "AirKick")
		TNT1 A 0 A_GunFlash("ReloadingKickFlash")
		ITCN A 1 Offset(0, 34)
		ITCN A 1 Offset(0, 38)
		ITCN A 1 Offset(0, 42)
		ITCN A 4 Offset(0, 50)
		ITCN A 1 Offset(0, 42)
		ITCN A 1 Offset(0, 38)
		ITCN A 1 Offset(0, 34)
		ITCN A 4
		Goto InsertingShells//Stop

	Steady:
		TNT1 A 1
		Goto Ready
	NoAmmo3:
		919A A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		ITCN A 4 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOPRIMARY)
		RIFG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"TurboReload2")
		TNT1 A 0 A_JumpIfInventory("NoAutoReload", 1, "NoAmmo3")
		RIFG A 0 A_JumpIfInventory("AmmoFireShell",1,"Reload")
		RIFG A 0 A_JumpIfInventory("FiredPrimary",1,"NoAmmo3")
		Goto Ready3

}
}
ACTOR IthacaAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 6
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 6
	Inventory.Icon "WSG1A0"
}

ACTOR AmmoFireShell : Ammo
{
	Inventory.PickupMessage "You got the incendiary shells!"
	Inventory.Amount 4
	Inventory.MaxAmount 50
	Ammo.BackpackAmount 6
	Ammo.BackpackMaxAmount 50
	Inventory.Icon "SHELX0"
	Inventory.Pickupsound "SHELPK1"
	Scale 0.8
	States
	{

	Spawn:
		SHEL X -1
		Stop

}

}
