// VietDoom BD player/weapon tokens and spawners not shipped in PB Staging.

ACTOR TokenCleaner : bd_Token
{
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("Zoomed", 1)
		TNT1 A 0 A_TakeInventory("ZoomHold", 1)
		TNT1 A 0 A_TakeInventory("ADSmode", 1)
		TNT1 A 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_TakeInventory("FiredPrimary", 1)
		TNT1 A 0 A_TakeInventory("FiredSecondary", 1)
		TNT1 A 0 A_TakeInventory("GoSpecial", 1)
		TNT1 A 0 A_TakeInventory("Reloading", 1)
		TNT1 A 0 A_TakeInventory("Unloading", 1)
		TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility", 1)
		TNT1 A 0 A_GiveInventory("ResetZoom", 1)
		TNT1 A 0 A_TakeInventory("TokenCleaner", 1)
		Stop
	}
}
