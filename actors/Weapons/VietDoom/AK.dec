ACTOR AK : PB_WeaponBase
{
	Weapon.SlotNumber 4
	Weapon.AmmoType1 "PB_HighCalMag"
	Weapon.AmmoType2 "AKAmmo"
	Weapon.AmmoGive1 0
	Weapon.SelectionOrder 700
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \ceAK! \c-(slot 4)"
	Obituary "$OBBD_RIFLE"
	Tag "AK47"
	States
	{
	NoAmmo:
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		AKMS J 0 { PB_JumpIfMagUnloaded("KickFlashUnLoaded"); }
		AKMS AB 1 A_DoPBWeaponAction
		AKMS C 14 A_DoPBWeaponAction
		AKMS BA 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		AKMS J 0 { PB_JumpIfMagUnloaded("KickFlashUnLoaded"); }
		AKMS AB 1 A_DoPBWeaponAction
		AKMS C 14 A_DoPBWeaponAction
		AKMS BA 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		AKMS J 0 { PB_JumpIfMagUnloaded("SlideFlashUnLoaded"); }
		AKMS AB 1 A_DoPBWeaponAction
		AKMS C 14 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		AKMS J 0 { PB_JumpIfMagUnloaded("SlideFlashEndLoaded"); }
		AKMS c 7 A_DoPBWeaponAction
		AKMS BA 1 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		AKMS J 0 { PB_JumpIfMagUnloaded("SlideFlashEndEarlyLoaded"); }
		AKMS c 4
		AKMS AB 1
		Stop
	KickFlashUnLoaded: 
		AKMS de 1
		AKMS f 14
		AKMS ed 1
		Goto Ready3
	SlideFlashUnLoaded:
		AKMS de 1
		AKMS f 36
		Goto Ready3
	SlideFlashEndLoaded: 
		AKMS f 7
		AKMS ed 1
		Goto Ready3
	SlideFlashEndEarlyLoaded: 
		AKMS f 4
		AKMS ed 1
		Goto Ready3

	StartSprint:
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16G A 0 A_Takeinventory("ADSmode",1)
		M16G A 0 A_ZoomFactor(1.0)
		AKMG A 0 A_TakeInventory("NeverSelectedAK",1)
		AKMG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		AKMS A 0 { PB_JumpIfMagUnloaded("StartSprintUnLoaded"); }
		AKMS "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Sprinting
	StartSprintUnLoaded:
		AKMS "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Sprinting:
		AKMG A 0 offset(-9,32)
		//AKMS E 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		AKMS E 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		AKMS E 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		AKMS E 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		AKMS E 0 offset(-9,32)
		AKMS D 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip20"); }
		AKMS A 0
		AKMS "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		AKMS "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		PB_MagUnloadedSkip20:
		AKMS "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		AKMS "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		AKMS "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		AKMS "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		AKMS "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		AKMS "#" 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		AKMS "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		AKMS "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		AKMS "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		AKMS "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		AKMS "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		AKMS "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		AKMS "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		AKMS "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		AKMS "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		AKMS "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		AKMS "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		AKMS "#" 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		AKMS "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint
	StopSprint:
		AKMg A 0 { PB_JumpIfMagUnloaded("StopSprintUnLoaded"); }
		AKMg A 1
		AKMg A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	StopSprintUnLoaded:
		AKMG A 1
		AKMG A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("AKMSelected",1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("NeverSelectedAK", 1, "FirstSelectAnimation")
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
				Goto Ready3

	SelectAnimation:
		PIST E 0 A_PlaySound("rifle/select", 5)	
		PISS A 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip19"); }
		Goto SelectAnimationLoaded
		TNT1 AA 0
		AKMS FED 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("StartDualWield",1)
		PB_MagUnloadedSkip19:
		Goto Ready

	SelectAnimationLoaded:
		AKMS CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready3

	FirstSelectAnimation:
		TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		AKMG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("JustStartedGame", 1,"warmUp")
		TNT1 A 0 A_JumpIfInventory("NeverSelectedAK", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 2 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Tacticalselect:
		TNT1 A 0 A_TakeInventory("NeverSelectedAK",1)
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		AKRL I 8 A_WEAPONREADY(WRF_ALLOWZOOM)
		AKRL JKL 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("Rifle/Reload2", 5)
		AKRL FEEDDDCBA 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		AKRL MMMM 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		AKRL NOPQQQQRS 1
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		AKRL T 5 A_WEAPONREADY(WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("rifle/Bolt2", 5)
		AKRL N 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		AKRL M 5 A_WEAPONREADY(WRF_ALLOWZOOM)
		AKMG A 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		Goto Ready3

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		AKMG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		AKMG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		AKMG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		AKMG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		AKMG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		AKMG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		AKMG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		AKMG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		AKMG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		AKMG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		AKMG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		AKMG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		AKMG A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		Loop

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M16G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RI2G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RI2G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		AKMG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		AKMG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		AKMG A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RI2G A 0 A_TakeInventory("UsedStamina", 2)
		AKMI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		Loop

	Deselect:
		AKMG A 0 A_Takeinventory("Zoomed",1)
		AKMG A 0 A_Takeinventory("ADSmode",1)
		AKMG A 0 A_TakeInventory("TossGrenade", 1)
		AKMG A 0 A_TakeInventory("Kicking",1)
		AKMG A 0 A_TakeInventory("Taunting",1)
		AKMG A 0 A_TakeInventory("Reloading",1)
		AKMG A 0 A_TakeInventory("Unloading",1)
		AKMG A 0 A_TakeInventory("DropIt", 1)
		AKMG A 0 A_TakeInventory("Salute1", 1)
		AKMG A 0 A_TakeInventory("Salute2", 1)
		AKMG A 0 A_Takeinventory("AKMSelected",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		AKMG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		PISS E 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip18"); }
		Goto DeselectLoaded
		AKMS E 0
	DeselectContinue:
		"####" DEF 1
				TNT1 A 0 A_Lower(120)
		PB_MagUnloadedSkip18:
		TNT1 A 0 A_Lower(120)
		Wait
	DeselectLoaded:
		AKMS ABC 1
		TNT1 A 0 A_Lower(120)
		Wait


	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		AKMI C 0 A_JumpIfInventory("Zoomed",1,13)
		AKMG A 0
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" A 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("AKAmmo",1,1)
		Goto NoAmmo
		"####" "#" 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 3)
		"####" "#" 0 A_JumpIfInventory("AKDurability",1,1)
		Goto GunBroken
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("AKDurability",35,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "#" 0
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("AKAmmo",1)
		"####" "#" 0 A_JumpIfInventory("AKAmmo",7,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("AKAmmo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("PB_HighCalMag",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("PB_HighCalMag",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		AKMG AAAA 0
		2IFF A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFF A 0
		AKMG A 0 A_AlertMonsters
		AKMG A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		AKMG A 0 A_PlaySound("AKMFire", 1)
		AKMG "#" 0 A_Quake(1,3,0,4,"")
		AKMG A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		AKMG "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		AKMG "#" 0 { PB_GunSmoke(0,0,0); }
		AKMG "#" 0 A_FireCustomMissile("AK47Tracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		//AKMG A 0 A_JumpIfInventory("PSeq3", 1, "SpriteVariant")
		//AKMG A 0 A_GiveInventory("PSeq3",1)
		AKMF A 1 BRIGHT A_FireBullets (4, 4, -1, 30, "HitPuff", FBF_NORANDOM)
	FinishFire:
		AKMG A 0 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		AKMF B 1 A_ZoomFactor(0.95)
		AKMG A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		AKMG A 0 A_SetPitch(pitch-2.0)
		AKMF C 1 
		AKMF D 1 A_ZoomFactor(1.0)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		AKMG A 0
		AKMG A 0 A_JumpIfInventory("IsTacticalClass", 1, "Ready")//Tactical mode skips a frame, fires faster
		AKMG A 1
		AKMG A 0 A_Refire
		Goto Ready

	IsHolding:
		AKMG A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+11
	Fire2:
		AKMG A 0
		AKMG A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		AKMG A 0 { PB_GunSmoke(0,0,0); }
		RI2F A 0 BRIGHT A_FireCustomMissile("AK47Tracer", 0, 0, 0, 0)
		AKMI d 1 BRIGHT A_FireBullets (2, 2, -1, 30, "HitPuff", FBF_NORANDOM)
		AKMG A 0 A_ZoomFactor(1.92)
		AKMG A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)
		AKMi E 1 A_SetPitch(pitch-1.25)
		AKMI F 1 A_FireCustomMissile("RifleCaseSpawn",1,0,8,0)
		AKMi G 1 A_ZoomFactor(2.0)
		AKMG A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		AKMI C 1
		AKMG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		RI2F A 0 A_GiveInventory("FireFrameCount", 1)
		AKMG A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")//If still pressing alt fire, it means its holding aim
		AKMG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		TNT1 AAA 0
		RI2G A 0 A_ReFire
		AKMI c 10 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		AKMG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		AKMG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		AKMG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		AKMG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RI2G A 0
		Goto Ready2

	AltFire:
		AKMG A 0
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		//AKMG A 0 A_TakeInventory("FiredMGGrenade",1)
		AKMG A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		AKMG A 0 A_Giveinventory("GoSpecial",1)
		AKMG A 0 A_Giveinventory("Zoomed",1)
		//AKMG A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(41)
		AKMG A 0 A_ZoomFactor(2.0)
		AKMG A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		AKMG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		AKMI ABC 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlaySound("weapons/rifle/move")
		AKMG A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		AKMG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		AKMG A 0 A_JumpIfInventory("FiredSecondary",1,3)
		AKMi C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		AKMi C 4
		AKMG A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		AKMI ABC 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		AKMI C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		AKMG A 0
		AKMG A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		RI2G A 0 A_JumpIfInventory("TossGrenade",1,"FireGrenade")
		//RI2G A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		//TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		AKMG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		AKMI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		AKMG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		AKMI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		AKMG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		AKMI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		AKMG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		//AKMG A 0 A_JumpIfInventory("NoAutoReload",1,2)
		//AKMG A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		AKMG AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(7)
		AKMG A 0
		AKMG A 0 A_Takeinventory("Zoomed",1)
		AKMG A 0 A_Takeinventory("ZoomHold",1)
		AKMG A 0 A_ZoomFactor(1.0)
		AKMG A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		AKMG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		AKMI cBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		AKMG "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		AKMG A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		AKMI CBA 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		AKMG "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		AKMG A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	//Inspecting anim (also repurposed as rechambering)
	Inspect:
		AKMG A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		AKMG A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		AKMG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		AKMG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		AKMG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		AKMG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		AKMG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		AKMG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		AKMG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		AKMG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		AKMG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		AKMG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		AKMG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		//AKMG A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		AKMG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		AKMG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		AKMG A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		AKMG A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		AKMG A 0 A_GiveInventory("DoInspect",1)
		AKMG A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		AKMG A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		AKMG A 0 A_TakeInventory("DoInspect",1)
		AKMG A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		AKMG a 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		AKMG "#" 0 A_Giveinventory("IsInspecting",1)
		AKRL M 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		AKMG "#" 0 A_TakeInventory("AKReloadToken",1)
		AKRL NOPQQQQRS 1
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		AKRL T 3 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("rifle/Bolt2", 5)
		AKRL N 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		AKRL M 5 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		AKMG "#" 0 A_Takeinventory("IsInspecting",1)
		AKMG "#" 0 A_TakeInventory("AKReloadToken",1)
		//AKRL BA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		AKMG "#" 0 A_Takeinventory("IsInspecting",1)
		AKMG "#" 0 A_TakeInventory("AKReloadToken",1)
		AKMG "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectRechamber:
		AKMG A 0 A_TakeInventory("DoInspect",1)
		AKRL ab 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		AKMG a 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		AKMG "#" 0 A_Giveinventory("IsInspecting",1)
		AKRL M 5 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		AKMG "#" 0 A_TakeInventory("AKReloadToken",1)
		AKRL NOPQQQQRS 1
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
		AKRL T 5 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("rifle/Bolt2", 5)
		AKRL N 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		AKRL M 5 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		AKMG "#" 0 A_Takeinventory("IsInspecting",1)
		AKMG "#" 0 A_TakeInventory("AKReloadToken",1)
		//AKRL ba 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		AKMG "#" 0 A_Takeinventory("IsInspecting",1)
		AKMG "#" 0 A_TakeInventory("AKReloadToken",1)
		AKMG "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready
	FullReload:
		AKMG A 0 A_ClearReFire
		AKMG A 0 { PB_SetMagUnloaded(false); }


		AKMG A 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	Reload:
		AKMG "#" 0 A_TakeInventory("RifleSpread", 10)
		AKMG "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		AKMG "#" 0 A_Takeinventory("Reloading",1)
		AKMG "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		AKMG "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		AKMG "#" 0 A_JumpIfInventory("PB_HighCalMag",1,3)
		Goto Ready
		TNT1 AAA 0
		AKMG "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		AKMG "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")
		AKMG A 0 A_JumpIfInventory("AKAmmo",0,"Inspect")
		AKMG A 0 A_JumpIfInventory("AKReloadToken",1,"Inspect")
		AKMG A 0 A_Takeinventory("Reloading",1)
		AKMG A 0 A_Takeinventory("ADSmode",1)
		AKMG A 0 A_Takeinventory("Zoomed",1)
		AKMG A 0 A_Takeinventory("ZoomHold",1)
		AKMG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//AKMG A 3 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		AKMG A 0 A_Takeinventory("ADSmode",1)
		AKMG A 0 A_Takeinventory("Zoomed",1)
		AKMG A 0 A_Takeinventory("ZoomHold",1)
		AKMG A 0 { PB_JumpIfMagUnloaded("ReloadFromEmpty"); }
		AKMG A 0 A_GiveInventory ("Pumping", 1)
		AKMG A 0 A_Takeinventory("Reloading",1)
		AKRL ABCDDDEE 1
		AKMG A 0 A_PlaySound("Rifle/Reload1", 5)
		AKRL F 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		AKMG A 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip17"); }
		AKRL GH 1
		AKRL I 8 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR G 0 A_FireCustomMissile("EmptyClipSpawn",-5,0,8,-4)
	PB_MagUnloadedSkip17:
	ReloadFromEmpty:
		AKRL I 8 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		AKRL JKL 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("Rifle/Reload2", 5)
		AKRL FEEDDDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		AKMG A 0 A_JumpIfInventory("AKAmmo",1,"InsertBullets2")//30+1 effect
		TNT1 A 0 A_GiveInventory("AKReloadToken",1)
		Goto InsertBullets

	FinishReloading:
		AKMG A 0 A_ClearReFire
		AKRL MMMM 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		AKRL NOPQQQQRS 1
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		AKRL T 5 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2IFR A 0 A_PlaySound("rifle/Bolt2", 5)
		AKRL N 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		AKRL M 5 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("AKReloadToken",1)
		AKMG A 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		//AKRL EDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	InsertBullets:
		TNT1 AAAA 0
		AKMG A 0 A_JumpIfInventory("AKAmmo",30,15)
		AKMG A 0 A_JumpIfInventory("PB_HighCalMag",1,3)
		Goto FinishReloading
		TNT1 AAAAAA 0
		AKMG A 0 A_Giveinventory("AKAmmo",1)
		//AKMG A 0 A_Giveinventory("DoubleAKAmmo",1)
		AKMG A 0 { PB_SetMagUnloaded(false); }


		//AKMG A 0 { PB_SetMagUnloaded(false); }


		AKMG A 0 A_Takeinventory("PB_HighCalMag",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		AKMG A 0 A_Takeinventory("Reloading",1)
		AKMG A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto FinishReloading
		TNT1 AAAA 0
		AKMG A 0 A_Takeinventory("Reloading",1)
		AKMG A 0 //A_Refire
		Goto FinishReloading

	InsertBullets2:
		TNT1 AAAA 0
		AKMG A 0 A_JumpIfInventory("AKAmmo",0,15)
		AKMG A 0 A_JumpIfInventory("PB_HighCalMag",1,3)
		Goto FullReload
		TNT1 AAAAAA 0
		AKMG A 0 A_Giveinventory("AKAmmo",1)
		//AKMG A 0 A_Giveinventory("DoubleAKAmmo",1)
		AKMG A 0 A_Takeinventory("PB_HighCalMag",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2
		TNT1 AAAAAAAAAA 0
		AKMG A 0 A_Takeinventory("Reloading",1)
		AKMG A 0 //A_Refire
		Goto FullReload
		TNT1 AAAA 0
		AKMG A 0 A_Takeinventory("Reloading",1)
		AKMG A 0 //A_Refire
		Goto FullReload

	ReloadConcluded:
		AKMG A 2
		AKMG "#" 0 A_TakeInventory("AKReloadToken",1)
		AKMG A 0 A_Refire
		Goto Ready3

	User2:
	Unload:
		AKMG "#" 0 A_Takeinventory("Unloading",1)
		AKMG "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		AKMG "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		AKMG "#" 0 A_JumpIfInventory("AKAmmo",1,3)
		Goto Ready
		TNT1 AAA 0
		AKMG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		AKMG A 0 A_Takeinventory("Unloading",1)
		AKMG A 0 A_Takeinventory("ADSmode",1)
		AKMG A 0 A_Takeinventory("Zoomed",1)
		AKRL ABCDDEEFF 1
		AKMG A 0 A_PlaySound("Rifle/Reload1", 5)
		AKMG A 0 A_GiveInventory ("Pumping", 1)
		AKMG A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		AKMG A 0 A_JumpIfInventory("AKAmmo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		AKMG A 0 A_Takeinventory("AKAmmo",1)
		AKMG A 0 { PB_SetMagUnloaded(true); }


		AKMG A 0 A_Giveinventory("PB_HighCalMag",1)
		Goto RemoveBullets
	FInishUnload:
		AKRL GHIIII 1
		AKMG A 0 A_Takeinventory("Unloading",1)
		Goto Ready3
	GunBroken:
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 1 A_WeaponReady(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 0 A_Print("Your rifle has been destroyed!\n\n\n\n\n\n\n")
		"####" "#" 0 A_GiveInventory("AKDestroyed", 1)
		"####" "#" 0 A_PlaySound("DSBRK2")
		"####" "#" 0 A_Quake(4,5,0,12,"")
		"####" "##" 0 A_CustomMissile("MetalShard1", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles", 20, 0, random(-35, 35), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "####" 0 A_CustomMissile ("WoodParticle", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile("ExplosionParticle", 20, 0, random(-10, 10), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard3", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		TNT1 A 0 A_GiveInventory("DropAK47", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Goto Ready

	RollForJam:
		"####" "#" 0 A_JumpIfInventory("AKDurability", 120, "JamChanceLow")
		"####" "#" 0 A_JumpIfInventory("AKDurability", 60, "JamChanceMid")

	JamChanceHigh:
		"####" "#" 0 A_Jump(10, "ClearJam")
		Goto ResumeFireFrame

	JamChanceMid:
		"####" "#" 0 A_Jump(7, "ClearJam")
		Goto ResumeFireFrame

	JamChanceLow:
		"####" "#" 0 A_Jump(4, "ClearJam")
		Goto ResumeFireFrame

	ClearJam:
		AKMG A 0
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_ClearReFire
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 2 A_WeaponReady(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 1 A_ClearReFire
		AKRL M 5
		AKRL NOPQQQQRS 1
		AKRL S 0 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		AKRL S 0 A_PlaySound("Rifle/Bolt1", 5)
		AKRL T 5
		AKRL T 0 A_PlaySound("rifle/Bolt2", 5)
		AKRL NMMMMM 1
		AKMG A 1
		Goto Ready

	PrintConditionTrash:
		"####" "#" 0 A_Print("Condition: \crTrash\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionBroken:
		"####" "#" 0 A_Print("Condition: \cgBroken\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionAlmostBroken:
		"####" "#" 0 A_Print("Condition: \cgAlmost Broken\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionCritical:
		"####" "#" 0 A_Print("Condition: \caCritical\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionBad:
		"####" "#" 0 A_Print("Condition: \caBad\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionHeavilyWorn:
		"####" "#" 0 A_Print("Condition: \ciHeavily Worn\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionWorn:
		"####" "#" 0 A_Print("Condition: \ciWorn\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionFair:
		"####" "#" 0 A_Print("Condition: \ckFair\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionGood:
		"####" "#" 0 A_Print("Condition: \cdGood\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionVeryGood:
		"####" "#" 0 A_Print("Condition: \cdVery Good\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionExcellent:
		"####" "#" 0 A_Print("Condition: \cdExcellent\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionPristine:
		"####" "#" 0 A_Print("Condition: \cCPristine\n\n\n\n\n\n\n")

	Inspect2CarryOn:
		"####" "#" 0 A_GiveInventory("HoldInspect",1)

	Dropper:
		GLOA A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1,"Ready")
		919A A 0 A_Takeinventory("Zoomed",1)
		919A A 0 A_Takeinventory("ADSmode",1)
		919A A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("DropAK47", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Goto Ready

	Spawn:
		WAK4 A 1
		WAK4 A 1 A_SpawnItemEx ("AK47Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop
}
}


ACTOR AKAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 31
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 31
	Inventory.Icon "WAK4A0"
}
Actor AKReloadToken : bd_Token {
}
ACTOR NeverSelectedAK : bd_Token {
}
Actor AKMSelected : bd_Token {
}
ACTOR AK47PickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceAK47! \c-(slot 4)"
	Inventory.PickupSound "CLIPIN"
	States
	{

	Spawn:
		P3ST A 0
		WAK4 A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WAK4 A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("AK", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("AK", 1)
		P3ST A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 1)
		P3ST A 0 A_GiveInventory("AKDurability", 1000)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 20)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 20)
		Stop

}

}

Actor AKDestroyed : bd_Token {}

ACTOR AK47PickUpHC: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	//scale 0.74
	+THRUACTORS
	States
	{
	Spawn:
		WAK4 A 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		WAK4 A -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("AK", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceAK47! \c-(Bulk: 4)\n Condition: \cCPristine")
		TNT1 A 0 A_GiveInventory("AK", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 4)
		TNT1 A 0 A_GiveInventory("AKDurability", 1000)
		TNT1 A 0 A_SelectWeapon("AK")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("AK47PickUpHC")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("AK47PickUpHC")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

ACTOR AK47PickUpHC_90: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	//scale 0.74
	+THRUACTORS
	States
	{
	Spawn:
		WAK4 A 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		WAK4 A -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("AK", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceAK47! \c-(Bulk: 4)\n Condition: \cDExcellent")
		TNT1 A 0 A_GiveInventory("AK", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 4)
		TNT1 A 0 A_GiveInventory("AKDurability", random(900,999))
		TNT1 A 0 A_SelectWeapon("AK")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("AK47PickUpHC_90")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("AK47PickUpHC_90")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

