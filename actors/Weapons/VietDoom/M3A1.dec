		TNT1 A 0 A_Print("You got the \ceM3A1! \c-(Bulk: 3) \n Condition: \cDVery Good")
		TNT1 A 0 A_GiveInventory("M3A1", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 3)
		TNT1 A 0 A_GiveInventory("M3Durability", random(560,629))
