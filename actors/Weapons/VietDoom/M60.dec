ACTOR M60 : PB_WeaponBase
{
	Weapon.SlotNumber 5
	Weapon.AmmoType "PB_HighCalMag"
	Weapon.AmmoGive 0
	Weapon.SelectionOrder 700
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \ceM60! \c-(slot 6)"
	Obituary "$OBBD_RIFLE"
	Inventory.PickupSound "CBOXPKUP"
	Tag "M60"
	States
	{
	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		M60G J 0 A_JumpIfInventory("PB_HighCalMag", 2,"KickFlashLoaded")
		m60S DE 1 A_DoPBWeaponAction
		m60s F 14 A_DoPBWeaponAction
		m60s ed 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		M60G J 0 A_JumpIfInventory("PB_HighCalMag", 2,"KickFlashLoaded")
		m60S DE 1 A_DoPBWeaponAction
		m60s F 14 A_DoPBWeaponAction
		m60s ed 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		M60G J 0 A_JumpIfInventory("PB_HighCalMag", 2,"SlideFlashLoaded")
		m60s de 1 A_DoPBWeaponAction
		m60s f 12 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		M60G J 0 A_JumpIfInventory("PB_HighCalMag", 2,"SlideFlashEndLoaded")
		m60s c 7 A_DoPBWeaponAction
		m60s ed 1 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		M60G J 0 A_JumpIfInventory("PB_HighCalMag", 2,"SlideFlashEndEarlyLoaded")
		m60s c 4
		m60s AB 1
		Stop
	KickFlashLoaded: 
		m60s AB 1
		m60s c 14
		m60s BA 1
		Goto Ready3
	SlideFlashLoaded:
		m60s AB 1
		m60s c 35
		Goto Ready3
	SlideFlashEndLoaded: 
		m60s c 7
		m60s BA 1
		Goto Ready3
	SlideFlashEndEarlyLoaded: 
		m60s c 4
		m60s BA 1
		Goto Ready3

	StartSprint:
		M60G A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		M60G J 0 A_JumpIfInventory("PB_HighCalMag", 2,"StartSprintLoaded")
		m60S d 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Sprinting
	StartSprintLoaded:
		m60s a 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Sprinting:
		PISP A 0 offset(-9,32)
		//M60G E 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		M60G E 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		M60G E 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		M60G E 0 offset(-9,32) A_GiveInventory("UsedStamina", 8)
		M60G E 0 offset(-9,32)
		M60S A 0 A_JumpIfInventory("PB_HighCalMag", 2,2)
		M60S D 0
		M60S "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		M60S "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		M60S "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		M60S "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		M60S "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		M60S "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		M60S "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		M60S "#" 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		M60S "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		M60S "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		M60S "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 8)
		M60S "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		M60S "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		M60S "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		M60S "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		M60S "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		M60S "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		M60S "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		M60S "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		M60S "#" 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		M60S "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint
	StopSprint:
		M60G J 0 A_JumpIfInventory("PB_HighCalMag", 2,"StopSprintLoaded")
		m60s d 1
		m60s d 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	StopSprintLoaded:
		m60s a 1
		m60s a 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("MinigunSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("M60Selected",1)
		TNT1 A 0 A_Giveinventory("HeavyAutomaticWeapon",1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")

			TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
			Goto Ready3
	SelectAnimation:
		//TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		TNT1 A 0 A_PlaySound("CHGNPKUP", 5)
		PISS A 0 A_JumpIfInventory("PB_HighCalMag", 2, 2)
		Goto SelectAnimationEmpty
		TNT1 AA 0
		m60S CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	SelectAnimationEmpty:
		m60S FED 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M60G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		M60G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		M60G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		M60G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		M60D C 0 A_JumpIfInventory("M60Deployed",1,"ready4")
		M60G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		M60G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M60G A 0 A_JumpIfInventory("FiredPrimary",1,"M60FireIfHeld")
		TNT1 AAA 0
		M60G A 0
		M60G A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		M60G B 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Ready2:
		TNT1 A 0 A_TakeInventory("MGIsOverSOmething", 1)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		M60A A 0
		M60A A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		M60A G 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M60G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, "Ready2")
		M60U A 0
		M60U A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		M60U C 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		TNT1 A 0
	Ready4:
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		M60G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		M60G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		M60G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		M60G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		M60G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M60G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M60u b 0
		M60u b 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		M60u d 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOPRIMARY)
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, "Ready2")
		Loop

	Deselect:
		M60G A 0 A_Takeinventory("M60Deployed",1)
		M60G A 0 A_TakeInventory("TossGrenade", 1)
		M60G A 0 A_TakeInventory("Kicking",1)
		M60G A 0 A_TakeInventory("Taunting",1)
		M60G A 0 A_TakeInventory("Reloading",1)
		M60G A 0 A_TakeInventory("Unloading",1)
		M60G A 0 A_TakeInventory("Salute1", 1)
		M60G A 0 A_TakeInventory("Salute2", 1)
		M60G A 0 A_Takeinventory("M60Selected",1)
		CHAG A 0 A_Takeinventory("HeavyAutomaticWeapon",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		M60G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		PISS E 0 A_JumpIfInventory("PB_HighCalMag", 2, 1)
		Goto DeselectEmpty
		PISS E 0
	DeselectContinue:
		m60s ABC 1
		TNT1 A 0 A_Lower(120)
		Wait

	DeselectEmpty:
		m60S DEF 1
		TNT1 A 0 A_Lower(120)
		Wait

	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	WeaponSpecial:
		TNT1 A 0 {
			A_TakeInventory("GoWeaponSpecialAbility", 1);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_TakeInventory("ZoomHold", 1);
			A_ZoomFactor(1.0);
		}
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("M60Pig", 1, "M60PigOff")
		TNT1 A 0 A_GiveInventory("M60Pig", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Stance: Drill")
		Goto Ready3
	M60PigOff:
		TNT1 A 0 A_TakeInventory("M60Pig", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Stance: Standard")
		Goto Ready3
	M60FireIfHeld:
		M60G A 0 A_JumpIfInventory("PB_HighCalMag", 2, "Fire")
		Goto M60Empty
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		TNT1 A 0 { return PB_jumpIfNoAmmo("M60Empty", 2, true, false, ""); }
		M60G A 0
		M60G "#" 0 A_JumpIfInventory("PB_HighCalMag",2,1)
		Goto M60Empty
	ContinueFiring:
		M60G "###" 0
		TNT1 A 0 A_JumpIFInventory("M60Deployed", 1, "Fire2")
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr, "PB_HighCalMag"); }
		M60G "#" 0 A_Takeinventory("PB_HighCalMag",2)
		M60G "#" 0 A_JumpIfInventory("PB_HighCalMag",20,1)
		M60G A 0 A_AlertMonsters
		M60G A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		M60G A 0 A_PlaySound("M60Fire", 1)
		M60G "#" 0 A_Quake(2,3,0,4,"")
	M60WearDone:
		M60G A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		M60G "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		M60G "#" 0 { PB_GunSmoke(0,0,0); }
		M60F A 1 BRIGHT
		{
			if (CountInv("M60Pig") >= 1)
			{
				PB_FireBullets("PB_762x51mm", 1, 1.5, 0, 0, 1.5);
			}
			else
			{
				PB_FireBullets("PB_762x51mm", 1, 4, 0, 0, 4);
			}
		}
		M60G B 0 A_Firecustommissile("CaseSpawn50_2",random(-2,2),0,0,-12,-18)
		M60F B 1 BRIGHT A_ZoomFactor(0.95)
		M60G A 0 A_JumpIfInventory("M60Pig", 1, 2)
		M60G A 0 A_SetPitch(pitch-1.75)
		M60G A 0 A_Jump(256, 2)
		M60G A 0 A_SetPitch(pitch-0.85)
		M60G A 0
		M60F C 1 
		M60F D 1 A_ZoomFactor(1.0)
		M60F E 1
		M60G A 0 A_Refire
		Goto Ready

	Fire2:
		TNT1 A 0
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr, "PB_HighCalMag"); }
		M60A A 0 A_Takeinventory("PB_HighCalMag",2)
		M60A A 0 A_JumpIfInventory("PB_HighCalMag",20,1)
		M60G A 0 A_AlertMonsters
		M60G A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		M60G A 0 A_PlaySound("M60Fire", 1)
		TNT1 A 0 SetPlayerProperty(0, 1, 0)
		M60G "#" 0 A_Quake(1,2,0,3,"")
	M60WearDone2:
		M60G A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		M60G A 0 { PB_GunSmoke(0,0,0); }
		M60A B 1 BRIGHT { PB_FireBullets("PB_762x51mm", 1, 2, 0, 0, 2); }
		M60G A 0 A_ZoomFactor(0.97)
		M60A C 1 BRIGHT A_Firecustommissile("CaseSpawn50_2",random(-2,2),0,0,-12,-18)
		M60A D 1 A_ZoomFactor(1.0)
		M60A E 1
		TNT1 A 0 A_TakeInventory("MGIsOverSOmething", 1)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		M60A F 1
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, 1)
		Goto Ready4
		RI2G A 0 A_ReFire
		Goto Ready2
	M60Empty:
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		TNT1 A 0 A_JumpIFInventory("M60Deployed", 1, "M60DeployedEmpty")
		M60G B 1 A_DoPBWeaponAction(WRF_NOPRIMARY)
		Goto Ready
	M60DeployedEmpty:
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		M60A g 1 A_DoPBWeaponAction(WRF_NOPRIMARY)
		Goto Ready2
	 AltFire:
		TNT1 A 0
		TNT1 A 0 A_JumpIFInventory("M60Deployed", 1, "StopAlt")
		TNT1 A 0 A_GiveInventory("M60Deployed", 1)
		TNT1 A 0 A_JumpIfInventory("PB_HighCalMag", 2, "DeployLoaded")
		TNT1 A 0 A_PlaySound("ads/in", 5)
		M60D hijklmn 1
		Goto Ready2

	DeployLoaded:
		TNT1 A 0 A_PlaySound("ads/in", 5)
		M60D ABCDEFG 1
		Goto Ready2
	StopAlt:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("M60Deployed", 1)
		TNT1 A 0 A_JumpIfInventory("PB_HighCalMag", 2, "UnDeployLoaded")
		TNT1 A 0 A_PlaySound("ads/out", 5)
		M60D NMLKJIH 1
		Goto Ready3	
	UnDeployLoaded:
		TNT1 A 0 A_PlaySound("ads/out", 5)
		M60D gFEDCBA 1
		Goto Ready3
	Spawn:
		WM60 A 1
		WM60 A 1 A_SpawnItemEx ("M60Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop

}

}
Actor MachinegunCheck
{
	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+HITTARGET
	radius 8
	height 2
	speed 24
	Scale 0.3
		states
			{
		Spawn:
			TNT1 A 0
			TNT1 A 1
			TNT1 A 0 A_Stop
			TNT1 A 2 BRIGHT
			Stop
		Death:
			TNT1 A 0
			TNT1 A 0 A_CheckFloor("IsOverSomething")
			TNT1 A 0 A_Stop
			TNT1 A 2
			Stop
		Xdeath:	
			TNT1 A 0
			TNT1 A 0 A_JumpIfInTargetINventory("IsSandbag", 1, "IsOverSomething2")
			TNT1 A 1
			Stop
		IsOverSomething:
			TNT1 A 0
			TNT1 A 0 A_GiveToTarget("MGIsOverSomething", 1)
			Stop
		IsOverSomething2:
			TNT1 A 0
			TNT1 A 0 A_RadiusGive("MGIsOverSomething", 100, RGF_PLAYERS, 1)
			Stop

}

}
Actor CoverCheck: MachinegunCheck
{
Speed 32
radius 10
height 12
		states
			{
		Spawn:
			TNT1 A 0
			TNT1 A 3
			TNT1 A 0 A_Stop
			TNT1 A 2 BRIGHT
			Stop

		Death:
			TNT1 A 0
			TNT1 A 0 A_RadiusGive("MGIsOverSomething", 100, RGF_MONSTERS, 1)
			Stop

		Xdeath:	
			TNT1 A 0
			TNT1 A 0 A_JumpIfInTargetINventory("IsSandbag", 1, "Death")
			TNT1 A 0 A_JumpIfInTargetINventory("IsPlant", 1, "Death")
			TNT1 A 1
			Stop

}

}
Actor CoverCheck2: CoverCheck
{
radius 1
}

Actor GunnerCoverCheck: CoverCheck
{
radius 4
		states
			{
		Spawn:
			TNT1 A 0
			TNT1 A 3
			TNT1 A 0 A_Stop
			TNT1 A 2 BRIGHT
			Stop

		Death:
			TNT1 A 0
			TNT1 A 0 A_RadiusGive("MGIsOverSomething", 100, RGF_MONSTERS, 1)
			Stop

		Xdeath:	
			TNT1 A 0
			TNT1 A 0 A_JumpIfInTargetINventory("IsSandbag", 1, "Death")
			TNT1 A 1
			Stop

}

}
Actor GunnerCoverCheck2: GunnerCoverCheck
{
Speed 45
}

Actor M60Deployed : bd_Token {
}
Actor MGIsOverSomething : bd_Token {
}
ACTOR NeverSelectedM60 : bd_Token {
}
Actor M60Selected : bd_Token {
}
ACTOR M60PickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceM60! \c-(slot 6)"
	Inventory.PickupSound "CBOXPKUP"
	States
	{
	Spawn:
		P3ST A 0
		WM60 A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WM60 A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("M60", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("M60", 1)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 50)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 50)
		Stop

}

}
