}
ACTOR NeverSelectedM60 : bd_Token {
}
Actor M60Selected : bd_Token {
}
ACTOR M60PickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceM60! \c-(slot 6)"
	Inventory.PickupSound "CBOXPKUP"
	States
	{
	Spawn:
		P3ST A 0
		WM60 A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WM60 A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("M60", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("M60", 1)
		P3ST A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 1)
		P3ST A 0 A_GiveInventory("M60Durability", 800)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 50)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 50)
		Stop

}

}

Actor M60Destroyed : bd_Token {}

ACTOR M60PickUpHC: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	//scale 0.74
	+THRUACTORS
	States
	{
	Spawn:
		WM60 A 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		WM60 A -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("M60", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 6, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 5, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 4, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceM60! \c-(Bulk: 7)\n Condition: \cCPristine")
		TNT1 A 0 A_GiveInventory("M60", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 7)
		TNT1 A 0 A_GiveInventory("M60Durability", 800)
		TNT1 A 0 A_SelectWeapon("M60")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("M60PickUpHC")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("M60PickUpHC")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

