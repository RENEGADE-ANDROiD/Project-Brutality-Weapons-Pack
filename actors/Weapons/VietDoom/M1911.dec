		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("M1911", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceM1911A1! \c-(Bulk: 1)\n Condition: \cgBroken")
		TNT1 A 0 A_GiveInventory("M1911", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 1)
		TNT1 A 0 A_GiveInventory("M1911Durability", random(15, 29))
		TNT1 A 0 A_SelectWeapon("M1911")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("M1911PickUpHC_5")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("M1911PickUpHC_5")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

ACTOR M1911PickUpHC_trash: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	scale 0.8
	+THRUACTORS
	States
	{
	Spawn:
		COLT A 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		COLT A -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("M1911", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceM1911A1! \c-(Bulk: 1)\n Condition: \crTrash")
		TNT1 A 0 A_GiveInventory("M1911", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 1)
		TNT1 A 0 A_GiveInventory("M1911Durability", random(1,14))
		TNT1 A 0 A_SelectWeapon("M1911")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("M1911PickUpHC_trash")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("M1911PickUpHC_trash")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}


