ACTOR M14 : PB_WeaponBase
{
	Weapon.SlotNumber 4
	Weapon.AmmoType1 "PB_HighCalMag"
	Weapon.AmmoType2 "M14Ammo"
	weapon.selectionorder 900
	Weapon.AmmoGive1 0
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \ceM14! \c-(slot 4)"
	Obituary "$OBBD_SNIPER"
	Tag "M14"
	PB_WeaponBase.UsesWheel 1
	PB_WeaponBase.WheelInfo "PBWP_VietSemiAutoWheel"
	scale 1.1
	States
	{
	NoAmmo:
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true, ""); }
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	Spawn:
		WM14 A 1
		WM14 A 1 A_SpawnItemEx ("M14Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop
	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		M14R A 1 A_DoPBWeaponAction
		M14S AB 1 A_DoPBWeaponAction
		M14S C 11 A_DoPBWeaponAction
		M14S ba 1 A_DoPBWeaponAction
		M14g A 2 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		M14R A 1 A_DoPBWeaponAction
		M14S AB 1 A_DoPBWeaponAction
		M14S C 11 A_DoPBWeaponAction
		M14S ba 1 A_DoPBWeaponAction
		M14g A 2 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		M14R A 2 A_DoPBWeaponAction
		M14S AB 1 A_DoPBWeaponAction
		M14S C 35 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		M14R A 10 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		M14R A 2
		M14R Aaaa 1
		Stop

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("DMRSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("M14Selected",1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("NeverSelectedM14", 1, "FirstSelectAnimation")
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
				Goto Ready3

	SelectAnimation:
		TNT1 A 0 A_PlaySound("sniper/draw", 5)
		M14R CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		TNT1 A 0 a_jumpifinventory("M14ReloadToken",1,"SelectRechamber")
		TNT1 A 0 A_TakeInventory("RELOADING",1)
		Goto Ready3

	FirstSelectAnimation:
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		M16G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("NeverSelectedM14", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 3 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Tacticalselect:
		TNT1 A 0 A_TakeInventory("NeverSelectedM14",1)
		TNT1 A 4 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m14R I 8 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m14R JKL 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		RIFR A 0 A_PlaySound("Sniper/MagIn", 5)
		m14r MMMMM 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m14R DCBA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m14R N 8 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("Sniper/BoltBack", 5)
		m14R OPQR 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m14R R 8 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m14R STUVVV 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("Sniper/BoltForward", 5)
		m14R XYZ 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m14R R 8 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m14R QPON 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M14G A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		Goto Ready
	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(19)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		//TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		m14G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Ready2:
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		M14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	StartSprint:
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16G A 0 A_Takeinventory("ADSmode",1)
		M16G A 0 A_ZoomFactor(1.0)
		m14s a 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14s a 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
	Sprinting:
		PISP A 0 offset(-9,32)
		//DEAG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		DEAG A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 100, "StopSprintTired")
		DEAG A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		DEAG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 7)
		DEAG A 0 offset(-9,32)
		m14S A 1 offset(-9,34) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		m14S A 1 offset(-6,36) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		m14S A 1 offset(-3,38) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		m14S A 1 offset(0,38) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		m14S A 1 offset(3,36) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		m14S A 1 offset(6,34) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		m14S A 1 offset(9,32) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		DEAG A 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		DEAG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		DEAG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		DEAG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 7)
		DEAG A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		m14S A 1 offset(9,34) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		m14S A 1 offset(6,36) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		m14S A 1 offset(3,38) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		m14S A 1 offset(0,38) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		m14S A 1 offset(-3,36) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		m14S A 1 offset(-6,34) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		m14S A 1 offset(-9,32) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		DEAG A 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		DEAG A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprintTired:
		DEAG A 0 A_PlaySound("Tired", 2)
		DEAG A 0 A_TakeInventory("UsedStamina", 2)
		m14s a 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		DEAG A 0 A_TakeInventory("UsedStamina", 2)
		m14s a 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		DEAG A 0 A_TakeInventory("UsedStamina", 2)
		m14s a 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		DEAG A 0 A_TakeInventory("UsedStamina", 2)
		m14s a 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		DEAG A 0 A_TakeInventory("UsedStamina", 2)
		m14s a 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	StopSprint:
		m14s a 1
		DEAG A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	Deselect:
		m14G A 0
		TNT1 A 0 A_SetCrosshair(19)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_TakeInventory("StartDualWield", 1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Lower(120)
		Wait

	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true); }
		M14I C 0 A_JumpIfInventory("Zoomed",1,13)
		M14G A 0
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" A 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("M14Ammo",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 { PB_LowAmmoSoundWarning(hdmr); }
		"####" "#" 0 A_Takeinventory("M14Ammo",1)
		"####" "#" 0 A_JumpIfInventory("M14Ammo",5,2)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("M14Ammo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("PB_HighCalMag",2,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		m14G A 0 A_Quake(1,3,0,4,"")
		m14G A 0 A_AlertMonsters
		m14G A 0 A_PlaySound("Sniper/Fire", 1)
		SMGG A 0 A_PlaySound("FARM14", 6)
		TNT1 A 0 A_JumpIFInventory("Zoomed", 1, "Fire2")
		m14F A 1 BRIGHT { PB_FireBullets("PB_762x51mm", 1, 3, 0, 0, 3); }
		//TNT1 A 0 A_JumpIFInventory("ADSMode", 1, "Fire2")
		m14G A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		m14G A 0 { PB_GunSmoke_Sniper(0,0,0); }
		m14G A 0 A_ZoomFactor(0.96)
		//TNT1 A 0 A_JumpIfInventory("IsTacticalClass",1,"Tacticoool")
		m14G A 0 A_SetPitch(pitch-1.6)
		m14G A 0 A_SetANgle(angle-1.5)
		m14F B 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		m14G A 0 A_ZoomFactor(1.0)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14F C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIFInventory("M14Auto", 1, "EndOfFiring")
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	EndOfFiring:
		m14G A 0 A_Refire
		Goto Ready3

	Tacticoool:
		m14G A 0 A_SetPitch(pitch-2.6)
		m14G A 0 A_SetANgle(angle-1.4)
		m14F C 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		m14G A 0 A_ZoomFactor(1.0)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		m14G A 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		m14G A 0 A_Refire
		Goto Ready3

	Fire2:
		AKMG "#" 0 A_Quake(1,2,0,3,"")
		m14G A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		m14G A 0 { PB_GunSmoke_Sniper(0,0,0); }
		M14I D 1 BRIGHT { PB_FireBullets("PB_762x51mm", 1, 1, 0, 0, 1); }
		m14G A 0 A_ZoomFactor(1.92)
		//TNT1 A 0 A_JumpIfInventory("IsTacticalClass",1,"Tacticoool2")
		M14I C 0 A_SetPitch(pitch-1.5)
		M14I C 0 A_SetANgle(angle-1.4)
		M14I F 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		M14I C 0 A_ZoomFactor(2.0)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I E 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		TNT1 A 0 A_JumpIFInventory("M14Auto", 1, "EndOfFiring2")
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I F 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		M14I C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	EndOfFiring2:
		M14I C 0 A_Refire
		Goto Ready2

	Tacticoool2:
		M14I C 0 A_SetPitch(pitch-2.6)
		M14I C 0 A_SetANgle(angle-1.4)
		M14I C 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		M14I C 0 A_ZoomFactor(2.0)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 1 A_DoPBWeaponAction(WRF_NOFIRE | WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 A_Refire
		Goto Ready2
	WeaponSpecial:
		TNT1 A 0 {
			A_TakeInventory("GoWeaponSpecialAbility", 1);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_TakeInventory("ZoomHold", 1);
			A_ZoomFactor(1.0);
		}
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("SelectViet_FullAuto", 1, "ActivateAuto")
		TNT1 A 0 A_JumpIfInventory("SelectViet_Semi", 1, "DisableAuto")
		Goto DualWield
	DualWield:
		TNT1 A 0 A_TakeInventory("StartDualWield", 1)
		TNT1 A 0 A_SetCrosshair(0)
		M14G A 0 A_ZoomFactor(1.0)
		M14G A 0 A_Takeinventory("Zoomed",1)
		M14G A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_JumpIfInventory("M14Auto",1,"DisableAuto")
		Goto ActivateAuto

	ActivateAuto:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("SelectViet_FullAuto", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_Semi", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_BARFast", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_BARSlow", 1)
		//TNT1 A 0 A_TakeInventory("FiredPrimary", 1)
		M14G A 0 A_Giveinventory("M14Auto",1)
		TNT1 A 0 A_Print("Full Auto\n\n\n\n\n\n\n")
		m14G A 2
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		Goto Ready
	DisableAuto:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("SelectViet_FullAuto", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_Semi", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_BARFast", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_BARSlow", 1)
		//TNT1 A 0 A_TakeInventory("FiredPrimary", 1)
		M14G A 0 A_Takeinventory("M14Auto",1)
		TNT1 A 0 A_Print("Semi-Auto\n\n\n\n\n\n\n")
		m14G A 2
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		Goto Ready

	AltFire:
		TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		//TNT1 A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_ZoomFactor(2.0)
		TNT1 A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		m14I ABC 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		TNT1 A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,3)
		M14I C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		M14I C 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		M14I C 4
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		m14i ABC 1
		M14I C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready2

	HoldAim:
		TNT1 A 0
		TNT1 A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		M14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		M14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		M14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		TNT1 AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		m14i CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		m14i CBA 1
		m14G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready3

	TurboReload:
		RIFG A 0 { PB_SetMagUnloaded(false); }

		RIFG A 0 A_JumpIfInventory("PB_HighCalMag",1,3)
		Goto Ready3
		RIFS ABC 0
		m14G A 0 A_JumpIfInventory("M14Ammo",1,"InsertBullets2")
		Goto InsertBullets
Inspect:
		M14G A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		M14G A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		M14G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M14G A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		M14G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		M14G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		M14G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M14G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		M14G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		M14G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M14G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		M14G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		//M14G A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		M14G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		M14G A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		M14G A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		M14G A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M14G A 0 A_GiveInventory("DoInspect",1)
		M14G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14G A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		M14G A 0 A_TakeInventory("DoInspect",1)
		M14G A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		M14G a 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M14G "#" 0 A_Giveinventory("IsInspecting",1)
		m14R N 8 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M14R "#" 0 A_TakeInventory("M14ReloadToken",1)
		M14R OPQR 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M14R R 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("Sniper/BoltBack", 5)
		M14R STU 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		M14R V 4 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		M14R XYZ 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		2IFR A 0 A_PlaySound("Sniper/BoltForward", 5)
		M14R RRRQPO 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		M14R n 4 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		M14R "#" 0 A_Takeinventory("IsInspecting",1)
		M14R "#" 0 A_TakeInventory("M14ReloadToken",1)
		//AKRL BA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M14R "#" 0 A_Takeinventory("IsInspecting",1)
		M14R "#" 0 A_TakeInventory("M14ReloadToken",1)
		M14R "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	User2:
	Unload:
		m14G A 1 // A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_Takeinventory("Unloading",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_JumpIfInventory("NoReloading",1,"Ready3")
		RIFG A 0 A_JumpIfInventory("M14Ammo",1,3)
		Goto NoAmmo
		TNT1 AAA 0
		RIFG A 0 A_Takeinventory("Zoomed",1)
		m14R ABCDEEEE 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Sniper/MagOut", 5)
		m14R FGH 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_GiveInventory ("Pumping", 1)
		RIFG A 0 A_Takeinventory("Unloading",1)

	RemoveBullets:
		TNT1 AAAA 0
		RIFG A 0 A_JumpIfInventory("M14Ammo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		RIFG A 0 A_Takeinventory("M14Ammo",1)
		RIFG A 0 A_Giveinventory("PB_HighCalMag",2)
		Goto RemoveBullets

	FInishUnload:
		m14R I 15 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_PlaySound("weapons/empty", 5)
		RIFG A 0 { PB_SetMagUnloaded(true); }

		RIFG A 0 A_Takeinventory("Unloading",1)
		Goto Ready3

	Reload:
		M14G "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		M14G "#" 0 A_Takeinventory("Reloading",1)
		M14G "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		M14G "#" 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		Goto Ready
		TNT1 A 0
		M14G "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		M14G "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")
		M14G A 0 A_JumpIfInventory("M14Ammo",0,"Inspect")
		M14G A 0 A_JumpIfInventory("M14ReloadToken",1,"Inspect")
		M14G A 0 A_Takeinventory("Reloading",1)
		M14G A 0 A_Takeinventory("ADSmode",1)
		M14G A 0 A_Takeinventory("Zoomed",1)
		M14G A 0 A_Takeinventory("ZoomHold",1)
		M14G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//M14G A 3 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M14G A 0 A_Takeinventory("ADSmode",1)
		M14G A 0 A_Takeinventory("Zoomed",1)
		M14G A 0 A_Takeinventory("ZoomHold",1)
		M14G A 0 { PB_JumpIfMagUnloaded("ReloadFromEmpty"); }
		M14G A 0 A_GiveInventory ("Pumping", 1)
		M14G A 0 A_Takeinventory("Reloading",1)
		m14R ABCDEEEE 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Sniper/MagOut", 5)
		m14R FGH 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_FireCustomMissile("EmptySniperAmmoSpawn",-5,0,8,-4)
	ReloadFromEmpty:
		m14R I 20 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R J 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Sniper/MagIn", 5)
		m14R KLMMM 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14G A 0 A_JumpIfInventory("M14Ammo",1,"InsertBullets2")
		TNT1 A 0 A_GiveInventory("M14ReloadToken",1)
		Goto InsertBullets

	InsertBullets:
		TNT1 AAAA 0
		m14G A 0 A_JumpIfInventory("M14Ammo",20,15)
		m14G A 0 A_JumpIfInventory("PB_HighCalMag",2,3)
		Goto FinishReload3
		TNT1 AAAAAA 0
		m14G A 0 A_Giveinventory("M14Ammo",1)
		m14G A 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		m14G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload3
		TNT1 AAAA 0
		m14G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload3

	InsertBullets2:
		TNT1 AAAA 0
		m14G A 0 A_JumpIfInventory("M14Ammo",0,15)
		m14G A 0 A_JumpIfInventory("PB_HighCalMag",2,3)
		Goto FinishReload3
		TNT1 AAAAAA 0
		m14G A 0 A_Giveinventory("M14Ammo",1)
		m14G A 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
		Goto InsertBullets2

		TNT1 AAAAAAAAAA 0
		m14G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload2
		TNT1 AAAA 0
		m14G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload2

	FinishReloading:
		m14G A 0
		m14R A 0 { PB_SetMagUnloaded(false); }

		TNT1 A 0 A_TakeInventory("M14ReloadToken",1)
		m14G A 0 A_Refire
		Goto Ready3

	FinishReload2:
		tnt1 a 0
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"ready3")
		m14R M 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R DCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R A 0 { PB_SetMagUnloaded(false); }

		TNT1 A 0 A_TakeInventory("M14ReloadToken",1)
		Goto Ready3

	FinishReload3:
		tnt1 a 0
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"ready3")
		m14R M 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R DCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R N 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Sniper/BoltBack", 5)
		m14R OPQR 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R R 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R STUVVV 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Sniper/BoltForward", 5)
		m14R XYZ 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R R 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R QPON 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m14R A 0 { PB_SetMagUnloaded(false); }

		TNT1 A 0 A_TakeInventory("M14ReloadToken",1)
		Goto Ready3
}

}
ACTOR M14Ammo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 21
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 21
	Inventory.Icon "WM14A0"
}

Actor M14Auto : bd_Token {
}
Actor M14ReloadToken : bd_Token {
}
ACTOR NeverSelectedM14 : bd_Token {
}
Actor M14Selected : bd_Token {
}
ACTOR M14PickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceM14! \c-(slot 4)"
	Inventory.PickupSound "CLIPIN"
	scale 1.1
	States
	{

	Spawn:
		P3ST A 0
		WM14 A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WM14 A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("M14", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("M14", 1)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 10)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 10)
		Stop

}

}
