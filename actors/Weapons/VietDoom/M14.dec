		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M14I F 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M14I C 0 //Nope
		M14I C 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		m14I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
