	AltFire:
		TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		//TNT1 A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_ZoomFactor(4.0)
		TNT1 A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		M21A ABC 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		TNT1 A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,3)
		SNIP D 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		SNIP D 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		SNIP D 4
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		M21A ABC 1
		SNIP D 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready2

	HoldAim:
		TNT1 A 0
		TNT1 A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		TNT1 AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		M21A CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		M21G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		M21A CBA 1
		M21G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready3

	TurboReload:
		RIFG A 0 { PB_SetMagUnloaded(false); }


		RIFG A 0 A_JumpIfInventory("PB_HighCalMag",1,3)
		Goto Ready3
		RIFS ABC 0
		M21G A 0 A_JumpIfInventory("M21Ammo",1,"InsertBullets2")
		Goto InsertBullets
Inspect:
		M21G A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		M21G A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		M21G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M21G A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		M21G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		M21G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		M21G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M21G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M21G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		M21G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		M21G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M21G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		M21G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		//M21G A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		M21G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		M21G A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		M21G A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		M21G A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M21G A 0 A_GiveInventory("DoInspect",1)
		M21G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M21G A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		M21G A 0 A_TakeInventory("DoInspect",1)
		M21G A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		M21G a 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M21G "#" 0 A_Giveinventory("IsInspecting",1)
		M21R N 8 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M21R "#" 0 A_TakeInventory("M21ReloadToken",1)
		M21R OPQR 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M21R R 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("sniper/BoltBack", 5)
		M21R STU 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		M21R V 4 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		M21R XYZ 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		2IFR A 0 A_PlaySound("sniper/Boltforward", 5)
		M21R RRRQPO 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		M21R n 4 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		M21R "#" 0 A_Takeinventory("IsInspecting",1)
		M21R "#" 0 A_TakeInventory("M21ReloadToken",1)
		//AKRL BA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M21R "#" 0 A_Takeinventory("IsInspecting",1)
		M21R "#" 0 A_TakeInventory("M21ReloadToken",1)
		M21R "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	User2:
	Unload:
		M21G A 1 // A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_Takeinventory("Unloading",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_JumpIfInventory("NoReloading",1,"Ready3")
		RIFG A 0 A_JumpIfInventory("M21Ammo",1,3)
		Goto NoAmmo
		TNT1 AAA 0
		RIFG A 0 A_Takeinventory("Zoomed",1)
		M21R ABCDEEEE 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Sniper/MagOut", 5)
		M21R FGH 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_GiveInventory ("Pumping", 1)
		RIFG A 0 A_Takeinventory("Unloading",1)

	RemoveBullets:
		TNT1 AAAA 0
		RIFG A 0 A_JumpIfInventory("M21Ammo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		RIFG A 0 A_Takeinventory("M21Ammo",1)
		RIFG A 0 A_Giveinventory("PB_HighCalMag",2)
		Goto RemoveBullets

	FInishUnload:
		M21R I 15 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_PlaySound("weapons/empty", 5)
		RIFG A 0 { PB_SetMagUnloaded(true); }


		RIFG A 0 A_Takeinventory("Unloading",1)
		Goto Ready3

	Reload:
		//M21G A 1 // A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M21G "#" 0 A_TakeInventory("RifleSpread", 10)
		M21G "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		M21G "#" 0 A_Takeinventory("Reloading",1)
		M21G "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		M21G "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		M21G "#" 0 A_JumpIfInventory("PB_HighCalMag",2,3)
		Goto Ready
		TNT1 AAA 0
		M21G "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		M21G "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")
		M21G A 0 A_JumpIfInventory("M21Ammo",0,"Inspect")
		M21G A 0 A_JumpIfInventory("M21ReloadToken",1,"Inspect")
		M21G A 0 A_Takeinventory("Reloading",1)
		M21G A 0 A_Takeinventory("ADSmode",1)
		M21G A 0 A_Takeinventory("Zoomed",1)
		M21G A 0 A_Takeinventory("ZoomHold",1)
		M21G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//M21G A 3 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21G A 0 A_Takeinventory("ADSmode",1)
		M21G A 0 A_Takeinventory("Zoomed",1)
		M21G A 0 A_Takeinventory("ZoomHold",1)
		M21G A 0 { PB_JumpIfMagUnloaded("ReloadFromEmpty"); }
		M21G A 0 A_GiveInventory ("Pumping", 1)
		M21G A 0 A_Takeinventory("Reloading",1)
		M21R ABCDEEEE 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Sniper/MagOut", 5)
		M21R FGH 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_FireCustomMissile("EmptySniperAmmoSpawn",-5,0,8,-4)
	ReloadFromEmpty:
		M21R I 20 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R J 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Sniper/MagIn", 5)
		M21R KLMM 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21G A 0 A_JumpIfInventory("M21Ammo",1,"InsertBullets2")
		TNT1 A 0 A_GiveInventory("M21ReloadToken",1)
		Goto InsertBullets

	InsertBullets:
		TNT1 AAAA 0
		M21G A 0 A_JumpIfInventory("M21Ammo",20,15)
		M21G A 0 A_JumpIfInventory("PB_HighCalMag",2,3)
		Goto FinishReload3
		TNT1 AAAAAA 0
		M21G A 0 A_Giveinventory("M21Ammo",1)
		M21G A 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		M21G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload3
		TNT1 AAAA 0
		M21G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload3

	InsertBullets2:
		TNT1 AAAA 0
		M21G A 0 A_JumpIfInventory("M21Ammo",0,15)
		M21G A 0 A_JumpIfInventory("PB_HighCalMag",2,3)
		Goto FinishReload3
		TNT1 AAAAAA 0
		M21G A 0 A_Giveinventory("M21Ammo",1)
		M21G A 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
		Goto InsertBullets2

		TNT1 AAAAAAAAAA 0
		M21G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload2
		TNT1 AAAA 0
		M21G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload2

	FinishReloading:
		M21G A 0
		TNT1 A 0 A_TakeInventory("M21ReloadToken",1)
		M21G A 0 A_Refire
		Goto Ready3

	FinishReload2:
		tnt1 a 0
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"ready3")
		M21R M 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R DCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R A 0 { PB_SetMagUnloaded(false); }


		TNT1 A 0 A_TakeInventory("M21ReloadToken",1)
		Goto Ready3

	FinishReload3:
		tnt1 a 0
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"ready3")
		M21R M 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R DCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R N 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Sniper/BoltBack", 5)
		M21R OPQR 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R R 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R STUVVV 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("sniper/BoltForward", 5)
		M21R XYZ 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R R 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R QPON 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M21R A 0 { PB_SetMagUnloaded(false); }


		TNT1 A 0 A_TakeInventory("M21ReloadToken",1)
		Goto Ready3
	GunBroken:
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 0 A_Print("Your rifle has been destroyed!\n\n\n\n\n\n\n")
		"####" "#" 0 A_GiveInventory("M21Destroyed", 1)
		"####" "#" 0 A_PlaySound("DSBRK2")
		"####" "#" 0 A_Quake(4,5,0,12,"")
		"####" "##" 0 A_CustomMissile("MetalShard1", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile("GlassPart", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45) 
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles", 20, 0, random(-35, 35), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile ("MetalShard2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#####" 0 A_CustomMissile ("GreenPlasticParticle", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile("ExplosionParticle", 20, 0, random(-10, 10), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard3", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		TNT1 A 0 A_GiveInventory("DropM21", 1)
		TNT1 A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Stop

	RollForJam:
		"####" "#" 0 A_JumpIfInventory("M21Durability", 67, "JamChanceLow")
		"####" "#" 0 A_JumpIfInventory("M21Durability", 40, "JamChanceMid")

	JamChanceHigh:
		"####" "#" 0 A_Jump(10, "ClearJam")
		Goto ResumeFireFrame

	JamChanceMid:
		"####" "#" 0 A_Jump(7, "ClearJam")
		Goto ResumeFireFrame

	JamChanceLow:
		"####" "#" 0 A_Jump(4, "ClearJam")
		Goto ResumeFireFrame

	ClearJam:
		m21G A 0
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_ClearReFire
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 2 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 1 A_ClearReFire
		M21G a 1 
		m21R N 8
		M21R OPQRRRRRR 1
		M21R R 0 A_PlaySound("Sniper/BoltBack", 5)
		M21R STU 1
		M21G A 0 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		M21R VVVVXYZ 1
		2IFR A 0 A_PlaySound("Sniper/BoltForward", 5)
		M21R RRRQPONNNN 1
		M21G A 2
		Goto Ready

	PrintConditionTrash:
		"####" "#" 0 A_Print("Condition: \crTrash\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionBroken:
		"####" "#" 0 A_Print("Condition: \cgBroken\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionAlmostBroken:
		"####" "#" 0 A_Print("Condition: \cgAlmost Broken\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionCritical:
		"####" "#" 0 A_Print("Condition: \caCritical\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionBad:
		"####" "#" 0 A_Print("Condition: \caBad\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionHeavilyWorn:
		"####" "#" 0 A_Print("Condition: \ciHeavily Worn\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionWorn:
		"####" "#" 0 A_Print("Condition: \ciWorn\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionFair:
		"####" "#" 0 A_Print("Condition: \ckFair\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionGood:
		"####" "#" 0 A_Print("Condition: \cdGood\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionVeryGood:
		"####" "#" 0 A_Print("Condition: \cdVery Good\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionExcellent:
		"####" "#" 0 A_Print("Condition: \cdExcellent\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionPristine:
		"####" "#" 0 A_Print("Condition: \cCPristine\n\n\n\n\n\n\n")

	Inspect2CarryOn:
		"####" "#" 0 A_GiveInventory("HoldInspect",1)

	Dropper:
		GLOA A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1,"Ready")
		919A A 0 A_Takeinventory("Zoomed",1)
		919A A 0 A_Takeinventory("ADSmode",1)
		919A A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("DropM21", 1)
		TNT1 A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Stop
}


}
ACTOR M21Ammo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 21
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 21
	Inventory.Icon "WM14T0"
}
Actor M21ReloadToken : bd_Token {
}
ACTOR NeverSelectedM21 : bd_Token {
}
Actor M21Selected : bd_Token {
}
ACTOR M21PickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceXM21! \c-(slot 4)"
	Inventory.PickupSound "CLIPIN"
	scale 1.1
	States
	{

	Spawn:
		P3ST A 0
		WM14 t 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WM14 t -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("XM21", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("XM21", 1)
		P3ST A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 1)
		P3ST A 0 A_GiveInventory("M21Durability", 300)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 10)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 10)
		Stop

}

}

Actor M21Destroyed : bd_Token {}

ACTOR M21PickUpHC: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	scale 1.1
	+THRUACTORS
	States
	{
	Spawn:
		WM14 t 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		WM14 t -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("XM21", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 6, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceXM21! \c-(Bulk: 5)\n Condition: \cCPristine")
		TNT1 A 0 A_GiveInventory("XM21", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 5)
		TNT1 A 0 A_GiveInventory("M21Durability", 300)
		TNT1 A 0 A_SelectWeapon("XM21")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("M21PickUpHC")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("M21PickUpHC")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

