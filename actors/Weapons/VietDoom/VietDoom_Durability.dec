// VietDoom v22 weapon durability - Dropper hub + durability counters.
// Gated by CVAR PB_VietDoomDurability via player token VietDoomDurabilityDisabled.
ACTOR VietDoomDurabilityDisabled : bd_Token
{
	Inventory.MaxAmount 1
}
ACTOR Dropper : PB_WeaponBase
{
	+INVENTORY.UNDROPPABLE
	+WEAPON.WIMPY_WEAPON
	+WEAPON.CHEATNOTWEAPON
	+WEAPON.MELEEWEAPON
	States
	{
	Ready:
	Ready3:
	    TNT1 A 1 A_weaponready(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("DropIt",1)
		TNT1 A 0 A_JumpIfInventory("DropM1911",1,"DropM1911")
		TNT1 A 0 A_JumpIfInventory("DropM3",1,"DropM3")
		TNT1 A 0 A_JumpIfInventory("DropMAT49",1,"DropMAT49")
