ACTOR Stoner : PB_WeaponBase
{
	Weapon.SlotNumber 6
	Weapon.AmmoType "PB_HighCalMag"
	Weapon.AmmoGive 0
	Weapon.SelectionOrder 700
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \ceStoner! \c-(slot 6)"
	Obituary "$OBBD_RIFLE"
	Tag "Stoner 63"
	States
	{
	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		STOG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"KickFlashLoaded")
		STOS DE 1 A_DoPBWeaponAction
		STOs F 14 A_DoPBWeaponAction
		STOs ed 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		STOG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"KickFlashLoaded")
		STOS DE 1 A_DoPBWeaponAction
		STOs F 14 A_DoPBWeaponAction
		STOs ed 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		STOG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"SlideFlashLoaded")
		STOs de 1 A_DoPBWeaponAction
		STOs f 12 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		STOG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"SlideFlashEndLoaded")
		STOs c 7 A_DoPBWeaponAction
		STOs ed 1 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		STOG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"SlideFlashEndEarlyLoaded")
		STOs c 4
		STOs AB 1
		Stop
	KickFlashLoaded: 
		STOs AB 1
		STOs c 14
		STOs BA 1
		Goto Ready3
	SlideFlashLoaded:
		STOs AB 1
		STOs c 35
		Goto Ready3
	SlideFlashEndLoaded: 
		STOs c 7
		STOs BA 1
		Goto Ready3
	SlideFlashEndEarlyLoaded: 
		STOs c 4
		STOs BA 1
		Goto Ready3

	StartSprint:
		STOG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		STOG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"StartSprintLoaded")
		STOS d 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Sprinting
	StartSprintLoaded:
		STOs a 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Sprinting:
		PISP A 0 offset(-9,32)
		//STOG E 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		STOG E 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		STOG E 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		STOG E 0 offset(-9,32) A_GiveInventory("UsedStamina", 7)
		STOG E 0 offset(-9,32)
		STOS A 0 A_JumpIfInventory("PB_HighCalMag", 1,2)
		STOS D 0
		STOS "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		STOS "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		STOS "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		STOS "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		STOS "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		STOS "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		STOS "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		STOS "#" 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		STOS "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		STOS "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		STOS "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 7)
		STOS "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		STOS "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		STOS "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		STOS "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		STOS "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		STOS "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		STOS "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		STOS "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		STOS "#" 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		STOS "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint
	StopSprint:
		STOG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"StopSprintLoaded")
		STOs d 1
		STOs d 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	StopSprintLoaded:
		STOs a 1
		STOs a 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("RifleSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("STOnerSelected",1)
		TNT1 A 0 A_Giveinventory("HeavyAutomaticWeapon",1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")

			TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
			Goto Ready3
	SelectAnimation:
		//TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		TNT1 A 0 A_PlaySound("CHGNPKUP", 5)
		PISS A 0 A_JumpIfInventory("PB_HighCalMag", 1, 2)
		Goto SelectAnimationEmpty
		TNT1 AA 0
		STOS CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	SelectAnimationEmpty:
		STOS FED 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		STOG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		STOG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		STOG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		STOG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		STOG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		STOD C 0 A_JumpIfInventory("StonerDeployed",1,"ready4")
		STOG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		STOG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		STOG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		TNT1 AAA 0
		STOG A 0
		STOG A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		STOG B 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		Loop

	Ready2:
		TNT1 A 0 A_TakeInventory("MGIsOverSOmething", 1)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		STOA A 0
		STOA A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		STOA G 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		STOG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, "Ready2")
		STOU A 0
		STOU A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		STOU C 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		TNT1 A 0
	Ready4:
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		STOG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		STOG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		STOG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		STOG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		STOG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		STOG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		STOu b 0
		STOu b 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		STOu d 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOPRIMARY)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, "Ready2")
		Loop

	Deselect:
		STOG A 0 A_Takeinventory("StonerDeployed",1)
		STOG A 0 A_TakeInventory("TossGrenade", 1)
		AKMG A 0 A_TakeInventory("DropIt", 1)
		STOG A 0 A_TakeInventory("Kicking",1)
		STOG A 0 A_TakeInventory("Taunting",1)
		STOG A 0 A_TakeInventory("Reloading",1)
		STOG A 0 A_TakeInventory("Unloading",1)
		STOG A 0 A_TakeInventory("Salute1", 1)
		STOG A 0 A_TakeInventory("Salute2", 1)
		STOG A 0 A_Takeinventory("STOnerSelected",1)
		CHAG A 0 A_Takeinventory("HeavyAutomaticWeapon",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		STOG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		PISS E 0 A_JumpIfInventory("PB_HighCalMag", 1, 1)
		Goto DeselectEmpty
		PISS E 0
	DeselectContinue:
		STOs ABC 1
		TNT1 A 0 A_Lower(120)
		Wait

	DeselectEmpty:
		STOS DEF 1
		TNT1 A 0 A_Lower(120)
		Wait


	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		STOG A 0
		STOG "#" 0 A_JumpIfInventory("PB_HighCalMag",1,"ContinueFiring")
		Goto STOEmpty
	ContinueFiring:
		STOG "###" 0
		TNT1 A 0 A_JumpIFInventory("StonerDeployed", 1, "Fire2")
		STOG "#" 0 A_Takeinventory("PB_HighCalMag",1)
		STOG "#" 0 A_JumpIfInventory("PB_HighCalMag",20,1)
		STOG "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		STOG A 0 A_AlertMonsters
		//STOG A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		STOG A 0 A_PlaySound("StonFire", 1)
		STOG "#" 0 A_Quake(1, 2, 0, 2, "")
		STOG A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		STOG "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		STOG "#" 0 { PB_GunSmoke(0,0,0); }
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 1, 3, 0, 0, 3); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		STOF A 1 BRIGHT
		STOG B 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		STOF B 1 A_ZoomFactor(0.97)
		STOG A 0 A_SetPitch(pitch-1.25)

		STOF D 1 A_ZoomFactor(1.0)
		STOG A 0 A_Refire
		Goto Ready

	Fire2:
		TNT1 A 0
		STOA A 0 A_Takeinventory("PB_HighCalMag",1)
		STOA A 0 A_JumpIfInventory("PB_HighCalMag",20,1)
		STOA A 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		STOG A 0 A_AlertMonsters
		//STOG A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		STOG A 0 A_PlaySound("StonFire", 1)
		TNT1 A 0 SetPlayerProperty(0, 1, 0)
		STOG "#" 0 A_Quake(0.5,1,0,1.5,"")
		STOG A 0 A_ZoomFactor(0.98)
		STOG A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		STOG A 0 { PB_GunSmoke(0,0,0); }
		TNT1 A 0 { PB_FireBullets("PB_556x45mm", 1, 2, 0, 0, 2); }
		TNT1 A 0 { PB_LowAmmoSoundWarning(hdmr); }
		STOA B 1 BRIGHT
		STOA C 1 BRIGHT A_ZoomFactor(1.0)
		STOA C 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 8, 0, frandom(4,7), frandom(6,9), frandom(0,5)); }
		TNT1 A 0 A_TakeInventory("MGIsOverSOmething", 1)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		STOA e 1
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, 1)
		Goto Ready4
		RI2G A 0 A_ReFire
		Goto Ready2
	STOEmpty:
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		TNT1 A 0 A_JumpIFInventory("StonerDeployed", 1, "StonerDeployedEmpty")
		STOG B 1 A_DoPBWeaponAction(WRF_NOPRIMARY)
		Goto Ready
	StonerDeployedEmpty:
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		STOA g 1 A_DoPBWeaponAction(WRF_NOPRIMARY)
		Goto Ready2
	 AltFire:
		TNT1 A 0
		TNT1 A 0 A_JumpIFInventory("StonerDeployed", 1, "StopAlt")
		TNT1 A 0 A_GiveInventory("StonerDeployed", 1)
		TNT1 A 0 A_JumpIfInventory("PB_HighCalMag", 1, "DeployLoaded")
		TNT1 A 0 A_PlaySound("ads/in", 5)
		STOD hijklmn 1
		Goto Ready2

	DeployLoaded:
		TNT1 A 0 A_PlaySound("ads/in", 5)
		STOD ABCDEFG 1
		Goto Ready2
	StopAlt:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("StonerDeployed", 1)
		TNT1 A 0 A_JumpIfInventory("PB_HighCalMag", 1, "UnDeployLoaded")
		TNT1 A 0 A_PlaySound("ads/out", 5)
		STOD NMLKJIH 1
		Goto Ready3	
	UnDeployLoaded:
		TNT1 A 0 A_PlaySound("ads/out", 5)
		STOD gFEDCBA 1
		Goto Ready3
	GunBroken:
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 0 A_Print("Your machine gun has been destroyed!\n\n\n\n\n\n\n")
		"####" "#" 0 A_GiveInventory("StonerDestroyed", 1)
		"####" "#" 0 A_PlaySound("DSBRK2")
		"####" "#" 0 A_Quake(4,5,0,12,"")
		"####" "##" 0 A_CustomMissile("MetalShard1", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles", 20, 0, random(-35, 35), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "####" 0 A_CustomMissile ("BlackPlasticParticle", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile("ExplosionParticle", 20, 0, random(-10, 10), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard3", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		TNT1 A 0 A_GiveInventory("DropStoner", 1)
		TNT1 A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Stop

	RollForJam:
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 70, "JamChanceLow")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 45, "JamChanceMid")

	JamChanceHigh:
		"####" "#" 0 A_Jump(12, "ClearJam")
		Goto ContinueFiring

	JamChanceMid:
		"####" "#" 0 A_Jump(8, "ClearJam")
		Goto ContinueFiring

	JamChanceLow:
		"####" "#" 0 A_Jump(6, "ClearJam")
		Goto ContinueFiring

	ClearJam:
		"####" A 1 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_ClearReFire
		"####" "#" 1 offset(0,34)
		"####" "#" 1 offset(0,33)
		"####" "#" 2 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 1 A_ClearReFire
		"####" "#" 3
		STOA A 0 A_JumpIfInventory("StonerDeployed",1,2) //That thing is here in older to place the player's hand onto the carging handle
		Goto StartClearJam
		STOT E 0
		STOT EFF 1
		STOT F 0
	StartClearJam:
		STOA A 0 A_JumpIfInventory("StonerDeployed",1,2)
		STOG A 3
		"####" AA 0
		STOT A 0 A_JumpIfInventory("StonerDeployed",1,2)
		STOC A 0
		"####" A 0
		"####" A 0 A_PlaySound("ASG/bolt1", 5)
		"####" AB 1
		"####" A 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		"####" C 1 offset(0,33)
		"####" C 5 offset(0,32)
		"####" A 0 A_PlaySound("ASG/Bolt2", 5)
		"####" D 1 
		STOT A 0 A_JumpIfInventory("StonerDeployed",1,2)
		Goto EndClearJam
		STOT F 0
		STOT FFE 1
		STOT E 0

	EndClearJam:
		STOA A 0 A_JumpIfInventory("StonerDeployed",1,2)
		STOG A 3
		"####" AA 0
		"####" A 0 A_JumpIfInventory("StonerDeployed",1,"Ready2")
		Goto Ready

	Reload:
	CheckCondition:
		"####" A 0
		"####" A 0 A_TakeInventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1,"Ready")
		"####" A 0 A_JumpIfInventory("PB_HighCalMag",1,2)
		Goto Ready
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		STOA A 0 A_JumpIfInventory("StonerDeployed",1,2)
		Goto StartCheckCondition
		STOT E 0
		STOT EFF 1
		STOT F 0
	StartCheckCondition:
		STOA A 0 A_JumpIfInventory("StonerDeployed",1,2)
		STOG A 3
		"####" AA 0
		STOT A 0 A_JumpIfInventory("StonerDeployed",1,2)
		STOC A 0
		"####" A 0
		"####" A 0 A_PlaySound("ASG/bolt1", 5)
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 599, "PrintConditionPristine")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 540, "PrintConditionExcellent")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 480, "PrintConditionVeryGood")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 420, "PrintConditionGood")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 360, "PrintConditionFair")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 300, "PrintConditionWorn")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 240, "PrintConditionHeavilyWorn")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 180, "PrintConditionBad")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 120, "PrintConditionCritical")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 60, "PrintConditionAlmostBroken")
		"####" "#" 0 A_JumpIfInventory("StonerDurability", 30, "PrintConditionBroken")

	PrintConditionTrash:
		"####" "#" 0 A_Print("Condition: \crTrash\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionBroken:
		"####" "#" 0 A_Print("Condition: \cgBroken\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionAlmostBroken:
		"####" "#" 0 A_Print("Condition: \cgAlmost Broken\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionCritical:
		"####" "#" 0 A_Print("Condition: \caCritical\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionBad:
		"####" "#" 0 A_Print("Condition: \caBad\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionHeavilyWorn:
		"####" "#" 0 A_Print("Condition: \ciHeavily Worn\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionWorn:
		"####" "#" 0 A_Print("Condition: \ciWorn\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionFair:
		"####" "#" 0 A_Print("Condition: \ckFair\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionGood:
		"####" "#" 0 A_Print("Condition: \cdGood\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionVeryGood:
		"####" "#" 0 A_Print("Condition: \cdVery Good\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionExcellent:
		"####" "#" 0 A_Print("Condition: \cdExcellent\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionPristine:
		"####" "#" 0 A_Print("Condition: \cCPristine\n\n\n\n\n\n\n")

	CarryOnWithThatChecking:
		"####" AB 1
		"####" C 1 offset(0,33)
		"####" C 5 offset(0,32)
		"####" A 0 A_PlaySound("ASG/Bolt2", 5)
		"####" D 1 
		STOT A 0 A_JumpIfInventory("StonerDeployed",1,2)
		Goto EndCheckCondition
		STOT F 0
		STOT FFE 1
		STOT E 0

	EndCheckCondition:
		"####" A 0 A_TakeInventory("Reloading",1)
		STOA A 0 A_JumpIfInventory("StonerDeployed",1,2)
		STOG A 3
		"####" AA 0
		"####" A 0 A_JumpIfInventory("StonerDeployed",1,"Ready2")
		Goto Ready

	Dropper:
		GLOA A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1,"Ready")
		919A A 0 A_Takeinventory("Zoomed",1)
		919A A 0 A_Takeinventory("ADSmode",1)
		919A A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("DropStoner", 1)
		TNT1 A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Stop
	Spawn:
		WSTO A 1
		WSTO A 1 A_SpawnItemEx ("StonerSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop

	}
}
ACTOR RifleCaseSpawnLeft
{
	Speed 20
	PROJECTILE
	RenderStyle "None"
	+NOCLIP
	+CLIENTSIDEONLY
	+NOINTERACTION
	+INVISIBLE
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 1 A_CustomMissile("EmptyBrass",1,0,random(80,100),2,random(45,80))
		Stop
	}
}

ACTOR StonerPickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceStoner LMG! \c-(slot 6)"
	Inventory.PickupSound "CBOXPKUP"
	States
	{
	Spawn:
		P3ST A 0
		WSTO A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WSTO A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("Stoner", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("Stoner", 1)
		P3ST A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 1)
		P3ST A 0 A_GiveInventory("StonerDurability", 600)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 50)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 50)
		Stop
	}
}

Actor StonerDeployed : bd_Token {
}
ACTOR NeverSelectedStoner : bd_Token {
}
Actor StonerSelected : bd_Token {
}

ACTOR StonerPickUpHC: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	+THRUACTORS
	States
	{
	Spawn:
		WSTO A 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		WSTO A -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("Stoner", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 6, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceStoner LMG! \c-(Bulk: 5)\n Condition: \cCPristine")
		TNT1 A 0 A_GiveInventory("Stoner", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 5)
		TNT1 A 0 A_GiveInventory("StonerDurability", 600)
		TNT1 A 0 A_SelectWeapon("Stoner")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("StonerPickUpHC")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("StonerPickUpHC")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

