ACTOR Mosin : PB_WeaponBase
{
	Weapon.SlotNumber 4
	Game Doom
	Weapon.AmmoType1 "PB_HighCalMag"
	Weapon.AmmoType2 "MosinAmmo"
	Weapon.SelectionOrder 1300
	+INVENTORY.UNDROPPABLE
	Inventory.PickupSound "MBolt"
	Inventory.PickupMessage "You got the \ceMosin-Nagant! \c-(slot 4)"
	Obituary "$OBBD_SNIPER"
	Tag "Mosin-Nagant"
	States
	{
	NoAmmo:
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	Inspect:
		NUGG A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		NUGG A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		NUGG A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		NUGG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		NUGG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		NUGG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		NUGG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		NUGG A 0 A_JumpIfInventory("Zoomed",1,"REady2")
		NUGG A 0 A_Takeinventory("ZoomHold",1)
		NUGG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(41)
		NUGG A 0 A_Takeinventory("Zoomed",1)
		NUGG A 0 A_Takeinventory("ADSmode",1)
		NUGG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		NUGG A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		NUGG AAA 0
		NUGG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		NUGG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		NUGG A 0 A_GiveInventory("DoInspect",1)
		NUGG A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		NUGG A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		NUGG A 0 A_TakeInventory("DoInspect",1)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		NUGb ABCDE 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_Giveinventory("IsInspecting",1)
	ContinueInspect2:
		NUGB EEE 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("MBolt1", 5)
		NUGB FGHHHIJ 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		NUGB K 2 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		SHTN H 0 A_PlaySound("MBolt2", 5)
		NUGB JIHHHH 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
		NUGB GFEE 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("IsInspecting",1)
		NUGB DCBA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		Goto ReadyToFireAgain

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		NUGS AB 1 A_DoPBWeaponAction
		NUGS C 14 A_DoPBWeaponAction
		NUGS BA 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		NUGS AB 1 A_DoPBWeaponAction
		NUGS C 14 A_DoPBWeaponAction
		NUGS BA 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		NUGS AB 1 A_DoPBWeaponAction
		NUGS C 38 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		NUGS C 7 A_DoPBWeaponAction
		NUGS BA 1 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		NUGS CCCCBA 1
		Stop

	Spawn:
		WNUG A 1
		WNUG A 1 A_SpawnItemEx ("MosinSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop

	FirstSelectAnimation:
		NUGG A 0 A_Takeinventory("NeverSelectedMosin",1)
		NUGG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		NUGB ACDE 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		NUGB F 1 A_PlaySound("MBolt1", 5)
		NUGB GHIJKKKKKK 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		NUGB H 0 A_PlaySound("MBolt2", 5)
		NUGB JIHGFEDCBA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_NOFIRE)
		Goto Ready3

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("DMRSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		NUGG A 0 A_Giveinventory("MosinSelected",1)
		TNT1 A 0 A_SetCrosshair(41)
		TNT1 A 1
		NUGG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		NUGG A 0 A_JumpIfInventory("NeverSelectedMosin", 1, "FirstSelectAnimation")
			TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
			Goto Ready3
	SelectAnimation:
		NUGG A 0 A_JumpIfInventory("MosinWasEmpty",1,2)
		NUGG A 0 A_PlaySound("MBolt2", 1)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		NUGS CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		NUGG A 0 A_JumpIfInventory("MosinWasEmpty",1,"Bolt1")
		NUGG A 0 A_GunFlash
		TNT1 A 0 A_TakeInventory("RELOADING",1)
	Ready3:
	Ready:
		TNT1 A 0 A_SetCrosshair(41)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		NUGG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		NUGG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		NUGG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		NUGG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		NUGG A 0 A_JumpIfInventory("Zoomed",1,"REady2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		NUGG A 0 A_JumpIfInventory("YetToBolt",1,"Bolt1")
	OkToFire:
		NUGG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		NUGG A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		NUGG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		NUGG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_SetCrosshair(41)
		Goto Ready

	Ready2:
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		NUGG A 0 A_JumpIfInventory("MosinWasEmpty", 1, "Bolt3")
		NUGG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		NUGG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		NUGG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		NUGG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		NUGG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		NUGG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		NUGG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		NUGG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		NUGG A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		Loop

	Deselect:
		NUGG A 0 A_Takeinventory("Zoomed",0)
		NUGG A 0 A_TakeInventory("TossGrenade", 0)
		NUGG A 0 A_Takeinventory("ADSmode",0)
		TNT1 A 0 A_TakeInventory("HoldInspect",0)
		AKMG A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_TakeInventory("IsInspecting",0)
		NUGG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(41)
		TNT1 A 0 A_Lower(120)
		Wait


	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("MosinWasEmpty", 1, "Bolt2")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("MosinAmmo",1,1)
		Goto NoAmmo
		"####" "#" 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 3)
		"####" "#" 0 A_JumpIfInventory("MosinDurability",1,1)
		Goto GunBroken
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("MosinDurability",35,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "#" 0
		"####" "#" 0 A_Takeinventory("MosinAmmo",1)
		Goto ResumeFireFrame

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("PB_HighCalMag",2,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" "#" 0
		"####" A 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_Quake(4,4,0,12,"")
		"####" A 0 A_AlertMonsters
		x21G A 0 A_PlaySound("Sniper/Fire", 1)
		SMGG A 0 A_PlaySound("FARM14", 6)
		//"####" A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" A 0 { PB_GunSmoke_Sniper(0,0,0); }
		"####" "#" 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		NUGF A 1 BRIGHT { PB_LowAmmoSoundWarning("sniper"); PB_FireBullets("PB_762x51mmAP", 1, 0, 0, 0, 0); }
		x21F A 0 BRIGHT A_RailAttack (0, 0, 0, "none", "Gray", RGF_SILENT, 0, "None", 0, 0, 14000, 15, 1)//Trail effect only
		x21F A 0 BRIGHT A_RailAttack (50, 0, 0, "none", "None", RGF_SILENT, 0, "sniperpuff", 0, 0, 500, 15, 1)//Heavy penetration
		"####" A 0 A_ZoomFactor(0.97)
		NUGF B 1 A_SetPitch(pitch-12)
		NUGF C 1 A_ZoomFactor(1.0)
		NUGG A 1 A_SetPitch(-6.0 + pitch)
		NUGG AA 1 A_SetPitch(+2.5 + pitch)
		NUGG A 1 A_SetPitch(+1.0 + pitch)
		NUGG AAAAAA 1 A_SetPitch(pitch+0.6)
		"####" A 0 A_GiveInventory("MosinWasEmpty",1) 
		NUGG A 1 A_DoPBWeaponAction(WRF_NOPRIMARY)

	Bolt1:
		NUGB A 0
		NUGB A 0 A_GiveInventory ("Bolting", 1)
		NUGG A 0 A_Takeinventory("YetToBolt",1)
		NUGB A 0 A_GiveInventory ("GoSpecial", 1)
		NUGB A 0 A_JumpIfInventory("MosinAmmo",1,3)
		NUGB A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		NUGB ABCDE 1
		TNT1 A 0 A_PlaySound("MBolt1", 5)
		NUGB A 0 A_Takeinventory("MosinWasEmpty",1)
		NUGB A 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		NUGB A 0 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
		NUGB FGH 1
		NUGB IJ 1
		NUGB KKKKKKKK 1
		NUGB A 0 A_Takeinventory("MosinWasEmpty",1)
		NUGB H 0 A_PlaySound("MBolt2", 5)
		NUGB A 0 A_JumpIfInventory("NoReloading",1,13)
		NUGB A 0 A_JumpIfInventory("MosinAmmo",0,12)
		NUGB JI 1 A_JumpIfInventory("Reloading",1,"ReloadFromBolting")
		NUGB HGF 1 A_JumpIfInventory("Reloading",1,"ReloadFromBolting")
		NUGB A 0 A_JumpIfInventory("MosinAmmo",1,2)
		NUGB A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		NUGB EDCBA 1 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		NUGG A 2
		Goto ReadyToFireAgain

	Bolt2:
		NUGG A 0
		NUGG A 0 A_GiveInventory ("Bolting", 1)
		NUGG A 0 A_GiveInventory ("GoSpecial", 1)
		NUGG A 0 A_TakeInventory("Reloading", 1)
		NUGG A 0 A_Takeinventory("Zoomed",1)
		NUGG A 0 A_ZoomFactor(1.0)
		NUGG A 0 A_Takeinventory("YetToBolt",1)
		"####" A 0 A_JumpIfInventory("MosinAmmo",1,3)
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		//NUGB ABCDE 1
		//NUGB E 1 A_PlaySound("MBolt1", 5)
		NUGG A 0
		//NUGG A 0 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		//NUGB FGH 1
		NUGG A 0 A_Takeinventory("MosinWasEmpty",1)
		NUGG A 0		
		SHTN H 0 
		//NUGG A 0 A_JumpIfInventory("MosinAmmo",0,19)
		NUGR CBA 1 A_JumpIfInventory("Reloading",1,"ReloadFromBolting")
		NUGB KKKKKKKK 1 A_JumpIfInventory("Reloading",1,"ReloadFromBolting")
		TNT1 A 0 A_PlaySound("MBolt2", 5)
		NUGG A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		NUGG A 0 A_JumpIfInventory("PB_HighCalMag",1,2)
		//Goto ReadyToFireAgain
		NUGG AA 0
		NUGG A 0 A_JumpIfInventory("Reloading",1,"InsertingBullets")
		NUGG A 0 A_JumpIfInventory("MosinAmmo",1,2)
		NUGG A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		NUGG A 0
		//Goto ReadyToFireAgain
		NUGG AA 0
		NUGB JIHGFEDCBA 1 A_DoPBWeaponAction(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		NUGG A 2
		Goto ReadyToFireAgain

	ReadyToFireAgain:
		2HTA A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTA A 0
		NUGG AAAAA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 //A_Refire
		Goto Ready3

	IsHolding:
		NUGG A 0 A_GiveInventory("ZoomHold", 1)
		Goto ready2

	Fire2:
		NUGG A 0
		NUGG A 0 A_Takeinventory("Reloading",1)
		NUGG A 0 A_JumpIfInventory("MosinWasEmpty", 1, "Bolt3")
		NUGG A 0 A_AlertMonsters
		SNIP D 0
		"####" "#" 0 { PB_GunSmoke_Sniper(0,0,0); }
		SNIP A 1 BRIGHT { PB_LowAmmoSoundWarning("sniper"); PB_FireBullets("PB_762x51mmAP", 1, 0, 0, 0, 0); }
		x21F A 0 BRIGHT A_RailAttack (0, 0, 0, "none", "Gray", RGF_SILENT, 0, "None", 0, 0, 14000, 15, 1)//Trail effect only
		x21F A 0 BRIGHT A_RailAttack (50, 0, 0, "none", "None", RGF_SILENT, 0, "sniperpuff", 0, 0, 500, 15, 1)//Heavy penetration
		x21G A 0 A_ZoomFactor(4.93)
		SNIP B 1 A_SetPitch(pitch-2)
		SNIP D 0 A_SetANgle(angle-1.5)
		SNIP C 1
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		NUGG A 0 A_GiveInventory("YetToBolt", 1)
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 A_ZoomFactor(5.0)
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
		SNIP D 0 A_SetANgle(angle+0.1)
		SNIP D 12 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOPRIMARY)
	Bolt3:
		SNIP D 0
		SNIP D 0 A_JumpIfInventory("MosinAmmo", 1, 2)
		SNIP D 0 A_JumpIfInventory("FiredSecondary",1, 1)
		Goto NoAmmo3
		SNIP DCB 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOPRIMARY)
		SNIP D 0 A_GiveInventory("Bolting", 1)
		SHTN A 0 A_PlaySound("Mbolt1", 5)
		SNIP B 1 Offset(2,34)
		SNIP B 1 Offset(4,36)
		SNIP B 1 Offset(4,38)
		TNT1 A 0 A_SetANgle(angle+random(-1, 1))
		SNIP D 0 A_SetPitch(-0.1 + pitch)
		SNIP B 1 Offset(6,40)
		SNIP D 0 A_SetPitch(-0.1 + pitch)
		//SHTN A 0 A_JumpIfInventory("MosinNagantWasEmpty", 1, 1))
		SHTN A 0 A_TakeInventory("MosinWasEmpty", 1)
		SNIP D 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 14, 0, frandom(4,7), frandom(6,9), frandom(0,5)); }
		MNOA A 0 A_Takeinventory("YetToBolt",1)
		SNIP bB 2 Offset(7,41)
		SNIP BBB 3 Offset(8,42)
		SHTN A 0 A_PlaySound("Mbolt2", 5)
		SNIP B 1 Offset(7,41)
		SNIP B 1 Offset(6,40)
		SNIP B 1 Offset(4,38)
		SNIP B 1 Offset(4,36)
		SNIP B 1 Offset(2,34)
		SNIP B 1 Offset(0,32)
		SNIP BbBCCD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOPRIMARY)
		SNIP D 0
		SNIP D 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		SNIP D 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SNIP D 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")//If still pressing alt fire, it means its holding aim
		SNIP D 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		TNT1 AAA 0
		SNIP D 0 A_REfire
		SNIP D 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SNIP D 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		Goto Ready2

	AltFire:
		NUGG A 0
		NUGG A 0 A_Giveinventory("GoSpecial",1)
		NUGG A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		NUGG A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		NUGG A 0 A_ZoomFactor(5)
		NUGG A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		NUGG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		NUGZ AB 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE|WRF_NOBOB)
		//TNT1 A 0 A_PlayWeaponSound("Shotgun/Fire/move")
		NUGG A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		NUGG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		NUGG A 0 A_JumpIfInventory("FiredSecondary",1,3)
		SNIP D 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		SNIP D 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		SNIP DDD 1
		NUGG A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		NUGZ AB 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		SNIP D 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		NUGG AA 0
		NUGG A 0 A_GiveInventory("ZoomHold",1)
		NUGG A 0 A_JumpIfInventory("MosinWasEmpty", 1, "Bolt3")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		NUGG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		NUGG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		NUGG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		SNIP D 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		NUGG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		NUGG AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(41)
		TNT1 AAAAAA 0
		NUGG A 0 A_Takeinventory("Zoomed",1)
		NUGG A 0 A_ZoomFactor(1.0)
		NUGG A 0 A_Takeinventory("ADSmode",1)
		NUGG A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		NUGG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		NUGZ BA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		NUGG A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready

	ToggleNoAim:
		NUGZ BA 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		NUGG A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready

	StartSprint:
		NUGG A 0 A_Takeinventory("NeverSelectedMosin",1)
		NUGG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		NUGS A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		NUGG A 0 A_Takeinventory("Zoomed",1)
		NUGG A 0 A_Takeinventory("ADSmode",1)
		NUGG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(41)
	Sprinting:
		SHTA R 0 offset(-9,32)
		//NUGG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		NUGG A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		NUGG A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		NUGG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		NUGG A 0 offset(-9,32)
		NUGS A 1 offset(-9,34) A_SetPitch(pitch -0.5)
		NUGS A 1 offset(-6,36) A_SetPitch(pitch -0.5)
		NUGS A 1 offset(-3,38) A_SetPitch(pitch -0.5)
		NUGS A 1 offset(0,38) A_SetPitch(pitch -0.5)
		NUGS A 1 offset(3,36) A_SetPitch(pitch -0.5)
		NUGS A 1 offset(6,34) A_SetPitch(pitch -0.5)
		NUGS A 1 offset(9,32) A_SetPitch(pitch -0.5)
		NUGG A 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		NUGG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		NUGG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		NUGG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		NUGG A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		NUGS A 1 offset(9,34) A_SetPitch(pitch +0.5)
		NUGS A 1 offset(6,36) A_SetPitch(pitch +0.5)
		NUGS A 1 offset(3,38) A_SetPitch(pitch +0.5)
		NUGS A 1 offset(0,38) A_SetPitch(pitch +0.5)
		NUGS A 1 offset(-3,36) A_SetPitch(pitch +0.5)
		NUGS A 1 offset(-6,34) A_SetPitch(pitch +0.5)
		NUGS A 1 offset(-9,32) A_SetPitch(pitch +0.5)
		NUGG A 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		NUGG A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		NUGS A 1
		NUGG A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	ReloadFromBolting:
		NUGG A 0 A_Takeinventory("Reloading",1)
		NUGG AA 0 A_JumpIfInventory("MosinAmmo",0,"Bolt2")
		NUGG A 0 A_JumpIfInventory("PB_HighCalMag", 2, 2)
		Goto Bolt2+38
		NUGG AA 0
		SHTN ST 1
		Goto InsertingBullets

	ReloadWithNoAmmoLeft:
	Reload:
		2HTN A 0
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		2HTN A 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		NUGG A 0 A_JumpIfInventory("PB_HighCalMag", 2, 2)
		Goto Ready
		NUGG AA 0
		NUGG AA 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		NUGG AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		NUGG A 0 A_Takeinventory("ADSmode",1)
		NUGG A 0 A_Takeinventory("Zoomed",1)
		NUGG A 0 A_Takeinventory("ZoomHold",1)
		NUGG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(41)
		NUGG A 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		NUGG A 0 A_JumpIfInventory("IsInspecting",1,"ContinueInspect2")
		NUGG A 0 A_JumpIfInventory("MosinAmmo",0,"Inspect")
		NUGG A 0 A_JumpIfInventory("MosinAmmo", 1, "ReloadNormally")//Check if there is a shell in the chamber
		NUGG A 0 A_GiveInventory("MosinWasEmpty", 1)//This means there is no shell in the chamber
	ReloadNormally:
		NUGG A 0 A_JumpIfInventory("PB_HighCalMag",2,2)//If there is no reserve ammo, don't reload, go back to Ready
		Goto Ready
		NUGG AAA 0
		NUGG AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		NUGG A 0 A_Takeinventory("ADSmode",1)
		NUGG A 0 A_Takeinventory("Zoomed",1)
		NUGG A 0 A_Takeinventory("ZoomHold",1)
		NUGG A 1 A_GiveInventory ("Bolting", 1)
		NUGB ABCDE 1
		TNT1 A 0 A_PlaySound("MBolt1", 5)
		NUGB A 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		NUGB FGH 1
		NUGB IJ 1
		NUGB KKKKKKK 1
		NUGR ABCD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		NUGR DDD 1  A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	InsertingBullets:
		NUGG A 0
		NUGG A 0 A_JumpIfInventory("PB_HighCalMag",2,2)//if there are no more reserve Bullets, finish reload.
		Goto Bolt2
		NUGG AAA 0
		NUGG A 0 A_GiveInventory ("Bolting", 1)
		SSHR AA 0 A_TakeInventory("Reloading", 1)
		NUGG AA 0 A_JumpIfInventory("MosinAmmo",0,"CheckIfFinishReload")
		NUGG A 0 A_Giveinventory("MosinAmmo",1)
		NUGG A 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
	InsertBulletAnimation:
		NUGG A 0
		NUGR EFG 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Reload",5)
		NUGR G 3 A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
		NUGR GFE 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
		//NUGS A 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
		NUGG AA 0 A_JumpIfInventory("Reloading", 1, "FinishedInsertingBullets")
		NUGG AA 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		NUGG AA 0 A_JumpIfInventory("MosinAmmo",0,"FinishedInsertingBullets")//If there are 8+1 Bullets, stop it immediately
		Goto InsertingBullets

	CheckIfFinishReload:
		//SSHR A 1
		NUGG AA 0 A_JumpIfInventory("MosinWasEmpty", 1, "FinishedInsertingBullets")//If shotgun was empty,
		//Play the insert shell animation again, and insert the 9th shell
		NUGG A 0 A_JumpIfInventory("PB_HighCalMag",2,1)//if there are no more reserve Bullets, finish reload.
		Goto Bolt2
		NUGG A 0 A_Giveinventory("MosinAmmo",1)
		NUGG A 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
		Goto InsertBulletAnimation

	FinishedInsertingBullets:
		NUGG AA 0 A_Takeinventory("Reloading",1)
		NUGG A 0 A_Takeinventory("YetToBolt",1)
		NUGG AA 0 A_JumpIfInventory("MosinWasEmpty", 1, "Bolt2") //?
		NUGR DDD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		NUGR DCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		NUGG AA 0 A_Takeinventory("Reloading",1)
		NUGB KKKKKKK 1
		NUGB H 0 A_PlaySound("MBolt2", 5)
		NUGB JIHGFEDCBA 1
		Goto ReadyToFireAgain

	TurboReload:
		SHSS BC 0
	TurboBullets:
		NUGG A 0
		NUGG AA 0 A_JumpIfInventory("MosinAmmo",0,"FinishTurboReload")
		NUGG A 0 A_JumpIfInventory("PB_HighCalMag",2,3)
		Goto FinishTurboReload
		TNT1 AAAA 0
		NUGG A 0 A_Giveinventory("MosinAmmo",1)
		NUGG A 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
		Goto TurboBullets
	FinishTurboReload:
		NUGG A 1
		NUGG A 1 A_Refire
		Goto Ready3

	TurboReload2:
		SHSS BC 0
	TurboBullets2:
		NUGG A 0
		NUGG AA 0 A_JumpIfInventory("MosinAmmo",0,"FinishTurboReload")
		NUGG A 0 A_JumpIfInventory("PB_HighCalMag",2,3)
		Goto FinishTurboReload2
		TNT1 AAAA 0
		NUGG A 0 A_Giveinventory("MosinAmmo",1)
		NUGG A 0 A_Takeinventory("PB_HighCalMag",2,TIF_NOTAKEINFINITE)
		Goto TurboBullets2

	FinishTurboReload2:
		SNIP D 1 A_Refire
		Goto Ready2

	ReloadingKickFlash://DoKickReloading:
		//TNT1 A 0 A_GunFlash("ReloadingKickFlash")
		TNT1 A 0 A_PlaySound("Kick/Swing", 5)
		TNT1 A 0 SetPlayerProperty(0,1,0)
		KICK ABC 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_Quake(2,2,0,12,"")
		KICK D 1 A_FireCustomMissile("KickAttack", 0, 0, 0, -7)
		KICK A 0 A_Takeinventory("Kicking",1)
		KICK EEEEFGHIJKLM 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 SetPlayerProperty(0,0,0)
		RIBA A 0 A_Takeinventory("Kicking",1)
		Stop//Goto InsertingBullets

	DoKickReloading://ReloadingKickFlash:
		TNT1 A 0 A_GunFlash("ReloadingKickFlash")
		NUGS A 1 Offset(0, 34)
		NUGS A 1 Offset(0, 38)
		NUGS B 1 Offset(0, 42)
		NUGS C 4 Offset(0, 50)
		NUGS B 1 Offset(0, 42)
		NUGS A 1 Offset(0, 38)
		NUGS A 1 Offset(0, 34)
		NUGG A 4
		Goto InsertingBullets//Stop
	GunBroken:
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 0 A_Print("Your rifle has been destroyed!\n\n\n\n\n\n\n")
		"####" "#" 0 A_GiveInventory("MosinDestroyed", 1)
		"####" "#" 0 A_PlaySound("DSBRK2")
		"####" "#" 0 A_Quake(4,5,0,12,"")
		"####" "##" 0 A_CustomMissile("MetalShard1", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles", 20, 0, random(-35, 35), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile ("MetalShard2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#####" 0 A_CustomMissile ("WoodParticle", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile("ExplosionParticle", 20, 0, random(-10, 10), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard3", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		TNT1 A 0 A_GiveInventory("DropMosin", 1)
		TNT1 A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Stop

	RollForJam:
		"####" "#" 0 A_JumpIfInventory("MosinDurability", 67, "JamChanceLow")
		"####" "#" 0 A_JumpIfInventory("MosinDurability", 40, "JamChanceMid")

	JamChanceHigh:
		"####" "#" 0 A_Jump(12, "ClearJam")
		Goto ResumeFireFrame

	JamChanceMid:
		"####" "#" 0 A_Jump(9, "ClearJam")
		Goto ResumeFireFrame

	JamChanceLow:
		"####" "#" 0 A_Jump(6, "ClearJam")
		Goto ResumeFireFrame

	ClearJam:
		NUGG A 0
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_ClearReFire
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 2 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 1 A_ClearReFire
		"####" "#" 1 
		NUGB ABCDE 1
		NUGB E 0 A_PlaySound("MBolt1", 5)
		NUGB F 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		NUGB FGHIJ 1
		NUGB K 10
		NUGB J 0 A_PlaySound("MBolt2", 5)
		NUGB JIHGF 1
		NUGB EDCBA 1
		NUGG A 2
		Goto Ready

	PrintConditionTrash:
		"####" "#" 0 A_Print("Condition: \crTrash\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionBroken:
		"####" "#" 0 A_Print("Condition: \cgBroken\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionAlmostBroken:
		"####" "#" 0 A_Print("Condition: \cgAlmost Broken\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionCritical:
		"####" "#" 0 A_Print("Condition: \caCritical\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionBad:
		"####" "#" 0 A_Print("Condition: \caBad\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionHeavilyWorn:
		"####" "#" 0 A_Print("Condition: \ciHeavily Worn\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionWorn:
		"####" "#" 0 A_Print("Condition: \ciWorn\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionFair:
		"####" "#" 0 A_Print("Condition: \ckFair\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionGood:
		"####" "#" 0 A_Print("Condition: \cdGood\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionVeryGood:
		"####" "#" 0 A_Print("Condition: \cdVery Good\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionExcellent:
		"####" "#" 0 A_Print("Condition: \cdExcellent\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionPristine:
		"####" "#" 0 A_Print("Condition: \cCPristine\n\n\n\n\n\n\n")

	Inspect2CarryOn:
		"####" "#" 0 A_GiveInventory("HoldInspect",1)

	Dropper:
		GLOA A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1,"Ready")
		919A A 0 A_Takeinventory("Zoomed",1)
		919A A 0 A_Takeinventory("ADSmode",1)
		919A A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("DropMosin", 1)
		TNT1 A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Stop

	Steady:
		TNT1 A 1
		Goto Ready

	NoAmmo3:
		RIFG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SNIP D 4 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOPRIMARY)
		RIFG A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"TurboReload2")
		TNT1 A 0 A_JumpIfInventory("NoAutoReload", 1, "NoAmmo3")
		RIFG A 0 A_JumpIfInventory("PB_HighCalMag",1,"Reload")
		RIFG A 0 A_JumpIfInventory("FiredPrimary",1,"NoAmmo3")
		Goto Ready3


}
}
ACTOR MosinAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 5
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 5
	Inventory.Icon "WNUGA0"
}

Actor Bolting : bd_Token {
}
Actor MosinWasEmpty : bd_Token {
}
ACTOR NeverSelectedMosin : bd_Token {
}
ACTOR YetToBolt : bd_Token {
}
Actor MosinSelected : bd_Token {
}
ACTOR MosinPickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceMosin-Nagant! \c-(slot 4)"
	Inventory.PickupSound "MBOLT"
	States
	{

	Spawn:
		P3ST A 0
		WNUG A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WNUG A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("Mosin", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("Mosin", 1)
		P3ST A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 1)
		P3ST A 0 A_GiveInventory("MosinDurability", 300)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 5)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 5)
		Stop

}

}

Actor MosinDestroyed : bd_Token {}

ACTOR MosinPickUpHC: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	//scale 0.74
	+THRUACTORS
	States
	{
	Spawn:
		WNUG A 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		WNUG A -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("Mosin", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 6, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceMosin-Nagant! \c-(Bulk: 5)\n Condition: \cCPristine")
		TNT1 A 0 A_GiveInventory("Mosin", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 5)
		TNT1 A 0 A_GiveInventory("MosinDurability", 300)
		TNT1 A 0 A_SelectWeapon("Mosin")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("MosinPickUpHC")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("MosinPickUpHC")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

