ACTOR RPD : PB_WeaponBase
{
	Weapon.SlotNumber 5
	Weapon.AmmoType "PB_HighCalMag"
	Weapon.AmmoGive 0
	Weapon.SelectionOrder 700
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \ceRPD! \c-(slot 6)"
	Obituary "$OBBD_RIFLE"
	Tag "RPD"
	States
	{
	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		RPDG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"KickFlashLoaded")
		RPDS DE 1 A_DoPBWeaponAction
		RPDs F 14 A_DoPBWeaponAction
		RPDs ed 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		RPDG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"KickFlashLoaded")
		RPDS DE 1 A_DoPBWeaponAction
		RPDs F 14 A_DoPBWeaponAction
		RPDs ed 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		RPDG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"SlideFlashLoaded")
		RPDs de 1 A_DoPBWeaponAction
		RPDs f 12 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		RPDG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"SlideFlashEndLoaded")
		RPDs c 7 A_DoPBWeaponAction
		RPDs ed 1 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		RPDG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"SlideFlashEndEarlyLoaded")
		RPDs c 4
		RPDs AB 1
		Stop
	KickFlashLoaded: 
		RPDs AB 1
		RPDs c 14
		RPDs BA 1
		Goto Ready3
	SlideFlashLoaded:
		RPDs AB 1
		RPDs c 35
		Goto Ready3
	SlideFlashEndLoaded: 
		RPDs c 7
		RPDs BA 1
		Goto Ready3
	SlideFlashEndEarlyLoaded: 
		RPDs c 4
		RPDs BA 1
		Goto Ready3

	StartSprint:
		RPDG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		RPDG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"StartSprintLoaded")
		RPDS d 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Sprinting
	StartSprintLoaded:
		RPDs a 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Sprinting:
		PISP A 0 offset(-9,32)
		//RPDG E 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		RPDG E 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		RPDG E 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		RPDG E 0 offset(-9,32) A_GiveInventory("UsedStamina", 7)
		RPDG E 0 offset(-9,32)
		RPDS A 0 A_JumpIfInventory("PB_HighCalMag", 1,2)
		RPDS D 0
		RPDS "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		RPDS "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		RPDS "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		RPDS "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		RPDS "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		RPDS "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		RPDS "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		RPDS "#" 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		RPDS "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RPDS "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		RPDS "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 7)
		RPDS "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		RPDS "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		RPDS "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		RPDS "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		RPDS "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		RPDS "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		RPDS "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		RPDS "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		RPDS "#" 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		RPDS "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint
	StopSprint:
		RPDG J 0 A_JumpIfInventory("PB_HighCalMag", 1,"StopSprintLoaded")
		RPDs d 1
		RPDs d 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	StopSprintLoaded:
		RPDs a 1
		RPDs a 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("RPDSelected",1)
		TNT1 A 0 A_Giveinventory("HeavyAutomaticWeapon",1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")

			TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
			Goto Ready3
	SelectAnimation:
		//TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		TNT1 A 0 A_PlaySound("CHGNPKUP", 5)
		PISS A 0 A_JumpIfInventory("PB_HighCalMag", 1, 2)
		Goto SelectAnimationEmpty
		TNT1 AA 0
		RPDS CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	SelectAnimationEmpty:
		RPDS FED 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RPDG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		RPDG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RPDG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RPDG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RPDG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RPDD C 0 A_JumpIfInventory("RPDDeployed",1,"ready4")
		RPDG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RPDG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RPDG A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		TNT1 AAA 0
		RPDG A 0
		RPDG A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		RPDG B 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		Loop

	Ready2:
		TNT1 A 0 A_TakeInventory("MGIsOverSOmething", 1)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		RPDA A 0
		RPDA A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		RPDA G 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		RPDG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, "Ready2")
		RPDU A 0
		RPDU A 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		RPDU C 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		TNT1 A 0
	Ready4:
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		RPDG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RPDG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RPDG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RPDG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RPDG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RPDG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RPDu b 0
		RPDu b 0 A_JumpIfInventory("PB_HighCalMag",2,2)
		RPDu d 0
		"####" "#" 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOPRIMARY)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, "Ready2")
		Loop

	Deselect:
		RPDG A 0 A_Takeinventory("RPDDeployed",1)
		RPDG A 0 A_TakeInventory("TossGrenade", 1)
		RPDG A 0 A_TakeInventory("Kicking",1)
		RPDG A 0 A_TakeInventory("Taunting",1)
		AKMG A 0 A_TakeInventory("DropIt", 1)
		RPDG A 0 A_TakeInventory("Reloading",1)
		RPDG A 0 A_TakeInventory("Unloading",1)
		RPDG A 0 A_TakeInventory("Salute1", 1)
		RPDG A 0 A_TakeInventory("Salute2", 1)
		RPDG A 0 A_Takeinventory("RPDSelected",1)
		CHAG A 0 A_Takeinventory("HeavyAutomaticWeapon",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		RPDG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		PISS E 0 A_JumpIfInventory("PB_HighCalMag", 1, 1)
		Goto DeselectEmpty
		PISS E 0
	DeselectContinue:
		RPDs ABC 1
		TNT1 A 0 A_Lower(120)
		Wait

	DeselectEmpty:
		RPDS DEF 1
		TNT1 A 0 A_Lower(120)
		Wait


	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		RPDG A 0
		RPDG "#" 0 A_JumpIfInventory("PB_HighCalMag",1,"ContinueFiring")
		Goto RPDEmpty
	ContinueFiring:
		RPDG "###" 0
		TNT1 A 0 A_JumpIFInventory("RPDDeployed", 1, "Fire2")
		RPDG "#" 0 A_Takeinventory("PB_HighCalMag",1)
		RPDG "#" 0 A_JumpIfInventory("PB_HighCalMag",15,1)
		RPDG "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		RPDG A 0 A_AlertMonsters
		RPDG A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		RPDG A 0 A_PlaySound("AKMFire", 1)
		RPDG "#" 0 A_Quake(1.5,2,0,3,"")
		RPDG A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		RPDG "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		RPDG "#" 0 { PB_GunSmoke(0,0,0); }
		RPDG "#" 0 A_FireCustomMissile("AK47Tracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		RPDF A 1 BRIGHT A_FireBullets (4, 4, -1, 30, "HitPuff", FBF_NORANDOM)
		RPDG B 0 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		RPDF B 1 A_ZoomFactor(0.96)
		RPDG A 0 A_SetPitch(pitch-1.5)
		RPDF C 1 
		RPDF D 1 A_ZoomFactor(1.0)
		RPDG A 0 A_Refire
		Goto Ready

	Fire2:
		TNT1 A 0
		RPDA A 0 A_Takeinventory("PB_HighCalMag",1)
		RPDA A 0 A_JumpIfInventory("PB_HighCalMag",15,1)
		RPDA A 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		RPDG A 0 A_AlertMonsters
		RPDG A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		RPDG A 0 A_PlaySound("AKMFire", 1)
		TNT1 A 0 SetPlayerProperty(0, 1, 0)
		RPDG "#" 0 A_Quake(1, 2, 0, 2, "")
		RPDG A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		RPDG A 0 { PB_GunSmoke(0,0,0); }
		RI2F A 0 BRIGHT A_FireCustomMissile("AK47Tracer", 0, 0, 0, 0)
		RPDA B 1 BRIGHT A_FireBullets (2, 2, -1, 30, "HitPuff", FBF_NORANDOM)
		RPDG A 0 A_ZoomFactor(0.97)
		RPDA C 1 A_FireCustomMissile("RifleCaseSpawn",1,0,8,0)
		RPDA D 1 A_ZoomFactor(1.0)
		TNT1 A 0 A_TakeInventory("MGIsOverSOmething", 1)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -45)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -50)
		RIFF A 0 A_FireCustomMissile("MachinegunCheck", 0, 0, 0, 12, 0, -40)
		RPDA e 1
		TNT1 A 0 A_JumpIFInventory("MGIsOverSomething", 1, 1)
		Goto Ready4
		RI2G A 0 A_ReFire
		Goto Ready2
	RPDEmpty:
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		TNT1 A 0 A_JumpIFInventory("RPDDeployed", 1, "RPDDeployedEmpty")
		RPDG B 1 A_DoPBWeaponAction(WRF_NOPRIMARY)
		Goto Ready
	RPDDeployedEmpty:
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		RPDA g 1 A_DoPBWeaponAction(WRF_NOPRIMARY)
		Goto Ready2
	 AltFire:
		TNT1 A 0
		TNT1 A 0 A_JumpIFInventory("RPDDeployed", 1, "StopAlt")
		TNT1 A 0 A_GiveInventory("RPDDeployed", 1)
		TNT1 A 0 A_JumpIfInventory("PB_HighCalMag", 1, "DeployLoaded")
		TNT1 A 0 A_PlaySound("ads/in", 5)
		RPDD hijklm 1
		Goto Ready2

	DeployLoaded:
		TNT1 A 0 A_PlaySound("ads/in", 5)
		RPDD ABCDEFG 1
		Goto Ready2
	StopAlt:
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("RPDDeployed", 1)
		TNT1 A 0 A_JumpIfInventory("PB_HighCalMag", 1, "UnDeployLoaded")
		TNT1 A 0 A_PlaySound("ads/out", 5)
		RPDD MLKJIH 1
		Goto Ready3	
	UnDeployLoaded:
		TNT1 A 0 A_PlaySound("ads/out", 5)
		RPDD gFEDCBA 1
		Goto Ready3
	GunBroken:
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 0 A_Print("Your machine gun has been destroyed!\n\n\n\n\n\n\n")
		"####" "#" 0 A_GiveInventory("RPDDestroyed", 1)
		"####" "#" 0 A_PlaySound("DSBRK2")
		"####" "#" 0 A_Quake(4,5,0,12,"")
		"####" "##" 0 A_CustomMissile("MetalShard1", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles", 20, 0, random(-35, 35), 2, random(-10, 25))
		"####" "###" 0 A_CustomMissile ("MetalShard2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "####" 0 A_CustomMissile ("WoodParticle", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile("ExplosionParticle", 20, 0, random(-10, 10), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard3", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		TNT1 A 0 A_GiveInventory("DropRPD", 1)
		TNT1 A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Stop

	RollForJam:
		"####" "#" 0 A_JumpIfInventory("RPDDurability", 100, "JamChanceLow")
		"####" "#" 0 A_JumpIfInventory("RPDDurability", 50, "JamChanceMid")

	JamChanceHigh:
		"####" "#" 0 A_Jump(10, "ClearJam")
		Goto ContinueFiring

	JamChanceMid:
		"####" "#" 0 A_Jump(7, "ClearJam")
		Goto ContinueFiring

	JamChanceLow:
		"####" "#" 0 A_Jump(5, "ClearJam")
		Goto ContinueFiring

	ClearJam:
		"####" A 1 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_ClearReFire
		"####" "#" 1 offset(0,34)
		"####" "#" 1 offset(0,33)
		"####" "#" 2 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 1 A_ClearReFire
		"####" "#" 3

		RPDT A 0 A_JumpIfInventory("RPDDeployed",1,2)
		RPDC A 0
		"####" A 0
		"####" ABBBBBB 1
		"####" A 0 A_PlaySound("Rifle/bolt1", 5)
		"####" C 1 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		"####" D 1 offset(0,33)
		"####" D 5 offset(0,32)
		"####" E 1 
		"####" A 0 A_PlaySound("ASG/Bolt2", 5)
		RPDA A 0 A_JumpIfInventory("RPDDeployed",1,2)
		RPDG A 3
		"####" AA 0
		"####" A 0 A_JumpIfInventory("RPDDeployed",1,"Ready2")
		Goto Ready

	PrintConditionTrash:
		"####" "#" 0 A_Print("Condition: \crTrash\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionBroken:
		"####" "#" 0 A_Print("Condition: \cgBroken\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionAlmostBroken:
		"####" "#" 0 A_Print("Condition: \cgAlmost Broken\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionCritical:
		"####" "#" 0 A_Print("Condition: \caCritical\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionBad:
		"####" "#" 0 A_Print("Condition: \caBad\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionHeavilyWorn:
		"####" "#" 0 A_Print("Condition: \ciHeavily Worn\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionWorn:
		"####" "#" 0 A_Print("Condition: \ciWorn\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionFair:
		"####" "#" 0 A_Print("Condition: \ckFair\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionGood:
		"####" "#" 0 A_Print("Condition: \cdGood\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionVeryGood:
		"####" "#" 0 A_Print("Condition: \cdVery Good\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionExcellent:
		"####" "#" 0 A_Print("Condition: \cdExcellent\n\n\n\n\n\n\n")
		Goto CarryOnWithThatChecking

	PrintConditionPristine:
		"####" "#" 0 A_Print("Condition: \cCPristine\n\n\n\n\n\n\n")

CarryOnWithThatChecking:
		"####" D 1 offset(0,33)
		"####" D 5 offset(0,32)
		"####" E 1 
		"####" A 0 A_PlaySound("ASG/Bolt2", 5)
		RPDA A 0 A_JumpIfInventory("RPDDeployed",1,2)
		RPDG A 3
		"####" AA 0
		"####" A 0 A_JumpIfInventory("RPDDeployed",1,"Ready2")
		Goto Ready

	Dropper:
		GLOA A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1,"Ready")
		919A A 0 A_Takeinventory("Zoomed",1)
		919A A 0 A_Takeinventory("ADSmode",1)
		919A A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("DropRPD", 1)
		TNT1 A 0 A_TakeInventory("DropIt", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Stop
	Spawn:
		WRPD A 1
		WRPD A 1 A_SpawnItemEx ("RPDSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop


}

}
ACTOR RPDPickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceRPD! \c-(slot 6)"
	Inventory.PickupSound "CBOXPKUP"
	States
	{
	Spawn:
		P3ST A 0
		WRPD A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		WRPD A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("RPD", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("RPD", 1)
		P3ST A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 1)
		P3ST A 0 A_GiveInventory("RPDDurability", 900)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 50)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 50)
		Stop

}


}
