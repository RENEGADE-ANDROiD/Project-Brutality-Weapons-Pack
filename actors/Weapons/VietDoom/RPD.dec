		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("RPD", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 6, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 5, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceRPD! \c-(Bulk: 6)\n Condition: \crTrash")
		TNT1 A 0 A_GiveInventory("RPD", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 6)
		TNT1 A 0 A_GiveInventory("RPDDurability", random(1,44))
		TNT1 A 0 A_SelectWeapon("RPD")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("RPDPickUpHC_trash")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("RPDPickUpHC_trash")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

Actor RPDDestroyed : bd_Token {}


