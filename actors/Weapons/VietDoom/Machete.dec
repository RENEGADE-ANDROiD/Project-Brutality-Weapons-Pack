ACTOR VietDoomMachete : PB_WeaponBase
{
	Weapon.SlotNumber 1
	Weapon.SelectionOrder 2300
	+WEAPON.AXEBLOOD
	+WEAPON.MELEEWEAPON
	+WEAPON.CHEATNOTWEAPON
	+INVENTORY.UNDROPPABLE
	Inventory.PickupSound "KTSEL"
	Inventory.Pickupmessage "You got the \caMachete! \c-(slot 1)"
	Obituary "$OBBD_AXE"
	Tag "Machete"
	scale 0.90
	States
	{
	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" A 0
		"####" EBCC 1 A_DoPBWeaponAction
		"####" C 10 A_DoPBWeaponAction
		"####" CCBE 1 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" A 0
		"####" EBCC 1 A_DoPBWeaponAction
		"####" C 10 A_DoPBWeaponAction
		"####" CCBE 1 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" A 0
		"####" EBCC 1 A_DoPBWeaponAction
		"####" C 35 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" A 0
		"####" C 5 A_DoPBWeaponAction
		"####" CCBE 1 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" A 0
		"####" C 2
		"####" CCBE 1
		Stop

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("AddonSelected"); }
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("HasCutingWeapon",1)
		TNT1 A 0 A_SetCrosshair(41)
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_PlaySound("KTSEL",1)
			TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
			Goto Ready3
	SelectAnimation:	
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
        "####" JIHG 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Ready3:
	Ready:
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		//"####" A 0 A_Giveinventory("HasCutingWeapon",1)
        "####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3

	StartSprint:
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" A 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
	Sprinting:
		"####" A 0 offset(-9,32)
		"####" A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 100, "StopSprintTired")
		"####" A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		"####" A 0 offset(-9,32) A_GiveInventory("UsedStamina", 2)
		"####" A 0 offset(-9,32)
		"####" A 1 offset(-9,34) A_SetPitch(pitch -0.5)
		"####" A 1 offset(-6,36) A_SetPitch(pitch -0.5)
		"####" A 1 offset(-3,38) A_SetPitch(pitch -0.5)
		"####" A 1 offset(0,38) A_SetPitch(pitch -0.5)
		"####" A 1 offset(3,36) A_SetPitch(pitch -0.5)
		"####" A 1 offset(6,34) A_SetPitch(pitch -0.5)
		"####" A 1 offset(9,32) A_SetPitch(pitch -0.5)
		"####" A 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
        "####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 offset(-9,32) A_GiveInventory("UsedStamina", 2)
		"####" A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		"####" A 1 offset(9,34) A_SetPitch(pitch +0.5)
		"####" A 1 offset(6,36) A_SetPitch(pitch +0.5)
		"####" A 1 offset(3,38) A_SetPitch(pitch +0.5)
		"####" A 1 offset(0,38) A_SetPitch(pitch +0.5)
		"####" A 1 offset(-3,36) A_SetPitch(pitch +0.5)
		"####" A 1 offset(-6,34) A_SetPitch(pitch +0.5)
		"####" A 1 offset(-9,32) A_SetPitch(pitch +0.5)
		"####" A 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
		"####" A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint
	StopSprintTired:
		"####" A 1
		"####" A 0 A_PlaySound("Tired", 2)
		"####" A 0 A_TakeInventory("UsedStamina", 2)
		"####" A 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		"####" A 0 A_TakeInventory("UsedStamina", 2)
		"####" A 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		"####" A 0 A_TakeInventory("UsedStamina", 2)
		"####" A 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		"####" A 0 A_TakeInventory("UsedStamina", 2)
		"####" A 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		"####" A 0 A_TakeInventory("UsedStamina", 2)
		"####" A 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		Goto Ready
	StopSprint:
		"####" A 1
		"####" A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready

	Deselect:
		MHTA A 0 A_Takeinventory("HasCutingWeapon",1)
		MHTA A 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_PlaySound("KTDES",1)
		TNT1 A 0 A_Lower(120)
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		MHTA A 0 A_Takeinventory("PowerBloodOnVisor",1)
		MHTA A 0 A_Takeinventory("PowerBlueBloodOnVisor",1)
		MHTA A 0 A_Takeinventory("PowerGreenBloodOnVisor",1)
		TNT1 A 0 A_Lower(120)
		Wait

	WeaponSpecial:
		TNT1 A 0 {
			A_TakeInventory("GoWeaponSpecialAbility", 1);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_TakeInventory("ZoomHold", 1);
			A_ZoomFactor(1.0);
		}
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("MacheteHeavyCleaver", 1, "MacheteHeavyCleaverOff")
		TNT1 A 0 A_GiveInventory("MacheteHeavyCleaver", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Blade: Heavy Cleaver")
		Goto Ready3
	MacheteHeavyCleaverOff:
		TNT1 A 0 A_TakeInventory("MacheteHeavyCleaver", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Blade: Standard")
		Goto Ready3
	Reload:
	CancelFire:
		"####" E 0 A_ClearReFire
		"####" JIHG 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto Ready

    Fire:
		4XEG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,5)
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" A 0 A_TakeInventory("AxeHit", 1)
        "####" BC 1
	Hold:
		"####" A 0
		"####" A 0 A_TakeInventory("AxeHit", 1)
		"####" C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" E 0 A_JumpIfInventory("FiredSecondary",1,"CancelFire")
		"####" E 0 A_JumpIfInventory("FiredPrimary",1,"Hold")
		"####" C 1
		"####" D 1 A_PlaySound("Melee/Swing", 1)
		"####" "#" 0 A_Quake(2,6,0,12,"")
		//"####" HI 1
		"####" A 0 A_JumpIfInventory("MacheteHeavyCleaver", 1, "HeavyCleaverAttack")
		"####" A 0 A_JumpIfInventory("PowerStrength", 1, "StrongAttack")
		//"####" A 0 A_Saw("", "", 3, "AxePuffs", 0, 120, 0,16)
		//"####" A 0 A_FireCustomMissile("AxeAttack", 0, 0, 0, 0)
		"####" E 1 A_Saw("", "", 3, "AxePuffs", 0, 44, 0,0)
		"####" F 1 A_FireCustomMissile("AxeAttackNoDecal", 0, 0, 0, 4)
		"####" A 0 A_FireCustomMissile("AxeAttack", 0, 0, 0, 4)
	EndSwing:
		"####" G 1 A_SetPitch(pitch+2)
		"####" H 1 A_SetPitch(pitch+2)
		"####" I 1 A_SetPitch(pitch+2)
		"####" J 1 A_SetPitch(pitch+1)
		TNT1 A 1 A_SetPitch(pitch+1)
		TNT1 A 2
		TNT1 AAAA 1 A_SetPitch(pitch-2)
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" JIHG 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		"####" "#" 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		Goto Ready
	StrongAttack:
		"####" A 0
		//"####" A 0 A_Saw("", "", 10, "AxePuffs", 0, 120, 0,16)
		//"####" AA 0 A_FireCustomMissile("AxeAttack", 0, 0, 0, 0)
		"####" E 1 A_Saw("", "", 10, "AxePuffs", 0, 44, 0,0)
		"####" F 1 A_FireCustomMissile("AxeAttackNoDecal", 0, 0, 0, 4)
		"####" AA 0 A_FireCustomMissile("AxeAttack", 0, 0, 0, 4)
		Goto EndSwing
	HeavyCleaverAttack:
		"####" A 0 A_Quake(3, 8, 0, 16, "")
		"####" E 2 A_Saw("", "", 8, "AxePuffs", 0, 56, 0, 0)
		"####" F 2 A_FireCustomMissile("AxeAttackNoDecal", 0, 0, 0, 4)
		"####" A 0 A_FireCustomMissile("AxeAttack", 0, 0, 0, 4)
		"####" A 0 A_FireCustomMissile("AltAxeAttackNoDecal", 18, 0, 0, 4)
		"####" A 0 A_FireCustomMissile("AltAxeAttackNoDecal", -18, 0, 0, 4)
		Goto EndSwing

    AltFire:
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
        "####" GHI 1
		TNT1 AAA 1
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
	AltHold:
		"####" A 0
		"####" A 0 A_TakeInventory("AxeHit", 1)
		"####" K 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" E 0 A_JumpIfInventory("FiredPrimary",1,"CancelFire")
		"####" E 0 A_JumpIfInventory("FiredSecondary",1,"AltHold")
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" L 1
		"####" "#" 0 A_Quake(2,6,0,12,"")
	    "####" M 1 A_PlaySound("Axe/Swing", 1)
		"####" A 0 A_JumpIfInventory("PowerStrength", 1, "AltStrongAttack")
		//"####" A 0 A_Saw("", "", 3, "AxePuffs", 0, 120, 0,16)
		//"####" A 0 A_FireCustomMissile("AltAxeAttack", 0, 0, 0, 0)
		//"####" A 0 A_FireCustomMissile("AltAxeAttackNoDecal", 20, 0, 0, 0)
		//"####" A 0 A_FireCustomMissile("AltAxeAttackNoDecal", -20, 0, 0, 0)
		"####" A 0 A_Saw("", "", 3, "AxePuffs", 0, 44, 0,0)
		"####" A 0 A_FireCustomMissile("AltAxeAttack", 0, 0, 0, 4)
		"####" A 0 A_FireCustomMissile("AltAxeAttackNoDecal", 20, 0, 0, 4)
		"####" A 0 A_FireCustomMissile("AltAxeAttackNoDecal", -20, 0, 0, 4)
	AltEndSwing:
		"####" N 1 A_SetAngle(angle-2)
		"####" O 1 A_SetAngle(angle-2)
		"####" P 1 A_SetAngle(angle-3)
		"####" Q 1 A_SetAngle(angle-3)
		"####" R 1 A_SetAngle(angle-3)
		TNT1 A 3
		TNT1 AAAAA 1 A_SetAngle(angle+2)
		MRTA A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
        MBTA A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
        MGTA A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		MHTA A 0
		"####" IHGF 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		"####" "#" 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		Goto Ready
	AltStrongAttack:
		"####" A 0
		//"####" A 0 A_Saw("", "", 10, "AxePuffs", 0, 120, 0,16)
		//"####" AA 0 A_FireCustomMissile("AltAxeAttack", 0, 0, 0, 0)
		//"####" AA 0 A_FireCustomMissile("AltAxeAttackNoDecal", 20, 0, 0, 0)
		//"####" AA 0 A_FireCustomMissile("AltAxeAttackNoDecal", -20, 0, 0, 0)
		"####" A 0 A_Saw("", "", 10, "AxePuffs", 0, 44, 0,0)
		"####" AA 0 A_FireCustomMissile("AltAxeAttack", 0, 0, 0, 4)
		"####" AA 0 A_FireCustomMissile("AltAxeAttackNoDecal", 20, 0, 0, 4)
		"####" AA 0 A_FireCustomMissile("AltAxeAttackNoDecal", -20, 0, 0, 4)
		Goto AltEndSwing
	Steady:
		"####" A 1
		Goto Ready
	Spawn:
		MHTE A 1
		MHTE A 1 A_SpawnItemEx ("MacheteSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop
}

}
ACTOR MachetePickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \caMachete! \c-(melee equipment)"
	Inventory.PickupSound "KTSEL"
	scale 0.9
	States
	{
	Spawn:
		P3ST A 0
		MHTE A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		MHTE A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("PBWP_MacheteMeleeToken", 1, "Refill")
		P3ST A 0 A_GiveInventory("PBWP_MacheteMeleeToken", 1)
		Stop
	Refill:
		Stop

}

}
