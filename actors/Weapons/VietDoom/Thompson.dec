ACTOR Thompson : PB_WeaponBase
{
	Weapon.SlotNumber 2
	Weapon.AmmoType1 "PB_LowCalMag"
	Weapon.AmmoType2 "ThompsonAmmo"
	Weapon.AmmoGive1 0
	Weapon.SelectionOrder 1000
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \ceM1A1 Thompson! \c-(slot 2)"
	Obituary "$OBBD_SMG"
	Tag "M1 Thompson"
	States
	{
	NoAmmo:
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		STES J 0 { PB_JumpIfMagUnloaded("KickFlashUnLoaded"); }
		THMc ABNM 1 A_DoPBWeaponAction
		THMc L 10 A_DoPBWeaponAction
		THMc MNBA 1 A_DoPBWeaponAction
		THMA A 2 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		STES J 0 { PB_JumpIfMagUnloaded("KickFlashUnLoaded"); }
		THMc ABNM 1 A_DoPBWeaponAction
		THMc L 10 A_DoPBWeaponAction
		THMc MNBA 1 A_DoPBWeaponAction
		THMA A 2 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		STES J 0 { PB_JumpIfMagUnloaded("SlideFlashUnLoaded"); }
		THMc ABNM 1 A_DoPBWeaponAction
		THMc L 35 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		STES J 0 { PB_JumpIfMagUnloaded("SlideFlashEndUnLoaded"); }
		THMc M 10 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		STES J 0 { PB_JumpIfMagUnloaded("SlideFlashEndEarlyUnLoaded"); }
		THMC N 2
		THMC MMMM 1
		Stop
	KickFlashUnLoaded:
		THMc ABQP 1
		THMc O 10
		THMc PQBA 1
		THMA A 2
		Goto Ready3
	SlideFlashUnLoaded: 
		THMc ABQP 1
		THMc O 35
		Goto Ready3
	SlideFlashEndUnLoaded:
		THMc P 10
		Goto Ready3
	SlideFlashEndEarlyUnLoaded: 
		THMC Q 2
		THMC PPPP 1
		Goto Ready3

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedThompson",1)
		THMA A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		THMs AAA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		THMA A 0 A_Takeinventory("Zoomed",1)
		THMA A 0 A_Takeinventory("ADSmode",1)
		THMA A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
	Sprinting:
		THMA A 0
		RISP A 0 offset(-9,32)
		//THMA A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		THMA A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		THMA A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		THMA A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		THMA A 0 offset(-9,32)
		THMS A 1 offset(-9,34) A_SetPitch(pitch -0.5)
		THMS A 1 offset(-6,36) A_SetPitch(pitch -0.5)
		THMS A 1 offset(-3,38) A_SetPitch(pitch -0.5)
		THMS A 1 offset(0,38) A_SetPitch(pitch -0.5)
		THMS A 1 offset(3,36) A_SetPitch(pitch -0.5)
		THMS A 1 offset(6,34) A_SetPitch(pitch -0.5)
		THMS A 1 offset(9,32) A_SetPitch(pitch -0.5)
		THMA A 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		THMA A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		THMA A 0 A_JumpIfInventory("Reloading",1,"Reload")
		THMA A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		THMA A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		THMS A 1 offset(9,34) A_SetPitch(pitch +0.5)
		THMS A 1 offset(6,36) A_SetPitch(pitch +0.5)
		THMS A 1 offset(3,38) A_SetPitch(pitch +0.5)
		THMS A 1 offset(0,38) A_SetPitch(pitch +0.5)
		THMS A 1 offset(-3,36) A_SetPitch(pitch +0.5)
		THMS A 1 offset(-6,34) A_SetPitch(pitch +0.5)
		THMS A 1 offset(-9,32) A_SetPitch(pitch +0.5)
		THMA A 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		THMA A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		THMs AAA 1
		THMs A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready3

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		//TNT1 A 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("ThompsonSelected",1)
		//TNT1 A 0 A_TakeInventory("DualRifles", 1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		//TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("NeverSelectedThompson", 1, "FirstSelectAnimation")
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
				Goto Ready3

	SelectAnimation:
		//TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		MP40 A 0 A_PlaySound("MP40/Draw", 5)
		THMS CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		TNT1 A 0 a_jumpifinventory("ThompsonReloadToken",1,"SelectRechamber")
		TNT1 A 0 A_TakeInventory("RELOADING",1)
		Goto Ready3

	FirstSelectAnimation:
		// A 0 A_TakeInventory("NeverSelectedThompson",1)
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		THMA A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("NeverSelectedThompson", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 3 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Tacticalselect:
		TNT1 A 0 A_TakeInventory("NeverSelectedThompson",1)
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		THMr AB 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		THMR I 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		THMr JKLM 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		RIFR A 0 A_PlaySound("mp40/Reload2", 5)	
		THMr DDDDDDDCB 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		THMA A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		Goto Ready3

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		THMA A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		THMA A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		THMA A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		THMA A 0 A_JumpIfInventory("Reloading",1,"Reload")
		THMA A 0 A_JumpIfInventory("Unloading",1,"Unload")
		THMA A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		THMA A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		THMA A 0 A_JumpIfInventory("Unloading",1,"Unload")
		THMA A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		THMA A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		THMA A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		THMA A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		THMA A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		Loop

	Ready2:
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		THMA A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RI2G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RI2G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		THMA A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		THMA A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		THMA A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RI2G A 0 A_TakeInventory("UsedStamina", 2)
		THMI C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("DropIt",1,"Dropper")
		Loop

	Deselect:
		THMA A 0 A_Takeinventory("Zoomed",1)
		THMA A 0 A_Takeinventory("ADSmode",1)
		AKMG A 0 A_TakeInventory("DropIt", 1)
		THMA A 0 A_TakeInventory("TossGrenade", 1)
		THMA A 0 A_TakeInventory("Kicking",1)
		THMA A 0 A_TakeInventory("Taunting",1)
		THMA A 0 A_TakeInventory("Reloading",1)
		THMA A 0 A_TakeInventory("Unloading",1)
		THMA A 0 A_TakeInventory("Salute1", 1)
		THMA A 0 A_TakeInventory("Salute2", 1)
		THMA A 0 A_Takeinventory("ThompsonSelected",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		THMA A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		TNT1 A 0 A_Lower(120)
		Wait


	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3
	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		THMI C 0 A_JumpIfInventory("Zoomed",1,13)
		THMA A 0
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" A 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("ThompsonAmmo",1,1)
		Goto NoAmmo
		"####" "#" 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 3)
		"####" "#" 0 A_JumpIfInventory("ThompsonDurability",1,1)
		Goto GunBroken
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("ThompsonDurability",35,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "#" 0
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("ThompsonAmmo",1)
		"####" "#" 0 A_JumpIfInventory("ThompsonAmmo",5,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("ThompsonAmmo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("PB_LowCalMag",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("PB_LowCalMag",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		THMA AAAA 0
		THMA A 0 A_AlertMonsters
		//THMA A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		THMA A 0 A_StartSound("SMG/Fire", CHAN_WEAPON)
		THMA A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		THMA "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		THMA "#" 0 { PB_GunSmoke(0,0,0); }
		THMA "#" 0 A_FireCustomMissile("VietPistolTracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		THMF A 1 BRIGHT A_FireBullets (4, 3, -1, 16, "WeakPuff", FBF_NORANDOM)
		THMA "#" 0 A_Quake(2,2,0,3,"")
		THMA B 0 A_FireCustomMissile("PistolCaseSpawn",5,0,6,-14)
		THMA B 0 A_ZoomFactor(0.96)
		THMA A 0 A_SetPitch(pitch-1.0)
		THMF B 1 
		TNT1 A 0 A_ZoomFactor(1.0)
		THMF C 1 A_SetPitch(Pitch+0.5)
		THMA A 0 A_Refire
		Goto Ready

	IsHolding:
		THMA A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+11
	Fire2:
		THMA A 0
		THMA A 0 A_StartSound("SMG/Fire", CHAN_WEAPON)
		THMA A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		THMA A 0 { PB_GunSmoke(0,0,0); }
		RI2F A 0 BRIGHT A_FireCustomMissile("VietPistolTracer", 0, 0, 0, 0)
		THMA A 0 A_ZoomFactor(1.14)
		THMI d 1 BRIGHT A_FireBullets (3, 2, -1, 16, "weakPuff", FBF_NORANDOM)
		THMA A 0 A_SetPitch(pitch-1.0)
		THMI e 1 A_ZoomFactor(1.2) 
		THMi F 1 A_SetPitch(Pitch+0.25)
		THMI e 0 A_FireCustomMissile("PistolCaseSpawn",1,0,8,0)
		THMi c 0 A_SetPitch(Pitch+0.1)
		THMA A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		THMA A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")//If still pressing alt fire, it means its holding aim
		THMA A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		TNT1 AAA 0
		RI2G A 0 A_ReFire
		THMI c 10 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		THMA A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		THMA A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		THMA A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		THMA A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RI2G A 0
		Goto Ready2

	AltFire:
		THMA A 0
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		//THMA A 0 A_TakeInventory("FiredMGGrenade",1)
		THMA A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		THMA A 0 A_Giveinventory("GoSpecial",1)
		THMA A 0 A_Giveinventory("Zoomed",1)
		//THMA A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		THMA A 0 A_ZoomFactor(1.2)
		THMA A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		THMA A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		THMI ABC 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlaySound("weapons/rifle/move")
		THMA A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		THMA A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		THMA A 0 A_JumpIfInventory("FiredSecondary",1,3)
		THMi C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		THMi C 4
		THMA A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		THMI ABC 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		THMI C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		THMA A 0
		THMA A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		RI2G A 0 A_JumpIfInventory("TossGrenade",1,"FireGrenade")
		//RI2G A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		//TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		THMA A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		THMI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		THMA A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		THMI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		THMA A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		THMI c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		THMA A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		//THMA A 0 A_JumpIfInventory("NoAutoReload",1,2)
		//THMA A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		THMA AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(7)
		THMA A 0
		THMA A 0 A_Takeinventory("Zoomed",1)
		THMA A 0 A_Takeinventory("ZoomHold",1)
		THMA A 0 A_ZoomFactor(1.0)
		THMA A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		THMA A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		THMI cBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		THMA "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		THMA A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		THMI CBA 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		THMA "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		THMA A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	//Inspecting anim (also repurposed as rechambering)
	Inspect:
		THMA A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		THMA A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		THMA A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		THMA A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		THMA A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		THMA A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		THMA A 0 A_JumpIfInventory("Reloading",1,"Reload")
		THMA A 0 A_JumpIfInventory("Unloading",1,"Unload")
		THMA A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		THMA A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		THMA A 0 A_JumpIfInventory("Unloading",1,"Unload")
		THMA A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		THMA A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		//THMA A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		THMA A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		THMA A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		THMA A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		THMA A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		THMA A 0 A_GiveInventory("DoInspect",1)
		THMA A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		THMA A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		THMA A 0 A_TakeInventory("DoInspect",1)
		THMC ABCD 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		THMA "#" 0 A_Giveinventory("IsInspecting",1)
		THMc E 3 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		THMc FGHHHI 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		THMA "#" 0 A_TakeInventory("ThompsonReloadToken",1)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		THMC J 2 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		//2IFR A 0 A_PlaySound("mp40/Bolt2", 5)
		THMC KLLLLMNB 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		THMA A 3 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		THMA "#" 0 A_Takeinventory("IsInspecting",1)
		THMA "#" 0 A_TakeInventory("ThompsonReloadToken",1)
		THMA "#" 0 A_Takeinventory("IsInspecting",1)
		THMA "#" 0 A_TakeInventory("ThompsonReloadToken",1)
		THMA "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectRechamber:
		THMA A 0 A_TakeInventory("DoInspect",1)
		THMr ab 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		THMc aBC 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		THMA "#" 0 A_Giveinventory("IsInspecting",1)
		THMc D 3 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		//2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		THMA "#" 0 A_TakeInventory("ThompsonReloadToken",1)
		THMC EFGGG 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
		THMC H 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("mp40/Bolt1", 5)
		THMC I 2 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		THMC JKKKL 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		THMA "#" 0 A_Takeinventory("IsInspecting",1)
		THMA "#" 0 A_TakeInventory("ThompsonReloadToken",1)
		THMR MA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		THMA "#" 0 A_Takeinventory("IsInspecting",1)
		THMA "#" 0 A_TakeInventory("ThompsonReloadToken",1)
		THMA "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready
	FullReload:
		THMA A 0 A_ClearReFire
		THMA A 0 { PB_SetMagUnloaded(false); }


		THMA A 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	Reload:
		THMA "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		THMA "#" 0 A_Takeinventory("Reloading",1)
		THMA "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		THMA "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		THMA "#" 0 A_JumpIfInventory("PB_LowCalMag",1,3)
		Goto Ready
		TNT1 AAA 0
		THMA "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		THMA "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")
		THMA A 0 A_JumpIfInventory("ThompsonAmmo",0,"Inspect")
		THMA A 0 A_JumpIfInventory("ThompsonReloadToken",1,"Inspect")
		THMA A 0 A_Takeinventory("Reloading",1)
		THMA A 0 A_Takeinventory("ADSmode",1)
		THMA A 0 A_Takeinventory("Zoomed",1)
		THMA A 0 A_Takeinventory("ZoomHold",1)
		THMA A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//THMA A 3 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		THMA A 0 A_Takeinventory("ADSmode",1)
		THMA A 0 A_Takeinventory("Zoomed",1)
		THMA A 0 A_Takeinventory("ZoomHold",1)
		THMA A 0 { PB_JumpIfMagUnloaded("ReloadFromEmpty"); }
		THMA A 0 A_GiveInventory ("Pumping", 1)
		THMA A 0 A_Takeinventory("Reloading",1)
		THMR BCDDDDDD 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		THMA A 0 A_PlaySound("mp40/Reload1", 5)
		THMA A 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip36"); }
		THMR EFGH 1
		THMR I 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR G 0 A_FireCustomMissile("EmptyClip2Spawn",-5,0,8,-4)
	PB_MagUnloadedSkip36:
	ReloadFromEmpty:
		THMR I 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		THMr JKLM 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("mp40/Reload2", 5)
		THMr D 7 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_GiveInventory("ThompsonReloadToken",1)
		Goto InsertBullets

	FinishReloading:
		THMA A 0 A_ClearReFire
		THMr CB 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("ThompsonReloadToken",1)
		Goto ReloadConcluded

	InsertBullets:
		TNT1 AAAA 0
		THMA A 0 A_JumpIfInventory("ThompsonAmmo",0,15)
		THMA A 0 A_JumpIfInventory("PB_LowCalMag",1,3)
		Goto FinishReloading
		TNT1 AAAAAA 0
		THMA A 0 A_Giveinventory("ThompsonAmmo",1)
		//THMA A 0 A_Giveinventory("DoubleThompsonAmmo",1)
		THMA A 0 { PB_SetMagUnloaded(false); }


		//THMA A 0 { PB_SetMagUnloaded(false); }


		THMA A 0 A_Takeinventory("PB_LowCalMag",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		THMA A 0 A_Takeinventory("Reloading",1)
		THMA A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto FinishReloading
		TNT1 AAAA 0
		THMA A 0 A_Takeinventory("Reloading",1)
		THMA A 0 //A_Refire
		Goto FinishReloading

	ReloadConcluded:
		THMA A 2
		THMA "#" 0 A_TakeInventory("ThompsonReloadToken",1)
		THMA A 0 A_Refire
		Goto Ready3

	User2:
	Unload:
		THMA "#" 0 A_Takeinventory("Unloading",1)
		THMA "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		THMA "#" 0 A_JumpIfInventory("ThompsonAmmo",1,3)
		Goto Ready
		TNT1 AAA 0
		THMA A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		THMA A 0 A_Takeinventory("Unloading",1)
		THMA A 0 A_Takeinventory("ADSmode",1)
		THMA A 0 A_Takeinventory("Zoomed",1)
		//RIFR AB 1
		//RIFR "[" 1
		THMR ABDDDDD 1
		THMA A 0 A_PlaySound("MP40/Reload1", 5)
		THMA A 0 A_GiveInventory ("Pumping", 1)
		THMA A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		THMA A 0 A_JumpIfInventory("ThompsonAmmo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		THMA A 0 A_Takeinventory("ThompsonAmmo",1)
		//THMA A 0 A_Takeinventory("DoubleThompsonAmmo",1)
		THMA A 0 { PB_SetMagUnloaded(true); }


		//THMA A 0 { PB_SetMagUnloaded(true); }


		THMA A 0 A_Giveinventory("PB_LowCalMag",1)
		Goto RemoveBullets
	FInishUnload:
		THMr MLKJIIIIIIBA 1
		THMA A 0 A_Takeinventory("Unloading",1)
		Goto Ready3
	GunBroken:
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 0 A_Print("Your gun has been destroyed!\n\n\n\n\n\n\n")
		"####" "#" 0 A_GiveInventory("ThompsonDestroyed", 1)
		"####" "#" 0 A_PlaySound("DSBRK2")
		"####" "#" 0 A_Quake(4,5,0,12,"")
		"####" "##" 0 A_CustomMissile("MetalShard1", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#######" 0 A_CustomMissile("Shotgunparticles", 20, 0, random(-35, 35), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard2", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "####" 0 A_CustomMissile ("WoodParticle", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_CustomMissile("ExplosionParticle", 20, 0, random(-10, 10), 2, random(-10, 25))
		"####" "##" 0 A_CustomMissile ("MetalShard3", 20, 0, random(-30, 30), 2, random(-10, 25))
		"####" "#" 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		TNT1 A 0 A_GiveInventory("DropThompson", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Goto Ready

	JamChanceHigh:
		"####" "#" 0 A_Jump(8, "ClearJam")
		Goto ResumeFireFrame

	JamChanceMid:
		"####" "#" 0 A_Jump(6, "ClearJam")
		Goto ResumeFireFrame

	JamChanceLow:
		"####" "#" 0 A_Jump(4, "ClearJam")
		Goto ResumeFireFrame

	ClearJam:
		THMA a 0
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_ClearReFire
		"####" "#" 1 offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Empty", 5)
		"####" "#" 1 offset(0,33)
		"####" "#" 2 A_DoPBWeaponAction(WRF_NOFIRE)// | WRF_NOFIRE)
		"####" "#" 1 A_ClearReFire
		THMA A 4		
		THMC ABCDEEEFGHHHI 1
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		THMI e 0 A_FireCustomMissile("PistolCaseSpawn",1,0,8,0)
		THMC JJJJJKLLLLMNB 1
		THMA A 3
		Goto Ready

	PrintConditionTrash:
		"####" "#" 0 A_Print("Condition: \crTrash\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionBroken:
		"####" "#" 0 A_Print("Condition: \cgBroken\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionAlmostBroken:
		"####" "#" 0 A_Print("Condition: \cgAlmost Broken\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionCritical:
		"####" "#" 0 A_Print("Condition: \caCritical\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionBad:
		"####" "#" 0 A_Print("Condition: \caBad\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionHeavilyWorn:
		"####" "#" 0 A_Print("Condition: \ciHeavily Worn\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionWorn:
		"####" "#" 0 A_Print("Condition: \ciWorn\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionFair:
		"####" "#" 0 A_Print("Condition: \ckFair\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionGood:
		"####" "#" 0 A_Print("Condition: \cdGood\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionVeryGood:
		"####" "#" 0 A_Print("Condition: \cdVery Good\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionExcellent:
		"####" "#" 0 A_Print("Condition: \cdExcellent\n\n\n\n\n\n\n")
		Goto Inspect2CarryOn

	PrintConditionPristine:
		"####" "#" 0 A_Print("Condition: \cCPristine\n\n\n\n\n\n\n")

	Inspect2CarryOn:
		"####" "#" 0 A_GiveInventory("HoldInspect",1)

	Dropper:
		GLOA A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1,"Ready")
		919A A 0 A_Takeinventory("Zoomed",1)
		919A A 0 A_Takeinventory("ADSmode",1)
		919A A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("DropThompson", 1)
		TNT1 A 0 A_SelectWeapon("Dropper")
		Goto Ready

	Spawn:
		M1TM P 1
		M1TM P 1 A_SpawnItemEx ("ThompsonSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop
}


}
ACTOR ThompsonAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 30
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 30
	Inventory.Icon "M1TMP0"
}
Actor ThompsonReloadToken : bd_Token {
}
ACTOR NeverSelectedThompson : bd_Token {
}
Actor ThompsonSelected : bd_Token {
}
ACTOR ThompsonPickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceThompson! \c-(slot 4)"
	Inventory.PickupSound "ads/out"
	scale 0.88
	States
	{

	Spawn:
		P3ST A 0
		M1TM P 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		M1TM P -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("Thompson", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("Thompson", 1)
		P3ST A 0 A_JumpIfInventory("VietDoomDurabilityDisabled", 1, 1)
		P3ST A 0 A_GiveInventory("ThompsonDurability", 600)
		P3ST A 0 A_Giveinventory("PB_LowCalMag", 10)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_LowCalMag", 10)
		Stop

}

}

Actor ThompsonDestroyed : bd_Token {}

ACTOR ThompsonPickUpHC: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	scale 0.88
	+THRUACTORS
	States
	{
	Spawn:
		M1TM P 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		M1TM P -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("Thompson", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceThompson! \c-(Bulk: 4)\n Condition: \cCPristine")
		TNT1 A 0 A_GiveInventory("Thompson", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 4)
		TNT1 A 0 A_GiveInventory("ThompsonDurability", 600)
		TNT1 A 0 A_SelectWeapon("Thompson")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("ThompsonPickUpHC")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("ThompsonPickUpHC")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

