ACTOR M16 : PB_WeaponBase
{
	Weapon.SlotNumber 4
	Weapon.AmmoType1 "PB_HighCalMag"
	Weapon.AmmoType2 "M16Ammo"
	Weapon.AmmoGive1 0
	Weapon.SelectionOrder 700
	+INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "You got the \ceM16! \c-(slot 4)"
	Obituary "$OBBD_RIFLE"
	Tag "XM16E1"
	PB_WeaponBase.UsesWheel 1
	PB_WeaponBase.WheelInfo "PBWP_VietBurstWheel"
	States
	{
	NoAmmo:
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true, ""); }
		"####" A 0 A_PlaySound("weapons/dryfire", CHAN_WEAPON)
		"####" "#" 1 A_DoPBWeaponAction(WRF_NOFIRE)
		Goto Ready3

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		M16R A 1 A_DoPBWeaponAction
		M16S AB 1 A_DoPBWeaponAction
		M16S C 11 A_DoPBWeaponAction
		M16S ba 1 A_DoPBWeaponAction
		M16g A 2 A_DoPBWeaponAction
		Stop
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		M16R A 1 A_DoPBWeaponAction
		M16S AB 1 A_DoPBWeaponAction
		M16S C 11 A_DoPBWeaponAction
		M16S ba 1 A_DoPBWeaponAction
		M16g A 2 A_DoPBWeaponAction
		Stop
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		Goto FlashKicking
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		M16R A 2 A_DoPBWeaponAction
		M16S AB 1 A_DoPBWeaponAction
		M16S C 35 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStop:
		M16R A 10 A_DoPBWeaponAction
		Stop
	FlashSlideKickingStopEarly:
		M16R A 2
		M16R Aaaa 1
		Stop

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedM16",1)
		M16G A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		M16R AAA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16G A 0 A_Takeinventory("ADSmode",1)
		M16G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
	Sprinting:
		M16G A 0
		RISP A 0 offset(-9,32)
		//M16G A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		M16G A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		M16G A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		M16G A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		M16G A 0 offset(-9,32)
		M16R A 1 offset(-9,34) A_SetPitch(pitch -0.5)
		M16R A 1 offset(-6,36) A_SetPitch(pitch -0.5)
		M16R A 1 offset(-3,38) A_SetPitch(pitch -0.5)
		M16R A 1 offset(0,38) A_SetPitch(pitch -0.5)
		M16R A 1 offset(3,36) A_SetPitch(pitch -0.5)
		M16R A 1 offset(6,34) A_SetPitch(pitch -0.5)
		M16R A 1 offset(9,32) A_SetPitch(pitch -0.5)
		M16G A 0 offset(9,32) A_DoPBWeaponAction(WRF_NOBOB)
		M16G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		M16G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M16G A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		M16G A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		M16R A 1 offset(9,34) A_SetPitch(pitch +0.5)
		M16R A 1 offset(6,36) A_SetPitch(pitch +0.5)
		M16R A 1 offset(3,38) A_SetPitch(pitch +0.5)
		M16R A 1 offset(0,38) A_SetPitch(pitch +0.5)
		M16R A 1 offset(-3,36) A_SetPitch(pitch +0.5)
		M16R A 1 offset(-6,34) A_SetPitch(pitch +0.5)
		M16R A 1 offset(-9,32) A_SetPitch(pitch +0.5)
		M16G A 0 offset(-9,32) A_DoPBWeaponAction(WRF_NOBOB)
		M16G A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		M16R AAA 1
		M16G A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		Goto Ready3

	Select:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_TakeInventory("HasBarrel",1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("RifleSelected"); }
		//TNT1 A 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("M16Selected",1)
		//TNT1 A 0 A_TakeInventory("DualRifles", 1)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_GunFlash
		//TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		TNT1 A 0 A_JumpIfInventory("NeverSelectedM16", 1, "FirstSelectAnimation")
				TNT1 A 0 A_WeaponOffset(2, 34, WOF_INTERPOLATE)
				Goto Ready3

	SelectAnimation:
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		M16S CBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		TNT1 A 0 a_jumpifinventory("M16ReloadToken",1,"SelectRechamber")
		TNT1 A 0 A_TakeInventory("RELOADING",1)
		Goto Ready3

	FirstSelectAnimation:
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		M16G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIfInventory("NeverSelectedM16", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 3 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Tacticalselect:
		TNT1 A 0 A_TakeInventory("NeverSelectedM16",1)
		TNT1 A 4 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m16R K 8 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m16R L 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		RIFR A 0 A_PlaySound("Rifle/Reload2", 5)
		m16r MNNNNOPQR 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m16r STU 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		m16r VVVV 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		m16r UTSNEDCBA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		Goto Ready3

	Ready:
	Ready3:
		TNT1 A 0 A_TakeInventory("M16BurstShots", 3)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M16G A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		M16G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		M16G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		M16G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M16G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M16G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		M16G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		M16G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M16G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		M16G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M16G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		M16G A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		M16G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Ready2:
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M16G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RI2G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RI2G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M16G A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		M16G A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		M16G A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RI2G A 0 A_TakeInventory("UsedStamina", 2)
		M16I C 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Loop

	Deselect:
		M16G A 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16G A 0 A_Takeinventory("ADSmode",1)
		M16G A 0 A_TakeInventory("TossGrenade", 1)
		M16G A 0 A_TakeInventory("Kicking",1)
		M16G A 0 A_TakeInventory("Taunting",1)
		M16G A 0 A_TakeInventory("Reloading",1)
		M16G A 0 A_TakeInventory("Unloading",1)
		M16G A 0 A_TakeInventory("Salute1", 1)
		M16G A 0 A_TakeInventory("Salute2", 1)
		M16G A 0 A_Takeinventory("M16Selected",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		M16G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		TNT1 A 0 A_Lower(120)
		Wait

	Salute:
		TNT1 A 0 A_AlertMonsters
		SALU ABCDEDCDEDCDEDCBA 4
		TNT1 A 0 A_TakeInventory("Salute1", 1)
		TNT1 A 0 A_TakeInventory("Salute2", 1)
		Goto Ready3

	Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
		TNT1 A 0 { return PB_jumpIfNoAmmo("Reload", 1, true, true); }
		M16I C 0 A_JumpIfInventory("Zoomed",1,13)
		M16G A 0
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" A 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("M16Ammo",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 { PB_LowAmmoSoundWarning(hdmr); }
		"####" "#" 0 A_Takeinventory("M16Ammo",1)
		"####" "#" 0 A_JumpIfInventory("M16Ammo",5,2)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("M16Ammo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("PB_HighCalMag",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("PB_HighCalMag",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		M16G A 0 A_AlertMonsters
		M16G A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		M16G A 0 A_PlaySound("M16FIRE", 1)
		M16G "#" 0 A_Quake(1,3,0,4,"")
		M16G A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		M16G "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		M16G "#" 0 { PB_GunSmoke(0,0,0); }
		M16G A 0 A_JumpIfInventory("PSeq3", 1, "SpriteVariant")
		M16G A 0 A_GiveInventory("PSeq3",1)
		M16F A 1 BRIGHT { PB_FireBullets("PB_556x45mm", 1, 2, 0, 0, 2); }
		Goto FinishFire
	SpriteVariant:
		M16G D 0 A_TakeInventory("PSeq3",1)
		M16F B 1 BRIGHT { PB_FireBullets("PB_556x45mm", 1, 3, 0, 0, 3); }
	FinishFire:
		M16G B 0 { PB_SpawnCasing("PB_EmptyBrass", 32, 6, -14, frandom(4,7), frandom(6,9), frandom(0,5)); }
		M16G B 0 A_ZoomFactor(0.98)
		M16G A 0 A_SetPitch(pitch-1.5)
		M16F C 1 
		M16G A 1 A_ZoomFactor(1.0)
		M16G A 0 A_JumpIfInventory("M16Semi", 1, "Ready")
		M16G A 0 A_JumpIfInventory("M16Burst", 1, "M16BurstCheck")
		M16G A 0 A_Refire
		Goto Ready
	M16BurstCheck:
		TNT1 A 0 A_GiveInventory("M16BurstShots", 1)
		TNT1 A 0 A_JumpIfInventory("M16BurstShots", 3, "M16BurstDone")
		M16G A 0 A_Refire
		Goto Ready
	M16BurstDone:
		TNT1 A 0 A_TakeInventory("M16BurstShots", 3)
		Goto Ready

	IsHolding:
		M16G A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+11
	Fire2:
		M16G A 0
		M16G A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		M16G A 0 { PB_GunSmoke(0,0,0); }
		M16I d 1 BRIGHT { PB_FireBullets("PB_556x45mm", 1, 1, 0, 0, 1); }
		M16G A 0 A_ZoomFactor(1.94)
		M16G A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)
		M16G A 0 A_SetPitch(pitch-0.5)
		M16I e 1 { PB_SpawnCasing("PB_EmptyBrass", 32, 8, 0, frandom(4,7), frandom(6,9), frandom(0,5)); }
		m16i F 1 A_ZoomFactor(2.0)
		M16G A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		RI2F A 0 A_GiveInventory("FireFrameCount", 1)
		M16G A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")//If still pressing alt fire, it means its holding aim
		M16G A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		TNT1 AAA 0
		TNT1 A 0 A_JumpIfInventory("M16Semi", 1, "Ready2")
		TNT1 A 0 A_JumpIfInventory("M16Burst", 1, "M16BurstCheckADS")
		RI2G A 0 A_ReFire
		M16I c 10 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M16G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		M16G A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		M16G A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		M16G A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RI2G A 0
		Goto Ready2
	M16BurstCheckADS:
		TNT1 A 0 A_GiveInventory("M16BurstShots", 1)
		TNT1 A 0 A_JumpIfInventory("M16BurstShots", 3, "M16BurstDoneADS")
		RI2G A 0 A_ReFire
		Goto Ready2
	M16BurstDoneADS:
		TNT1 A 0 A_TakeInventory("M16BurstShots", 3)
		Goto Ready2

	WeaponSpecial:
		TNT1 A 0 {
			A_TakeInventory("GoWeaponSpecialAbility", 1);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_TakeInventory("ZoomHold", 1);
			A_ZoomFactor(1.0);
		}
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("SelectViet_FullAuto", 1, "M16SetAuto")
		TNT1 A 0 A_JumpIfInventory("SelectViet_Burst", 1, "M16SetBurst")
		TNT1 A 0 A_JumpIfInventory("SelectViet_Semi", 1, "M16SetSemi")
		// Fallback cycle: Auto → Burst → Semi → Auto
		TNT1 A 0 A_JumpIfInventory("M16Burst", 1, "M16SetSemi")
		TNT1 A 0 A_JumpIfInventory("M16Semi", 1, "M16SetAuto")
		Goto M16SetBurst
	M16SetAuto:
		TNT1 A 0 A_TakeInventory("SelectViet_FullAuto", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_Burst", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_Semi", 1)
		TNT1 A 0 A_TakeInventory("M16Semi", 1)
		TNT1 A 0 A_TakeInventory("M16Burst", 1)
		TNT1 A 0 A_TakeInventory("M16BurstShots", 3)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Switch Mode: Full Auto")
		Goto Ready3
	M16SetBurst:
		TNT1 A 0 A_TakeInventory("SelectViet_FullAuto", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_Burst", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_Semi", 1)
		TNT1 A 0 A_TakeInventory("M16Semi", 1)
		TNT1 A 0 A_TakeInventory("M16BurstShots", 3)
		TNT1 A 0 A_GiveInventory("M16Burst", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Switch Mode: 3-Round Burst")
		Goto Ready3
	M16SetSemi:
		TNT1 A 0 A_TakeInventory("SelectViet_FullAuto", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_Burst", 1)
		TNT1 A 0 A_TakeInventory("SelectViet_Semi", 1)
		TNT1 A 0 A_TakeInventory("M16Burst", 1)
		TNT1 A 0 A_TakeInventory("M16BurstShots", 3)
		TNT1 A 0 A_GiveInventory("M16Semi", 1)
		TNT1 A 0 A_PlaySound("LIGHTON", CHAN_AUTO)
		TNT1 A 0 A_Print("Switch Mode: Semi Fire")
		Goto Ready3
	AltFire:
		M16G A 0
		//M16G A 0 A_TakeInventory("FiredMGGrenade",1)
		M16G A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		M16G A 0 A_Giveinventory("GoSpecial",1)
		M16G A 0 A_Giveinventory("Zoomed",1)
		//M16G A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(0)
		TNT1 A 0 A_WeaponOffset(0, 32, WOF_INTERPOLATE)
		M16G A 0 A_ZoomFactor(2.0)
		M16G A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		M16G A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		M16I ABC 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlaySound("weapons/rifle/move")
		M16G A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		M16G A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		M16G A 0 A_JumpIfInventory("FiredSecondary",1,3)
		m16i C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RI2G A 0 A_JumpIfInventory("FiredPrimary",1,"HoldAim")
		m16i C 4
		M16G A 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
		Goto Ready2

	ToggleAim:
		M16I ABC 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		M16I C 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		M16G A 0
		M16G A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		RI2G A 0 A_JumpIfInventory("TossGrenade",1,"FireGrenade")
		//RI2G A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		//TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		M16G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		m16I c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		M16G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		m16I c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		M16G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		m16I c 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		M16G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		//M16G A 0 A_JumpIfInventory("NoAutoReload",1,2)
		//M16G A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		M16G AA 0 A_JumpIfInventory("FiredSecondary",1,"HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair(7)
		M16G A 0
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16G A 0 A_Takeinventory("ZoomHold",1)
		M16G A 0 A_ZoomFactor(1.0)
		M16G A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		M16G A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		m16I cBA 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		M16G "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		M16G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		M16I CBA 1 //A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY|WRF_NOBOB)
		M16G "#" 0 A_JumpIfInventory("Reloading",1,"Reload")
		M16G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)//A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOSECONDARY)
		Goto Ready3

	//Inspecting anim (also repurposed as rechambering)
	Inspect:
		M16G A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		M16G A 0 A_JumpIfInventory("FiredSecondary",1,"ContinueInspect")
		M16G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		M16G A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		//TNT1 A 0 A_JumpIfInventory("RFGrenade",1,"FireGrenade")
		M16G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		M16G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		M16G A 0 A_JumpIfInventory("Reloading",1,"Reload")
		M16G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M16G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		M16G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		M16G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		M16G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		M16G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		//M16G A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		M16G A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		M16G A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		M16G A 0 A_JumpIfInventory("FiredSecondary",1,"AltFire")
		TNT1 AAA 0
		M16G A 6 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M16G A 0 A_GiveInventory("DoInspect",1)
		M16G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		M16G A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		M16G A 0 A_TakeInventory("DoInspect",1)
		M16R AB 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		M16C a 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M16G "#" 0 A_Giveinventory("IsInspecting",1)
		M16C B 5 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		M16G "#" 0 A_TakeInventory("M16ReloadToken",1)
		M16C BDE 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		M16C E 2 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("mp40/Bolt2", 5)
		M16C F 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		M16C A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		M16G "#" 0 A_Takeinventory("IsInspecting",1)
		M16G "#" 0 A_TakeInventory("M16ReloadToken",1)
		M16R BA 1 A_DoPBWeaponAction(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		M16G "#" 0 A_Takeinventory("IsInspecting",1)
		M16G "#" 0 A_TakeInventory("M16ReloadToken",1)
		M16G "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectRechamber:
		M16G A 0 A_TakeInventory("DoInspect",1)
		m16r ab 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		m16c a 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		M16G "#" 0 A_Giveinventory("IsInspecting",1)
		m16c b 5 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		M16G "#" 0 A_TakeInventory("M16ReloadToken",1)
		m16C CDE 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
		m16C E 2 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("mp40/Bolt2", 5)
		M16C F 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		M16C A 5 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		M16G "#" 0 A_Takeinventory("IsInspecting",1)
		M16G "#" 0 A_TakeInventory("M16ReloadToken",1)
		M16R ba 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
		M16G "#" 0 A_Takeinventory("IsInspecting",1)
		M16G "#" 0 A_TakeInventory("M16ReloadToken",1)
		M16G "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready
	FullReload:
		M16G A 0 A_ClearReFire
		M16G A 0 { PB_SetMagUnloaded(false); }

		//m16r STU 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		//2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		//m16r VVVV 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		//TNT1 A 0 A_TakeInventory("M16ReloadToken",1)
		//m16r UTSNEDCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		m16r EDCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	Reload:
		M16G "#" 0 A_TakeInventory("RifleSpread", 10)
		M16G "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		M16G "#" 0 A_Takeinventory("Reloading",1)
		M16G "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		M16G "#" 0 A_JumpIfInventory("PB_HighCalMag",1,3)
		Goto Ready
		TNT1 AAA 0
		M16G "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		M16G "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")
		M16G A 0 A_JumpIfInventory("M16Ammo",0,"Inspect")
		M16G A 0 A_JumpIfInventory("M16ReloadToken",1,"Inspect")
		M16G A 0 A_Takeinventory("Reloading",1)
		M16G A 0 A_Takeinventory("ADSmode",1)
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16G A 0 A_Takeinventory("ZoomHold",1)
		M16G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		//M16G A 3 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M16G A 0 A_Takeinventory("ADSmode",1)
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16G A 0 A_Takeinventory("ZoomHold",1)
		M16G A 0 { PB_JumpIfMagUnloaded("ReloadFromEmpty"); }
		M16G A 0 A_PlaySound("Rifle/Reload1", 5)
		M16G A 0 A_GiveInventory ("Pumping", 1)
		M16G A 0 A_Takeinventory("Reloading",1)
		m16R ABCDEFFF 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M16G A 0 { PB_JumpIfMagUnloaded("PB_MagUnloadedSkip23"); }
		M16R GHIKK 1
		RIFR G 0 A_FireCustomMissile("EmptyClipSpawn",-5,0,8,-4)
	ReloadFromEmpty:
		m16R K 8 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PB_MagUnloadedSkip23:
		m16R L 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("Rifle/Reload2", 5)
		m16r MNNNNOPQR 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		M16G A 0 A_JumpIfInventory("M16Ammo",1,"InsertBullets2")//30+1 effect
		TNT1 A 0 A_GiveInventory("M16ReloadToken",1)
		Goto InsertBullets

	FinishReloading:
		M16G A 0 A_ClearReFire
		m16r STU 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		m16r VVVV 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("M16ReloadToken",1)
		m16r UTSNEDCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		//m16r EDCBA 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	InsertBullets:
		TNT1 AAAA 0
		M16G A 0 A_JumpIfInventory("M16Ammo",20,15)
		M16G A 0 A_JumpIfInventory("PB_HighCalMag",1,3)
		Goto FinishReloading
		TNT1 AAAAAA 0
		M16G A 0 A_Giveinventory("M16Ammo",1)
		//M16G A 0 A_Giveinventory("DoubleM16Ammo",1)
		M16G A 0 { PB_SetMagUnloaded(false); }

		//M16G A 0 { PB_SetMagUnloaded(false); }

		M16G A 0 A_Takeinventory("PB_HighCalMag",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		M16G A 0 A_Takeinventory("Reloading",1)
		M16G A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto FinishReloading
		TNT1 AAAA 0
		M16G A 0 A_Takeinventory("Reloading",1)
		M16G A 0 //A_Refire
		Goto FinishReloading

	InsertBullets2:
		TNT1 AAAA 0
		M16G A 0 A_JumpIfInventory("M16Ammo",0,15)
		M16G A 0 A_JumpIfInventory("PB_HighCalMag",1,3)
		Goto FullReload
		TNT1 AAAAAA 0
		M16G A 0 A_Giveinventory("M16Ammo",1)
		//M16G A 0 A_Giveinventory("DoubleM16Ammo",1)
		M16G A 0 A_Takeinventory("PB_HighCalMag",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2
		TNT1 AAAAAAAAAA 0
		M16G A 0 A_Takeinventory("Reloading",1)
		M16G A 0 //A_Refire
		Goto FullReload
		TNT1 AAAA 0
		M16G A 0 A_Takeinventory("Reloading",1)
		M16G A 0 //A_Refire
		Goto FullReload

	ReloadConcluded:
		M16G A 2
		M16G "#" 0 A_TakeInventory("M16ReloadToken",1)
		M16G A 0 A_Refire
		Goto Ready3

	User2:
	Unload:
		M16G "#" 0 A_Takeinventory("Unloading",1)
		M16G "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		M16G "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		M16G "#" 0 A_JumpIfInventory("M16Ammo",1,3)
		Goto Ready
		TNT1 AAA 0
		M16G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair(7)
		M16G A 0 A_Takeinventory("Unloading",1)
		M16G A 0 A_Takeinventory("ADSmode",1)
		M16G A 0 A_Takeinventory("Zoomed",1)
		M16R ABCDEFFF 1
		M16G A 0 A_PlaySound("Rifle/Reload1", 5)
		M16G A 0 A_GiveInventory ("Pumping", 1)
		M16G A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		M16G A 0 A_JumpIfInventory("M16Ammo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		M16G A 0 A_Takeinventory("M16Ammo",1)
		M16G A 0 { PB_SetMagUnloaded(true); }

		M16G A 0 A_Giveinventory("PB_HighCalMag",1)
		Goto RemoveBullets
	FInishUnload:
		m16r MLKKKKKCBA 1
		M16G A 0 A_Takeinventory("Unloading",1)
		Goto Ready3

	Spawn:
		AR15 M 1
		AR15 M 1 A_SpawnItemEx ("M16Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERAMBUSHFLAG ,0)
		Stop
}

}
ACTOR M16Ammo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 21
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 21
	Inventory.Icon "AR15A0"
}

ACTOR M16PickUp: BDWeaponSpawner
{
	Inventory.PickupMessage "You got the \ceM16! \c-(slot 4)"
	Inventory.PickupSound "CLIPIN"
	States
	{

	Spawn:
		P3ST A 0
		AR15 A 1
		P3ST A 0 A_ChangeFlag("THRUACTORS", 0)
	Stay:
		AR15 A -1
		Stop

	Pickup:
		P3ST A 0
		P3ST A 0 A_JumpIfInventory("M16", 1, "AmmoOnly")
	PickupNormal:
		P3ST A 0 A_GiveInventory("M16", 1)
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 10)
		Stop

	AmmoOnly:
		P3ST A 0
		P3ST A 0 A_Giveinventory("PB_HighCalMag", 10)
		Stop

}
}
Actor M16ReloadToken : bd_Token {
}
ACTOR NeverSelectedM16 : bd_Token {
}
Actor M16Selected : bd_Token {

}
