}
ACTOR SKSEmpty : bd_Token {
}
Actor SKSSelected : bd_Token {


}

ACTOR SKSPickUpHC: CustomInventory
{
	+INVENTORY.NOSCREENFLASH
	Inventory.PickupMessage ""
	+INVENTORY.QUIET
	Inventory.Icon ""
	Inventory.Pickupsound ""
	Radius 16
	Height 8
	//scale 0.74
	+THRUACTORS
	States
	{
	Spawn:
		WSKS A 30
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		WSKS A -1
		Stop
	Pickup:
		TNT1 A 0 A_jumpIfInventory("SKS", 1, "Respawn2")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 10, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 9, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 8, "Respawn")
		TNT1 A 0 A_jumpIfInventory("BulkPoint", 7, "Respawn")
		Goto Picks
	Picks:
		TNT1 A 0
		TNT1 A 0 A_Print("You got the \ceSKS! \c-(Bulk: 4)\n Condition: \cCPristine")
		TNT1 A 0 A_GiveInventory("SKS", 1)
		TNT1 A 0 A_GiveInventory("Bulkpoint", 4)
		TNT1 A 0 A_GiveInventory("SKSDurability", 600)
		TNT1 A 0 A_SelectWeapon("SKS")
		Stop
	Respawn:
		TNT1 A 35
		TNT1 A 0 A_Print("You can't carry that much!\n\n\n\n\n\n\n")
		TNT1 A 0 A_SpawnItem("SKSPickUpHC")
		Stop
	Respawn2:
		TNT1 A 35
		TNT1 A 0 A_SpawnItem("SKSPickUpHC")
		TNT1 A 0 A_Print("You already have one!\n\n\n\n\n\n\n")
	}
}

