	Unload:
		TNT1 A 0 A_TakeInventory("Unloading")
		TNT1 A 0 A_jumpifinventory("MP12SilencerIsOn", 1, "UnloadWithSil")
		TNT1 A 0 A_JumpIfInventory("PistolSMGUpgrade",1,"UnloadSMG")
		TNT1 A 0 A_JumpIfInventory("MP12Unloaded", 1, "Ready3")
		TNT1 A 0 A_JumpIfInventory("MP12Ammo2", 1, 1)
		Goto Ready3
		TNT1 A 0 A_JumpIfInventory("MP12Unloaded", 1, "Ready3")
		PISR GFE 1
		PISR D 1 A_playsound("MP1/cout", 4)
		PISR CB 1
		PISR A 6
		TNT1 A 0 A_GiveInventory("MP12Unloaded")		
	UnloadSequence:
		TNT1 A 0 A_JumpIfInventory("MP12Ammo2", 1, 1)
		Goto Ready3
		TNT1 A 0 A_GiveInventory("PB_LowCalMag", 1)
		TNT1 A 0 A_TakeInventory("MP12Ammo2", 1)
		Loop
		
	UnloadWithSil:
		TNT1 A 0 A_TakeInventory("Unloading")
		TNT1 A 0 A_JumpIfInventory("PistolSMGUpgrade",1,"UnloadSMGWithSil")
		TNT1 A 0 A_JumpIfInventory("MP12Unloaded", 1, "Ready3")
		TNT1 A 0 A_JumpIfInventory("MP12Ammo2", 1, 1)
		Goto Ready3
		TNT1 A 0 A_JumpIfInventory("MP12Unloaded", 1, "Ready3")
		12SR GFE 1
		12SR D 1 A_playsound("MP1/cout", 4)
		12SR CB 1
		12SR A 6
		TNT1 A 0 A_GiveInventory("MP12Unloaded")		
	UnloadSequenceSil:
		TNT1 A 0 A_JumpIfInventory("MP12Ammo2", 1, 1)
		Goto Ready3
		TNT1 A 0 A_GiveInventory("PB_LowCalMag", 1)
		TNT1 A 0 A_TakeInventory("MP12Ammo2", 1)
		Loop
		
	UnloadSMG:
		TNT1 A 0 A_TakeInventory("Unloading")
		TNT1 A 0 A_JumpIfInventory("MP12Unloaded", 1, "Ready3")
		TNT1 A 0 A_JumpIfInventory("MP12Ammo2", 1, 1)
		Goto Ready3
		TNT1 A 0 A_JumpIfInventory("MP12Unloaded", 1, "Ready3")
		MGAR ABCDEF 1
		TNT1 A 0 A_PlaySound("sg/cout", 1)
        MGAR G 1
        MGAR HI 1
		TNT1 A 0 A_GiveInventory("MP12Unloaded")		
	UnloadSequence2:
		TNT1 A 0 A_JumpIfInventory("MP12Ammo2", 1, 1)
		Goto Ready3
		TNT1 A 0 A_GiveInventory("PB_LowCalMag", 1)
		TNT1 A 0 A_TakeInventory("MP12Ammo2", 1)
