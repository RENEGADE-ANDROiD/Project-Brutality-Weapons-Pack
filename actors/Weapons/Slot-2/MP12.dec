	UnloadSMGWithSil:
		TNT1 A 0 A_TakeInventory("Unloading")
		TNT1 A 0 A_JumpIfInventory("MP12Unloaded", 1, "Ready3")
		TNT1 A 0 A_JumpIfInventory("MP12Ammo2", 1, 1)
		Goto Ready3
		TNT1 A 0 A_JumpIfInventory("MP12Unloaded", 1, "Ready3")
