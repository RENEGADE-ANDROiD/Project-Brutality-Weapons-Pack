Actor DualDukePistols : PB_Weapon
{
    Game Doom
	SpawnID 2300
	Weapon.BobRangeX 0.3
	Weapon.BobRangeY 0.5
	Weapon.BobStyle InverseSmooth
	Weapon.BobSpeed 2.4
	Weapon.AmmoUse1 0
	Weapon.AmmoGive1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 1900
	Weapon.AmmoType1 "PB_LowCalMag"
	Weapon.AmmoType2 "DualDukePistolAmmo"
	Obituary "Shot down by Duke Nukem 3D Dual Pistols."
    AttackSound "None"
    Inventory.PickupSound "P3DOUT"
	Inventory.Pickupmessage "You got the Duke Nukem 3D Dual Pistols. (Slot 2)!"
    +WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	+WEAPON.WIMPY_WEAPON
	+INVENTORY.ALWAYSPICKUP
    +FORCEXYBILLBOARD
    +FLOORCLIP
	Scale 0.7
	Tag "Duke Nukem Dual Pistols"
	Inventory.AltHudIcon "PD3IA0"
	FloatBobStrength 0.5
	States
	{
	Steady:
		TNT1 A 1
		Goto Ready

	Ready:
		TNT1 A 0
	SelectAnimation:
		TNT1 A 0 {
		     A_SetRoll(0);
			 A_TakeInventory("PB_LockScreenTilt",1);
			 return A_DoPBWeaponAction(WRF_NOFIRE);
		}
	    PD3G A 0 A_GunFlash
        PD3S ABCDE 1
        PD3G A 0 A_PlaySound("P3DOUT", 6)
		PD3G A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
	Ready3:
	    TNT1 A 0 {
			 A_WeaponOffset(0,32);
			 A_SetRoll(0);
			 A_TakeInventory("PB_LockScreenTilt",1);
		}
	    TNT1 A 0
	DukeDualPistolsReadyToFire:
		PD3G A 1 {
			 return PB_DoPBWeaponActionUnloaded(WRF_ALLOWRELOAD);







		}
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		Loop

	Deselect:	
        TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
	    TNT1 A 0 {
			 A_WeaponOffset(0,32);
			 A_SetRoll(0);
			 A_TakeInventory("PB_LockScreenTilt",1);







	    }
		TNT1 A 0 A_ZoomFactor(1.0)
				TNT1 A 0 A_Lower(120)
		Wait	

	Select:
	    TNT1 A 0 {
		     A_WeaponOffset(0,32);
		     A_SetRoll(0);
		     A_TakeInventory("PB_LockScreenTilt",1);







	    }
	    TNT1 A 0 A_TakeInventory("HasBarrel",1)
	    TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
	    TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
	    TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
	    TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
	    TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel",1)
	    Goto SelectFirstPersonLegs
	    SelectContinue:
		TNT1 A 0 { PB_WeaponRaise; }
		TNT1 A 0 { PB_WeapTokenSwitch("DukePistolSelected"); }
	    		TNT1 A 0 A_WeaponOffset(0, 32)
	    		Goto Ready3

    Fire:
		TNT1 A 0 { return PB_FireExecuteCheck(); }
        PD3G A 0 A_JumpIfInventory("DualDukePistolAmmo",1,1)
        Goto NoAmmo
		TNT1 A 0 A_JumpIfInventory("FiredSecondDukePistol", 1, "FireSecondGun")
        PD3G A 0 A_PlaySound("P3DFIRE", 3)
		PD3G A 0 A_ZoomFactor(0.98)
		PD3F AB 1 BRIGHT {
		     A_AlertMonsters;
			 PB_FireBullets("PB_9x19mm", 1, 0.1, 0, 0, 0.1);
			 PB_LowAmmoSoundWarning("pistol");
			 A_FireCustomMissile("YellowFlareSpawn",0,0,-3,0);
			 A_FireCustomMissile("ShakeYourAssMinor", 270, 0, 0, 0);
			 PB_SpawnCasing("PB_EmptyBrass", 28, -3, 28, frandom(4,7), frandom(-6,-3), frandom(0,4));
			 PB_GunSmoke(0,0,4);
			 A_GunFlash;
			 PB_WeaponRecoil(-0.84,-1.2);




		}
		TNT1 A 0 A_GiveInventory("FiredSecondDukePistol",1) //will fire the second gun next time
		TNT1 A 0 A_SetPitch(pitch-0.4, SPF_INTERPOLATE)
		TNT1 A 0 A_SetAngle(Angle+random(-1,1), SPF_INTERPOLATE)
		PD3G A 0 A_TakeInventory("DukePistolAmmo",1)
		PD3G A 0 A_TakeInventory("DualDukePistolAmmo",1)
		PD3G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetPitch(pitch-0.3, SPF_INTERPOLATE)
		PD3F C 1 A_DoPBWeaponAction(WRF_NOBOB | WRF_ALLOWRELOAD)
		PD3G A 3 A_DoPBWeaponAction(WRF_NOBOB)
		TNT1 A 0 A_Refire
		Goto DukeDualPistolsReadyToFire

	FireSecondGun:
	    TNT1 A 0 A_TakeInventory("FiredSecondDukePistol",1) // Will Fire The First Gun Now
	    PD3G A 0 A_JumpIfInventory("DukePistolAmmo",1,1)
		Goto DukeDualPistolsReadyToFire
        PD3G A 0 A_PlaySound("P3DFIRE")
		PD3F DE 1 BRIGHT {
		     A_AlertMonsters;
			 PB_FireBullets("PB_9x19mm", 1, 0.1, 0, 0, 0.1);
			 PB_LowAmmoSoundWarning("pistol");
			 A_FireCustomMissile("YellowFlareSpawn",0,0,3,0);
			 A_FireCustomMissile("ShakeYourAssMinor", 270, 0, 0, 0);
			 PB_SpawnCasing("PB_EmptyBrass", 28, 3, 28, frandom(4,7), frandom(-6,-3), frandom(0,4));
			 PB_GunSmoke(0,0,-4);
			 A_GunFlash;
			 PB_WeaponRecoil(-0.84,+1.2);




		}
		PD3G A 0 A_ZoomFactor(0.98)
		TNT1 A 0 A_SetPitch(pitch-0.4, SPF_INTERPOLATE)
		PD3G A 0 A_TakeInventory("DualDukePistolAmmo",1)
		PD3G A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetPitch(pitch-0.3, SPF_INTERPOLATE)
		TNT1 A 0 A_SetAngle(Angle+random(-1,1), SPF_INTERPOLATE)
		PD3F F 1 A_DoPBWeaponAction(WRF_NOBOB | WRF_ALLOWRELOAD)
		PD3G A 3 A_DoPBWeaponAction(WRF_NOBOB)
		TNT1 A 0 A_Refire
		Goto DukeDualPistolsReadyToFire

	AltFire:
        TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
	    TNT1 A 0 {
			 A_WeaponOffset(0,32);
			 A_SetRoll(0);
			 A_TakeInventory("PB_LockScreenTilt",1);







	    }
	    TNT1 A 0
        Goto DukeDualPistolsReadyToFire

	NoAmmo:
		RIFG A 0
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"TurboReload")
		RIFG A 0 A_PlaySound("weapons/empty", 4)
		RIFG A 0 A_JumpIfInventory("PB_LowCalMag",3,"Reload")
		NoAmmo2:
		PD3G A 5 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOFIRE)
		Goto DukeDualPistolsReadyToFire

    Reload:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
	    TNT1 A 0 {
		     A_Takeinventory("PB_LockScreenTilt",1);







	    }
	    TNT1 A 0
		PD3G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PD3G A 0 A_Takeinventory("Reloading",1)
		PD3G A 0 A_Takeinventory("ADSmode",1)
		PD3G A 0 A_JumpIfInventory("DualDukePistolAmmo",26,"DukeDualPistolsReadyToFire")

        PD3G A 0 A_JumpIfInventory("PB_LowCalMag",1,3)
        Goto NoAmmo
        TNT1 AAA 0
		PD3G A 0 A_Takeinventory("Zoomed",1)
        PD3G A 0 A_ZoomFactor(1.0)
		PD3G A 0 A_GiveInventory ("Pumping", 1)
		PD3G A 0 A_Takeinventory("Reloading",1)
		PD3G A 0 A_JumpIfInventory("TurboReload",1,"TurboReload")

		PD3G A 0 A_PlaySound("P3DIN")
		PD3S CBA 1
		TNT1 A 2
		PD3G A 0 { PB_JumpIfMagUnloaded("DualDuke_RMagSkip1"); }
		TNT1 A 0 A_FireCustomMissile("EmptyClipMP40",-80,0,3,-4,0,-45)
		DualDuke_RMagSkip1:
        P3DR CDEFGHHH 1 
		P3DR H 5
		PD3G A 0 A_PlaySound("P3DOUT")
        P3DR IIIJKLMNNNO 1
		PD3G A 0 A_PlaySound("P3DIN")		
		TNT1 A 2	
		PD3G A 0 { PB_JumpIfMagUnloaded("DualDuke_RMagSkip2"); }
		TNT1 A 0 A_FireCustomMissile("EmptyClipMP40",-80,0,3,-4,0,-45)
		DualDuke_RMagSkip2:
		PD3R CDEFGHHH 1 
		PD3R H 5
		PD3G A 0 A_PlaySound("P3DOUT")
        PD3R IJKLLLMN 1
		TNT1 A 2
		PD3S ABC 1
		PD3G A 0 { PB_SetMagUnloaded(false); PB_SetMagUnloaded(false, true); }


		PD3G A 0 A_JumpIfInventory("DualDukePistolAmmo",1,"InsertBullets2")//15+1 effect

	TurboReload:
		PD3G A 0 { PB_SetMagUnloaded(false); PB_SetMagUnloaded(false, true); }


        PIS2 BA 0
        Goto InsertBullets

	InsertBullets:
		TNT1 AAAA 0
		PD3G A 0 A_JumpIfInventory("DualDukePistolAmmo",26,15)
		PD3G A 0 A_JumpIfInventory("PB_LowCalMag",1,3)
		Goto DukeDualPistolsReadyToFire
        TNT1 AAAAAA 0
		PD3G A 0 A_Giveinventory("DualDukePistolAmmo",1)
		PD3G A 0 A_Giveinventory("DukePistolAmmo",1)
		PD3G A 0 A_Takeinventory("PB_LowCalMag",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets

		TNT1 AAAAAAAAAA 0
		PD3G A 0 A_Takeinventory("Reloading",1)
		PD3G A 0 A_Refire
        Goto DukeDualPistolsReadyToFire
		TNT1 AAAA 0
		PD3G A 0 A_Takeinventory("Reloading",1)
		PD3G A 0 A_Refire
        Goto DukeDualPistolsReadyToFire

	InsertBullets2:
		TNT1 AAAA 0
		PD3G A 0 A_JumpIfInventory("DualDukePistolAmmo",26,15)
		PD3G A 0 A_JumpIfInventory("PB_LowCalMag",1,3)
		Goto DukeDualPistolsReadyToFire
        TNT1 AAAAAA 0
		PD3G A 0 A_Giveinventory("DualDukePistolAmmo",1)
		PD3G A 0 A_Giveinventory("DukePistolAmmo",1)
		PD3G A 0 A_Takeinventory("PB_LowCalMag",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2

		TNT1 AAAAAAAAAA 0
		PD3G A 0 A_Takeinventory("Reloading",1)
		PD3G A 0 A_Refire
        Goto DukeDualPistolsReadyToFire
		TNT1 AAAA 0
		PD3G A 0 A_Takeinventory("Reloading",1)
		PD3G A 0 A_Refire
        Goto DukeDualPistolsReadyToFire

	Unload:
		PD3G A 0 A_Takeinventory("Unloading",1)
		PD3G A 0 A_Takeinventory("ADSmode",1)
		PD3G A 0 A_JumpIfInventory("DukePistolAmmo",1,3)
        Goto NoAmmo
        TNT1 AAA 0
		PD3G A 0 A_Takeinventory("Zoomed",1)
        PD3G A 0 A_ZoomFactor(1.0)
		PD3G A 0 A_GiveInventory ("Pumping", 1)
		PD3G A 0 A_Takeinventory("Reloading",1)
        P3DR ONNNMLKJIIH 1
		PD3G A 0 A_PlaySound("P3DOUT")
		P3DR DCBA 1

		PD3R ONNNMLKJIIH 1
		PD3G A 0 A_PlaySound("P3DOUT")
		PD3R DCBA 1
		PD3G A 0 { PB_SetMagUnloaded(true); PB_SetMagUnloaded(true, true); }


		PD3G A 0 A_JumpIfInventory("DukePistolAmmo",1,"RemoveBullets")

	RemoveBullets:
		TNT1 AAAA 0
		PD3G A 0 A_JumpIfInventory("DualDukePistolAmmo",1,3)
		Goto DukeDualPistolsReadyToFire
        TNT1 AAAAAA 0
		PD3G A 0 A_Takeinventory("DukePistolAmmo",1)
		PD3G A 0 A_Takeinventory("DualDukePistolAmmo",1)
		PD3G A 0 A_Giveinventory("PB_LowCalMag",1)
		Goto RemoveBullets

		TNT1 AAAAAAAAAA 0
		PD3G A 0 A_Takeinventory("Reloading",1)
		PD3G A 0 A_Refire
        Goto DukeDualPistolsReadyToFire
		TNT1 AAAA 0
		PD3G A 0 A_Takeinventory("Reloading",1)
		PD3G A 0 A_Refire
        Goto DukeDualPistolsReadyToFire

 	Spawn:
		PD3I A -1
		Stop

	WeaponSpecial:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "IdleBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "IdleIceBarrel")
	    TNT1 A 0 {
			 A_WeaponOffset(0,32);
			 A_SetRoll(0);
			 A_TakeInventory("PB_LockScreenTilt",1);
			 A_Takeinventory("GoWeaponSpecialAbility",1);




		}
		TNT1 A 0
		PD3G A 0 A_SelectWeapon("DukePistol")
		PD3G A 0 A_Print("Duke Pistol Selected.")
		Goto DukeDualPistolsReadyToFire

	FlashKicking:
        TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		PD3G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		PD3K A 1 A_DoPBWeaponAction
		PD3K B 1 A_DoPBWeaponAction
		PD3K C 1 A_DoPBWeaponAction
		PD3K D 1 A_DoPBWeaponAction
		PD3K E 6 A_DoPBWeaponAction
		PD3K D 1 A_DoPBWeaponAction
		PD3K C 1 A_DoPBWeaponAction
		PD3K B 1 A_DoPBWeaponAction
		PD3K A 1 A_DoPBWeaponAction
		PD3G A 1 A_DoPBWeaponAction
		Goto DukeDualPistolsReadyToFire

	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelAirKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		PD3G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		PD3K A 1 A_DoPBWeaponAction
		PD3K B 1 A_DoPBWeaponAction
		PD3K C 1 A_DoPBWeaponAction
		PD3K D 1 A_DoPBWeaponAction
		PD3K E 7 A_DoPBWeaponAction
		PD3K D 1 A_DoPBWeaponAction
		PD3K C 1 A_DoPBWeaponAction
		PD3K B 1 A_DoPBWeaponAction
		PD3K A 1 A_DoPBWeaponAction
		PD3G A 1 A_DoPBWeaponAction
		Goto DukeDualPistolsReadyToFire

	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		PD3G A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		PD3K A 1 A_DoPBWeaponAction
		PD3K B 1 A_DoPBWeaponAction
		PD3K C 1 A_DoPBWeaponAction
		PD3K D 1 A_DoPBWeaponAction
		PD3K E 13 A_DoPBWeaponAction
		PD3K D 1 A_DoPBWeaponAction
		PD3K C 1 A_DoPBWeaponAction
		PD3K B 1 A_DoPBWeaponAction
		PD3K A 1 A_DoPBWeaponAction
		PD3G A 1 A_DoPBWeaponAction
		Goto DukeDualPistolsReadyToFire

	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelSlideKickingStop")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelSlideKickingStop")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelSlideKickingStop")
		PD3G A 1 A_DoPBWeaponAction
		Goto DukeDualPistolsReadyToFire

	FlashPunching:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "FlashBarrelPunching")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
	    TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		TNT1 AAAAAAAAAAAAAA 1
		Stop


	}
}

Actor FiredSecondDukePistol : Inventory { Inventory.MaxAmount 1 }

Actor DualDukePistolAmmo : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 26
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 26
   Inventory.Icon "PD3IA0"
}
