// Minimal actor/inventory stubs for PBWP content that references legacy PB actors
// not shipped in PB_Staging_PDA. Prevents "Unknown class" script warnings.

// Base for actors/Effects/ICE.dec freeze clouds (full defs load later in ICE.dec).
ACTOR SlowingCloud
{
	Radius 1
	Height 1
	+NOBLOCKMAP
}

// ICE.dec references these before its commented full defs; minimal live stubs.
ACTOR FreezeCloud : SlowingCloud
{
	+NOINTERACTION
	States
	{
		Spawn:
			TNT1 A 35
			Stop
		Death:
			Stop
	}
}

ACTOR FreezeCloudSmall : FreezeCloud
{
	Scale 0.65
}

ACTOR FreezeCloudSpawner : Actor
{
	+NOGRAVITY
	Height 0
	Radius 0
	States
	{
		Spawn:
			TNT1 A 0 A_JumpIfInventory("FreezeSpawnerCheck", 4, "CloudEnd")
			TNT1 AAAA 2 A_SpawnItemEx("FreezeCloud", 0, 0, 0, 0, 0, 0)
			TNT1 A 0 A_GiveInventory("FreezeSpawnerCheck", 1)
			Loop
		CloudEnd:
			TNT1 A 0
			Stop
	}
}

ACTOR FreezeSpawnerCheck : Inventory { Inventory.MaxAmount 10 }

ACTOR SnowStart : Actor
{
	+NOGRAVITY
	+SKYEXPLODE
	States
	{
		Spawn:
			TNT1 A 1
			Stop
		Death:
			Stop
	}
}

// Gauss / ThunderCarrier A_RailAttack trail (avoid Staging RailgunTrail name collision).
ACTOR PBWP_RailGunTrail : Actor
{
	+NOBLOCKMAP
	+NOINTERACTION
	States
	{
		Spawn:
			TNT1 A 1
			Stop
	}
}

