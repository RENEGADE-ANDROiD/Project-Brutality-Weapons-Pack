// Glory Kills tokens/highlights — provided by glorykills-master.zip (do not stub here)

// GLDEFS.PBWP Hecteball fireball lights (weapon FX actor not shipped in PBWP)
ACTOR HecteballGargoyle
{
   +NOBLOCKMAP +NOINTERACTION +NOGRAVITY
   States
   {
      Spawn:
         HECF A -1
         Stop
   }


}
