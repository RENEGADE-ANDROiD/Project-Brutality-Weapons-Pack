// RoboDog companion (Sergeant_Mark_IV / RENEGADE-ANDROiD) — killstreak familiar summon.
// Assets: SPRITES/RoboDog, Sounds/DOGAT* (RoboDog_Companion-RA-edit)
// IsPlayer / TargetIsAMarine tokens come from PB player + Freezebot patterns.
Actor IsHoldingPosition : Inventory { inventory.maxamount 1 }
Actor RoboDogLifetime : Inventory { inventory.maxamount 700 }

ACTOR MarineSpawnChecker
{
MONSTER
-COUNTKILL
+FRIENDLY
Health 1
Radius 24
Height 52
Damagetype "SpawnMarine"
	States
	{
	Spawn:
	    TNT1 A 0
		TNT1 A 0 A_GiveInventory("TargetIsAMarine", 1)
	    TNT1 A 0
		TNT1 A 0 A_Explode(1100, 32)
		Stop
	Death:
	TNT1 A 1
	Stop
}
}



Actor OrderTitle1
{
  Height 1
  Radius 1
  Mass 0
  +Missile
  +NoBlockMap
  +NoGravity
  +DontSplash
  +FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  +THRUACTORS
  +GHOST
  +THRUGHOST
  RenderStyle Add
  Scale 0.2
  Speed 1
  States
  {
  Spawn:
    CMMN A 2 BRIGHT
	CMMN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_FadeOut(0.04)
    Stop
  }
}

Actor OrderTitle2: OrderTitle1
{
  States
  {
  Spawn:
    CMMN B 2 BRIGHT
	CMMN BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB 1 Bright A_FadeOut(0.04)
    Stop
  }
}

Actor OrderTitle3: OrderTitle1
{
  States
  {
  Spawn:
    CMMN C 2 BRIGHT
	CMMN CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 1 Bright A_FadeOut(0.04)
    Stop
  }
}


//Advanced Dog Friend by Sergeant_Mark_IV
//Tweaked by several people at this point.
//Incl. me, RENEGADE ANDROiD :)

Actor AttachedElectricArc : Actor
{
  +NOINTERACTION +NOGRAVITY +NOBLOCKMAP
  RenderStyle None
  Scale 0.8
  
  States
  {
  Spawn:
    // Make the arc pulse with the dog's attacks
    TNT1 A 1 
    {
      A_SpawnItemEx("StunSparks", 0, 0, 48, 0, 0, 0, 0, 0);
      A_SpawnItemEx("StunSparks", 16, 0, 32, 0, 0, 0, 0, 0);
      A_SpawnItemEx("StunSparks", -16, 0, 32, 0, 0, 0, 0, 0);
    }
    TNT1 A 2
    {
      A_SpawnItemEx("StunSparks", 8, 8, 40, 0, 0, 0, 0, 0);
      A_SpawnItemEx("StunSparks", -8, -8, 40, 0, 0, 0, 0, 0);
    }
    Loop
  }
}
Actor StunSparks 
{
  RenderStyle Add
  Alpha 0.8
  Scale 0.7
  +THRUGHOST
  +NOBLOCKMAP
  +NOGRAVITY
  Speed 10
  DamageType "Electric"
  States
  {
  Spawn:
    SPAR A 2 Bright
    TNT1 A 0 A_RadiusGive("Stunned", 64, 0, 0)
    SPAR B 2 Bright A_FadeOut(0.1)
    SPAR C 2 Bright A_FadeOut(0.1)
    SPAR D 2 Bright A_FadeOut(0.1)
    Stop
  }
}
Actor Stunned : Inventory 9001
{
  Inventory.MaxAmount 1
  +INVENTORY.UNTOSSABLE
  +INVENTORY.AUTOACTIVATE
  States
  {
  Use:
    TNT1 A 35
    TNT1 A 0 A_ChangeFlag("FROZEN", 1)
    TNT1 A 0 A_SetScale(0.9)
    Stop
  Death:
    TNT1 A 0 A_ChangeFlag("FROZEN", 0)
    TNT1 A 0 A_SetScale(1.0)
    Stop
  }
}
ACTOR PBWP_RoboDogFamiliar : Actor
{
	Scale 1.1
	Health 10000
	Radius 16
	Height 24
	Mass 400
	MaxTargetRange 40
	Speed 4
	FastSpeed 15
	PainChance 250
	Species "Marines"
	MONSTER
	-SHOOTABLE
	+INVULNERABLE
	+NODAMAGE
	+QUICKTORETALIATE
	+LOOKALLAROUND
	+PUSHABLE
	+SLIDESONWALLS
	+FLOORCLIP
	+JUMPDOWN
	+DROPOFF
	+CANPASS
	-FASTER
	+MTHRUSPECIES
	+THRUSPECIES
	+DONTHURTSPECIES 
	+NOBLOCKMONST 
	+USESPECIAL
	-CANNOTPUSH
	-COUNTKILL
	+THRUACTORS
	Damagetype "Eat"
	Activation THINGSPEC_Activate
	Damage 4
	MaxStepHeight 48
	MaxDropOffHeight 48
	MeleeDamage 8
	States
 {
 

	Spawn:
		 DOGW A 1
		 TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		 TNT1 A 0 A_GiveInventory("RoboDogLifetime", 700)
		 TNT1 A 0 A_SpawnItemEx("AttachedElectricArc", 0, 0, 48, 0, 0, 0, 256)
		 DOGW A 1 A_Look
		 Loop
		 
	
	ForgetTarget:
		TNT1 A 0 A_ClearTarget
		Goto See
		
		
		
	Idle:	
	See:
		TNT1 A 0 A_TakeInventory("RoboDogLifetime", 1)
		TNT1 A 0 A_JumpIfInventory("RoboDogLifetime", 1, "SeeContinue")
		TNT1 A 0 A_SpawnItem("TeleportFog")
		Stop
	SeeContinue:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		
		
		
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_Recoil(-1)
		
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		DOGW AA 1 A_Chase
		TNT1 A 0 A_StartSound("misc/spark", CHAN_BODY, CHANF_LOOP, 0.3)
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPLayer")//
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		DOGW BB 1 A_Chase
		NULL A 0 
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		DOGW BB 1 A_Chase
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		DOGW CC 1 A_Chase
		NULL A 0 
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		DOGW CC 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		DOGW DD 1 A_Chase
		
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		DOGW DD 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		
		DOGW AA 1 A_Chase
		NULL A 0 
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		DOGW BB 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		DOGW CC 1 A_Chase
		NULL A 0 
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		DOGW DD 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
	
		TNT1 A 0 A_SpawnItemEx ("BlueFlareMedium", 0, 0, -5)
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.3, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.3, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		Goto See
		
		
		
	FollowPlayer:
		TNT1 A 0 A_TakeInventory("RoboDogLifetime", 1)
		TNT1 A 0 A_JumpIfInventory("RoboDogLifetime", 1, "FollowPlayerContinue")
		TNT1 A 0 A_SpawnItem("TeleportFog")
		Stop
	FollowPlayerContinue:
		TNT1 A 0 A_SpawnItemEx ("BlueFlareMedium", 0, 0, -5)
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.3, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	    TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
	    TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		DOGW A 1 A_Chase
		
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_Recoil(-1)
		DOGW AA 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		DOGW BB 1 A_Chase
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		NULL A 0 
		TNT1 A 0 A_Recoil(-1)
		DOGW BB 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		DOGW CC 1 A_Chase
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		NULL A 0 
		TNT1 A 0 A_Recoil(-1)
		DOGW CC 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		DOGW DD 1 A_Chase
		
		TNT1 A 0 A_Recoil(-1)
		DOGW DD 1 A_Chase
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_Recoil(-1)
		
		DOGW AA 1 A_Chase
		TNT1 A 0 A_SpawnItemEx ("BlueFlareMedium", 0, 0, -5)
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.3, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.3, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_Recoil(-1)
		NULL A 0 
		DOGW BB 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		DOGW BB 1 A_Chase
		NULL A 0 
		TNT1 A 0 A_Recoil(-1)
		DOGW CC 1 A_Chase
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_Recoil(-1)
		DOGW CC 1 A_Chase

		TNT1 A 0 A_SpawnItemEx ("BlueFlareMedium", 0, 0, -5)
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.3, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.3, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		
		TNT1 A 0 A_Recoil(-1)
		DOGW DD 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		DOGW DD 1 A_Chase
		NULL A 0 
		TNT1 A 0 A_Recoil(-1)
		
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		
		
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	
	CheckRangeToWait:
		TNT1 A 0
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		Goto FollowPLayer
	
	CheckIfPlayerSee:
		TNT1 A 0
		DOGW AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_FastChase
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		////TNT1 A 0 Thing_Hate(94, 0, 0)
		TNT1 A 0 A_JumpIfCloser(1000, 2)
		Goto Pathfind
		TNT1 AAA 0
		Goto FollowPlayer
	
	
	
	Pathfind:
		TNT1 A 0
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_JumpIFInTargetInventory("IsPLayer", 1, 1)
		Goto FollowPLayer
		//TNT1 A 1 A_Chase("", "")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_ChangeFlag("NOCLIP", 1)
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_Noblocking
		TNT1 A 0 A_SpawnItemEx ("DogPathfinder",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop
	
	BecomeEnemy23:
		DOGS A 1
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		Goto FollowPlayer
	
	Waits:
		TNT1 A 0 A_SpawnItemEx ("BlueFlareMedium", 0, 0, -5)
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.3, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		DOGS A 1
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, 2)
		TNT1 A 0 A_ClearTarget
		Goto See
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		
		DOGS A 4 A_Stop
		TNT1 A 0 A_SpawnItemEx ("BlueFlareMedium", 0, 0, -5)
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		DOGS B 4 A_Stop
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_ClearTarget
		
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		DOGS A 0 A_Look
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		DOGS A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		DOGS A 6 A_Stop
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_PlaySound("Plasma/BeepQuiet", 2)
		DOGS B 6 A_Stop
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_ClearTarget
		
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		DOGW A 0 A_Look
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		DOGS A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	Waits3:
		TNT1 A 0
		//TNT1 A 0 A_JumpIfInTargetInventory("Clip2", 40, 3)
		//Goto GiveAmmo
		TNT1 AAA 0
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		DOGS A 4 A_Stop
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_PlaySound("Plasma/BeepQuiet", 2)
		DOGS B 4 A_Stop
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_ClearTarget
		
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		DOGW A 0 A_Look
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		DOGS A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 AAAA 0 A_SpawnItemEx("MiniCryoSmoke1", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_SpawnItemEx("FreezerTrailSparksSmall", 0, 0, -5, random(10, 30)*0.1, 0, random(0, -10)*0.2, random(-1,-360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
		
	//Disabled
	GiveAmmo:
		TNT1 A 0
		MR7S A 10 A_FaceTarget
		TNT1 A 0 //A_PlaySound("MRNGI1")
		MR8S CD 15
		TNT1 A 0 A_GiveToTarget("Clip2", 50)
		//TNT1 A 0 A_SpawnItemEx("Stimpack", 40, 0)
		Goto Waits	

	Missile:
        TNT1 A 0
        TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACyberdemon", 1, "CheckRetreat") // Brutal Doom-friendly realistic AI.
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMastermind", 1, "CheckRetreat")//...
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsABaronOfHell", 1, "CheckRetreat")//...
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMancubus", 1, "CheckRetreat")//...
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")////Never remove this one!
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "CheckRangeToWait")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		
		TNT1 A 0 A_JumpIfCloser(200, "ActualFireState")

		TNT1 A 0 A_FaceTarget
		DOGS A 1  A_Recoil(-1)
		TNT1 A 0 A_PlaySound("DogAttack")
		DOGW A 0 A_Chase ("","")
		DOGW A 1 A_Chase ("","")
		DOGW B 0 A_Chase ("","")
		DOGW B 1 A_Chase ("","")
		DOGW C 0 A_Chase ("","")
		DOGW C 1 A_Chase ("","")
		DOGW D 0 A_Chase ("","")
		DOGW D 1 A_Chase
		DOGW A 0 A_Chase ("","")
		DOGW A 1 A_Chase ("","")
		DOGW B 0 A_Chase ("","")
		DOGW B 1 A_Chase ("","")
		DOGW C 0 A_Chase ("","")
		DOGW C 1 A_Chase ("","")
		DOGW D 0 A_Chase ("","")
		DOGW D 1 A_Chase
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "CheckRangeToWait")
		Goto See
		
	ActualFireState:

		DOGW F 3 A_FaceTarget
		TNT1 A 0 A_Recoil(-6)
		TNT1 A 0 THrustThingZ(0, 35, 0, 1)
		TNT1 A 0 A_PlaySound("DOGAT4", 3)
    DOGW EEFF 3 
    {
      A_MeleeAttack;
      A_SpawnItemEx("StunSparks", 48, 0, 32, 0, 0, 0, 0, 0);
    }
		Goto See

		ApplyStunEffect:
		    TNT1 A 0 A_RadiusGive("Stunned", 64, RGF_PLAYERS, 1)
		    TNT1 A 0 A_SpawnItemEx("StunSparks", 0, 0, 48, 0, 0, 0, 0, 0)
		    Goto See
 
	CheckRetreat:
		TNT1 A 0
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		Goto ActualFireState
	
	Retreat:
		TNT1 A 0
		
		
		DOGW A 2 A_Recoil(4)
		TNT1 A 0 A_SpawnItem ("BlueFlareMedium", 0, 24)
		TNT1 A 0 A_FaceTarget
		NULL A 0 
		DOGW B 2 A_Recoil(4)
		TNT1 A 0 A_SpawnItem ("BlueFlareMedium", 0, 24)
		TNT1 A 0 A_FaceTarget
		NULL A 0 
		DOGW C 2 A_Recoil(4)
		TNT1 A 0 A_SpawnItem ("BlueFlareMedium", 0, 24)
		TNT1 A 0 A_FaceTarget
		
		DOGW D 2 A_Recoil(4)
		TNT1 A 0 A_SpawnItem ("BlueFlareMedium", 0, 24)
		TNT1 A 0 A_FaceTarget
		Goto ActualFireState
		

	Pain:
        	TNT1 AAA 0 A_CustomMissile ("SoulTrails", 12, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 3
		DOGS A 2
		TNT1 A 0 A_PlaySound("DogPain")
		DOGS A 2 A_Pain
		Goto See + 1
  	
	Active:
		TNT1 A 0
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 10, 0, 0, 2, 90)
		TNT1 A 0 A_PlaySound("DOGAT2", 3)
		DOGW A 10 A_FaceTarget
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		TNT1 A 0 A_SpawnItemEx ("PBWP_RoboDogFamiliar_Guarding",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 1
		TNT1 A -1
		Stop
	
	Death:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0) //Always add this line on every death animation, to prevent the player from resurrecting the actor by pressing use.
		TNT1 A 0 A_PlaySound("DOGDIE", 3)
	    	EXPL AA 0 A_SpawnItem("ExplosionParticleSpawner")
	    	TNT1 A 0 A_SpawnItemEx ("ExplosionFlareSpawner",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION,0)
	    	EXPL AAAAA 0 A_CustomMissile ("FireBallExplosionFlamesMedium", 32, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAA 0 A_CustomMissile ("PlasmaSmoke", 32, 0, random (0, 360), 2, random (0, 360))
       		TNT1 AAA 0 A_CustomMissile ("XJunk3", 42, 0, random (0, 360), 2, random (0, 160))
       		TNT1 A 0 A_CustomMissile ("XJunk5", 42, 0, random (0, 360), 2, random (0, 160))
       		TNT1 AA 0 A_CustomMissile ("XJunk4", 42, 0, random (0, 360), 2, random (0, 160))
		DOGW I 4 A_NoBlocking
		DOGW JKLM 4
		DOGW M -1
		Stop
 }
}



ACTOR PBWP_RoboDogFamiliar_Guarding : PBWP_RoboDogFamiliar
{
	Speed 0
	FastSpeed 0
	+FRIENDLY
	+REFLECTIVE
	Mass 500
	States
 {
 

	Spawn:
		 TNT1 A 0
		 TNT1 A 0 A_GiveInventory("TargetIsAMarine", 1)
		 DOGS A 4
		 TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		 TNT1 A 0 A_GiveInventory("TargetIsAMarine")//Stops multiple sentries from firing at each other.
		 DOGS B 4 A_Look
		 Loop
		 
	
	
	See:
		TNT1 A 0
		TNT1 A 0 A_ClearTarget
		DOGS AABBAABB 2 A_Chase
		TNT1 A 0 A_FaceTarget
		Loop

	See2:	
		DOGS AB 2
		TNT1 A 0 A_ClearTarget
		Goto See
		
		Missile:
        TNT1 A 0
        TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACyberdemon", 1, "CheckRetreat") // Brutal Doom-friendly realistic AI.
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMastermind", 1, "CheckRetreat")//...
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsABaronOfHell", 1, "CheckRetreat")//...
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMancubus", 1, "CheckRetreat")//...
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")////Never remove this one!
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "CheckRangeToWait")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		
		TNT1 A 0 A_JumpIfCloser(200, "ActualFireState")

		TNT1 A 0 A_FaceTarget
		DOGS A 1  A_Recoil(-3)
		TNT1 A 0 A_PlaySound("DogAttack")
		DOGW A 0 A_Chase ("","")
		DOGW A 1 A_Chase ("","")
		DOGW B 0 A_Chase ("","")
		DOGW B 1 A_Chase ("","")
		DOGW C 0 A_Chase ("","")
		DOGW C 1 A_Chase ("","")
		DOGW D 0 A_Chase ("","")
		DOGS A 1  A_Recoil(-3)
		DOGW A 0 A_Chase ("","")
		DOGW A 1 A_Chase ("","")
		DOGW B 0 A_Chase ("","")
		DOGW B 1 A_Chase ("","")
		DOGW C 0 A_Chase ("","")
		DOGW C 1 A_Chase ("","")
		DOGW D 0 A_Chase ("","")
		DOGW D 1 A_Chase
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "CheckRangeToWait")
		Goto See
		
	ActualFireState:

		DOGW F 3 A_FaceTarget
		TNT1 A 0 A_Recoil(-6)
		TNT1 A 0 THrustThingZ(0, 35, 0, 1)
		TNT1 A 0 A_PlaySound("DOGAT4", 3)
		DOGW EEFF 3 A_MeleeAttack
		Goto See
 
	CheckRetreat:
		TNT1 A 0
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		Goto ActualFireState
	
	Retreat:
		TNT1 A 0
		
		
		DOGW A 2 A_Recoil(4)
		TNT1 A 0 A_FaceTarget
		NULL A 0 
		DOGW B 2 A_Recoil(4)
		TNT1 A 0 A_FaceTarget
		NULL A 0 
		DOGW C 2 A_Recoil(4)
		TNT1 A 0 A_FaceTarget
		
		DOGW D 2 A_Recoil(4)
		TNT1 A 0 A_FaceTarget
		Goto ActualFireState
		

	Pain:
		DOGS A 2
		TNT1 A 0 A_PlaySound("DogPain")
		DOGS A 2 A_Pain
		Goto See + 1
  	

	Death:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0) //Always add this line on every death animation, to prevent the player from resurrecting the actor by pressing use.
		TNT1 A 0 A_PlaySound("DOGDIE", 3)
		DOGW I 4 A_NoBlocking
		DOGW JKLM 4
		DOGW M -1
		Stop
  	
	Active:
		TNT1 A 0
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 10, 0, 0, 2, 90)
		TNT1 A 0 A_PlaySound("DOGAT1", 3)
		DOGW A 10 A_FaceTarget
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		TNT1 A 0 A_SpawnItemEx ("PBWP_RoboDogFamiliar",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 1
		TNT1 A -1
		Stop
 }
}













ACTOR DogPathfinder
{
	Radius 32
	Height 56
	Speed 20
	Health 4000
	PainChance 255
	MaxTargetRange 150
	Monster
	damagefactor "SpawnMarine", 99999.0
	MaxDropOffHeight 1200
	MaxStepHeight 1200
	-COUNTKILL
	+NOTARGET
	+THRUACTORS
	+MISSILEMORE
	+MISSILEEVENMORE
	+FASTER
	+DONTSPLASH
	+SHOOTABLE
	+JUMPDOWN
	+DROPOFF
	+CANPASS
	-FRIENDLY
	+NOCLIP
	+LOOKALLAROUND
	+NOINFIGHTING
	States
	{
	Spawn:
	Pain:
    See:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		//TNT1 A 0 Thing_ChangeTID(0,98)
		//TNT1 A 0 Thing_Hate(98, 0, 0)
		TNT1 A 0
		TNT1 A 0 A_GiveInventory("TargetIsAMarine", 1)
		TNT1 AAAAA 1 A_Chase
		//TNT1 A 0 Thing_Hate(98, 0, 0)
		TNT1 A 0
		TNT1 A 0
		TNT1 A 0 A_GiveInventory("TargetIsAMarine", 1)
		TNT1 A 0 A_FaceTarget
		Loop
	//Missile:
	TNT1 A 2
	TNT1 A 0 A_SpawnItem("MarineSpawnChecker")	
	TNT1 A 5
	Goto See
	Death:
	Missile:
	    TNT1 A 0
		TNT1 A 1 A_FaceTarget
	    TNT1 A 0 A_Recoil(-6)
		TNT1 A 4
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_SpawnItemEx("PBWP_RoboDogFamiliar",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItem("TeleportFog")
		Stop
	}
}
