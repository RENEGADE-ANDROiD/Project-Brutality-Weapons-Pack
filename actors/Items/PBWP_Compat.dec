// Missing inventory tokens referenced by PBWP weapons/equipment.
// (Actor stubs live in PBWP_ActorStubs.dec — loaded first from DECORATE.PBWP.)

// VietDoom Dropper hub selects bare-hands when done dropping weapons.
ACTOR Melee_Attacks : PB_WeaponBase
{
	Weapon.SlotNumber 0
	+WEAPON.CHEATNOTWEAPON
	States
	{
		Ready:
			TNT1 A 1 A_WeaponReady
			Loop
		Select:
			TNT1 A 1
			Goto Ready
		Deselect:
			TNT1 A 0 A_Lower
			Wait
		Fire:
			Goto Ready
	}
}

ACTOR FreezerAmmo : Ammo
{
	Inventory.MaxAmount 999
	Ammo.BackpackMaxAmount 999
}

