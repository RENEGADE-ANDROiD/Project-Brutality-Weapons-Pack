// PB2022-style kill-streak drone familiar (Universal Kill Streaks fold-in).
// Summon item: FamiliarSummon (ZScript) + FamiliarSummonThrown (PBWP_Powerups.dec).
// Sprites: HDRN (live), DRON (death), DROS (shot) — from PB Staging / PB2022 Realm667 pack.

ACTOR DroneFamiliar : DroneFamiliarBase
{
	Health 1000
	ReactionTime 8
	PainChance 64
	Speed 10
	Radius 16
	Height 24
	Mass 75
	Monster
	MaxTargetRange 1024
	MissileType "DroneFamiliarShot"
	+DROPOFF +NOGRAVITY +FLOAT
	+FLOORCLIP +TELESTOMP
	+MISSILEMORE +FRIENDLY +NOBLOCKMONST
	+NOPAIN +NODAMAGE
	+NOBLOOD
	+FLOATBOB
	+QUICKTORETALIATE
	Species "FriendlyDrone"
	SeeSound "drone/see"
	PainSound "drone/pain"
	DeathSound "drone/die"
	ActiveSound "drone/idle"
	Obituary "%o was blasted by a drone familiar."
	States
	{
	Spawn:
		HDRN A 5 Bright A_PlaySound("drone/idle", CHAN_BODY)
		TNT1 A 0 A_ChangeVelocity(0, 0, 5, CVF_REPLACE)
		HDRN A 4 Bright
		HDRN A 4 Bright A_PlaySound("drone/see", CHAN_VOICE)
		TNT1 A 0 A_ChangeVelocity(0, 0, 0, CVF_REPLACE)
		HDRN AAA 4 Bright
		TNT1 A 0 A_ChangeFlag("NOPAIN", 0)
		TNT1 A 0 A_ChangeFlag("NODAMAGE", 0)
	Chase:
		HDRN A 4 A_Chase
		HDRN A 4 A_Chase
		Loop
	Pain:
		HDRN A 3 A_Pain
		Goto Chase
	Missile:
		HDRN A 3 Bright A_FaceTarget
	MissileLoop:
		HDRN D 0 Bright A_FaceTarget
		HDRN D 0 Bright A_CustomMissile("DroneFamiliarShot", 4, -12)
		HDRN D 0 Bright A_CustomMissile("DroneFamiliarShot", 4,  12)
		HDRN B 3 Bright
		HDRN C 3 Bright
		HDRN D 3 Bright
		HDRN D 0 A_Jump(128, 1)
		Goto Chase
		HDRN D 0 A_SpidRefire
		Loop
	Crash:
	XDeath:
	Death:
		DRON E 0 Bright A_NoBlocking
		DRON E 0 Bright A_ChangeFlag("FLOATBOB", false)
		DRON E 0 Bright A_Scream
		TNT1 A 0 A_SpawnItemEx("DroneFamiliarBurst", 0, 0, 16, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER)
		TNT1 A 0 A_SpawnItemEx("FamiliarRock1", 0, 0, 8, frandom(6,14), frandom(-11,11), frandom(-11,11), 0, SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("FamiliarRock2", 0, 0, 8, frandom(6,14), frandom(-11,11), frandom(-11,11), 0, SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("FamiliarRock3", 0, 0, 8, frandom(6,14), frandom(-11,11), frandom(-11,11), 0, SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("FamiliarRock4", 0, 0, 8, frandom(6,14), frandom(-11,11), frandom(-11,11), 0, SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("FamiliarRock5", 0, 0, 8, frandom(6,14), frandom(-11,11), frandom(-11,11), 0, SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION)
		DRON E 6 Bright A_SetTranslucent(1.0, 0)
		DRON F 6 Bright A_SetTranslucent(0.9, 0)
		DRON G 6 Bright A_SetTranslucent(0.8, 0)
		DRON H 6 Bright A_SetTranslucent(0.7, 0)
		DRON I 6 Bright A_SetTranslucent(0.6, 0)
		DRON J 6 Bright A_SetTranslucent(0.5, 0)
		DRON K 6 Bright A_SetTranslucent(0.4, 0)
		Stop
	Ice:
		HDRN A 5 A_FreezeDeath
		HDRN A 1 A_FreezeDeathChunks
		Wait
	}
}

ACTOR DroneFamiliarShot
{
	Speed 18
	FastSpeed 24
	Radius 6
	Height 6
	Mass 5
	Damage 15
	Projectile
	+RANDOMIZE
	+MTHRUSPECIES
	Species "FriendlyDrone"
	RenderStyle Add
	Scale 0.5
	SeeSound "drone/fire"
	States
	{
	Spawn:
		DROS ABAB 3 Bright
		Loop
	Death:
		DROS CDEFGH 4 Bright
		Stop
	}


}
