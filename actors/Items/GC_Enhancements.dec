// God Complex enhancement pickups — map spawns + equipment wheel ammo.

ACTOR GCPlasmaChargeMode : Inventory { Inventory.MaxAmount 1 }
ACTOR GCNemLMGSuppress : Inventory { Inventory.MaxAmount 1 }
ACTOR GCASGSlugMode : Inventory { Inventory.MaxAmount 1 }
ACTOR GCChainsawBerserk : Inventory { Inventory.MaxAmount 1 }
ACTOR GCDevastadorBoost : Inventory { Inventory.MaxAmount 1 }
ACTOR NemesisBFGMode : Inventory { Inventory.MaxAmount 1 }

ACTOR GCShieldSphereAmmo : Ammo
{
	Inventory.Amount 1
	Inventory.MaxAmount 2
	Ammo.BackPackAmount 1
	Ammo.BackPackMaxAmount 4
	Inventory.Icon "SHIGA0"
	+INVENTORY.IGNORESKILL
}

ACTOR GCChaliceAmmo : Ammo
{
	Inventory.Amount 1
	Inventory.MaxAmount 1
	Ammo.BackPackAmount 1
	Ammo.BackPackMaxAmount 2
	Inventory.Icon "SHIGA0"
	+INVENTORY.IGNORESKILL
}

ACTOR PBWP_GCShieldSpherePickup : CustomInventory
{
	+DONTSPLASH
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupMessage "GC Shield Sphere (equipment)"
	Inventory.PickupSound "misc/p_pkup"
	Scale 0.55
	States
	{
	Spawn:
		LFSS ABCDEF 4 Bright
		Loop
	Pickup:
		TNT1 A 0 A_GiveInventory("GCShieldSphereAmmo", 1)
		TNT1 A 0 A_GiveInventory("PBWP_GCShieldSphereToken", 1)
		Stop
	}
}

ACTOR PBWP_GCDemonicChalicePickup : CustomInventory
{
	+DONTSPLASH
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupMessage "Demonic Chalice (equipment)"
	Inventory.PickupSound "misc/p_pkup"
	Scale 0.65
	States
	{
	Spawn:
		PINS ABCD 4 Bright
		Loop
	Pickup:
		TNT1 A 0 A_GiveInventory("GCChaliceAmmo", 1)
		TNT1 A 0 A_GiveInventory("PBWP_GCChaliceToken", 1)
		Stop
	}
}

ACTOR PBWP_GCLegRandomSpherePickup : CustomInventory
{
	+COUNTITEM
	+FLOATBOB
	+INVENTORY.BIGPOWERUP
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupMessage "Leg Random Sphere!"
	Inventory.PickupSound "misc/p_pkup"
	Scale 0.7
	States
	{
	Spawn:
		LESP ABCD 6 Bright
		Loop
	Pickup:
		TNT1 A 0 A_GiveInventory("GC_LegRandomSpherePulse", 1)
		Stop
	}
}

ACTOR PBWP_GCShieldSphereToken : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR PBWP_GCChaliceToken : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

