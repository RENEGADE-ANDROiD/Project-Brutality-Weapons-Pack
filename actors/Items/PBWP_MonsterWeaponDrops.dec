// Salvage durability pools (PBX-style) for monster-drop-only PBWP weapons.
// First pickup grants weapon; full durability is applied on weapon Select (PBWP_EnsureMonsterDurability).

ACTOR MancubusFlameDurability : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 50
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 50
}

ACTOR DualFlameCannonDurability : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 60
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 60
}

ACTOR CryoRifleDurability : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 45
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 45
}

ACTOR StormcastDurability : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 50
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 50
}

ACTOR BioAcidLauncherDurability : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 40
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 40
}

// --- Drop pickups (weapon first pickup; durability/ammo refill after) ---

ACTOR PBWP_CryoRifleDrop : CustomInventory
{
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupSound "weapons/plassmg"
	States
	{
	Spawn:
		FRZR A -1
		Stop
	Pickup:
		TNT1 A 0 A_JumpIfInventory("PB_CryoRifle", 1, "Refill")
		TNT1 A 0 A_GiveInventory("PB_CryoRifle", 1)
		Stop
	Refill:
		TNT1 A 0 A_GiveInventory("CryoRifleDurability", 22)
		TNT1 A 0 A_GiveInventory("FreezerAmmo", 40)
		Stop

}

}
ACTOR PBWP_ThunderCrossbowDrop : CustomInventory
{
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupSound "weapons/sawup"
	States
	{
	Spawn:
