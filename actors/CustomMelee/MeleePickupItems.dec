ACTOR KatanaPickup : CustomInventory {
	Game Doom
	Inventory.PickupSound "Ammocase/Open"
    Inventory.Amount 1
	Inventory.PickupMessage "Katana"
	Scale 0.9
	+Inventory.AlwaysPickUp
	+FLOORCLIP
	+DONTGIB
		States {
			Spawn:
				KATA N -1 
				Stop
			Pickup:
				TNT1 A 0 A_GiveInventory ("KatanaDurability",50)
				TNT1 A 0 A_GiveInventory ("PBWP_KatanaMeleeToken", 1)
				Stop }}

