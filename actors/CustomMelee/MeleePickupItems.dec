actor HasShockBaton : Inventory {inventory.maxamount 1}

ACTOR ShockBaton : CustomInventory {
	Game Doom
	Inventory.PickupSound "shockbaton/swing1"
	Inventory.PickupMessage "Shock Baton"
	Scale 0.9
	+Inventory.AlwaysPickUp
	+FLOORCLIP
	+DONTGIB
		States {
			Spawn:
				BATN W -1 
				Stop
			Pickup:
				TNT1 A 0 A_GiveInventory ("PB_Cell",50)
				TNT1 A 0 A_GiveInventory ("HasShockBaton",1)
				TNT1 A 0 A_GiveInventory ("PBWP_BatonMeleeToken", 1)
				Stop }}

ACTOR DemonicSword : CustomInventory {
	Game Doom
	Inventory.PickupSound "AXSWING"
	Inventory.PickupMessage "Demonic Sword"
	Scale 0.7
	+Inventory.AlwaysPickUp
	+FLOORCLIP
	+DONTGIB
		States {
			Spawn:
				6KAT A -1 
				Stop
			Pickup:
				TNT1 A 0 A_GiveInventory ("PB_DTech",40)
				TNT1 A 0 A_GiveInventory ("KatanaDurability",50)
                TNT1 A 0 A_GiveInventory ("HasDemonicKatana",1)
				TNT1 A 0 A_GiveInventory ("PBWP_KatanaMeleeToken", 1)
				Stop }}

